{%- if shop.refund_policy.body != blank and shop.refund_policy.url != blank -%}
  {%- assign merchant_return_policy_url = shop.url | append: shop.refund_policy.url -%}
  {%- assign merchant_return_policy_id = merchant_return_policy_url | append: '#merchant-return-policy' -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- comment -%}
    Judge.me uses the product @id to connect its review JSON-LD to this Product.
    Read the aggregate from the same Judge.me badge shown on the product page;
    omit it when the product has no published reviews.
  {%- endcomment -%}
  {%- assign judgeme_badge = product.metafields.judgeme.badge -%}
  {%- assign judgeme_review_count = 0 -%}
  {%- assign judgeme_rating_value = 0 -%}
  {%- if judgeme_badge != blank -%}
    {%- assign judgeme_review_count = judgeme_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0 -%}
    {%- assign judgeme_rating_value = judgeme_badge | split: "data-average-rating='" | last | split: "'" | first | plus: 0 -%}
  {%- endif -%}
  {%- comment -%}
    Shopify's structured_data filter does not expose Offer-level shipping.
    The values below mirror the Japan shipping information published on the
    storefront: free domestic shipping, 1–3 business days to dispatch, and
    5–7 business days in transit. Do not add validFrom without the actual
    campaign start date for the price.
  {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ canonical_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ product.description | strip_html | strip_newlines | json }},
      {%- if product.featured_image -%}
        "image": [{{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}],
      {%- endif -%}
      {%- if product.vendor != blank -%}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
      {%- endif -%}
      {%- if judgeme_review_count > 0 and judgeme_rating_value > 0 -%}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ judgeme_rating_value | json }},
          "reviewCount": {{ judgeme_review_count | json }},
          "bestRating": 5
        },
      {%- endif -%}
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "url": {{ canonical_url | json }},
            "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            {%- if merchant_return_policy_id != blank -%}
              "hasMerchantReturnPolicy": { "@id": {{ merchant_return_policy_id | json }} },
            {%- endif -%}
            "shippingDetails": {
              "@type": "OfferShippingDetails",
              "shippingDestination": {
                "@type": "DefinedRegion",
                "addressCountry": "JP"
              },
              "shippingRate": {
                "@type": "MonetaryAmount",
                "value": 0,
                "currency": {{ cart.currency.iso_code | default: shop.currency | json }}
              },
              "deliveryTime": {
                "@type": "ShippingDeliveryTime",
                "handlingTime": {
                  "@type": "QuantitativeValue",
                  "minValue": 1,
                  "maxValue": 3,
                  "unitCode": "DAY"
                },
                "transitTime": {
                  "@type": "QuantitativeValue",
                  "minValue": 5,
                  "maxValue": 7,
                  "unitCode": "DAY"
                }
              }
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
  {%- if merchant_return_policy_id != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": {{ shop.url | append: '#organization' | json }},
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "@id": {{ merchant_return_policy_id | json }},
          "merchantReturnLink": {{ merchant_return_policy_url | json }}
        }
      }
    </script>
  {%- endif -%}
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{- article | structured_data -}}
  </script>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumb.home' | t | json }},
        "item": "{{ shop.url }}"
      }

      {%- if request.page_type == 'product' -%}
        {%- if collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "{{ shop.url }}{{ collection.url }}"
          }, {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": "{{ shop.url }}{{ product.url }}"
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": "{{ shop.url }}{{ product.url }}"
          }
        {%- endif -%}
      {%- elsif request.page_type == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "{{ shop.url }}{{ collection.url }}"
          }
      {%- elsif request.page_type == 'blog' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }
      {%- elsif request.page_type == 'article' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }, {
            "@type": "ListItem",
            "position": 3,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ article.url }}"
          }
      {%- elsif request.page_type == 'page' -%}
        ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": "{{ shop.url }}{{ page.url }}"
          }
      {%- endif -%}
    ]
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" -%}
  {%- comment -%}
    Keep the optional description property present even when no Brand short
    description has been configured in Shopify admin. This prevents the
    Organization/WebSite schema from being reported as incomplete.
  {%- endcomment -%}
  {%- assign schema_description = shop.brand.short_description | default: shop.description | default: page_description | default: shop.name -%}

  <script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "description": {{ schema_description | strip_html | strip_newlines | json }},
      "url": {{ shop.url | append: page.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ shop.url | append: '#organization' | json }},
      "name": {{ shop.name | json }},
      {%- if merchant_return_policy_id != blank -%}
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "@id": {{ merchant_return_policy_id | json }},
          "merchantReturnLink": {{ merchant_return_policy_url | json }}
        },
      {%- endif -%}
      {%- if shop.brand.logo -%}
        "logo": {{ shop.brand.logo | image_url: width: shop.brand.logo.width | prepend: "https:" | json }},
      {%- endif -%}
      "description": {{ schema_description | strip_html | strip_newlines | json }},
      {%- if shop.brand.slogan -%}
        "slogan": {{ shop.brand.slogan | json }},
      {%- endif -%}
      {%- if shop.brand.metafields.social_links.size > 0 -%}
        "sameAs": [
          {%- for social_link in shop.brand.metafields.social_links -%}
            {{- social_link.last.value | json -}}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
      {%- endif -%}
      "url": {{ shop.url | append: page.url | json }}
    }
  ]
  </script>
{%- endif -%}
