{%- comment -%}
  Snippet: product-info-new
  用途：产品页右侧信息区，根据 jp-main-product.liquid 的 blocks 配置逐块渲染。

  参数：
  - product: 当前产品对象
  - section: 当前 section 对象
  - update_url: 是否允许变体切换时更新 URL，预留给后续 JS 使用
{%- endcomment -%}

{%- liquid
  assign current_product = product
  assign current_variant = current_product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign quantity_blocks = section.blocks | where: 'type', 'quantity_selector'
  assign buy_button_blocks = section.blocks | where: 'type', 'buy_buttons'
  assign has_quantity_selector = false
  assign has_buy_buttons = false

  if quantity_blocks.size > 0
    assign has_quantity_selector = true
  endif

  if buy_button_blocks.size > 0
    assign has_buy_buttons = true
  endif
-%}

<div class="jp-product-info" data-product-info data-product-id="{{ current_product.id }}">
  {%- form 'product',
    current_product,
    id: form_id,
    class: 'jp-product-info__form product-form',
    novalidate: 'novalidate',
    data-type: 'add-to-cart-form',
    data-hide-errors: 'false',
    is: 'product-form'
  -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-variant-id>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          <div class="jp-product-info__block jp-product-info__block--app" {{ block.shopify_attributes }}>
            {%- render block -%}
          </div>

        {%- when 'title' -%}
          <div class="jp-product-info__block jp-product-info__block--title" {{ block.shopify_attributes }}>
            <h1 class="jp-product-info__title">{{ current_product.title }}</h1>
          </div>

        {%- when 'review_badge' -%}
          <div class="jp-product-info__block jp-product-info__block--review" {{ block.shopify_attributes }}>
            {{ current_product.metafields.judgeme.badge }}
          </div>

        {%- when 'product_description' -%}
          {%- if current_product.description != blank -%}
            <div class="jp-product-info__block jp-product-info__block--description" {{ block.shopify_attributes }}>
              <div class="jp-product-info__description ">
                {{ current_product.description }}
              </div>
            </div>
          {%- endif -%}

        {%- when 'price' -%}
          <div class="jp-product-info__block jp-product-info__block--price" {{ block.shopify_attributes }}>
            <div class="jp-product-info__price-row">
              {%- liquid
                assign original_price = block.settings.original_price
                if original_price == blank and current_variant.compare_at_price > current_variant.price
                  assign original_price = current_variant.compare_at_price | money
                endif
              -%}

              <div class="jp-product-info__price-item">
                {%- if block.settings.label != blank -%}
                  <div class="jp-product-info__price-label">{{ block.settings.label }}</div>
                {%- endif -%}
                <div class="jp-product-info__price" data-product-price>
                  {%- if block.settings.price_text != blank -%}
                    <div data-product-price-money data-static-price="true">{{ block.settings.price_text }}</div>
                  {%- else -%}
                    <div data-product-price-money>{{ current_variant.price | money }}</div>
                  {%- endif -%}
                  <div class="jp-product-info__tax-label">（税込）</div>
                </div>
              </div>

              {%- if original_price != blank -%}
                <div class="jp-product-info__price-item">
                  {%- if block.settings.original_price_label != blank -%}
                    <div class="jp-product-info__price-label">{{ block.settings.original_price_label }}</div>
                  {%- endif -%}
                  <div class="jp-product-info__compare-price" data-product-compare-price>
                    <div data-product-compare-price-money{% if block.settings.original_price != blank %} data-static-price="true"{% endif %}>{{ original_price }}</div>
                    <span class="jp-product-info__tax-label">（税込）</span>
                  </div>
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.discount_information != blank -%}
              <div class="jp-product-info__discount-info">
                {{ block.settings.discount_information }}
              </div>
            {%- endif -%}
          </div>

        {%- when 'discount_code' -%}
          {%- liquid
            assign coupon_style = ''
            if block.settings.bg_image != blank
              assign coupon_bg = block.settings.bg_image | image_url: width: 1000
              assign coupon_style = 'background-image: url(' | append: coupon_bg | append: ');'
            endif
          -%}

          <div class="jp-product-info__block jp-product-info__block--discount-code" {{ block.shopify_attributes }}>
            <div class="jp-product-coupon" data-discount-code-card>
              <div class="jp-product-coupon__main" style="{{ coupon_style }}">
                {%- if block.settings.discount_text != blank -%}
                  <div class="jp-product-coupon__discount">{{ block.settings.discount_text }}</div>
                {%- endif -%}

                {%- if block.settings.code_text != blank -%}
                  <button
                    type="button"
                    class="jp-product-coupon__copy"
                    data-discount-code-copy
                    data-code="{{ block.settings.code_text | escape }}"
                    data-auto-apply="{{ block.settings.is_auto_apply }}"
                  >
                    <span class="jp-product-coupon__copy-label">{{ block.settings.copy_text | default: 'Copy:' }}</span>
                    <span class="jp-product-coupon__code">{{ block.settings.code_text }}</span>
                    <div class="copy-success" aria-hidden="true">
                      <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0656/9079/6273/files/Union_4.svg?v=1723451359" alt="">
                      Copied
                    </div>
                  </button>
                {%- endif -%}
              </div>

              {%- if block.settings.tip_text != blank -%}
                <div class="jp-product-coupon__tip">{{ block.settings.tip_text }}</div>
              {%- endif -%}

              {%- if block.settings.success_text != blank -%}
                <div class="jp-product-coupon__success" data-discount-code-success hidden>
                  {{ block.settings.success_text }}
                </div>
              {%- else -%}
                <div class="jp-product-coupon__success" data-discount-code-success hidden>
                  コピーしました
                </div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'variant_picker' -%}
          {%- unless current_product.has_only_default_variant -%}
            <div class="jp-product-info__block jp-product-info__block--variant-picker" {{ block.shopify_attributes }}>
              <div class="jp-product-variants" data-product-variants>
                {%- for option in current_product.options_with_values -%}
                  {%- liquid
                    assign color_swatch_trigger = 'products.general.color_swatch_trigger' | t | downcase
                    assign option_name_downcase = option.name | downcase
                    assign is_color_option = false

                    if option_name_downcase contains color_swatch_trigger
                      assign is_color_option = true
                    elsif color_swatch_trigger == 'color' and option_name_downcase contains 'colour'
                      assign is_color_option = true
                    endif
                  -%}
                  <fieldset class="jp-product-variants__group{% if is_color_option %} variant-picker product-form__input variant-input-wrapper{% endif %}" data-option-index="option{{ option.position }}" data-option-slug="{{ option.name | handleize }}">
                    <legend class="jp-product-variants__legend{% if is_color_option %} sr-only{% endif %}">{{ option.name }}</legend>

                    {%- if is_color_option -%}
                      <div class="form__label flex items-center justify-between gap-2 w-full">
                        <div class="flex gap-2">
                          {{ option.name }}:
                          <span class="font-medium" data-option-selected-value="{{ option.position }}">{{ option.selected_value }}</span>
                        </div>
                      </div>
                      <ul class="swatches swatches--{{ settings.rounded_swatch }} swatches--variant flex items-center flex-wrap gap-4 jp-product-variants__swatches">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index
                            assign swatch_color = value | split: ' ' | last | handle
                            assign swatch_image = blank
                            assign option_idx0 = option.position | minus: 1
                            assign swatch_media_id = blank
                            assign value_downcase = value | downcase
                            assign swatch_config = settings.swatch_config
                            if swatch_config == blank
                              assign swatch_config = settings.color_swatch_config
                            endif
                            assign swatch_config = swatch_config | newline_to_br | split: '<br />'

                            for swatch in swatch_config
                              assign swatch_parts = swatch | strip | split: ':'
                              assign swatch_name = swatch_parts.first | downcase | strip

                              if swatch_name == value_downcase
                                assign configured_swatch = swatch_parts.last | strip
                                if configured_swatch contains '#'
                                  assign swatch_color = configured_swatch
                                else
                                  assign swatch_file_name = configured_swatch
                                  if images[swatch_file_name] != blank
                                    assign swatch_image = images[swatch_file_name] | image_url: width: 72
                                  elsif swatch_file_name contains '//cdn.shopify.com/'
                                    assign swatch_image = swatch_file_name
                                  endif
                                endif
                                break
                              endif
                            endfor

                            for variant in current_product.variants
                              if variant.options[option_idx0] == value and variant.image != blank
                                assign swatch_image = variant.image | image_url: width: 144
                                assign swatch_media_id = variant.image.id
                                break
                              endif
                            endfor
                          -%}
                          <li>
                            <input
                              id="{{ input_id }}"
                              class="sr-only"
                              type="radio"
                              name="option{{ option.position }}"
                              value="{{ value | escape }}"
                              data-option-position="{{ option.position }}"
                              {% if swatch_media_id != blank %}data-variant-media-id="{{ swatch_media_id }}"{% endif %}
                              {% if option.selected_value == value %}checked{% endif %}
                            >
                            <label class="color-swatch relative" for="{{ input_id }}" title="{{ value | escape }}" style="--swatch-background: {{ swatch_color }};{% if swatch_image != blank %} background-image: url({{ swatch_image }});{% endif %}">
                              <span class="tooltip opacity-0 pointer-events-none text-sm rounded-full z-10">{{ value }}</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- elsif block.settings.selector_mode == 'dropdown' -%}
                      <select class="jp-product-variants__select" data-option-position="{{ option.position }}">
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                        {%- endfor -%}
                      </select>
                    {%- else -%}
                      <div class="jp-product-variants__list">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index
                            assign option_media_id = blank
                            assign option_idx0 = option.position | minus: 1
                            for variant in current_product.variants
                              if variant.options[option_idx0] == value and variant.image != blank
                                assign option_media_id = variant.image.id
                                break
                              endif
                            endfor
                          -%}
                          <input
                            id="{{ input_id }}"
                            class="jp-product-variants__input visually-hidden"
                            type="radio"
                            name="option{{ option.position }}"
                            value="{{ value | escape }}"
                            data-option-position="{{ option.position }}"
                            {% if option_media_id != blank %}data-variant-media-id="{{ option_media_id }}"{% endif %}
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <label class="jp-product-variants__item" for="{{ input_id }}">{{ value }}</label>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </fieldset>
                {%- endfor -%}
              </div>

              <script type="application/json" data-product-variants-json>
                {{ current_product.variants | json }}
              </script>
              <script type="application/json" data-product-variant-media-map-json>
                [
                  {%- for variant in current_product.variants -%}
                    {%- liquid
                      assign variant_media_position = variant.featured_media.position
                      if variant_media_position == blank and variant.image != blank
                        assign variant_media_position = variant.image.position
                      endif
                    -%}
                    {
                      "vid": {{ variant.id | json }},
                      "position": {{ variant_media_position | default: 0 | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              </script>
              <script type="application/json" data-product-media-json>
                [
                  {%- for media in current_product.media -%}
                    {{ media | json }}{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              </script>
            </div>
          {%- endunless -%}

        {%- when 'quantity_selector' -%}
          {%- unless has_buy_buttons -%}
            <div class="jp-product-info__block jp-product-info__block--quantity" {{ block.shopify_attributes }}>
              <div class="jp-product-quantity" data-product-quantity>
                <button class="jp-product-quantity__button" type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
                <input class="jp-product-quantity__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-quantity-input>
                <button class="jp-product-quantity__button" type="button" data-quantity-plus aria-label="Increase quantity">+</button>
              </div>
            </div>
          {%- endunless -%}

        {%- when 'buy_buttons' -%}
          <div class="jp-product-info__block jp-product-info__block--buy-buttons" {{ block.shopify_attributes }}>
            <div class="jp-product-purchase">
              <div class="jp-product-form-error product-form__error-message" role="alert" hidden></div>
              <div class="jp-product-purchase__primary{% unless has_quantity_selector %} jp-product-purchase__primary--button-only{% endunless %}">
                {%- if has_quantity_selector -%}
                  <div class="jp-product-quantity" data-product-quantity>
                    <button class="jp-product-quantity__button" type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
                    <input class="jp-product-quantity__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-quantity-input>
                    <button class="jp-product-quantity__button" type="button" data-quantity-plus aria-label="Increase quantity">+</button>
                  </div>
                {%- else -%}
                  <input type="hidden" name="quantity" value="1">
                {%- endif -%}

                <button
                  type="submit"
                  name="add"
                  form="{{ form_id }}"
                  class="jp-product-buttons__btn jp-product-buttons__btn--cart"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span class="jp-product-buttons__fill" aria-hidden="true"></span>
                  <span class="jp-product-buttons__text btn-text" data-add-to-cart-text>
                    {%- if current_variant.available -%}
                      {{ block.settings.add_to_cart_text | default: 'カートに追加する' }}
                    {%- else -%}
                      売り切れ
                    {%- endif -%}
                  </span>
                  <span class="jp-product-buttons__loader" aria-hidden="true"></span>
                </button>
              </div>

              {%- if block.settings.show_buy_button -%}
                <button
                  type="button"
                  name="buy_now"
                  form="{{ form_id }}"
                  class="jp-product-buttons__btn jp-product-buttons__btn--buy-now"
                  data-buy-now-button
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span class="jp-product-buttons__fill" aria-hidden="true"></span>
                  <span class="jp-product-buttons__text">{{ block.settings.buy_now_text | default: '今すぐ注文' }}</span>
                  <span class="jp-product-buttons__loader" aria-hidden="true"></span>
                </button>
              {%- endif -%}
            </div>
          </div>

        {%- when 'aftermarket' -%}
          <div class="jp-product-info__block jp-product-info__block--aftermarket" {{ block.shopify_attributes }}>
            <div class="jp-product-service">
              {%- for i in (0..4) -%}
                {%- liquid
                  if i == 0
                    assign icon = block.settings.image
                    assign text = block.settings.text
                  elsif i == 1
                    assign icon = block.settings.image1
                    assign text = block.settings.text1
                  elsif i == 2
                    assign icon = block.settings.image2
                    assign text = block.settings.text2
                  elsif i == 3
                    assign icon = block.settings.image3
                    assign text = block.settings.text3
                  else
                    assign icon = block.settings.image4
                    assign text = block.settings.text4
                  endif
                -%}

                {%- if icon != blank or text != blank -%}
                  <div class="jp-product-service__item">
                    {%- if icon != blank -%}
                      {{ icon | image_url: width: 80 | image_tag: class: 'jp-product-service__icon', loading: 'lazy', widths: '40, 60, 80', sizes: '40px' }}
                    {%- endif -%}
                    {%- if text != blank -%}
                      <div class="jp-product-service__text">{{ text }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.note_text != blank -%}
              <div class="jp-product-service-note">
                {{ block.settings.note_text }}
              </div>
            {%- endif -%}
          </div>

        {%- when 'link_button' -%}
          {%- if block.settings.text != blank -%}
            <div class="jp-product-info__block jp-product-info__block--link-button" {{ block.shopify_attributes }}>
              <a
                class="jp-product-link-button"
                target="_blank"
                href="{{ block.settings.link | default: '#' }}"
                {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                <span>{{ block.settings.text }}</span>
                {%- if block.settings.show_arrow -%}
                  <span class="jp-product-link-button__arrow" aria-hidden="true">»</span>
                {%- endif -%}
              </a>
            </div>
          {%- endif -%}

        {%- when 'countdown' -%}
          {%- liquid
            assign countdown_end_time = block.settings.end_time
            if current_product.metafields.theme.countdown.value != blank
              assign countdown_end_time = current_product.metafields.theme.countdown.value
            endif

            assign should_show_countdown = false
            if countdown_end_time != blank
              assign now_time = 'now' | date: '%s' | times: 1
              assign countdown_time = countdown_end_time | date: '%s' | times: 1
              if countdown_time > now_time
                assign should_show_countdown = true
              endif
            endif
          -%}

          {%- if should_show_countdown -%}
            <div class="jp-product-info__block jp-product-info__block--countdown" {{ block.shopify_attributes }}>
              <div class="jp-product-countdown" data-product-countdown data-countdown-end="{{ countdown_end_time | escape }}">
                <div class="jp-product-countdown__headline">
                  {%- if block.settings.prefix_text != blank -%}
                    <span>{{ block.settings.prefix_text }}</span>
                  {%- endif -%}
                  {%- if block.settings.highlight_text != blank -%}
                    <span class="jp-product-countdown__highlight" text="{{ block.settings.highlight_text }}" >{{ block.settings.highlight_text }}</span>
                  {%- endif -%}
                  {%- if block.settings.suffix_text != blank -%}
                    <span>{{ block.settings.suffix_text }}</span>
                  {%- endif -%}
                </div>

                <div class="jp-product-countdown__timer" aria-live="polite">
                  <span class="jp-product-countdown__label">{{ block.settings.label_text | default: '終了まであと' }}</span>
                  <span class="jp-product-countdown__value" data-countdown-days>00</span>
                  <span class="jp-product-countdown__unit">日</span>
                  <span class="jp-product-countdown__separator">:</span>
                  <span class="jp-product-countdown__value" data-countdown-hours>00</span>
                  <span class="jp-product-countdown__unit">時間</span>
                  <span class="jp-product-countdown__separator">:</span>
                  <span class="jp-product-countdown__value" data-countdown-minutes>00</span>
                  <span class="jp-product-countdown__unit">分</span>
                  <span class="jp-product-countdown__separator">:</span>
                  <span class="jp-product-countdown__value" data-countdown-seconds>00</span>
                  <span class="jp-product-countdown__unit">秒</span>
                </div>
              </div>
            </div>
          {%- endif -%}

        {%- when 'liquid' -%}
          {%- if block.settings.liquid != blank -%}
            <div class="jp-product-info__block jp-product-info__block--liquid" {{ block.shopify_attributes }}>
              {{ block.settings.liquid }}
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  {%- endform -%}
</div>
