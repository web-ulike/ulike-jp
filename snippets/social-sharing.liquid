{%- liquid
  assign share_url = share_permalink
  unless share_url contains '://'
    assign share_url = request.origin | append: share_permalink
  endunless
  assign encoded_url = share_url | url_param_escape
  assign encoded_title = share_title | strip_html | url_param_escape
  if share_image != blank
    assign encoded_image = share_image | image_url: width: 1200 | prepend: 'https:' | url_param_escape
  endif
-%}

<div class="social-sharing">
  <p class="social-sharing__label">{{ share_label | default: 'Share' | escape }}:</p>
  <ul class="social-sharing__list" role="list">
    <li>
      <a target="_blank" rel="noopener noreferrer" class="social-sharing__link" is="magnet-link" href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}" aria-label="{{ 'general.social.facebook_share' | t | escape }}">
        {%- render 'icon', icon: 'facebook', size: 'sm' -%}
      </a>
    </li>
    <li>
      <a target="_blank" rel="noopener noreferrer" class="social-sharing__link" is="magnet-link" href="https://twitter.com/intent/tweet?text={{ encoded_title }}%20{{ encoded_url }}" aria-label="{{ 'general.social.twitter_tweet' | t | escape }}">
        {%- render 'icon', icon: 'twitter', size: 'sm' -%}
      </a>
    </li>
    <li>
      <a target="_blank" rel="noopener noreferrer" class="social-sharing__link" href="https://www.pinterest.com/pin/create/button/?url={{ encoded_url }}&amp;description={{ encoded_title }}{% if encoded_image != blank %}&amp;media={{ encoded_image }}{% endif %}" aria-label="{{ 'general.social.pinterest_pin' | t | escape }}">
        {%- render 'icon', icon: 'pinterest', size: 'sm' -%}
      </a>
    </li>
    <li>
      <a class="social-sharing__link" href="mailto:?subject={{ encoded_title }}&amp;body={{ encoded_url }}" aria-label="{{ 'general.social.email_share' | t | escape }}">
        {%- render 'icon', icon: 'header-email' -%}
      </a>
    </li>
  </ul>
</div>
