{%- liquid
  assign card_product = product | default: all_products[product_handle]
  assign card_title = title | default: card_product.title
  assign card_badge = badge
  assign card_url = fallback_url | default: routes.all_products_collection_url
  if card_product != blank
    assign card_url = card_product.url
    if card_product.metafields.custom.badges != blank
      assign card_badge = card_product.metafields.custom.badges.value | first
    endif
  endif
-%}
<a class="header-2026__product-card" href="{{ card_url }}">
  <span class="header-2026__product-media">
    {%- if card_product.featured_image != blank -%}
      {{- card_product.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '100,160,200,240', sizes: '100px', alt: card_title -}}
    {%- elsif fallback_image != blank -%}
      <img src="{{ fallback_image | asset_url }}" width="100" height="98" alt="{{ card_title | escape }}" loading="lazy">
    {%- endif -%}
  </span>
  <span class="header-2026__product-copy">
    <span class="header-2026__product-heading">
      <span class="header-2026__product-title">{{ card_title | escape }}</span>
      {%- if card_badge != blank -%}<span class="header-2026__product-badge">{{ card_badge | escape }}</span>{%- endif -%}
    </span>
    {%- render 'header-2026-product-rating', product: card_product -%}
    {%- if card_product != blank -%}<span class="header-2026__product-price">{{ card_product.price | money_without_trailing_zeros }} <small>（税込）</small></span>{%- endif -%}
    <span class="header-2026__product-more">詳しく見る <span aria-hidden="true">→</span></span>
  </span>
</a>
