<div class="search-page-2026__recommendations">
  <h2>おすすめ検索</h2>
  <div class="search-page-2026__recommendation-grid">
    <a class="search-page-2026__recommendation" href="{{ section.settings.recommend_products_link | default: '/collections/all' }}">
      <span class="search-page-2026__recommendation-image search-page-2026__recommendation-image--products">
        {%- if section.settings.recommend_products_image != blank -%}
          {{ section.settings.recommend_products_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: 'Ulikeの人気製品' }}
        {%- else -%}
          <img src="{{ 'search-recommend-products.png' | asset_url }}" width="1799" height="1866" loading="lazy" alt="Ulikeの人気製品">
        {%- endif -%}
      </span>
      <span class="search-page-2026__recommendation-label">人気製品一覧 <img src="{{ 'search-recommend-arrow.svg' | asset_url }}" width="10" height="16" alt=""></span>
    </a>
    <a class="search-page-2026__recommendation" href="{{ section.settings.recommend_faq_link | default: '/pages/faq' }}">
      <span class="search-page-2026__recommendation-image search-page-2026__recommendation-image--photo">
        {%- if section.settings.recommend_faq_image != blank -%}
          {{ section.settings.recommend_faq_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: 'よくある質問' }}
        {%- else -%}
          <img src="{{ 'search-recommend-faq.png' | asset_url }}" width="1608" height="978" loading="lazy" alt="よくある質問">
        {%- endif -%}
      </span>
      <span class="search-page-2026__recommendation-label">よくある質問 <img src="{{ 'search-recommend-arrow.svg' | asset_url }}" width="10" height="16" alt=""></span>
    </a>
    <a class="search-page-2026__recommendation" href="{{ section.settings.recommend_contact_link | default: '/pages/contact-us' }}">
      <span class="search-page-2026__recommendation-image search-page-2026__recommendation-image--photo">
        {%- if section.settings.recommend_contact_image != blank -%}
          {{ section.settings.recommend_contact_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: 'お問い合わせ' }}
        {%- else -%}
          <img src="{{ 'search-recommend-contact.png' | asset_url }}" width="1608" height="978" loading="lazy" alt="お問い合わせ">
        {%- endif -%}
      </span>
      <span class="search-page-2026__recommendation-label">お問い合わせ <img src="{{ 'search-recommend-arrow.svg' | asset_url }}" width="10" height="16" alt=""></span>
    </a>
  </div>
</div>
