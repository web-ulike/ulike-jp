{% comment %}Figma comparison artwork. Only show value-specific symbols for matching specifications.{% endcomment %}
{%- liquid
  assign spec = value | strip_newlines | remove: ' ' | remove: '　' | downcase
  case field
    when 'ushr', 'sensor', 'ice', 'app'
      if value
        assign icon = 'yes'
      else
        assign icon = 'no'
      endif
    when 'effect'
      assign icon = 'calendar'
    when 'cooling'
      assign icon = 'cooling'
    when 'power'
      case spec
        when '30j'
          assign icon = 'power30'
        when '28j'
          assign icon = 'power28'
        when '22j', '20j'
          assign icon = 'power22'
      endcase
    when 'density'
      case spec
        when '7.6'
          assign icon = 'density76'
        when '7.1'
          assign icon = 'density71'
        when '6.6'
          assign icon = 'density66'
      endcase
    when 'lamps'
      case spec
        when '2本(ダブルランプ)', '2本（ダブルランプ）', '2本'
          assign icon = 'lamps2'
        when '1本'
          assign icon = 'lamps1'
      endcase
    when 'area'
      case spec
        when '13×30'
          assign icon = 'area13'
        when '11×30'
          assign icon = 'area11'
        when '10×30'
          assign icon = 'area10'
      endcase
    when 'duration'
      case spec
        when '髭ケア1回約2分', '約2分', '2分'
          assign icon = 'duration2'
        when '約8分', '8分'
          assign icon = 'duration8'
        when '約10分', '10分'
          assign icon = 'duration10'
        when '約17分', '17分'
          assign icon = 'duration17'
      endcase
    when 'speed'
      case spec
        when '最短0.2秒の高速フラッシュ', '0.2秒'
          assign icon = 'speed02'
        when '最短0.25秒の高速フラッシュ', '0.25秒'
          assign icon = 'speed025'
        when '最短0.4秒の高速フラッシュ', '0.4秒'
          assign icon = 'speed04'
        when '最短0.5秒の高速フラッシュ', '0.5秒'
          assign icon = 'speed05'
      endcase
    when 'weight'
      case spec
        when '355g'
          assign icon = 'weight355'
        when '278g'
          assign icon = 'weight278'
        when '287g'
          assign icon = 'weight287'
      endcase
    when 'start_cooling'
      case spec
        when '−5度', '-5度', '−5°c', '-5°c'
          assign icon = 'start2'
        when '5度以下', '5°c以下'
          assign icon = 'start1'
      endcase
    when 'lifetime'
      case spec
        when '90万発'
          assign icon = 'life90'
        when '30万発'
          assign icon = 'life30'
      endcase
  endcase
-%}
