<desktop-navigation class="header-2026__desktop-navigation">
  <ul class="header__linklist header-2026__nav-list list--unstyled {% unless bottom_navigation %}hidden-pocket hidden-lap{% endunless %}" role="list">
    {%- assign header_2026_kinds = 'products,guide,technology,about,topics' | split: ',' -%}
    {%- for link in menu.links -%}
      {%- assign index = forloop.index0 -%}
      {%- assign kind = header_2026_kinds[index] -%}
      {%- if kind != blank -%}
      <li class="header__linklist-item header-2026__nav-item has-dropdown" data-item-title="{{ link.title | escape }}">
        <button class="header__linklist-link header-2026__nav-link" type="button" aria-controls="header-2026-menu-{{ section.id }}-{{ index }}" aria-expanded="false">
          {{- link.title -}}
        </button>
        <div hidden id="header-2026-menu-{{ section.id }}-{{ index }}" class="mega-menu header-2026__mega header-2026__mega--{{ kind }}">
          {%- render 'header-2026-focal-mega', kind: kind, section: section -%}
        </div>
      </li>
      {%- else -%}
      <li class="header__linklist-item header-2026__nav-item" data-item-title="{{ link.title | escape }}">
        <a class="header__linklist-link header-2026__nav-link" href="{{ link.url }}">{{- link.title -}}</a>
      </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</desktop-navigation>
