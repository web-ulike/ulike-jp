<details class="header-2026__account-menu{% if icon %} hidden-phone{% unless show_icons %} hidden-desk{% endunless %}{% endif %}">
  <summary class="header-2026__account-trigger{% if icon %} header__icon-wrapper tap-area{% endif %}">
    {%- if icon -%}
      {{ icon }}
      <span class="visually-hidden">{{ 'header.general.account' | t }}</span>
    {%- else -%}
      {{ 'header.general.account' | t }}
    {%- endif -%}
  </summary>
  <div class="header-2026__account-links">
    <a href="https://account.ulike.com/account?site=jp" data-no-instant>アカウントセンター</a>
    <a href="{{ routes.account_logout_url }}" data-header-account-logout data-no-instant>{{ 'customer.logout.title' | t }}</a>
    <span class="header-2026__logout-status" data-header-logout-status role="status"></span>
  </div>
</details>
