        "doctor_gaypKF": {
          "type": "doctor",
          "settings": {
            "image": "shopify:\/\/shop_images\/PC_e5ef3c35-4f9f-49a0-b9a9-bc79b5088fdb.png",
            "card_title": "信頼性、安全性、有效性",
            "desc": "<p>皮膚科医として、UlikeのIPL光美容器を強くおすすめします。サロンに通う煩わしさなく、長期的かつプロ級の効果を求める方に最適です。<\/p>",
