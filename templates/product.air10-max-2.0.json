    "jp_how_to_use_video_6YEd66": {
      "type": "jp-how-to-use-video",
      "name": "JP How To Use Video",
      "settings": {
        "bg_color": "#ffffff",
        "heading": "使い方動画",
        "link_text": "アプリの使用ガイドをダウンロード",
        "link_url": "https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/7392\/2352\/files\/Air10_Max_Ulike_X_Max_48dcc3e8-7ab6-46d8-a939-1ecf6c982460.pdf?v=1779109820",
        "poster_image": "shopify:\/\/shop_images\/1_d3194bf8-e545-4af4-9954-c8e8bacb853a.jpg",
        "video": "shopify:\/\/files\/videos\/A10 Max.mov",
