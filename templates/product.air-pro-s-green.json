    "jp_triple_guarantee_WXkVQe": {
      "type": "jp-triple-guarantee",
      "blocks": {
        "guarantee_wtkYtb": {
          "type": "guarantee",
          "settings": {
            "title": "90日間の返金・返品保証",
            "text": "<p>製品の効果や使用感に万が一ご満足いただけない場合も、購入から90日間は全額返金・返品可能。じっくり試せる3ヶ月の期間で、あなたの肌との相性や効果を実感いただいた上でのご判断ができます。自信を持ってお届けする製品だからこそ実現できる、お客様目線の安心保証です。<\/p>",
            "note": ""
          }
        },
        "guarantee_TMK349": {
          "type": "guarantee",
          "settings": {
            "title": "2年間の長期メーカー保証",
            "text": "<p>購入後2年間の長期メーカー保証付きで、万一の故障や不具合にも迅速に対応。世界No.1光美容器メーカーの高品質だからこそ提供できる充実の保証期間で、長期にわたって安心してご使用いただけます。<\/p>",
            "note": "<p>*1. Ulikeユーティリティ：家庭用美容器部門の販売金額累計No.1。<br>*2. 2022年5月から2023年4月までの累計販売実績。<\/p>"
          }
        },
        "guarantee_d4hCrx": {
          "type": "guarantee",
          "settings": {
            "title": "90万回²照射可能な長寿命設計",
            "text": "<p>A++グレードのサファイア素材、ダブルパイプ放熱特許技術、さらにVC液冷放熱特許技術を採用した高効率冷却設計。これらの放熱・温度制御技術により、電子部品や光学系への熱負担を抑え、機器全体の耐久性を向上させています。<\/p>",
            "note": "<p>*2. 当社の耐久性試験結果、最大90万回照射が可能です。<\/p>"
          }
        }
      },
