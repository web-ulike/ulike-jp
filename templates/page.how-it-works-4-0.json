    "help_tips_fHmf8j": {
      "type": "help-tips",
      "blocks": {
        "item_kkjVKM": {
          "type": "item",
          "settings": {
            "text": "まずパッチテストを行ってください。",
            "text1": "小さな範囲で最低レベルから始め、1〜3回照射してください。別の箇所で少しずつ出力を上げ、肌の反応を確認します。24時間以内に異常がなければ、通常のケアを開始できます。不快感がある場合は使用を中止してください。"
          }
        },
        "item_mJPRaF": {
          "type": "item",
          "settings": {
            "text": "継続して使用しましょう。",
            "text1": "長期的な効果を実感するには、継続使用が大切です。スケジュールに沿って使用すると、通常1〜4週間で変化を感じ始め、約4か月でなめらかな肌を目指せます。肌への刺激を避け、安全かつ効果的に使用するため、ケアの間隔は48〜72時間空けてください。"
          }
        },
        "item_fCQBxH": {
          "type": "item",
          "settings": {
            "text": "適切な出力レベルを選びましょう。",
            "text1": "特に敏感肌の方は、最低レベルから始めてください。肌が慣れてきたら少しずつ出力を上げることで、不快感を抑えながら効果的にケアできます。"
          }
        },
        "item_nEELw7": {
          "type": "item",
          "settings": {
            "text": "肌を保湿し、しっかり保護しましょう。",
            "text1": "ケア後は日光を避け、肌への刺激や色素沈着を防ぐためにSPF30以上の日焼け止めを使用してください。水分補給を心がけ、毎日保湿することで、より良いIPLケアにつながります。"
          }
        },
        "item_fQed3F": {
          "type": "item",
          "settings": {
            "text": "目を保護してください。",
            "text1": "デバイスを目に向けないでください。Ulikeデバイスに付属の保護メガネを必ず着用してください。"
          }
        }
      },
      "block_order": [
