            "text3": "時々生えてくる毛をケアすることで、なめらかな仕上がりを保てます。"
          }
        },
        "item_aP3ew4": {
          "type": "item",
          "settings": {
            "text": "12週目以降",
            "text1": "月1〜2回使用してください。",
