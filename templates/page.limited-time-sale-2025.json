    "doctor_recommend_w9xNhJ": {
      "type": "doctor-recommend",
      "blocks": {
        "item_zRnafM": {
          "type": "item",
          "settings": {
            "image": "shopify:\/\/shop_images\/1_ef9a441a-b216-467b-8f34-6ef1cc69c330.png",
            "image_mobile": "shopify:\/\/shop_images\/1_992dc649-9b91-4cd5-ad1a-5d60498d61be.png",
            "tle": "<p>宇井千穗 <strong>先生\u2028<\/strong><\/p>",
            "des": "<p>皮膚科 秋葉原院 院長\u2028<\/p><p>やさしい美美容皮膚科 院長<\/p>",
            "txt": "<p>SHRモードのように強いパワーと肌へのやさしさを両立した点が良いですね。<\/p>",
            "txt1": "<p>ムダ毛ケアのポイントは継続することです。自宅で好きな時にお手入れができる家庭用光美容器は、継続しやすい点がいいですね。Ulike Air 10 IPL光美容器は、エステサロンと同様のIPLという光でムダ毛ケアの期待ができます。光のパワーが強いと効率的にお手入れができる反面、熱感や痛みが気になる方もいますので、SHRモードのように強いパワーと肌へのやさしさを両立したモードがある点や、冷却機能で肌をクールダウンしながらお手入れできる点が良いですね。<br\/><br\/><\/p>",
            "background": ""
          }
        },
        "item_LXEb4e": {
          "type": "item",
          "settings": {
            "image": "shopify:\/\/shop_images\/2_9b227a45-be3b-46b5-aead-048265d0eb86.png",
            "image_mobile": "shopify:\/\/shop_images\/2_cb07c4f3-cf55-43f7-9ef6-68b7c65c083d.png",
            "tle": "<p>山内達司 先生<\/p>",
            "des": "<p>医療法人悠山会理事長<br\/>外科\/整形外科\/メデイカルエステ<\/p>",
            "txt": "<p>男性の剛毛はケアが困難で、高い出力が必要な一方、肌刺激を抑える配慮も重要。<\/p>",
            "txt1": "<p>男性向けの光美容器でケアを行うことで、毎日のヒゲ剃りから解放されるほか、肌への負担やカミソリ負け、青ヒゲといった悩みの解決にも繋がります。男性の太く硬い毛はケアが困難で、高い出力が必要な一方、肌刺激を最小限に抑える配慮も重要です。Ulike Xシリーズは、熱や刺激を抑えるための冷却機能のほか、男性の濃い毛質に合わせたハイパワーの出力と広範囲波長（550-1200nm）を搭載し、男性特有のニーズに応えた機能を搭載している点が評価できます。<br\/><br\/><\/p>",
            "background": ""
          }
        },
        "item_C8DzHt": {
          "type": "item",
          "settings": {
            "image": "shopify:\/\/shop_images\/3_59f3faff-1e46-4a91-94b6-f85a9d809687.png",
            "image_mobile": "shopify:\/\/shop_images\/3_cf3533fb-4431-427a-bdab-5ce018b7d6bf.png",
            "tle": "<p>星子尚美 先生<\/p>",
            "des": "<p>星子クリニック院長<br\/>内科·皮フ科·予防エイジングケア<\/p>",
            "txt": "<p>肌色に合わせてパワーを自動調整できる機能があれば全身のお手入れも安心。<\/p>",
            "txt1": "<p>家庭用光美容器で上手にムダ毛ケアをするコツは、お手入れする部位に合わせて光のパワーを調整することです。光が弱すぎるとお手入れの効率が悪く、強すぎると肌に強い刺激を与えてしまうため、肌色に合わせてパワーを自動調整する機能がついたUlike Air 10 Pro IPL光美容器なら、全身のお手入れを行えますね。<\/p>",
            "background": ""
          }
        }
