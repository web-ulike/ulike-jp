    "doctor_recommend_w9xNhJ": {
      "type": "doctor-recommend",
      "blocks": {
        "item_zRnafM": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/1_e28b65b4-0c4f-44b7-95f4-71b96944f598.png",
            "image_mobile": "shopify://shop_images/1_d3c5dd4a-8cd7-43ed-90b7-94339d77caf9.png",
            "tle": "<p>宇井千穗 <strong>先生</strong></p>",
            "des": "<p>皮膚科 秋葉原院 院長</p><p>やさしい美美容皮膚科 院長</p>",
            "txt": "<p>SHRモードのように強いパワーと肌へのやさしさを両立した点が良いですね。</p>",
            "txt1": "<p>ムダ毛ケアのポイントは継続することです。自宅で好きな時にお手入れができる家庭用光美容器は、継続しやすい点がいいですね。Ulike Air 10 IPL光美容器は、エステサロンと同様のIPLという光でムダ毛ケアの期待ができます。光のパワーが強いと効率的にお手入れができる反面、熱感や痛みが気になる方もいますので、SHRモードのように強いパワーと肌へのやさしさを両立したモードがある点や、冷却機能で肌をクールダウンしながらお手入れできる点が良いですね。<br/><br/></p>",
            "background": "#F9F9F9"
          }
        },
        "item_LXEb4e": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/2_a445db17-d866-4322-851a-b8f601681579.jpg",
            "image_mobile": "shopify://shop_images/2_9f43ac77-0b7f-44b0-8e79-1ce64c5b8bf3.png",
            "tle": "<p>山内達司 先生</p>",
            "des": "<p>医療法人悠山会理事長<br/>外科/整形外科/メデイカルエステ</p>",
            "txt": "<p>男性の剛毛はケアが困難で、高い出力が必要な一方、肌刺激を抑える配慮も重要。</p>",
            "txt1": "<p>男性向けの光美容器でケアを行うことで、毎日のヒゲ剃りから解放されるほか、肌への負担やカミソリ負け、青ヒゲといった悩みの解決にも繋がります。男性の太く硬い毛はケアが困難で、高い出力が必要な一方、肌刺激を最小限に抑える配慮も重要です。Ulike Xシリーズは、熱や刺激を抑えるための冷却機能のほか、男性の濃い毛質に合わせたハイパワーの出力と広範囲波長（550-1200nm）を搭載し、男性特有のニーズに応えた機能を搭載している点が評価できます。<br/><br/></p>",
            "background": "#F9F9F9"
          }
        },
        "item_C8DzHt": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/3_6a460118-2946-4980-9d7c-acae4f7c4a00.jpg",
            "image_mobile": "shopify://shop_images/3_f70fc999-4f3e-4392-b48d-27e40354f6ec.png",
            "tle": "<p>星子尚美 先生</p>",
