    "testimonials": {
      "type": "testimonials",
      "blocks": {
        "testimonial-1": {
          "type": "testimonial",
          "settings": {
            "content": "There’s an ongoing effort to bring a refined, modern aesthetic to everyday accessories—and more broadly, to the world of technology. The aim is to blend sophistication with functionality in every detail.",
