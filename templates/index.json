    "image-with-text": {
      "type": "image-with-text",
      "blocks": {
        "item-1": {
          "type": "item",
          "settings": {
            "tab_label": "Stow",
            "subheading": "Process",
            "title": "Designing the Stow Collection",
            "content": "<p>The decision to create this collection was not taken lightly. With a strong focus on thoughtful yet highly functional design, the goal was never to produce just another sleeve or organizer. Instead, the aim was to develop a solution that reflects a commitment to balance and purposeful design.<\/p>"
          }
        },
        "item-2": {
          "type": "item",
          "settings": {
            "tab_label": "Leather",
            "subheading": "Process",
            "title": "Crafting the Leather Collection",
            "content": "<p>Leather has long been a material of choice—valued both for its durability and the refined look it brings. Whether used as a subtle design detail or explored through bold colors and patterns, it continues to offer a versatile and enduring foundation for creative expression.<\/p>"
          }
        }
      },
