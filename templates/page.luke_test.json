        "doctor_gaypKF": {
          "type": "doctor",
          "settings": {
            "image": "shopify://shop_images/2_1_c92b4d3e-3a59-4882-9853-a3d5fa74135a.png",
            "card_title": "信頼性、安全性、有效性",
            "desc": "<p>皮膚科医として、UlikeのIPL光美容器を強くおすすめします。サロンに通う煩わしさなく、長期的かつプロ級の効果を求める方に最適です。</p>",
