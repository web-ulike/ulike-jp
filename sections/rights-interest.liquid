<style>
    .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px);
  }
}
   /* 权益板块 start */
   .rights-interest-section{
   }
   .rights-interest-inner{
    display: flex;
    gap: 20px;
   }
   .rights-interest-inner .rights-interest-item{
    flex: 1;
    display: flex;
    padding: 20px 10px;
    border: 1px solid #D9D9D9;
    flex-direction: column;
    justify-content: center;
    align-items: center;
   }
   .rights-interest-txt{
    color: #000;
text-align: center;
font-size: 21px;
font-style: normal;
font-weight: 400;
line-height: 32px;
letter-spacing: 2.103px;
margin-top: 8px;
   }
      @media screen and (max-width: 991px) {
        .rights-interest-inner{
          gap: 16px;
          flex-wrap: wrap;
        }
        .rights-interest-inner .rights-interest-item{
          padding: 8px;
          flex: 0 1 calc((100% - 16px)/2);
        }
        .rights-interest-txt{
          font-size: 14px;
          margin-top: 5px;
        }
        .rights-interest-item img{
          width: 32px;
        }
      }
   /* 权益板块 end */
</style>
  <section>
   <div class="rights-interest-section media-{{ section.id }}-padding">
              <div class="jp-container">
                <div class="rights-interest-inner to-top">

                       {% for block in section.blocks %}
                  <div class="rights-interest-item">
                    {%  if block.settings.image %}
                        <img src="{{ block.settings.image | image_url }}" alt="">
                        {%  endif %}
                    <div class="rights-interest-txt">{{ block.settings.text  }}</div>
                  </div>
                  {%  endfor %}
                  
                  
                </div>
              </div>
            </div>
       </section>
{% schema %}
{
  "name": "rights-interest",
  "settings": [
    {
      "type": "text",
      "id": "tle",
      "label": "Title"
    },
     {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
     {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
            {
      "type": "item",
      "name": "item",
      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
          {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    
      ]
    }
  ],
  "presets": [
    {
      "name": "rights-interest"
    }
  ]
}
{% endschema %}
