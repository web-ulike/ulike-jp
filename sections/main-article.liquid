<style>
  #shopify-section-{{ section.id }} {
    --article-ink: #241d1f;
    --article-muted: #73696c;
    --article-line: #e9e4e5;
    --article-surface: #fbf9f9;
  }

  #shopify-section-{{ section.id }} .article {
    margin: 0;
    color: var(--article-ink);
  }

  #shopify-section-{{ section.id }} .article__hero {
    background: var(--article-surface);
    padding: clamp(32px, 5vw, 76px) 0 clamp(38px, 6vw, 88px);
  }

  #shopify-section-{{ section.id }} .article__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 43%);
    align-items: center;
    gap: clamp(32px, 7vw, 112px);
  }

  #shopify-section-{{ section.id }} .article__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 22px;
    color: var(--article-muted);
    font-size: 12px;
    letter-spacing: .08em;
  }

  #shopify-section-{{ section.id }} .article__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .article__breadcrumb a:hover {
    color: var(--article-ink);
  }

  #shopify-section-{{ section.id }} .article__category {
    display: inline-flex;
    margin-bottom: 15px;
    color: #b51b57;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .article__title {
    max-width: 760px;
    margin: 0;
    color: var(--article-ink);
    font-size: clamp(30px, 4vw, 56px);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -.035em;
  }

  #shopify-section-{{ section.id }} .article__excerpt {
    max-width: 650px;
    margin-top: 22px;
    color: var(--article-muted);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.8;
  }

  #shopify-section-{{ section.id }} .article__hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 27px;
    color: var(--article-muted);
    font-size: 13px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .article__hero-meta > * + *::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: 14px;
    vertical-align: middle;
    border-radius: 50%;
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .article__hero-image {
    display: block;
    width: 100%;
    border-radius: 2px;
    box-shadow: 0 18px 50px rgba(36, 29, 31, .11);
  }

  #shopify-section-{{ section.id }} .article__main-part > .container {
    padding-top: clamp(42px, 6vw, 88px);
    padding-bottom: clamp(56px, 8vw, 112px);
  }

  #shopify-section-{{ section.id }} .article__inner {
    align-items: flex-start;
    flex-direction: row;
    justify-content: center;
    gap: clamp(30px, 7vw, 112px);
    min-height: 0;
    margin-inline: 0;
  }

  #shopify-section-{{ section.id }} .article__content {
    width: min(100%, 760px);
    max-width: 760px;
  }

  #shopify-section-{{ section.id }} .article__content .rte {
    color: var(--article-ink);
    font-size: 16px;
    line-height: 1.95;
  }

  #shopify-section-{{ section.id }} .article__content .rte > *:first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .article__content .rte p,
  #shopify-section-{{ section.id }} .article__content .rte ul,
  #shopify-section-{{ section.id }} .article__content .rte ol { margin: 0 0 1.65em; }

  #shopify-section-{{ section.id }} .article__content .rte h2,
  #shopify-section-{{ section.id }} .article__content .rte h3,
  #shopify-section-{{ section.id }} .article__content .rte h4 {
    margin: 2.1em 0 .7em;
    color: var(--article-ink);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -.02em;
  }

  #shopify-section-{{ section.id }} .article__content .rte h2 { font-size: clamp(25px, 3vw, 36px); }
  #shopify-section-{{ section.id }} .article__content .rte h3 { font-size: clamp(21px, 2.4vw, 28px); }
  #shopify-section-{{ section.id }} .article__content .rte img { border-radius: 2px; }
  #shopify-section-{{ section.id }} .article__content .rte blockquote {
    margin: 2.2em 0;
    padding: 18px 24px;
    border-left: 3px solid #c91f62;
    background: var(--article-surface);
    color: var(--article-muted);
  }

  #shopify-section-{{ section.id }} .article__info {
    position: sticky;
    top: calc(var(--header-height, 0px) + 28px);
    flex: 0 0 180px;
    width: 180px;
    max-width: none;
    margin: 6px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--article-line);
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .article__tags,
  #shopify-section-{{ section.id }} .article__share { display: block; }
  #shopify-section-{{ section.id }} .article__tags-label,
  #shopify-section-{{ section.id }} .article__share-label {
    display: block;
    margin: 0 0 10px;
    color: var(--article-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .article__tags-list { margin: 0; }
  #shopify-section-{{ section.id }} .article__tags-item { margin: 0 8px 8px 0; }
  #shopify-section-{{ section.id }} .article__tags-item a {
    display: inline-flex;
    padding: 4px 9px;
    border: 1px solid var(--article-line);
    border-radius: 999px;
    color: var(--article-muted);
    font-size: 12px;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .article__tags-item a:hover {
    border-color: var(--article-ink);
    color: var(--article-ink);
  }

  #shopify-section-{{ section.id }} .article__share-button-list {
    gap: 14px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .article__share-button-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--article-line);
    border-radius: 50%;
    transition: border-color .2s ease, color .2s ease;
  }

  #shopify-section-{{ section.id }} .article__share-button-item:hover {
    border-color: var(--article-ink);
    color: var(--article-ink);
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .article__hero-grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .article__hero-image { max-width: 720px; }
    #shopify-section-{{ section.id }} .article__inner { gap: 34px; }
  }

  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} .article__hero { padding: 28px 0 42px; }
    #shopify-section-{{ section.id }} .article__breadcrumb { margin-bottom: 18px; }
    #shopify-section-{{ section.id }} .article__hero-meta { margin-top: 21px; }
    #shopify-section-{{ section.id }} .article__main-part > .container { padding-top: 38px; }
    #shopify-section-{{ section.id }} .article__inner { flex-direction: column-reverse; }
    #shopify-section-{{ section.id }} .article__content { width: 100%; }
    #shopify-section-{{ section.id }} .article__content .rte { font-size: 15px; line-height: 1.85; }
    #shopify-section-{{ section.id }} .article__info {
      position: static;
      display: flex;
      flex: none;
      flex-wrap: wrap;
      width: 100%;
      margin: 0;
      padding-top: 18px;
      gap: 18px 28px;
    }
    #shopify-section-{{ section.id }} .article__share-button-list { gap: 12px; }
  }
</style>

<section>
  <div class="article">
    <div class="article__main-part">
      {%- if section.settings.show_on_scroll_navigation -%}
        <blog-post-navigation class="article__nav" {% if blog.next_article %}has-next-article{% endif %} style="--transform: 0.01">
          <div class="container">
            <div class="article__nav-wrapper">
              {%- if blog.previous_article -%}
                <a href="{{ blog.previous_article.url }}" class="article__nav-item article__nav-item--prev hidden-phone">
                  <span class="article__nav-arrow">{%- render 'icon' with 'nav-arrow-left', direction_aware: true -%}</span>
                  <span class="article__nav-item-title hidden-tablet">{{ blog.previous_article.title }}</span>
                </a>
              {%- endif -%}

              <span class="article__nav-item article__nav-item--current">
                {% comment %}We provide an estimate of the reading time, based on the fact that average people read 180 words per minute{% endcomment %}
                {%- assign minutes_to_read = article.content | strip_html | split: ' ' | size | divided_by: 180 | plus: 1 -%}

                <span class="article__nav-item-label text--strong hidden-pocket hidden-lap">{{ 'article.general.reading' | t }}</span>
                <span class="article__nav-item-title">{{ article.title }}</span>
                <span class="square-separator square-separator--block"></span>
                <span class="article__reading-time">{{ 'article.general.reading_time' | t: count: minutes_to_read }}</span>
              </span>

              {%- if blog.next_article -%}
                <a href="{{ blog.next_article.url }}" class="article__nav-item article__nav-item--next">
                  <span class="article__nav-item-label text--strong hidden-tablet-and-up">{{ 'article.general.next' | t }}</span>
                  <span class="article__nav-item-title hidden-tablet">{{ blog.next_article.title }}</span>
                  <span class="article__nav-arrow tap-area">{%- render 'icon' with 'nav-arrow-right', direction_aware: true -%}</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        </blog-post-navigation>
      {%- endif -%}

      {%- assign minutes_to_read = article.content | strip_html | split: ' ' | size | divided_by: 180 | plus: 1 -%}

      <header class="article__hero">
        <div class="container">
          <div class="article__hero-grid">
            <div class="article__hero-copy">
              <nav class="article__breadcrumb" aria-label="{{ 'general.breadcrumb.title' | t }}">
                <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
                <span aria-hidden="true">/</span>
                <a href="{{ blog.url }}">{{ blog.title }}</a>
              </nav>

              {%- if article.tags.size > 0 -%}
                <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}" class="article__category">{{ article.tags.first }}</a>
              {%- endif -%}

              <h1 class="article__title">{{ article.title }}</h1>

              {%- if article.excerpt != blank -%}
                <div class="article__excerpt">{{ article.excerpt }}</div>
              {%- endif -%}

              <div class="article__hero-meta">
                {%- if section.settings.show_date -%}
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'abbreviated_date' }}</time>
                {%- endif -%}
                {%- if section.settings.show_author -%}
                  <span>{{ 'article.general.written_by' | t: author: article.author }}</span>
                {%- endif -%}
                <span>{{ 'article.general.reading_time' | t: count: minutes_to_read }}</span>
                {%- if article.comments_enabled? -%}
                  <a href="#blog-post-{{ article.id }}-comments" data-smooth-scroll class="article__comments-count">{{ 'article.comments.comments_count' | t: count: article.comments_count }}</a>
                {%- endif -%}
              </div>
            </div>

            {%- if section.settings.show_image and article.image -%}
              {{ article.image | image_url: width: 1400 | image_tag: widths: '400,600,800,1000,1200,1400', sizes: '(max-width: 999px) calc(100vw - 40px), 43vw', class: 'article__hero-image', loading: 'eager', alt: article.image.alt | default: article.title }}
            {%- endif -%}
          </div>
        </div>
      </header>

      <div class="container">
        <div class="article__inner">
          {%- capture blog_post_info -%}
            {%- if article.tags.size > 0 -%}
              <div class="article__tags">
                <span class="article__tags-label heading heading--small">{{ 'article.general.tags' | t }}</span>

                <ul class="article__tags-list list--unstyled" role="list">
                  {%- for tag in article.tags -%}
                    <li class="article__tags-item" role="listitem">
                      <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="text--subdued link">{{ tag }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if section.settings.show_share_buttons -%}
              {%- assign share_url = shop.url | append: article.url -%}
              {%- assign twitter_text = article.title | url_param_escape -%}
              {%- assign pinterest_description = article.excerpt_or_content | strip_html | truncatewords: 15 | url_param_escape -%}
              {%- assign pinterest_image = article.image | image_url: width: 800 | prepend: 'https:' -%}

              <button type="button" is="share-toggle-button" share-url="{{ share_url | escape }}" share-title="{{ article.title | escape }}" class="article__share text--subdued link hidden-tablet-and-up" aria-controls="mobile-share-buttons-{{ section.id }}" aria-expanded="false">{{ 'article.general.share' | t }}</button>

              <popover-content id="mobile-share-buttons-{{ section.id }}" class="popover hidden-tablet-and-up">
                <span class="popover__overlay"></span>

                <header class="popover__header">
                  <span class="popover__title heading h6">{{- 'article.general.share' | t -}}</span>

                  <button type="button" class="popover__close-button tap-area tap-area--large" data-action="close" title="{{ 'general.accessibility.close' | t | escape }}">
                    {%- render 'icon' with 'close' -%}
                  </button>
                </header>

                <div class="mobile-share-buttons">
                  <a class="mobile-share-buttons__item mobile-share-buttons__item--facebook" href="https://www.facebook.com/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.facebook_share' | t }}">
                    {%- render 'icon' with 'facebook-share-mobile' -%} Facebook
                  </a>

                  <a class="mobile-share-buttons__item mobile-share-buttons__item--pinterest" href="https://pinterest.com/pin/create/button/?url={{ share_url }}{% if pinterest_image != blank %}&media={{ pinterest_image }}{% endif %}&description={{ pinterest_description }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.pinterest_pin' | t }}">
                    {%- render 'icon' with 'pinterest-share-mobile' -%} Pinterest
                  </a>

                  <a class="mobile-share-buttons__item mobile-share-buttons__item--twitter" href="https://twitter.com/intent/tweet?{% if twitter_text != blank %}text={{twitter_text}}&{% endif %}url={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.twitter_tweet' | t }}">
                    {%- render 'icon' with 'twitter-share-mobile' -%} Twitter
                  </a>

                  <a class="mobile-share-buttons__item mobile-share-buttons__item--mail" href="mailto:?&subject={{ article.title | escape }}&body={{ share_url }}" aria-label="{{ 'general.social.email_share' | t }}">
                    {%- render 'icon' with 'email-share-mobile' -%} {{ 'general.social.email_label' | t }}
                  </a>
                </div>
              </popover-content>

              <div class="article__share hidden-phone">
                <span class="article__share-label">{{ 'article.general.share' | t }}</span>

                <div class="article__share-button-list" role="list">
                  <a class="article__share-button-item article__share-button-item--facebook tap-area" href="https://www.facebook.com/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" role="listitem" aria-label="{{ 'general.social.facebook_share' | t }}">
                    {%- render 'icon' with 'facebook' -%}
                  </a>

                  <a class="article__share-button-item article__share-button-item--pinterest tap-area" href="https://pinterest.com/pin/create/button/?url={{ share_url }}{% if pinterest_image != blank %}&media={{ pinterest_image }}{% endif %}&description={{ pinterest_description }}" target="_blank" rel="noopener" role="listitem" aria-label="{{ 'general.social.pinterest_pin' | t }}">
                    {%- render 'icon' with 'pinterest' -%}
                  </a>

                  <a class="article__share-button-item article__share-button-item--twitter tap-area" href="https://twitter.com/intent/tweet?{% if twitter_text != blank %}text={{twitter_text}}&{% endif %}url={{ share_url }}" target="_blank" rel="noopener" role="listitem" aria-label="{{ 'general.social.twitter_tweet' | t }}">
                    {%- render 'icon' with 'twitter' -%}
                  </a>

                  <a class="article__share-button-item article__share-button-item--mail tap-area" href="mailto:?&subject={{ article.title | escape }}&body={{ share_url }}" role="listitem" aria-label="{{ 'general.social.email_share' | t }}">
                    {%- render 'icon' with 'share' -%}
                  </a>
                </div>
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- if blog_post_info != blank -%}
            <div class="article__info">
              {{- blog_post_info -}}
            </div>
          {%- endif -%}

          <div class="article__content">
            <div class="rte" {{ block.shopify_attributes }}>
              {{- article.content -}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog post",
  "class": "shopify-section--main-article",
  "blocks": [
    { "type": "share", "name": "Share", "settings": [] },
    { "type": "comments", "name": "Comments", "settings": [] },
    { "type": "next_previous_posts", "name": "Next and previous posts", "settings": [] }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_on_scroll_navigation",
      "label": "Show on scroll navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Show share buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    }
  ]
}
{% endschema %}
