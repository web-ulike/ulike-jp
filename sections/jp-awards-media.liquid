{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<style>
  #shopify-section-{{ sid }} {
    background: #FFFFFF;
  }

  .jp-awards-media--{{ sid }} {
    background: #FFFFFF;
    color: #000000;
    padding: 80px 0 88px;
    overflow: hidden;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__inner {
    margin: 0 auto;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
    align-items: start;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__section {
    min-width: 0;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__section--media {
    position: relative;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__section--media::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 4;
    width: 16%;
    height: calc(100% - 49px);
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), #FFFFFF 78%);
    pointer-events: none;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__head {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 15px;
    border-bottom: 1px solid #BDBDBD;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__head::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 58px;
    height: 2px;
    background: #000000;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__title {
    position: relative;
    margin: 0;
    color: #000;
    font-size: 14px;
    line-height: 1.2;
    font-weight: bold;
  }


  .jp-awards-media--{{ sid }} .jp-awards-media__awards-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 27px;
    margin-top: 34px;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__award {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F8F8F8;
    overflow: hidden;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__award img {
    display: block;
    width: 100%;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__media-nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__arrow {
    width: 18px;
    height: 18px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__arrow:hover {
    opacity: 0.55;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__arrow.swiper-button-disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__arrow svg {
    width: 14px;
    height: 14px;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__media {
    margin-top: 34px;
    overflow: hidden;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__media .swiper-wrapper {
    align-items: stretch;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__media-item {
    height: auto;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__media-card {
    display: block;
    width: 100%;
    background: #F8F8F8;
    overflow: hidden;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__media-card img {
    display: block;
    height: 203px;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__progress {
    display: none;
    position: relative;
    margin-top: 22px;
    width: 100%;
    height: 2px;
    background: #BDBDBD;
  }

  .jp-awards-media--{{ sid }} .jp-awards-media__progress .swiper-pagination-progressbar-fill {
    background: #000000;
  }

  @media screen and (max-width: 989px) {
    .jp-awards-media--{{ sid }} {
      padding: 44px 0 48px;
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__layout {
      display: block;
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__section + .jp-awards-media__section {
      margin-top: 35px;
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__section--media::after {
      width: 18%;
      height: calc(100% - 60px);
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__head::after {
      width: 116px;
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__awards-list {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 23px;
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__media {
      margin-top: 38px;
    }
    .jp-awards-media--{{ sid }} .jp-awards-media__media-nav {
      gap: 34px;
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__arrow {
      width: 24px;
      height: 24px;
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__arrow svg {
      width: 20px;
      height: 20px;
    }

    .jp-awards-media--{{ sid }} .jp-awards-media__progress {
      display: block;
    }
    .jp-awards-media--{{ sid }} .jp-awards-media__media-card img {
      display: block;
      height: initial;
      width: 100%;
    }
  }
</style>

<section class="jp-awards-media jp-awards-media--{{ sid }}">
  <div class="jp-awards-media__inner jp-container">
    <div class="jp-awards-media__layout">
      <div class="jp-awards-media__section jp-awards-media__section--awards">
        <div class="jp-awards-media__head">
          {%- if st.awards_title != blank -%}
            <div class="jp-awards-media__title">{{ st.awards_title }}</div>
          {%- endif -%}
        </div>

        <div class="jp-awards-media__awards-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'award' -%}
              <div class="jp-awards-media__award" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 420 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="jp-awards-media__section jp-awards-media__section--media">
        <div class="jp-awards-media__head">
          {%- if st.media_title != blank -%}
            <h2 class="jp-awards-media__title">{{ st.media_title }}</h2>
          {%- endif -%}

          <div class="jp-awards-media__media-nav">
            <button class="jp-awards-media__arrow jp-awards-media__arrow--prev" type="button" aria-label="Previous">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M15 4L7 12L15 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <button class="jp-awards-media__arrow jp-awards-media__arrow--next" type="button" aria-label="Next">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M9 4L17 12L9 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="swiper jp-awards-media__media">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- if block.type == 'media' -%}
                <div class="swiper-slide jp-awards-media__media-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a class="jp-awards-media__media-card" href="{{ block.settings.link }}">
                  {%- else -%}
                    <div class="jp-awards-media__media-card">
                  {%- endif -%}

                    {%- if block.settings.image != blank -%}
                      <img
                        src="{{ block.settings.image | image_url: width: 520 }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                      >
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}

                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="swiper-pagination jp-awards-media__progress"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.jp-awards-media--{{ sid }}');
    if (!section) return;

    var swiperEl = section.querySelector('.jp-awards-media__media');
    if (!swiperEl || typeof Swiper === 'undefined') return;

    new Swiper(swiperEl, {
      slidesPerView: 4,
      spaceBetween: 27,
      loop: false,
      watchOverflow: true,
      navigation: {
        nextEl: section.querySelector('.jp-awards-media__arrow--next'),
        prevEl: section.querySelector('.jp-awards-media__arrow--prev')
      },
      pagination: {
        el: section.querySelector('.jp-awards-media__progress'),
        type: 'progressbar'
      },
      breakpoints: {
        0: {
          slidesPerView: 3.5,
          spaceBetween: 16
        },
        768: {
          slidesPerView: 3,
          spaceBetween: 18
        },
        990: {
          slidesPerView: 4,
          spaceBetween: 35
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "JP Awards Media",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "awards_title",
      "label": "Awards title",
      "default": "Awards"
    },
    {
      "type": "text",
      "id": "media_title",
      "label": "Media title",
      "default": "Media"
    }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "Award image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "media",
      "name": "Media image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Awards Media",
      "blocks": [
        {
          "type": "award"
        },
        {
          "type": "award"
        },
        {
          "type": "award"
        },
        {
          "type": "award"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        }
      ]
    }
  ]
}
{% endschema %}