{%- liquid
  assign se_stts = section.settings
  assign se_bks = section.blocks
-%}

<style>
  .u-scroll-module {
    position: relative;
    background: linear-gradient(178deg, #EAF2FC -45.28%, rgba(247, 249, 255, 0.60) 97.64%);
    min-height: 120vh;
    overflow: clip;
  }

  .u-scroll-module .card-container {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 15vh 0 0;
  }

  .u-scroll-module .card { position: relative; height: 140%; }

  .u-scroll-module .card-text {
    position: absolute;
    top: 5vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(1139px, 86vw);
    text-align: center;
    font-size: clamp(16px, 3.2vw, 32px);
    line-height: 1.5;
    height: 20vh;
    z-index: 1; /* 低于图片 */
    pointer-events: none;
  }

  .u-scroll-module .card-text .sentence {
    display: inline;
    color: rgba(0, 0, 0, 0.20);
    background-clip: text;
    -webkit-background-clip: text;
    background-size: var(--num-backgroundSize, 0%) 100%;
    background-repeat: no-repeat;
    background-image: linear-gradient(90deg, #E0004D, #E0004D);
  }

  .u-scroll-module .image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    padding-top: 10vh;
  }

  .u-scroll-module .card-image {
    width: 17%;
    max-width: 420px;
    padding: 10px;
    background: #AFCEE3;
    color: #190A0A;
    will-change: transform;
    transform: translate3d(0, 18vh, 0) rotate(0deg) scale(1);
    box-shadow: -9.949px 9.044px 8.23px 0 rgba(29, 29, 29, 0.10);
  }

  .u-scroll-module .card-image:nth-child(even) {
    background-color: #66899F;
    color: #fff;
  }

  .u-scroll-module .card-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .u-scroll-module .card-image .name {
    font-size: 16px;
    font-weight: 500;
    line-height: 150%;
    margin-top: 10px;
  }

  .u-scroll-module .card-image__inner {
    width: 100%;
    height: 100%;
    will-change: transform;
  }
  .share__box{
      position: absolute;
      top: calc(5vh + 150px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 50px;
  }

  @media (max-width: 768px) {
    .u-scroll-module {
      min-height: 100vh;
      overflow: clip;
    }

    .u-scroll-module .card-container {
      padding-top: 0vh;
      height: 100%;
    }

    .u-scroll-module .card {
      position: relative;
      height: 100vh;
    }

    .u-scroll-module .card-text {
      top: 8vh;
      height: 100%;
      z-index: 1;
    }

    .u-scroll-module .image-wrapper {
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;
      display: block;
      padding-top: 0;
    }

    .u-scroll-module .card-image {
      position: absolute;
      width: 180px;
      max-width: none;
      transform: none;
      transform-origin: 50% 50%;
      will-change: transform;
      backface-visibility: hidden;
    }

    .u-scroll-module .card-image__inner {
      width: 100%;
      height: 100%;
      will-change: transform;
    }

    /* 仅支持最多 5 张（schema 里也限制了 max_blocks=5） */
  .u-scroll-module .card-image:nth-child(1) { left: 0vw;  top: 40vh; z-index: 2; }
  .u-scroll-module .card-image:nth-child(2) { left: 28vw; top: 32vh; z-index: 3; }
  .u-scroll-module .card-image:nth-child(3) { left: 65vw; top: 40vh; z-index: 3; }
  .u-scroll-module .card-image:nth-child(4) { left: 10vw; top: 58vh; z-index: 4; }
  .u-scroll-module .card-image:nth-child(5) { left: 46vw; top: 70vh; z-index: 4; }

    .u-scroll-module .card-image .name {
      font-size: 10px;
      line-height: 1.2;
    }
.share__box {
    position: absolute;
    top: calc(8vh + 120px);
    gap: 20px;
}
      .share__box svg{
        width: 30px;
height: 30px;
    gap: 20px;
  }
  }
</style>

<div class="u-scroll-module" data-scroll-module>
  <div class="card-container">
    <div class="card">
      <div class="card-text" style="--num-backgroundSize: 0%;">
        <span class="sentence">
          {{ se_stts.title }}
          <br />
          {{ se_stts.desc }}
        </span>
      </div>

      <div class="share__box">
        <a href="{{ se_stts.instagram_link }}" target="_blank">
