1 46.2875 69.3093 45.1725 69.3093 36.1624C69.3093 27.1522 69.2792 26.0372 69.0984 22.5115C69.0381 19.7693 68.5258 17.0271 67.5615 14.4657C66.7178 12.2659 65.3919 10.2469 63.7345 8.58949C62.047 6.9321 60.0581 5.6062 57.8583 4.76244C55.2969 3.79814 52.5547 3.28586 49.8125 3.22559C46.2867 3.07492 45.1718 3.01465 36.1616 3.01465ZM36.1616 19.1365C32.7866 19.1365 29.5019 20.1309 26.6995 21.9992C23.897 23.8676 21.7273 26.5194 20.4315 29.6534C19.1358 32.7572 18.8043 36.1925 19.4672 39.4771C20.1302 42.7919 21.7574 45.8053 24.138 48.1859C26.5187 50.5665 29.5622 52.1938 32.8468 52.8567C36.1616 53.5197 39.5668 53.1882 42.6706 51.8924C45.7745 50.5967 48.4263 48.427 50.3247 45.6245C52.1931 42.822 53.1875 39.5374 53.1875 36.1624C53.1875 31.6422 51.3794 27.3029 48.2153 24.1388C45.0211 20.9445 40.6818 19.1666 36.1918 19.1666L36.1616 19.1365ZM36.1616 47.2216C33.9618 47.2216 31.8524 46.5587 30.0142 45.3533C28.2062 44.1479 26.7899 42.4001 25.9461 40.3811C25.1023 38.3622 24.8914 36.1322 25.3133 33.9927C25.7352 31.8532 26.7899 29.8944 28.3267 28.3274C29.8636 26.7605 31.8524 25.7359 33.992 25.314C36.1315 24.8921 38.3614 25.1031 40.3804 25.9468C42.3994 26.7906 44.1171 28.2069 45.3526 30.015C46.5579 31.823 47.2209 33.9626 47.2209 36.1624C47.2209 39.0854 46.0457 41.918 43.9965 43.9671C41.9173 46.0464 39.1148 47.1915 36.1918 47.1915L36.1616 47.2216ZM53.8504 22.4513C56.0502 22.4513 57.8282 20.6733 57.8282 18.4735C57.8282 16.2737 56.0502 14.4958 53.8504 14.4958C51.6506 14.4958 49.8727 16.2737 49.8727 18.4735C49.8727 20.6733 51.6506 22.4513 53.8504 22.4513Z" fill="black"/>
</svg>
        </a>
        <a href="{{ se_stts.x_link }}" target="_blank">
          <svg xmlns="http://www.w3.org/2000/svg" width="73" height="73" viewBox="0 0 73 73" fill="none">
            <path d="M41.8818 31.5448L64.2882 6.02734H58.9689L39.4982 28.1827L23.9669 6.02734H6.02686L29.5371 39.5237L6.02686 66.2959H11.3462L31.8956 42.8861L48.3052 66.2959H66.2451M13.2531 9.94155H21.4076L58.9689 62.5574H50.8142" fill="black"/>
          </svg>
        </a>
      </div>

      <div class="image-wrapper">
        {%- for block in se_bks -%}
          {%- if block.type == 'item' -%}
            {%- assign img = block.settings.image -%}
            <div class="card-image" {{ block.shopify_attributes }}>
              <div class="card-image__inner">
                {%- if img != blank -%}
                  <picture>
                    <source
                      media="(max-width: 768px)"
                      srcset="{{ img | image_url: width: 400 }}"
                    >
                    <img
                      class="image"
                      loading="lazy"
                      decoding="async"
                      alt="{{ img.alt | escape }}"
                      src="{{ img | image_url: width: 800 }}"
                    >
                  </picture>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <div class="name">{{ block.settings.title }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'u-scroll-module.all.js' | asset_url }}" async></script>

{% schema %}
{
  "name": "u-scroll-module",
  "max_blocks": 5,
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "标题"
    },
    {
      "type": "html",
      "id": "desc",
      "label": "标题2"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link"
    },
     {
      "type": "url",
      "id": "x_link",
      "label": "X Link"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "标题",
          "default": "1st Prize"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "u-scroll-module",
      "blocks": []
    }
  ]
}
{% endschema %}