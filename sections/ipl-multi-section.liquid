<style>
     #shopify-section-{{ section.id }} {
      --section-background: {{ section.settings.background }};
       background: var(--section-background);
   }
.media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px);
  }
}
/* ipl-multi-section start */
.ipl-multi-section{

}
.ipl-multi-section h3{
  color: #000;
text-align: center;
font-size: 50px;
font-style: normal;
font-weight: 400;
line-height: 1.3;
margin-bottom: 57px;
}
.ipl__multi-wrapper{
  display: flex;
  gap: 20px;
}
.ipl__multi-wrapper .ipl__multi-item{
display:block;
flex:1;
}
.ipl__multi-wrapper .ipl__multi-item img{
width:100%;
}
.ipl__multi-item .ipl__multi-txt{
  color: #000;
font-size: 20px;
font-style: normal;
font-weight: 400;
line-height: 1.3;
margin-top: 33px;
}
.ipl__multi-button{
  display: inline-flex;
  background: #000;
  padding: 11px 22px;
  color: #FFF;
text-align: center;
font-size: 11px;
font-style: normal;
font-weight: 400;
line-height: 1; 
letter-spacing: -1.135px;
margin-top: 22px;
}
@media (max-width: 767px) {
  .ipl-multi-section h3{
    font-size: 28px;
    margin-bottom: 34px;
  }
  .ipl__multi-wrapper{
    flex-direction: column;
    gap: 30px;
  }
  .ipl__multi-item .ipl__multi-txt{
    font-size: 14px;
        margin-top: 21px;
  }
  .ipl__multi-button{
    font-size: 10px;
    padding: 9px 15px;
    margin-top: 12px;
    letter-spacing: -1px;
  }
}
/* ipl-multi-section end */
</style>
   <section>
<div class="ipl-multi-section media-{{ section.id }}-padding">
      <div class="container">
        {%- if section.settings.tle != blank -%}
        <h3 class="to-top">{{ section.settings.tle }}</h3>
        {%- endif -%}
        <div class="ipl__multi-wrapper">
            {%- for block in section.blocks -%}
          <a href="{{ block.settings.button_link }}" class="ipl__multi-item to-top">
             {%- if block.settings.image -%}
                <img src="{{block.settings.image | image_url }}" alt="" width="{{  block.settings.image.width  | divided_by: 2  }}" height="{{  block.settings.image.height  | divided_by: 2  }}">
            {%- endif -%}
             {%- if block.settings.tle != blank -%}
            <div class="ipl__multi-txt">{{ block.settings.tle }}</div>
             {%- endif -%}
              {%- if block.settings.button_text != blank -%}
            <div class="ipl__multi-button">{{ block.settings.button_text }}</div>
             {%- endif -%}
          </a>
           {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "ipl-multi-section",
  "blocks": [
            {
    "name": "item",
    "type": "item",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Images"
      },
      {
        "type": "image_picker",
        "id": "mobile_image",
        "label": "Mobile Images"
      },
        {
        
        "type": "richtext",
        "id": "tle",
        "label": "Title"
      },
              {
          "type": "url",
          "id": "button_link",
            "label": "Button Link"
        },
       {
        
        "type": "text",
        "id": "button_text",
        "label": "Button Text"
      }
    ]
    }
  ],
  "settings": [
     {
        
        "type": "text",
        "id": "tle",
        "label": "Title"
      },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "ipl-multi-section"
    }
  ]
}
{% endschema %}
