{% liquid
  assign sid = section.id
%}

<section class="jp-home-reviews jp-home-reviews--{{ sid }}">
  <div class="jp-container">
    <div class="jp-home-reviews__header">
      <div class="jp-home-reviews__header-main">
        {% if section.settings.heading != blank %}
          <h2 class="jp-home-reviews__title">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="jp-home-reviews__nav-group">
          <button class="jp-home-reviews__nav jp-home-reviews__nav--prev" type="button" aria-label="Previous">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M11.25 14.25L6 9L11.25 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="jp-home-reviews__nav jp-home-reviews__nav--next" type="button" aria-label="Next">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M6.75 14.25L12 9L6.75 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    <div class="jp-home-reviews__body">
      <div class="swiper jp-home-reviews__swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide jp-home-reviews__slide" {{ block.shopify_attributes }}>
              <div class="jp-home-reviews__card">
                {% if block.settings.image != blank %}
                  <div class="jp-home-reviews__image-wrap">
                    <img
                      class="jp-home-reviews__image"
                      src="{{ block.settings.image | image_url: width: 900 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  </div>
                {% endif %}

                <div class="jp-home-reviews__content">
                  <div class="jp-home-reviews__rating-row">
                    <div class="jp-home-reviews__stars" aria-label="{{ block.settings.rating }} stars">
                      {% assign rating = block.settings.rating | default: 5 %}
                      {% for i in (1..5) %}
                        <span class="jp-home-reviews__star{% if i <= rating %} is-active{% endif %}">★</span>
                      {% endfor %}
                    </div>

                    {% if block.settings.rating_text != blank %}
                      <div class="jp-home-reviews__rating-text">{{ block.settings.rating_text }}</div>
                    {% endif %}
                  </div>

                  {% if block.settings.review_title != blank %}
                    <h3 class="jp-home-reviews__review-title">{{ block.settings.review_title }}</h3>
                  {% endif %}

                  {% if block.settings.review_text != blank %}
                    <div class="jp-home-reviews__review-text">{{ block.settings.review_text }}</div>
                  {% endif %}

                  <div class="jp-home-reviews__footer">
                    <div class="jp-home-reviews__author-wrap">
                      {% if block.settings.avatar != blank %}
                        <div class="jp-home-reviews__avatar">
                          <img
                            src="{{ block.settings.avatar | image_url: width: 120 }}"
                            alt="{{ block.settings.author | escape }}"
                            loading="lazy"
                            width="{{ block.settings.avatar.width }}"
                            height="{{ block.settings.avatar.height }}"
                          >
                        </div>
                      {% endif %}

                      <div class="jp-home-reviews__meta">
                        {% if block.settings.author != blank %}
                          <div class="jp-home-reviews__author">{{ block.settings.author }}</div>
                        {% endif %}
                        {% if block.settings.product_name != blank %}
                          <div class="jp-home-reviews__product">{{ block.settings.product_name }}</div>
                        {% endif %}
                      </div>
                    </div>

                    {% if block.settings.link != blank %}
                      <a class="jp-home-reviews__link" href="{{ block.settings.link }}">
                        <span>{{ block.settings.link_text | default: '詳しく見る' }}</span>
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="M6 3.5L10.5 8L6 12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="jp-home-reviews__progress swiper-pagination"></div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .jp-home-reviews--{{ sid }} {
    --jp-home-reviews-title: #111111;
    --jp-home-reviews-text: #555555;
    --jp-home-reviews-muted: #888888;
    --jp-home-reviews-border: #ebe5e8;
    --jp-home-reviews-bg: #ffffff;
    --jp-home-reviews-card-bg: #ffffff;
    padding: 64px 0;
    background: var(--jp-home-reviews-bg);
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__header-main {
    min-width: 0;
    flex: 1 1 auto;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__title {
    margin: 0;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--jp-home-reviews-title);
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__nav-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__nav {
    width: 42px;
    height: 42px;
    border: 1px solid #7d7d7d;
    border-radius: 50%;
    background: transparent;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all .25s ease;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__nav:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__body {
    position: relative;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__swiper {
    overflow: hidden;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__slide {
    height: auto;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__card {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--jp-home-reviews-card-bg);
    border: 1px solid var(--jp-home-reviews-border);
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__image-wrap {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f7f5f6;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__content {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 20px 20px 22px;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__stars {
    display: flex;
    align-items: center;
    gap: 2px;
    line-height: 1;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__star {
    font-size: 12px;
    color: #d5d5d5;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__star.is-active {
    color: #111111;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__rating-text {
    font-size: 12px;
    line-height: 1.4;
    color: var(--jp-home-reviews-muted);
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__review-title {
    margin: 14px 0 0;
    font-size: 18px;
    line-height: 1.35;
    font-weight: 700;
    color: var(--jp-home-reviews-title);
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__review-text {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--jp-home-reviews-text);
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__footer {
    margin-top: auto;
    padding-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__author-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    overflow: hidden;
    flex: 0 0 auto;
    background: #f2f2f2;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__avatar img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__meta {
    min-width: 0;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__author {
    font-size: 13px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--jp-home-reviews-title);
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__product {
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--jp-home-reviews-muted);
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #111111;
    text-decoration: none;
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__progress {
    position: relative;
    margin-top: 24px;
    height: 2px;
    background: #d9d9d9;
    overflow: hidden;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__progress.swiper-pagination-progressbar {
    background: #d9d9d9;
  }

  .jp-home-reviews--{{ sid }} .jp-home-reviews__progress .swiper-pagination-progressbar-fill {
    background: #000;
    transform-origin: left top;
  }

  @media screen and (max-width: 989px) {
    .jp-home-reviews--{{ sid }} {
      padding: 42px 0;
    }

    .jp-home-reviews--{{ sid }} .jp-home-reviews__header {
      align-items: center;
      margin-bottom: 22px;
    }

    .jp-home-reviews--{{ sid }} .jp-home-reviews__title {
      font-size: 20px;
    }

    .jp-home-reviews--{{ sid }} .jp-home-reviews__nav {
      width: 34px;
      height: 34px;
    }

    .jp-home-reviews--{{ sid }} .jp-home-reviews__content {
      padding: 16px 16px 18px;
    }

    .jp-home-reviews--{{ sid }} .jp-home-reviews__review-title {
      margin-top: 12px;
      font-size: 16px;
    }

    .jp-home-reviews--{{ sid }} .jp-home-reviews__review-text {
      margin-top: 8px;
      font-size: 13px;
      line-height: 1.7;
    }

    .jp-home-reviews--{{ sid }} .jp-home-reviews__footer {
      padding-top: 14px;
      align-items: flex-start;
      flex-direction: column;
    }

    .jp-home-reviews--{{ sid }} .jp-home-reviews__progress {
      margin-top: 20px;
    }
  }
</style>

<script>
  (() => {
    const sectionEl = document.querySelector('.jp-home-reviews--{{ sid }}');
    if (!sectionEl) return;

    const initReviewsSwiper = () => {
      const swiperEl = sectionEl.querySelector('.jp-home-reviews__swiper');
      if (!swiperEl || typeof window.Swiper === 'undefined') return;

      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }

      new window.Swiper(swiperEl, {
        slidesPerView: 1.2,
        spaceBetween: 14,
        speed: 700,
        watchOverflow: true,
        navigation: {
          nextEl: sectionEl.querySelector('.jp-home-reviews__nav--next'),
          prevEl: sectionEl.querySelector('.jp-home-reviews__nav--prev')
        },
        pagination: {
          el: sectionEl.querySelector('.jp-home-reviews__progress'),
          type: 'progressbar'
        },
        breakpoints: {
          768: {
            slidesPerView: 2,
            spaceBetween: 18
          },
          990: {
            slidesPerView: 3,
            spaceBetween: 24
          }
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReviewsSwiper);
    } else {
      initReviewsSwiper();
    }
  })();
</script>

{% schema %}
{
  "name": "JP Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ユーザーの声"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main image"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating text",
          "default": "5.0"
        },
        {
          "type": "text",
          "id": "review_title",
          "label": "Review title",
          "default": "しっかり使い続けやすい"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "使い方がわかりやすく、自宅でも続けやすいので満足しています。肌あたりもやさしく、日々のケアに取り入れやすいです。"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Airi"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name",
          "default": "Ulike Air 10"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "詳しく見る"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}