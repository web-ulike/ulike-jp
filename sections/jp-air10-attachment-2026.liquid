{%- if section.settings.air10_max_layout -%}

<section id="a10-max-{{ section.id }}" class="a10-2026 to-top a10-2026__scene a10-2026__scene--attachment">
<div class="a10-2026__inner a10-2026__scene-grid">
<div class="a10-2026__scene-background">{%- assign a10_image = section.settings.image | default: section.settings.image_mobile -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{% if section.settings.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 375 }} 375w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}</div>

<div class="a10-2026__scene-copy">{% if section.settings.title != blank %}
<h2 class="a10-2026__title">{{ section.settings.title | escape | newline_to_br }}</h2>
{% endif %}{% if section.settings.description != blank %}
<div class="a10-2026__body">{{ section.settings.description }}</div>
{% endif %}{% if section.settings.note != blank %}
<div class="a10-2026__note">{{ section.settings.note }}</div>
{% endif %}</div>
</div>
</section>

<style>
#a10-max-{{ section.id }}{ color: #190a0a;  overflow: hidden; }
#a10-max-{{ section.id }} *, #a10-max-{{ section.id }} *::before, #a10-max-{{ section.id }} *::after{ box-sizing: border-box; }
#a10-max-{{ section.id }} h2, #a10-max-{{ section.id }} h3, #a10-max-{{ section.id }} p{ margin: 0; }
#a10-max-{{ section.id }} .a10-2026__inner{ width: min(1220px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-{{ section.id }} .a10-2026__wide{ width: min(1600px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-{{ section.id }} .a10-2026__title{ font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-{{ section.id }} .a10-2026__body{ color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__body p + p{ margin-top: 0; }
#a10-max-{{ section.id }} .a10-2026__note{ color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__note p{ margin: 0; }
#a10-max-{{ section.id }} .a10-2026__media{ display: block; min-width: 0; }
#a10-max-{{ section.id }} .a10-2026__media img{ display: block; width: 100%; height: auto; }
#a10-max-{{ section.id }} .a10-2026__center{ text-align: center; }
#a10-max-{{ section.id }} .a10-2026__mobile{ display: none; }
#a10-max-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-{{ section.id }} .a10-2026__note a{ color: inherit; }
#a10-max-{{ section.id }} sup{ font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-{{ section.id }}.a10-2026__scene{ position: relative; background: linear-gradient(135deg,#edf0f7,#fff); }
#a10-max-{{ section.id }} .a10-2026__scene-grid{ position: relative; min-height: 800px; display: flex; align-items: center; }
#a10-max-{{ section.id }} .a10-2026__scene-background{ position: absolute; inset: 0; }
#a10-max-{{ section.id }} .a10-2026__scene-background .a10-2026__media, #a10-max-{{ section.id }} .a10-2026__scene-background img{ width: 100%; height: 100%; object-fit: cover; }
#a10-max-{{ section.id }} .a10-2026__scene-copy{ position: relative; width: 43%; padding: 90px 0 60px; z-index: 1; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__body{ margin-top: 32px; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__stats{ gap: 35px; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__stat + .a10-2026__stat{ border-left: 1px solid #bbb; padding-left: 35px; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__note{ margin-top: 200px; }
@media (min-width:750px) and (max-width:1400px){#a10-max-{{ section.id }} .a10-2026__title{ font-size: 32px; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 26px; }
}@media (max-width:749px){#a10-max-{{ section.id }} .a10-2026__inner, #a10-max-{{ section.id }} .a10-2026__wide{ width: calc(100% - 40px); }
#a10-max-{{ section.id }} .a10-2026__desktop{ display: none !important; }
#a10-max-{{ section.id }} .a10-2026__mobile{ display: block; }
#a10-max-{{ section.id }} .a10-2026__title{ font-size: 24px; line-height: 1.3; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 24px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__body{ font-size: 14px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__note{ font-size: 10px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__scene-grid{ width: 100%; min-height: 0; display: flex; flex-direction: column; }
#a10-max-{{ section.id }} .a10-2026__scene-background{ position: static; order: 1; width: 100%; }
#a10-max-{{ section.id }} .a10-2026__scene-background .a10-2026__media, #a10-max-{{ section.id }} .a10-2026__scene-background img{ height: auto; }
#a10-max-{{ section.id }} .a10-2026__scene-copy{ display: contents; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__title{ order: 0; margin: 38px 20px 0; font-size: 20px; font-weight: 500; align-self: start; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__body{ order: 0; margin: 22px 20px 0; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__stats{ order: 0; margin: 30px 20px 25px; align-self: start; gap: 24px; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__stat + .a10-2026__stat{ padding-left: 24px; }
#a10-max-{{ section.id }} .a10-2026__scene-copy .a10-2026__note{ order: 2; background: #fff; width: 100%; margin: 0; padding: 22px 20px; }
#a10-max-{{ section.id }}.a10-2026__scene--attachment .a10-2026__title{ text-align: center; align-self: center; }
}
</style>
{%- else -%}
{%- liquid
  assign section_id = 'jp-air10-attachment-2026-' | append: section.id
-%}

<section id="{{ section_id }}" class="jp-attachment-2026">
  <div class="jp-attachment-2026__visual">
    {% if section.settings.image != blank %}
      <picture>
        {% if section.settings.image_mobile != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
        {% endif %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'jp-attachment-2026__image', loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400' }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'jp-attachment-2026__placeholder' }}
    {% endif %}
  </div>

  <div class="jp-attachment-2026__content">
    <h2 class="jp-attachment-2026__title">{{ section.settings.title | escape }}</h2>
    <div class="jp-attachment-2026__description">{{ section.settings.description }}</div>
  </div>

  {% if section.settings.note != blank %}
    <p class="jp-attachment-2026__note">{{ section.settings.note | escape }}</p>
  {% endif %}
</section>

{% style %}
  #{{ section_id }} {
    --jp-attachment-background: {{ section.settings.background_color | default: '#FCFCFF' }};
    --jp-attachment-text: {{ section.settings.text_color | default: '#000000' }};
    --jp-attachment-body-text: {{ section.settings.body_text_color | default: '#3F3636' }};
    position: relative;
    overflow: hidden;
    min-height: 940px;
    background: var(--jp-attachment-background);
  }

  #{{ section_id }} .jp-attachment-2026__visual,
  #{{ section_id }} .jp-attachment-2026__visual picture,
  #{{ section_id }} .jp-attachment-2026__image,
  #{{ section_id }} .jp-attachment-2026__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .jp-attachment-2026__visual {
    background: var(--jp-attachment-background);
    position: absolute;
    inset: 0;
  }

  #{{ section_id }} .jp-attachment-2026__image {
    object-fit: cover;
    object-position: center;
  }

  #{{ section_id }} .jp-attachment-2026__placeholder {
    position: absolute;
    inset: 0;
    fill: #dfe3ec;
  }

  #{{ section_id }} .jp-attachment-2026__content {
    position: relative;
    z-index: 1;
    width: min(573px, calc(100% - 40px));
    margin-left: max(40px, calc((100% - 1260px) / 2));
    padding-top: 354px;
  }

  #{{ section_id }} .jp-attachment-2026__title {
    margin: 0 0 39px;
    color: var(--jp-attachment-text);
    font-size: 48px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #{{ section_id }} .jp-attachment-2026__description {
    max-width: 573px;
    color: var(--jp-attachment-body-text);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.5;
  }

  #{{ section_id }} .jp-attachment-2026__description p {
    margin: 0;
  }

  #{{ section_id }} .jp-attachment-2026__note {
    position: absolute;
    z-index: 1;
    bottom: 37px;
    left: max(40px, calc((100% - 1260px) / 2));
    margin: 0;
    color: var(--jp-attachment-text);
    opacity: .5;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      min-height: unset;
    }

    #{{ section_id }} .jp-attachment-2026__visual {
      position: relative;
      inset: auto;
      height: auto;
    }

    #{{ section_id }} .jp-attachment-2026__visual picture,
    #{{ section_id }} .jp-attachment-2026__image {
      height: auto;
    }

    #{{ section_id }} .jp-attachment-2026__content {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      z-index: 1;
      width: auto;
      margin: 0;
      padding: 48px 19px 0;
    }

    #{{ section_id }} .jp-attachment-2026__title {
      margin-bottom: 20px;
      font-size: 30px;
      line-height: 1.35;
    }

    #{{ section_id }} .jp-attachment-2026__description {
      font-size: 16px;
      line-height: 1.6;
    }

    #{{ section_id }} .jp-attachment-2026__note {
      position: absolute;
      z-index: 1;
      bottom: 14px;
      left: 19px;
      padding: 0;
      font-size: 8px;
    }
  }
{% endstyle %}


{%- endif -%}
{% schema %}
{
  "name": "jp-air10-attachment-2026",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#FCFCFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "标题与脚注颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "说明文字颜色",
      "default": "#3F3636"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 主视觉图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端主视觉图片"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "細部まで、心地よく"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "说明文字",
      "default": "<p>2.6cm²のアタッチメント*は、スキンセンサーとサファイア冷感技術に対応。指先や口元などの細かな部分にも、心地よく、丁寧なケアを可能にします。</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "脚注",
      "default": "*アタッチメントは別売りアクセサリーです。"
    },
    {
      "type": "checkbox",
      "id": "air10_max_layout",
      "label": "使用 Air 10 Max 2026 设计",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "jp-air10-attachment-2026"
    }
  ]
}
{% endschema %}
