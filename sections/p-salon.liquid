{%- if section.settings.air10_max_layout -%}

<section id="a10-max-{{ section.id }}" class="a10-2026 to-top a10-2026__cost">
<div class="a10-2026__inner">{% if section.settings.title != blank %}
<h2 class="a10-2026__title a10-2026__center">{{ section.settings.title | escape | newline_to_br }}</h2>
{% endif %}{% if section.settings.subtitle != blank %}<p class="a10-2026__subtitle">{{ section.settings.subtitle | escape | newline_to_br }}</p>{% endif %}
<table class="a10-2026__cost-table">
<caption class="visually-hidden">{{ section.settings.subtitle | escape | newline_to_br }}</caption>

<tbody>{% for block in section.blocks %}
<tr  {{ block.shopify_attributes }}>
<th scope="row">
<div class="a10-2026__cost-label">{%- assign a10_image = block.settings.image | default: block.settings.image -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}<span>{{ block.settings.label | escape | newline_to_br }}</span></div>
{% if forloop.first and section.settings.vs_label != blank %}<span class="a10-2026__cost-vs">{{ section.settings.vs_label | escape }}</span>{% endif %}</th>

<td>{% if forloop.first %}<small>{{ section.settings.price_label | escape | newline_to_br }}</small>{% endif %}{{ block.settings.price | escape | newline_to_br }}</td>

<td>{{ block.settings.detail | escape | newline_to_br }}</td>
</tr>
{% endfor %}</tbody>
</table>
{% if section.settings.note != blank %}
<div class="a10-2026__note">{{ section.settings.note }}</div>
{% endif %}</div>
</section>

<style>
#a10-max-{{ section.id }}{ color: #190a0a;  overflow: hidden; }
#a10-max-{{ section.id }} *, #a10-max-{{ section.id }} *::before, #a10-max-{{ section.id }} *::after{ box-sizing: border-box; }
#a10-max-{{ section.id }} h2, #a10-max-{{ section.id }} h3, #a10-max-{{ section.id }} p{ margin: 0; }
#a10-max-{{ section.id }} .a10-2026__inner{ width: min(1220px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-{{ section.id }} .a10-2026__wide{ width: min(1600px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-{{ section.id }} .a10-2026__title{ font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-{{ section.id }} .a10-2026__body{ color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__body p + p{ margin-top: 0; }
#a10-max-{{ section.id }} .a10-2026__note{ color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__note p{ margin: 0; }
#a10-max-{{ section.id }} .a10-2026__media{ display: block; min-width: 0; }
#a10-max-{{ section.id }} .a10-2026__media img{ display: block; width: 100%; height: auto; }
#a10-max-{{ section.id }} .a10-2026__center{ text-align: center; }
#a10-max-{{ section.id }} .a10-2026__mobile{ display: none; }
#a10-max-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-{{ section.id }} .a10-2026__note a{ color: inherit; }
#a10-max-{{ section.id }} sup{ font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-{{ section.id }}.a10-2026__cost{ background: #fff; padding: 90px 0 55px; }
#a10-max-{{ section.id }}.a10-2026__cost .a10-2026__subtitle{ margin: 45px auto 100px; display: flex; align-items: center; gap: 30px; color: #3f3636; }
#a10-max-{{ section.id }}.a10-2026__cost .a10-2026__subtitle::before, #a10-max-{{ section.id }}.a10-2026__cost .a10-2026__subtitle::after{ content: ''; height: 1px; background: #aaa; flex: 1; }
#a10-max-{{ section.id }} .a10-2026__cost-table{ width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
#a10-max-{{ section.id }} .a10-2026__cost-table :is(th,td){ padding: 35px 15px; background: #f9f9f9; text-align: center; font-weight: 400; border: 0; font-size: 24px; }
#a10-max-{{ section.id }} .a10-2026__cost-table th{ width: 45%; }
#a10-max-{{ section.id }} .a10-2026__cost-table td:nth-child(2){  font-size: 40px; }
#a10-max-{{ section.id }} .a10-2026__cost-table td:last-child{ font-size: 24px; color: #3f3636; }
#a10-max-{{ section.id }} .a10-2026__cost-table .a10-2026__media{ width: 105px; flex: 0 0 auto; }
#a10-max-{{ section.id }} .a10-2026__cost-label{ display: flex; align-items: center; gap: 40px; }
#a10-max-{{ section.id }} .a10-2026__cost-table tr:first-child :is(th,td){ background: #fff0f5; border-bottom: 30px solid white; }
#a10-max-{{ section.id }} .a10-2026__cost-table tr:first-child td:nth-child(2){ color: #e0004d; font-size: 60px; }
#a10-max-{{ section.id }} .a10-2026__cost-table small{ display: block; font-size: 20px; color: #000; }
#a10-max-{{ section.id }}.a10-2026__cost .a10-2026__note{ margin-top: 90px; max-width: 1000px; }
@media (min-width:750px) and (max-width:1400px){#a10-max-{{ section.id }} .a10-2026__title{ font-size: 32px; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 26px; }
#a10-max-{{ section.id }} .a10-2026__cost-table :is(th,td), #a10-max-{{ section.id }} .a10-2026__cost-table td:last-child{ font-size: 18px; }
#a10-max-{{ section.id }} .a10-2026__cost-label{ gap: 18px; }
}@media (max-width:749px){#a10-max-{{ section.id }} .a10-2026__inner, #a10-max-{{ section.id }} .a10-2026__wide{ width: calc(100% - 40px); }
#a10-max-{{ section.id }} .a10-2026__desktop{ display: none !important; }
#a10-max-{{ section.id }} .a10-2026__mobile{ display: block; }
#a10-max-{{ section.id }} .a10-2026__title{ font-size: 24px; line-height: 1.3; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 24px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__body{ font-size: 14px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__note{ font-size: 10px; line-height: 1.5; }
#a10-max-{{ section.id }}.a10-2026__cost{ padding: 34px 0 30px; }
#a10-max-{{ section.id }}.a10-2026__cost .a10-2026__title{ font-size: 20px; font-weight: 500; max-width: 260px; margin: auto; }
#a10-max-{{ section.id }}.a10-2026__cost .a10-2026__subtitle{ font-size: 14px; gap: 8px; margin: 20px 0; }
#a10-max-{{ section.id }} .a10-2026__cost-table :is(th,td){ font-size: 9px; padding: 10px 2px; }
#a10-max-{{ section.id }} .a10-2026__cost-table th{ width: 45%; }
#a10-max-{{ section.id }} .a10-2026__cost-table td:nth-child(2){ font-size: 18px; white-space: nowrap; width: 26%; }
#a10-max-{{ section.id }} .a10-2026__cost-table td:last-child{ font-size: 10px; }
#a10-max-{{ section.id }} .a10-2026__cost-table tr:first-child td:nth-child(2){ font-size: 20px; }
#a10-max-{{ section.id }} .a10-2026__cost-table tr:first-child :is(th,td){ border-bottom-width: 10px; }
#a10-max-{{ section.id }} .a10-2026__cost-table .a10-2026__media{ width: 38px; }
#a10-max-{{ section.id }} .a10-2026__cost-label{ gap: 6px; }
#a10-max-{{ section.id }} .a10-2026__cost-table small{ font-size: 10px; }
#a10-max-{{ section.id }}.a10-2026__cost .a10-2026__note{ margin-top: 26px; }
}#a10-max-{{ section.id }} .a10-2026__cost-table{ border:0; margin:0; }
#a10-max-{{ section.id }} .a10-2026__cost-table th{ font-weight:400; }

#a10-max-{{ section.id }} .a10-2026__cost-table th { position:relative; }
#a10-max-{{ section.id }} .a10-2026__cost-vs { position:absolute; bottom:-35px;left:50px;z-index:1;display:flex;align-items:center;justify-content:center;width:72px;height:72px;border-radius:50%;background:#e0004d;color:#fff;font-size:35px;font-style:italic; }
@media(max-width:749px){#a10-max-{{ section.id }} .a10-2026__cost-vs { width:24px;height:24px;bottom:-12px;left:25px;font-size:14px; }}
</style>
{%- else -%}
{% assign sid = section.id %}

<style>
  #p-salon-{{ sid }} {
    overflow: hidden;
    background: var(--p-salon-bg);
    color: var(--p-salon-text);
  }

  #p-salon-{{ sid }} .p-aps-salon__in { position: relative; }
  #p-salon-{{ sid }} picture { display: block; }
  #p-salon-{{ sid }} .p-aps-salon__img { display: block; width: 100%; height: auto; }

  #p-salon-{{ sid }} .p-aps-salon__copy {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: min(1250px, calc(100% - 64px));
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  #p-salon-{{ sid }} .p-aps-salon__copy-in {
    width: 624px;
  }

  #p-salon-{{ sid }} .p-aps-salon__body { 
    width: 100%; 
  
  }
  #p-salon-{{ sid }} .p-aps-salon__title {
    margin: 0;
    color: #000;
    font-size: 48px;
    font-weight: 500;
    line-height: 1.5;
  }

  #p-salon-{{ sid }} .p-aps-salon__lead,
  #p-salon-{{ sid }} .p-aps-salon__outro {
    margin: 20px 0 0;
    color: #000;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
  }

  #p-salon-{{ sid }} .p-aps-salon__callout {
    margin-top: 30px;
    padding: 18px 22px;
    border-radius: 8px;
    max-width: 520px;
    background: #dff0e9;
    color: #000;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.55;
  }

  #p-salon-{{ sid }} .p-aps-salon__callout strong {
    font-size: 1.45em;
    font-weight: 500;
    line-height: 0;
  }

  #p-salon-{{ sid }} .p-aps-salon__outro { margin-top: 30px; font-size: 16px; }
  #p-salon-{{ sid }} .p-aps-salon__outro strong { font-size: 1.35em; font-weight: 500; }

  #p-salon-{{ sid }} .p-aps-salon__note {
    position: absolute;
    z-index: 1;
    bottom: 60px;
    left: 50%;
    width: min(1250px, calc(100% - 64px));
    transform: translateX(-50%);
    margin: 0;
    color: #000;
    font-size: 10px;
    opacity: 0.5;
    font-weight: 400;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    #p-salon-{{ sid }} .p-aps-salon__in { display: flex; flex-direction: column; }
    #p-salon-{{ sid }} .p-aps-salon__copy {
      position: relative;
      inset: auto;
      display: block;
      transform: none;
      width: auto;
      padding: 60px 15px 28px;
    }

    #p-salon-{{ sid }} .p-aps-salon__copy-in { width: 100%; margin: 0; }
    #p-salon-{{ sid }} .p-aps-salon__body { width: 100%; }
    #p-salon-{{ sid }} .p-aps-salon__title { 
      font-size: 32px;
      width: 70%;
    }
    #p-salon-{{ sid }} .p-aps-salon__lead { margin-top: 15px; font-size: 12px;  }
    #p-salon-{{ sid }} .p-aps-salon__callout { 
      margin-top: 15px; 
      padding: 12px;
      border-radius: 8px;
       font-size: 16px;
       line-height: 1.55; 
    }
    #p-salon-{{ sid }} .p-aps-salon__outro { 
      margin-top: 15px;
      font-size: 14px;
      width: 88%;
    }
    #p-salon-{{ sid }} .p-aps-salon__outro strong {
      font-size: 20px;
      
    }
    #p-salon-{{ sid }} .p-aps-salon__pic { width: 100%; }
    #p-salon-{{ sid }} .p-aps-salon__note { bottom: 15px; width: calc(100% - 32px); font-size: 10px; }
  }
</style>

<section id="p-salon-{{ sid }}" class="p-aps-salon" style="--p-salon-bg: {{ section.settings.background }}; --p-salon-text: {{ section.settings.text_color }};">
  <div class="p-aps-salon__in">
    <div class="p-aps-salon__copy">
      <div class="p-aps-salon__copy-in">
        <div class="p-aps-salon__body">
          {% if section.settings.title != blank %}<h2 class="p-aps-salon__title to-top">{{ section.settings.title }}</h2>{% endif %}
          {% if section.settings.lead != blank %}<div class="p-aps-salon__lead to-top" style="transition-delay: .1s">{{ section.settings.lead }}</div>{% endif %}
          {% if section.settings.callout != blank %}<div class="p-aps-salon__callout to-top" style="transition-delay: .2s">{{ section.settings.callout }}</div>{% endif %}
          {% if section.settings.outro != blank %}<div class="p-aps-salon__outro to-top" style="transition-delay: .3s">{{ section.settings.outro }}</div>{% endif %}
        </div>
      </div>
    </div>

    <div class="p-aps-salon__pic">
      <picture>
        {% if section.settings.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">{% endif %}
        {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1920 | image_tag: class: 'p-aps-salon__img', loading: 'lazy', widths: '750, 1200, 1600, 1920' }}{% endif %}
      </picture>
    </div>

    {% if section.settings.note != blank %}<p class="p-aps-salon__note to-top" style="transition-delay: .4s">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>


{%- endif -%}
{% schema %}
{
  "name": "P Air Pro S 沙龙对比",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "标题",
      "default": "脱毛サロンよりもコスパ良し"
    },
    {
      "type": "html",
      "id": "lead",
      "label": "标题说明",
      "default": "脱毛サロンに通うと、1人で数万円から数十万円もの費用がかかる上に、<br>予約の手間や通院時間の確保も大変…。"
    },
    {
      "type": "html",
      "id": "callout",
      "label": "高亮文案",
      "default": "Ulike Air Pro Sなら、最大<strong>90万回</strong>*照射可能。<br>パートナーや家族との共有もおすすめ。"
    },
    {
      "type": "html",
      "id": "outro",
      "label": "底部说明",
      "default": "シェアしてコスパよく、ムダ毛ケアができます。<strong>たった1台で。</strong>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "脚注",
      "default": "*当社の耐久性試験結果。"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端图片"
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景色",
      "default": "#f5f7f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字色",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "air10_max_layout",
      "label": "使用 Air 10 Max 2026 设计",
      "default": false
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "对比副标题"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "价格上方标签"
    },
    {
      "type": "text",
      "id": "vs_label",
      "label": "对比标记"
    }
  ],
  "presets": [
    {
      "name": "P Air Pro S 沙龙对比"
    }
  ],
  "blocks": [
    {
      "type": "comparison",
      "name": "费用对比行",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "缩略图"
        },
        {
          "type": "text",
          "id": "label",
          "label": "项目名称"
        },
        {
          "type": "text",
          "id": "price",
          "label": "金额"
        },
        {
          "type": "textarea",
          "id": "detail",
          "label": "回数与期间"
        }
      ]
    }
  ]
}
{% endschema %}
