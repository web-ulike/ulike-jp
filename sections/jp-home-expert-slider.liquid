{% liquid
  assign sid = section.id
%}

<section class="jp-home-expert jp-home-expert--{{ sid }}">
  <div class="jp-container">
    <div class="jp-home-expert__header">
      {% if section.settings.heading != blank %}
        <h2 class="jp-home-expert__title">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="jp-home-expert__body">
      <div class="swiper jp-home-expert__swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide jp-home-expert__slide" {{ block.shopify_attributes }}>
              <div class="jp-home-expert__card">
                <div class="jp-home-expert__media">
                  {% if block.settings.image != blank %}
                    <img
                      class="jp-home-expert__image"
                      src="{{ block.settings.image | image_url: width: 900 }}"
                      alt="{{ block.settings.name | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  {% endif %}
                </div>

                <div class="jp-home-expert__content">
                  {% if block.settings.name != blank %}
                    <div class="jp-home-expert__name">{{ block.settings.name }}</div>
                  {% endif %}

                  {% if block.settings.role != blank %}
                    <div class="jp-home-expert__role">{{ block.settings.role }}</div>
                  {% endif %}

                  {% if block.settings.quote != blank %}
                    <div class="jp-home-expert__quote">{{ block.settings.quote }}</div>
                  {% endif %}

                  {% if block.settings.desc != blank %}
                    <div class="jp-home-expert__desc">{{ block.settings.desc }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="jp-home-expert__footer">
          <div class="jp-home-expert__progress swiper-pagination"></div>
          <div class="jp-home-expert__nav-group">
            <button class="jp-home-expert__nav jp-home-expert__nav--prev" type="button" aria-label="Previous">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M11.25 14.25L6 9L11.25 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button class="jp-home-expert__nav jp-home-expert__nav--next" type="button" aria-label="Next">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M6.75 14.25L12 9L6.75 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .jp-home-expert--{{ sid }} {
    --jp-home-expert-title: #111111;
    --jp-home-expert-text: #555555;
    --jp-home-expert-muted: #777777;
    --jp-home-expert-bg: #ffffff;
    --jp-home-expert-card-bg: #f8f6f7;
    padding: 64px 0;
    background: var(--jp-home-expert-bg);
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__header {
    margin-bottom: 28px;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__title {
    margin: 0;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--jp-home-expert-title);
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__body {
    position: relative;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__swiper {
    overflow: hidden;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__slide {
    height: auto;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__card {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    align-items: stretch;
    min-height: 420px;
    background: var(--jp-home-expert-card-bg);
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__media {
    position: relative;
    overflow: hidden;
    background: #eee;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 46px 56px;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__name {
    font-size: 24px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--jp-home-expert-title);
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__role {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--jp-home-expert-muted);
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__quote {
    margin-top: 24px;
    font-size: 30px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--jp-home-expert-title);
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__desc {
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.9;
    color: var(--jp-home-expert-text);
    max-width: 700px;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__footer {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__progress {
    position: relative;
    flex: 1 1 auto;
    height: 2px;
    background: #d9d9d9;
    overflow: hidden;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__progress.swiper-pagination-progressbar {
    background: #d9d9d9;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__progress .swiper-pagination-progressbar-fill {
    background: #000;
    transform-origin: left top;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__nav-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__nav {
    width: 42px;
    height: 42px;
    border: 1px solid #7d7d7d;
    border-radius: 50%;
    background: transparent;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all .25s ease;
  }

  .jp-home-expert--{{ sid }} .jp-home-expert__nav:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  @media screen and (max-width: 989px) {
    .jp-home-expert--{{ sid }} {
      padding: 42px 0;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__header {
      margin-bottom: 22px;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__title {
      font-size: 20px;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__card {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__media {
      aspect-ratio: 1 / 1.05;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__content {
      padding: 22px 18px 24px;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__name {
      font-size: 20px;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__role {
      margin-top: 8px;
      font-size: 13px;
      line-height: 1.7;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__quote {
      margin-top: 16px;
      font-size: 22px;
      line-height: 1.5;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__desc {
      margin-top: 12px;
      font-size: 13px;
      line-height: 1.8;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__footer {
      gap: 14px;
      margin-top: 20px;
    }

    .jp-home-expert--{{ sid }} .jp-home-expert__nav {
      width: 34px;
      height: 34px;
    }
  }
</style>

<script>
  (() => {
    const sectionEl = document.querySelector('.jp-home-expert--{{ sid }}');
    if (!sectionEl) return;

    const initExpertSwiper = () => {
      const swiperEl = sectionEl.querySelector('.jp-home-expert__swiper');
      if (!swiperEl || typeof window.Swiper === 'undefined') return;

      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }

      new window.Swiper(swiperEl, {
        slidesPerView: 1,
        spaceBetween: 0,
        speed: 700,
        watchOverflow: true,
        navigation: {
          nextEl: sectionEl.querySelector('.jp-home-expert__nav--next'),
          prevEl: sectionEl.querySelector('.jp-home-expert__nav--prev')
        },
        pagination: {
          el: sectionEl.querySelector('.jp-home-expert__progress'),
          type: 'progressbar'
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initExpertSwiper);
    } else {
      initExpertSwiper();
    }
  })();
</script>

{% schema %}
{
  "name": "JP Expert",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "権威ある専門家による推薦"
    }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "M. Tanaka"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "美容専門家 / スキンケアアドバイザー"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "毎日のセルフケアを、もっとやさしく、もっと続けやすく。"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "自宅で使いやすい設計と、継続しやすい快適なケア体験が魅力です。忙しい毎日の中でも自然に取り入れやすく、習慣化しやすい点を高く評価しています。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Expert",
      "blocks": [
        {
          "type": "expert"
        },
        {
          "type": "expert"
        }
      ]
    }
  ]
}
{% endschema %}