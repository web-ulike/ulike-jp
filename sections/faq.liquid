<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .faq-reference {
    padding: var(--section-padding-top) 0 var(--section-padding-bottom);
    background: var(--gradient-background, rgb(var(--color-background, 255 255 255)));
    color: rgb(var(--color-foreground, 17 17 17));
  }

  #shopify-section-{{ section.id }} .faq-reference__header {
    margin-bottom: clamp(28px, 2.5vw, 40px);
  }

  #shopify-section-{{ section.id }} .faq-reference__title {
    margin: 0;
    color: inherit;
    font-size: clamp(32px, 2vw, 48px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .faq-reference__description {
    max-width: 680px;
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .faq-reference__list {
    overflow: hidden;
    border: 1px solid rgb(var(--color-border, 231 231 231));
    border-radius: 20px;
    background: rgb(var(--color-background, 255 255 255));
  }

  #shopify-section-{{ section.id }} .faq-reference__list--with-background {
    border: 0;
    background: rgb(var(--color-foreground, 17 17 17) / 0.04);
  }

  #shopify-section-{{ section.id }} .faq-reference__item + .faq-reference__item {
    border-top: 1px solid rgb(var(--color-border, 231 231 231));
  }

  #shopify-section-{{ section.id }} .faq-reference__summary {
    display: flex;
    min-height: 104px;
    padding: 24px clamp(24px, 3vw, 48px);
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: inherit;
    cursor: pointer;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .faq-reference__summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .faq-reference__question {
    min-width: 0;
    font-size: clamp(18px, 1.2vw, 22px);
    font-weight: 500;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .faq-reference__question strong{
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .faq-reference__icon {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
  }

  #shopify-section-{{ section.id }} .faq-reference__icon::before,
  #shopify-section-{{ section.id }} .faq-reference__icon::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    content: '';
    transform: translate(-50%, -50%);
    transition: transform 180ms ease;
  }

  #shopify-section-{{ section.id }} .faq-reference__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  #shopify-section-{{ section.id }} details[open] .faq-reference__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  #shopify-section-{{ section.id }} .faq-reference__answer {
    padding: 0 clamp(24px, 3vw, 48px) 32px;
    color: rgb(var(--color-foreground, 17 17 17) / 0.82);
    font-size: 15px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .faq-reference__answer > :first-child {
    margin-block-start: 0;
  }

  #shopify-section-{{ section.id }} .faq-reference__answer > :last-child {
    margin-block-end: 0;
  }

  #shopify-section-{{ section.id }} .faq-reference__answer p + p {
    margin-block-start: 16px;
  }

  #shopify-section-{{ section.id }} .faq-reference__answer :is(ul, ol) {
    margin-block: 16px;
  }

  #shopify-section-{{ section.id }} .faq-reference__answer a {
    font-weight: 600;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .faq-reference__footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 2.5vw, 40px);
  }

  #shopify-section-{{ section.id }} .faq-reference__item--text {
    padding: 28px clamp(24px, 3vw, 48px);
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .faq-reference {
      padding-top: min(var(--section-padding-top), 56px);
      padding-bottom: min(var(--section-padding-bottom), 72px);
    }

    #shopify-section-{{ section.id }} .faq-reference__header {
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .faq-reference__title {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .faq-reference__list {
      border-radius: 16px;
    }

    #shopify-section-{{ section.id }} .faq-reference__summary {
      min-height: 88px;
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .faq-reference__question {
      font-size: 16px;
      line-height: 1.45;
    }

    #shopify-section-{{ section.id }} .faq-reference__answer {
      padding: 0 20px 24px;
      font-size: 15px;
    }
  }
</style>

{%- assign faq_heading = section.settings.heading | default: 'よくあるご質問' -%}
{%- if faq_heading == 'FAQ' -%}
  {%- assign faq_heading = 'よくあるご質問' -%}
{%- endif -%}

<section class="faq-reference{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded{% endif %}">
  <div class="container relative">
    <header class="faq-reference__header to-top">
      <{{ section.settings.heading_tag | default: 'h2' }} class="faq-reference__title">{{ faq_heading | strip_html }}</{{ section.settings.heading_tag | default: 'h2' }}>
      {%- if section.settings.description != blank -%}
        <div class="faq-reference__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      {%- liquid
        assign with_gradient = false
        if section.settings.gradient_highlight != blank and section.settings.gradient_highlight != 'rgba(0,0,0,0)'
          assign with_gradient = true
        endif

        assign contact = section.blocks | where: "type", "contact" | first
      -%}
      <div class="faq-reference__list faq-reference__list--{{ section.settings.style | default: 'with-border' }}">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'rich-text' -%}
                  <div class="faq-reference__item faq-reference__item--text to-top" style="transition-delay: {{ forloop.index0 | modulo: 4 | times: 100 }}ms" {{ block.shopify_attributes }}>
                    <div class="grid gap-2d5">
                      <p class="heading lg:text-3xl text-2xl font-bold leading-none tracking-tight">
                        {%- render 'highlighted-text', content: block.settings.heading, style: block.settings.highlighted_text, scribble: block.settings.highlighted_scribble, gradient: with_gradient -%}
                      </p>
                      <div class="text-opacity text-base rte">
                        {{- block.settings.text -}}
                      </div>
                    </div>
                  </div>

                {%- when 'question' -%}
                  <div class="faq-reference__item to-top" style="transition-delay: {{ forloop.index0 | modulo: 4 | times: 100 }}ms">
                    <details class="details" is="accordion-details" {{ block.shopify_attributes }}>
                      <summary class="faq-reference__summary">
                        <span class="faq-reference__question">
                          {%- render 'highlighted-text', content: block.settings.title, style: block.settings.highlighted_text, scribble: block.settings.highlighted_scribble, gradient: with_gradient -%}
                        </span>
                        <span class="faq-reference__icon" aria-hidden="true"></span>
                      </summary>
                      <div class="faq-reference__answer rte">
                        {{- block.settings.text -}}
                      </div>
                    </details>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="faq-reference__footer to-top">
          <a class="button button--primary button--fixed" href="{{ section.settings.button_link }}" is="hover-link">
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">{{ section.settings.button_label | escape }}</span>
          </a>
        </div>
      {%- endif -%}

      {%- if contact != blank -%}
          {%- assign form_id = 'ContactForm-' | append: section.id -%}
          {%- form 'contact', id: form_id, class: 'grow-0' -%}
            <sticky-element class="contact__sidebar grid gap-7d5 md:gap-10 sticky top-0">
              <div class="flex justify-between gap-6">
                <div class="grid gap-2d5">
                  <p class="heading lg:text-3xl text-2xl font-bold leading-none tracking-tight">
                    {%- render 'highlighted-text', content: contact.settings.heading, style: contact.settings.highlighted_text, scribble: contact.settings.highlighted_scribble, gradient: with_gradient -%}
                  </p>
                  <div class="text-opacity text-base rte">
                    {{- contact.settings.text -}}
                  </div>
                </div>

                {%- if contact.settings.avatar != blank -%}
                  {%- capture sizes -%}{{ contact.settings.avatar_height | times: contact.settings.avatar.aspect_ratio }}px{%- endcapture -%}
                  {%- capture widths -%}{{ contact.settings.avatar_height | times: contact.settings.avatar.aspect_ratio }}, {{ contact.settings.avatar_height | times: contact.settings.avatar.aspect_ratio | times: 2 | at_most: contact.settings.avatar.width }}{%- endcapture -%}
                  {%- capture style -%}--image-width: {{ contact.settings.avatar_height | times: contact.settings.avatar.aspect_ratio }}px; --image-height: {{ contact.settings.avatar_height }}px;{%- endcapture -%}

                  <div class="media media--transparent relative">
                    {{- contact.settings.avatar | image_url: width: contact.settings.avatar.width | image_tag: loading: 'lazy', sizes: sizes, widths: widths, style: style, is: 'lazy-image' -}}
                  </div>
                {%- endif -%}
              </div>
              <div class="grid gap-4d5 md:gap-6">
                {%- if form.errors -%}
                  <div class="field">
                    {%- liquid
                      assign form_errors = form.errors | default_errors
                      render 'alert', status: 'error', content: form_errors
                    -%}
                  </div>
                {%- endif -%}

                {%- if form.posted_successfully? -%}
                  <div class="field">
                    {%- liquid
                      assign success_message = 'contact.form.successfully_sent' | t
                      render 'alert', status: 'success', content: success_message
                    -%}
                  </div>
                {%- endif -%}

                <div class="field">
                  <input
                    class="input is-floating"
                    autocomplete="name"
                    type="text"
                    id="ContactFormName-{{ section.id }}"
                    name="contact[{{ 'contact.form.name' | t }}]"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    placeholder="{{ 'contact.form.name' | t | escape }}"
                  />
                  <label class="label is-floating" for="ContactFormName-{{ section.id }}">{{ 'contact.form.name' | t }}</label>
                </div>
                <div class="field">
                  <input
                    class="input is-floating{% if form.errors contains 'email' %} invalid{% endif %}"
                    autocomplete="email"
                    type="email"
                    id="ContactFormEmail-{{ section.id }}"
                    name="contact[email]"
                    spellcheck="false"
                    autocapitalize="off"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    placeholder="{{ 'contact.form.email' | t | escape }}"
                    required
                  >
                  <label class="label is-floating" for="ContactFormEmail-{{ section.id }}">{{- 'contact.form.email' | t }}</label>
                </div>

                {%- if contact.settings.show_phone -%}
                  <div class="field">
                    <input
                      class="input is-floating"
                      autocomplete="phone"
                      type="tel"
                      id="ContactFormPhone-{{ section.id }}"
                      name="contact[{{ 'customer.addresses.phone' | t }}]"
                      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                      placeholder="{{ 'customer.addresses.phone' | t | escape }}"
                      pattern="[0-9\-]*"
                    />
                    <label class="label is-floating" for="ContactFormPhone-{{ section.id }}">{{ 'customer.addresses.phone' | t }}</label>
                  </div>
                {%- endif -%}

                <div class="field">
                  <textarea
                    class="textarea is-floating"
                    rows="4"
                    id="ContactFormMessage-{{ section.id }}"
                    name="contact[{{ 'contact.form.message' | t }}]"
                    placeholder=" "
                  >
                    {{- form.body -}}
                  </textarea>
                  <label class="label is-floating" for="ContactFormMessage-{{ section.id }}">{{ 'contact.form.message' | t }}</label>
                </div>
                <div class="field">
                  <label for="ContactSubmit-{{ section.id }}" class="sr-only">{{ 'contact.form.submit' | t }}</label>
                  <button type="submit" id="ContactSubmit-{{ section.id }}" class="button button--primary button--fixed" is="hover-button">
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">{{ 'contact.form.submit' | t }}</span>
                  </button>
                </div>
              </div>
            </sticky-element>
          {%- endform -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{%- assign faq_questions = section.blocks | where: 'type', 'question' -%}
{%- if faq_questions.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in faq_questions -%}
          {
            "@type": "Question",
            "name": {{ block.settings.title | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.text | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

