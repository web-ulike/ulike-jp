{%- liquid
  assign title = section.settings.title | default: 'ページが見つかりません'
  assign description = section.settings.description | default: 'お探しのページはもう存在しないようです。 前のページまたは以下のページに戻ってみてください。'
  assign primary_label = section.settings.primary_label | default: 'ホームページに戻る'
  assign secondary_label = section.settings.secondary_label | default: 'ショッピングを開始する'
  assign primary_url = section.settings.primary_url | default: routes.root_url
  assign secondary_url = section.settings.secondary_url | default: routes.all_products_collection_url
-%}

<style>
  #shopify-section-{{ section.id }} .page-404 { align-items: center; background: #fff; box-sizing: border-box; color: #000; display: flex; flex-direction: column; padding: 150px 32px 200px; text-align: center; }
  #shopify-section-{{ section.id }} .page-404 *, #shopify-section-{{ section.id }} .page-404 *::before, #shopify-section-{{ section.id }} .page-404 *::after { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .page-404__content { align-items: center; display: flex; flex-direction: column; gap: 25px; width: 311px; }
  #shopify-section-{{ section.id }} .page-404__illustration { display: block; height: 99px; width: 113px; }
  #shopify-section-{{ section.id }} .page-404__copy { display: flex; flex-direction: column; gap: 20px; width: 100%; }
  #shopify-section-{{ section.id }} .page-404__title { font-family: "Noto Sans JP", sans-serif; font-size: 28px; font-weight: 500; line-height: 1.2; margin: 0; }
  #shopify-section-{{ section.id }} .page-404__description { font-family: "Noto Sans JP", sans-serif; font-size: 12px; font-weight: 400; line-height: 1.5; margin: 0; }
  #shopify-section-{{ section.id }} .page-404__actions { display: flex; gap: 24px; margin-top: 39px; }
  #shopify-section-{{ section.id }} .page-404__button { align-items: center; border: 1px solid #e0004d; color: #e0004d; display: inline-flex; font-family: "Noto Sans JP", sans-serif; font-size: 12px; font-weight: 500; gap: 12px; justify-content: center; line-height: 1.5; min-height: 48px; padding: 14px 23px; text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  #shopify-section-{{ section.id }} .page-404__button--primary { background: #e0004d; color: #fff; }
  #shopify-section-{{ section.id }} .page-404__button:hover { background: #e0004d; color: #fff; }
  #shopify-section-{{ section.id }} .page-404__button--primary:hover { background: #bd0041; border-color: #bd0041; }
  #shopify-section-{{ section.id }} .page-404__button-icon { display: block; flex: 0 0 auto; height: 9px; width: 10px; }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .page-404 { gap: 40px; padding: 59px 32px; }
    #shopify-section-{{ section.id }} .page-404__content { width: 100%; }
    #shopify-section-{{ section.id }} .page-404__illustration { height: 80px; width: 91px; }
    #shopify-section-{{ section.id }} .page-404__title { font-size: 24px; line-height: 1.1; }
    #shopify-section-{{ section.id }} .page-404__description { max-width: 287px; }
    #shopify-section-{{ section.id }} .page-404__actions { align-items: center; flex-direction: column; gap: 20px; margin-top: 0; max-width: 100%; }
    #shopify-section-{{ section.id }} .page-404__button { height: 39px; min-height: 39px; max-width: 100%; padding: 0 23px; }
    #shopify-section-{{ section.id }} .page-404__button--primary { width: 199px; }
  }
</style>

<section class="page-404">
  <div class="page-404__content">
    <img class="page-404__illustration" src="{{ '404-illustration.svg' | asset_url }}" alt="" width="113" height="99" loading="eager">
    <div class="page-404__copy">
      <h1 class="page-404__title">{{ title | escape }}</h1>
      <p class="page-404__description">{{ description | escape | newline_to_br }}</p>
    </div>
  </div>

  <div class="page-404__actions">
    <a class="page-404__button page-404__button--primary" href="{{ primary_url }}">
      <span>{{ primary_label | escape }}</span>
      <img class="page-404__button-icon" src="{{ '404-arrow-light.svg' | asset_url }}" alt="" width="10" height="9">
    </a>
    <a class="page-404__button" href="{{ secondary_url }}">
      <span>{{ secondary_label | escape }}</span>
      <img class="page-404__button-icon" src="{{ '404-arrow-pink.svg' | asset_url }}" alt="" width="10" height="9">
    </a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "class": "shopify-section--404",
  "settings": [
    { "type": "text", "id": "title", "label": "标题", "default": "ページが見つかりません" },
    { "type": "textarea", "id": "description", "label": "说明文案", "default": "お探しのページはもう存在しないようです。 前のページまたは以下のページに戻ってみてください。" },
    { "type": "header", "content": "主按钮" },
    { "type": "text", "id": "primary_label", "label": "按钮文案", "default": "ホームページに戻る" },
    { "type": "url", "id": "primary_url", "label": "按钮链接" },
    { "type": "header", "content": "次按钮" },
    { "type": "text", "id": "secondary_label", "label": "按钮文案", "default": "ショッピングを開始する" },
    { "type": "url", "id": "secondary_url", "label": "按钮链接" }
  ]
}
{% endschema %}
