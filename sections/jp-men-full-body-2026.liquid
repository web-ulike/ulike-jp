{%- liquid
  assign section_id = 'jp-men-full-body-2026-' | append: section.id
  assign desktop_image = section.settings.image | default: section.settings.image_mobile
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign default_title_pc = 'シンプルなボタンに\nよる簡単操作'
  assign default_title_mobile = 'シンプルなボタンによる簡単操作'
  assign default_body = '全身ケアがたったの8分*で完了。自動連続照射モードつきで手の負担を軽減、全身ケアもスピーディ。腕・脇・脚などの広い範囲には、お肌に当てながら滑らせるだけでOK！ヒゲや前腕なら約1分、膝下でも約2分で完了！'
  assign default_note = '*認証機関CVC：GJW2024-1747。160㎝の男女3名を対象とした試験結果。お手入れにかかる時間には個人差があります。'
-%}

<section id="{{ section_id }}" class="jp-men-full-body-2026">
  <div class="jp-men-full-body-2026__inner jp-container">
    <div class="jp-men-full-body-2026__copy">
      <h2 class="jp-men-full-body-2026__title jp-men-full-body-2026__title--pc to-top">{{ section.settings.title_pc | default: default_title_pc | escape | newline_to_br }}</h2>
      <h2 class="jp-men-full-body-2026__title jp-men-full-body-2026__title--mobile to-top">{{ section.settings.title_mobile | default: default_title_mobile | escape }}</h2>
      <div class="jp-men-full-body-2026__body to-top" style="transition-delay: .1s">{{ section.settings.body | default: default_body }}</div>
      <p class="jp-men-full-body-2026__note jp-men-full-body-2026__note--desktop">{{ section.settings.note | default: default_note }}</p>
    </div>

    <div class="jp-men-full-body-2026__visual to-top" style="transition-delay: .2s">
      <picture class="jp-men-full-body-2026__picture">
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 1400 }}">
        {%- endif -%}
        {%- if desktop_image != blank -%}
          {{ desktop_image | image_url: width: 1800 | image_tag: class: 'jp-men-full-body-2026__image', loading: 'lazy', widths: '600, 900, 1200, 1500, 1800', alt: desktop_image.alt | default: section.settings.title_mobile }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'jp-men-full-body-2026__placeholder' }}
        {%- endif -%}
      </picture>

      <div class="jp-men-full-body-2026__parts">
        {%- for block in section.blocks limit: 10 -%}
          <span class="jp-men-full-body-2026__part" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
        {%- endfor -%}
      </div>
    </div>
    <p class="jp-men-full-body-2026__note jp-men-full-body-2026__note--mobile">{{ section.settings.note | default: default_note }}</p>
  </div>
</section>

<style>
  #{{ section_id }} {  color: {{ section.settings.text_color | default: '#000000' }}; margin-top: {{ section.settings.margin_top | default: 0 }}px; margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px; overflow: hidden; }
  #{{ section_id }} .jp-men-full-body-2026__inner {
    margin: 0 auto;
    max-width: 1360px;
    padding: 0; 
    position: relative;
    background: {{ section.settings.background | default: '#f7f8fa' }};
  }
  #{{ section_id }} .jp-men-full-body-2026__copy { left: 87px; position: absolute; top: 0; width: 480px; }
  #{{ section_id }} .jp-men-full-body-2026__title { color: inherit; font-size: 45px; font-weight: 500; line-height: 1.2; margin: 0; position: relative; top: 116px; }
  #{{ section_id }} .jp-men-full-body-2026__title--mobile { display: none; }
  #{{ section_id }} .jp-men-full-body-2026__body { color: inherit; font-family: inherit; font-size: 20.5px; font-weight: 400; line-height: 1.5; margin: 156px 0 0; text-align: justify; }
  #{{ section_id }} .jp-men-full-body-2026__note { color: {{ section.settings.note_color | default: '#000000' }}; font-size: 12.5px; font-weight: 400; left: 0; line-height: 1.3; margin: 0; opacity: .7; position: absolute; top: 465px; width: 481px; }
  #{{ section_id }} .jp-men-full-body-2026__note--mobile { display: none; }
  #{{ section_id }} .jp-men-full-body-2026__visual { height: 494px; left: 626px; position: absolute; top: 57px; width: 430px; }
  #{{ section_id }} .jp-men-full-body-2026__picture { display: block; width: 100%; }
  #{{ section_id }} .jp-men-full-body-2026__image, #{{ section_id }} .jp-men-full-body-2026__placeholder { display: block; height: auto; width: 100%; }
  #{{ section_id }} .jp-men-full-body-2026__placeholder { fill: #d7d9dc; }
  #{{ section_id }} .jp-men-full-body-2026__parts { display: flex; flex-direction: column; gap: 13.43px; left: 466px; position: absolute; top: 5px; width: 154px; }
  #{{ section_id }} .jp-men-full-body-2026__part { align-items: center; background: {{ section.settings.label_background | default: '#e9ebef' }}; border-radius: 999px; color: {{ section.settings.label_color | default: '#000000' }}; display: flex; flex: 0 0 35.75px; font-size: 15.33px; font-weight: 300; justify-content: center; line-height: 1.2; text-align: center; white-space: nowrap; }

  @media screen and (max-width: 749px) {
    #{{ section_id }} { background: {{ section.settings.background_mobile | default: '#ffffff' }}; margin-top: {{ section.settings.mobile_margin_top | default: 0 }}px; margin-bottom: {{ section.settings.mobile_margin_bottom | default: 0 }}px; }
    #{{ section_id }} .jp-men-full-body-2026__inner { display: block; min-height: 0; padding: 9.873vw 5.254vw 5.7vw; }
    #{{ section_id }} .jp-men-full-body-2026__copy { position: static; width: auto; }
    #{{ section_id }} .jp-men-full-body-2026__title { font-size: 5.774vw; line-height: 1.2; margin: 0; position: static; }
    #{{ section_id }} .jp-men-full-body-2026__title--pc { display: none; }
    #{{ section_id }} .jp-men-full-body-2026__title--mobile { display: block; white-space: nowrap; }
    #{{ section_id }} .jp-men-full-body-2026__body { font-size: 3.6386vw; line-height: 1.4; margin-top: 3.233vw; }
    #{{ section_id }} .jp-men-full-body-2026__visual { display: grid; grid-template-columns: minmax(0, 64.36%) minmax(0, 23.069%); column-gap: 8.8%; height: auto; left: auto; margin-top: 7.45vw; position: static; top: auto; width: 100%; }
    #{{ section_id }} .jp-men-full-body-2026__picture { margin-left: 3.488%; width: 100%; }
    #{{ section_id }} .jp-men-full-body-2026__placeholder { aspect-ratio: 997.569 / 1146.045; }
    #{{ section_id }} .jp-men-full-body-2026__parts { gap: 1.798vw; left: auto; position: static; top: auto; width: auto; }
    #{{ section_id }} .jp-men-full-body-2026__part { flex-basis: 4.789vw; font-size: 2.053vw; }
    #{{ section_id }} .jp-men-full-body-2026__note--desktop { display: none; }
    #{{ section_id }} .jp-men-full-body-2026__note--mobile { display: block; font-size: 1.66vw; grid-column: 1 / -1; line-height: 1.3; margin-top: 8.37vw; opacity: .5; position: static; text-align: center; width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Men Full Body",
  "settings": [
    { "type": "header", "content": "外边距" },
    { "type": "range", "id": "margin_top", "label": "PC 上边距", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "PC 下边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_top", "label": "M 上边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_bottom", "label": "M 下边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "textarea", "id": "title_pc", "label": "PC 标题", "default": "シンプルなボタンに\nよる簡単操作" },
    { "type": "text", "id": "title_mobile", "label": "M 标题", "default": "シンプルなボタンによる簡単操作" },
    { "type": "textarea", "id": "body", "label": "说明文案", "default": "全身ケアがたったの8分*で完了。自動連続照射モードつきで手の負担を軽減、全身ケアもスピーディ。腕・脇・脚などの広い範囲には、お肌に当てながら滑らせるだけでOK！ヒゲや前腕なら約1分、膝下でも約2分で完了！" },
    { "type": "textarea", "id": "note", "label": "脚注", "default": "*認証機関CVC：GJW2024-1747。160㎝の男女3名を対象とした試験結果。お手入れにかかる時間には個人差があります。" },
    { "type": "image_picker", "id": "image", "label": "PC 部位图片（建议 860 × 988）" },
    { "type": "image_picker", "id": "image_mobile", "label": "M 部位图片（建议 998 × 1146）" },
    { "type": "color", "id": "background", "label": "PC 背景颜色", "default": "#F7F8FA" },
    { "type": "color", "id": "background_mobile", "label": "M 背景颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#000000" },
    { "type": "color", "id": "note_color", "label": "脚注颜色", "default": "#000000" },
    { "type": "color", "id": "label_background", "label": "部位标签背景色", "default": "#E9EBEF" },
    { "type": "color", "id": "label_color", "label": "部位标签文字颜色", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "body_part",
      "name": "部位标签",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "label", "label": "标签文字", "default": "顔" }
      ]
    }
  ],
  "presets": [
    {
      "name": "jp-men-full-body-2026",
      "blocks": [
        { "type": "body_part", "settings": { "label": "顔" } },
        { "type": "body_part", "settings": { "label": "ワキ" } },
        { "type": "body_part", "settings": { "label": "胸" } },
        { "type": "body_part", "settings": { "label": "お腹" } },
        { "type": "body_part", "settings": { "label": "背中" } },
        { "type": "body_part", "settings": { "label": "腕" } },
        { "type": "body_part", "settings": { "label": "手（指 | 手の甲）" } },
        { "type": "body_part", "settings": { "label": "VIOゾーン" } },
        { "type": "body_part", "settings": { "label": "足" } },
        { "type": "body_part", "settings": { "label": "ほかの部位" } }
      ]
    }
  ]
}
{% endschema %}
