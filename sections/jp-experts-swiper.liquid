{% liquid
  assign sid = section.id
%}

<section class="jp-experts-swiper jp-experts-swiper--{{ sid }} {% if section.settings.custom_class != blank %}{{ section.settings.custom_class }}{% endif %}">
  <div class="jp-experts-swiper__header">
    <div class="container">
      {% if section.settings.heading != blank %}
        <h2 class="jp-experts-swiper__title to-top">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
  </div>

  <div class="">
    <div class="jp-experts-swiper__main">
      <div class="jp-experts-swiper__media-col">
        <div class="jp-experts-swiper__media-swiper swiper" id="jp-experts-media-{{ sid }}">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="jp-experts-swiper__media-card">
                  <div class="jp-experts-swiper__media-shape">
                    {% if block.settings.media_type == 'video' and block.settings.video != blank %}
                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: false,
                          loop: false,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'metadata',
                          image_size: '1200x',
                          class: 'jp-experts-swiper__video'
                      }}

                      {% if block.settings.image != blank %}
                        <div class="jp-experts-swiper__video-cover" data-video-cover>
                          <img
                            class="jp-experts-swiper__media-image"
                            src="{{ block.settings.image | image_url: width: 900 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </div>
                      {% endif %}
                    {% elsif block.settings.image != blank %}
                      <img
                        class="jp-experts-swiper__media-image"
                        src="{{ block.settings.image | image_url: width: 900 }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                      >
                    {% endif %}
                  </div>

                  {% if block.settings.play_button_show and block.settings.media_type == 'video' and block.settings.video != blank %}
                    <button
                      class="jp-experts-swiper__play"
                      type="button"
                      aria-label="Play video"
                      data-video-play
                    >
                      {% if section.settings.play_icon != blank %}
                        <img
                          src="{{ section.settings.play_icon | image_url: width: 120 }}"
                          alt="Play"
                          loading="lazy"
                          width="{{ section.settings.play_icon.width }}"
                          height="{{ section.settings.play_icon.height }}"
                        >
                      {% else %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="14" viewBox="0 0 10 14" fill="none">
                          <path d="M9.68802 6.625L0 13.25V0L9.68802 6.625Z" fill="black"/>
                        </svg>
                      {% endif %}
                    </button>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.blocks.size > 1 %}
          <div class="jp-experts-swiper__dots" id="jp-experts-dots-{{ sid }}"></div>
        {% endif %}
      </div>

      <div class="jp-experts-swiper__content-col">
        <div class="jp-experts-swiper__content-swiper swiper" id="jp-experts-content-{{ sid }}">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="jp-experts-swiper__content-item">
                  {% if block.settings.quote != blank %}
                    <div class="jp-experts-swiper__quote">{{ block.settings.quote }}</div>
                  {% endif %}

                  <div class="jp-experts-swiper__meta">
                    {% if block.settings.name != blank %}
                      <div class="jp-experts-swiper__name">- {{ block.settings.name }}</div>
                    {% endif %}
                    {% if block.settings.role != blank %}
                      <div class="jp-experts-swiper__role">{{ block.settings.role }}</div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.blocks.size > 1 %}
          <div class="jp-experts-swiper__nav">
            <button class="jp-experts-swiper__arrow jp-experts-swiper__arrow--prev" type="button" aria-label="Previous">
              {% if section.settings.prev_icon != blank %}
                <img
                  src="{{ section.settings.prev_icon | image_url: width: 120 }}"
                  alt="Previous"
                  loading="lazy"
                  width="{{ section.settings.prev_icon.width }}"
                  height="{{ section.settings.prev_icon.height }}"
                >
              {% else %}
                <svg width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
                  <circle cx="21" cy="21" r="20.5" stroke="#111"/>
                  <path d="M23.5 27L17.5 21L23.5 15" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% endif %}
            </button>

            <button class="jp-experts-swiper__arrow jp-experts-swiper__arrow--next" type="button" aria-label="Next">
              {% if section.settings.next_icon != blank %}
                <img
                  src="{{ section.settings.next_icon | image_url: width: 120 }}"
                  alt="Next"
                  loading="lazy"
                  width="{{ section.settings.next_icon.width }}"
                  height="{{ section.settings.next_icon.height }}"
                >
              {% else %}
                <svg width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
                  <circle cx="21" cy="21" r="20.5" stroke="#111"/>
                  <path d="M18.5 15L24.5 21L18.5 27" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% endif %}
            </button>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="jp-experts-swiper__modal" data-video-modal hidden>
    <div class="jp-experts-swiper__modal-overlay" data-video-modal-close></div>
    <div class="jp-experts-swiper__modal-dialog" role="dialog" aria-modal="true" aria-label="Video player">
      <button class="jp-experts-swiper__modal-close" type="button" aria-label="Close video" data-video-modal-close>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 2L16 16M16 2L2 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="jp-experts-swiper__modal-video-wrap" data-video-modal-content></div>
    </div>
  </div>
</section>

<style>
  .jp-experts-swiper--{{ sid }} {
    background: {{ section.settings.bg_color | default: '#f5f5f5' }};
    color: {{ section.settings.text_color | default: '#111111' }};
    border-bottom: 1px solid {{ section.settings.line_color | default: '#d4d4d4' }};
    position: relative;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__header {
    border-bottom: 1px solid {{ section.settings.line_color | default: '#d4d4d4' }};
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__title {
    margin: 0;
    padding: 40px 0 50px;
    text-align: center;
    font-size: 40px;
    line-height: 1.35;
    font-weight: 400;
    letter-spacing: .03em;
    color: inherit;
    font-family: var(--heading-font-family);
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__main {
    display: grid;
    grid-template-columns: 34.3% 65.7%;
    min-height: 284px;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-col {
    border-right: 1px solid {{ section.settings.line_color | default: '#d4d4d4' }};
    padding: 15% 15%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-swiper,
  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__content-swiper {
    width: 100%;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-card {
    position: relative;
    width: 100%;
    max-width: 310px;
    margin: 0 auto;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-shape {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.04;
    overflow: hidden;
    border-radius: 0 0 48% 48%;
    background: #ebebeb;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-image,
  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-shape video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-shape video {
    cursor: pointer;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__video-cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #ebebeb;
    transition: opacity .25s ease, visibility .25s ease;
    cursor: pointer;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__video-cover .jp-experts-swiper__media-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-card.is-playing .jp-experts-swiper__video-cover {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__play {
    position: absolute;
    right: 0px;
    bottom: 20px;
    width: 66px;
    height: 66px;
    border: 0;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 4px 14px rgba(0,0,0,.08);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    z-index: 4;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__play img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal[hidden] {
    display: none;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .72);
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal-dialog {
    position: relative;
    width: min(900px, 92vw);
    background: #000;
    border-radius: 16px;
    overflow: hidden;
    z-index: 1;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, .92);
    color: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    z-index: 2;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal-video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal-video-wrap video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    background: #000;
  }


  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: 26px;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__dots .swiper-pagination-bullet {
    position: relative;
    width: 8px;
    height: 8px;
    margin: 0 !important;
    background: #8a8a8a;
    opacity: 1;
    border-radius: 999px;
    transition: background .25s ease;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__dots .swiper-pagination-bullet-active {
    background: #111111;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__dots .swiper-pagination-bullet-active::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 24px;
    border: 1px solid #111111;
    border-radius: 999px;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__content-col {
    padding: 40px 120px 50px 120px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__content-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__quote {
    max-width: 800px;
    font-size: 30px;
    line-height: 1.4;
    font-weight: 500;
    color: #000;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__meta {
    margin-top: 30px;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__name {
    font-size: 25px;
    line-height: 1.4;
    color: inherit;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__role {
    margin-top: 2px;
    font-size: 18px;
    line-height: 1.4;
    color: #737577;
    margin-left: 15px;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__nav {
    margin-top: 60px;
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__arrow {
    width: 60px;
    height: 60px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__arrow img,
  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .jp-experts-swiper--{{ sid }} .jp-experts-swiper__arrow.swiper-button-disabled {
    opacity: .35;
    cursor: default;
  }

  @media screen and (max-width: 989px) {
    .jp-experts-swiper--{{ sid }} {
      border-top: 1px solid {{ section.settings.line_color | default: '#d4d4d4' }};
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__header {
      border-bottom: 0;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__title {
      padding: 30px 0 30px;
      text-align: left;
      font-size: 28px;
      line-height: 1.3;
      width: 70%;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__main {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-col {
      border-right: 0;
      border-bottom: 0;
      padding: 0 14px 24px;
      gap: 18px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-card {
      max-width: 95%;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__media-shape {
      border-radius: 0 0 48% 48%;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__play {
      width: 46px;
      height: 46px;
      right: 25px;
      bottom: 25px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__play svg {
      width: 10px;
      height: 14px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal {
      padding: 20px 12px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal-dialog {
      width: 100%;
      border-radius: 12px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__modal-close {
      top: 8px;
      right: 8px;
      width: 32px;
      height: 32px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__dots {
      gap: 18px;
      min-height: 25px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__dots .swiper-pagination-bullet {
      width: 7px;
      height: 7px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__dots .swiper-pagination-bullet-active::before {
      width: 23px;
      height: 23px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__content-col {
      padding: 28px 16px 26px;
      position: relative;
      border-top: 1px solid {{ section.settings.line_color | default: '#d4d4d4' }};
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__quote {
      max-width: none;
      font-size: 16px;
      line-height: 1.5;
      font-weight: 500;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__quote p {
      margin: 0;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__meta {
      margin-top: 30px;
      padding-right: 80px;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__name {
      font-size: 14px;
      line-height: 1.4;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__role {
      margin-top: 2px;
      font-size: 12px;
      line-height: 1.4;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__nav {
      position: absolute;
      right: 30px;
      bottom: 30px;
      margin-top: 0;
      gap: 10px;
      z-index: 2;
    }

    .jp-experts-swiper--{{ sid }} .jp-experts-swiper__arrow {
      width: 28px;
      height: 28px;
    }
  }
</style>

<script>
  window.addEventListener('load', () => {
    const sectionEl = document.querySelector('.jp-experts-swiper--{{ sid }}');
    if (!sectionEl || typeof window.Swiper === 'undefined') return;

    const mediaEl = sectionEl.querySelector('#jp-experts-media-{{ sid }}');
    const contentEl = sectionEl.querySelector('#jp-experts-content-{{ sid }}');
    const dotsEl = sectionEl.querySelector('#jp-experts-dots-{{ sid }}');

    const modalEl = sectionEl.querySelector('[data-video-modal]');
    const modalContentEl = sectionEl.querySelector('[data-video-modal-content]');

    let activeInlineVideo = null;
    let activeModalVideo = null;

    let mediaSwiper;
    let contentSwiper;

    const initExpertsSwiper = () => {
      if (mediaEl && mediaEl.swiper) mediaEl.swiper.destroy(true, true);
      if (contentEl && contentEl.swiper) contentEl.swiper.destroy(true, true);

      mediaSwiper = new window.Swiper(mediaEl, {
        slidesPerView: 1,
        effect: 'fade',
        fadeEffect: { crossFade: true },
        allowTouchMove: true,
        speed: 600,
        pagination: dotsEl ? {
          el: dotsEl,
          clickable: true
        } : undefined
      });

      contentSwiper = new window.Swiper(contentEl, {
        slidesPerView: 1,
        effect: 'fade',
        fadeEffect: { crossFade: true },
        allowTouchMove: true,
        speed: 600,
        autoHeight: true,
        navigation: sectionEl.querySelector('.jp-experts-swiper__arrow--prev') && sectionEl.querySelector('.jp-experts-swiper__arrow--next') ? {
          prevEl: sectionEl.querySelector('.jp-experts-swiper__arrow--prev'),
          nextEl: sectionEl.querySelector('.jp-experts-swiper__arrow--next')
        } : undefined
      });

      mediaSwiper.controller.control = contentSwiper;
      contentSwiper.controller.control = mediaSwiper;

      mediaSwiper.on('slideChange', function () {
        closeVideoModal();
        pauseOtherVideos();
      });
    };

    const pauseOtherVideos = (currentVideo) => {
      sectionEl.querySelectorAll('video').forEach((video) => {
        if (video === currentVideo) return;
        video.pause();

        const mediaCard = video.closest('.jp-experts-swiper__media-card');
        if (mediaCard) mediaCard.classList.remove('is-playing');
      });
    };

    const closeVideoModal = () => {
      if (activeModalVideo) {
        activeModalVideo.pause();
        activeModalVideo.remove();
        activeModalVideo = null;
      }

      if (activeInlineVideo) {
        const mediaCard = activeInlineVideo.closest('.jp-experts-swiper__media-card');
        activeInlineVideo.pause();
        if (mediaCard) mediaCard.classList.remove('is-playing');
        activeInlineVideo = null;
      }

      if (modalContentEl) modalContentEl.innerHTML = '';
      if (modalEl) modalEl.hidden = true;
    };

    const openVideoModal = (video) => {
      if (!video || !modalEl || !modalContentEl) return;

      closeVideoModal();
      pauseOtherVideos(video);

      const mediaCard = video.closest('.jp-experts-swiper__media-card');
      const modalVideo = video.cloneNode(true);

      activeInlineVideo = video;
      activeModalVideo = modalVideo;

      video.pause();
      video.muted = true;
      if (mediaCard) mediaCard.classList.add('is-playing');

      modalVideo.controls = true;
      modalVideo.autoplay = true;
      modalVideo.muted = false;
      modalVideo.playsInline = true;
      modalVideo.currentTime = 0;

      modalContentEl.innerHTML = '';
      modalContentEl.appendChild(modalVideo);
      modalEl.hidden = false;

      const playPromise = modalVideo.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          modalVideo.muted = true;
          modalVideo.play().catch(() => {});
        });
      }
    };

    const bindVideoPlay = () => {
      sectionEl.querySelectorAll('[data-video-play]').forEach((btn) => {
        if (btn.dataset.videoBound === 'true') return;
        btn.dataset.videoBound = 'true';

        btn.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();

          const mediaCard = this.closest('.jp-experts-swiper__media-card');
          if (!mediaCard) return;

          const video = mediaCard.querySelector('video');
          openVideoModal(video);
        });
      });

      sectionEl.querySelectorAll('[data-video-cover]').forEach((cover) => {
        if (cover.dataset.videoBound === 'true') return;
        cover.dataset.videoBound = 'true';

        cover.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();

          const mediaCard = this.closest('.jp-experts-swiper__media-card');
          if (!mediaCard) return;

          const video = mediaCard.querySelector('video');
          openVideoModal(video);
        });
      });

      sectionEl.querySelectorAll('.jp-experts-swiper__media-shape video').forEach((video) => {
        if (video.dataset.videoBound === 'true') return;
        video.dataset.videoBound = 'true';

        video.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          openVideoModal(this);
        });
      });

      sectionEl.querySelectorAll('[data-video-modal-close]').forEach((btn) => {
        if (btn.dataset.videoModalCloseBound === 'true') return;
        btn.dataset.videoModalCloseBound = 'true';

        btn.addEventListener('click', function (event) {
          event.preventDefault();
          closeVideoModal();
        });
      });
    };

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && modalEl && !modalEl.hidden) {
        closeVideoModal();
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initExpertsSwiper();
        bindVideoPlay();
      });
    } else {
      initExpertsSwiper();
      bindVideoPlay();
    }
 });
</script>

