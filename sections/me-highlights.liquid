{% comment %} Ulike ME: image-only product feature mosaic. {% endcomment %}
{%- assign sid = section.id -%}

<section id="me-highlights-{{ sid }}" class="me-highlights" style="--me-highlights-bg: {{ section.settings.background }};">
  <div class="me-highlights__inner">
    {% if section.settings.heading != blank %}
      <h2 class="me-highlights__heading to-top">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="me-highlights__grid">
      {% for block in section.blocks %}
        {%- assign bs = block.settings -%}
        {%- assign anchor_target = bs.anchor_id | strip | remove_first: '#' -%}
        <article
          class="me-highlights__card me-highlights__card--{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          {% if anchor_target != blank %}
            <a class="me-highlights__link" href="#{{ anchor_target | escape }}">
          {% endif %}
          {% if bs.image != blank or bs.image_mobile != blank %}
            {%- assign desktop_image = bs.image | default: bs.image_mobile -%}
            <picture>
              {% if bs.image_mobile != blank %}
                <source media="(max-width: 749px)" srcset="{{ bs.image_mobile | image_url: width: 1000 }}">
              {% endif %}
              {{ desktop_image | image_url: width: 1600 | image_tag: class: 'me-highlights__image', loading: 'lazy', widths: '360, 600, 900, 1200, 1600', sizes: '(max-width: 749px) 100vw, 35vw' }}
            </picture>
          {% else %}
            <div class="me-highlights__empty">画像を設定</div>
          {% endif %}
          {% if anchor_target != blank %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #me-highlights-{{ sid }} {
    background: var(--me-highlights-bg);
    padding: 98px 24px 120px;
  }

  #me-highlights-{{ sid }} .me-highlights__inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  #me-highlights-{{ sid }} .me-highlights__heading {
    margin: 0 0 72px;
    color: #000;
    text-align: center;
    font-size: 48px;
    font-weight: 500;
    line-height: 1.35;
  }

  #me-highlights-{{ sid }} .me-highlights__grid {
    --me-highlights-gap: 12px;
    --me-highlights-tile: min(330px, calc((100vw - 84px) / 4));
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, var(--me-highlights-tile));
    gap: var(--me-highlights-gap);
  }

  #me-highlights-{{ sid }} .me-highlights__card {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: #f1f6fc;
    border-radius: 10px;
    align-self: start;
  }

  #me-highlights-{{ sid }} .me-highlights__link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  #me-highlights-{{ sid }} .me-highlights__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  #me-highlights-{{ sid }} .me-highlights__card--1,
  #me-highlights-{{ sid }} .me-highlights__card--2,
  #me-highlights-{{ sid }} .me-highlights__card--4,
  #me-highlights-{{ sid }} .me-highlights__card--5 {
    aspect-ratio: 1 / 1;
  }

  #me-highlights-{{ sid }} .me-highlights__card--1 { grid-column: 1; grid-row: 1; }
  #me-highlights-{{ sid }} .me-highlights__card--2 { grid-column: 2; grid-row: 1; }
  #me-highlights-{{ sid }} .me-highlights__card--3 {
    grid-column: 3 / span 2;
    grid-row: 1;
    height: calc(var(--me-highlights-tile) * 1.22);
  }
  #me-highlights-{{ sid }} .me-highlights__card--4 { grid-column: 1; grid-row: 2; }
  #me-highlights-{{ sid }} .me-highlights__card--5 { grid-column: 2; grid-row: 2; }
  #me-highlights-{{ sid }} .me-highlights__card--6,
  #me-highlights-{{ sid }} .me-highlights__card--7 {
    grid-row: 2;
    margin-top: calc(var(--me-highlights-tile) * .23);
    aspect-ratio: 1.29 / 1;
  }
  #me-highlights-{{ sid }} .me-highlights__card--6 { grid-column: 3; }
  #me-highlights-{{ sid }} .me-highlights__card--7 { grid-column: 4; }

  #me-highlights-{{ sid }} .me-highlights__card picture,
  #me-highlights-{{ sid }} .me-highlights__image,
  #me-highlights-{{ sid }} .me-highlights__empty {
    display: block;
    width: 100%;
    height: 100%;
  }

  #me-highlights-{{ sid }} .me-highlights__image {
    object-fit: cover;
  }

  #me-highlights-{{ sid }} .me-highlights__empty {
    display: grid;
    min-height: 260px;
    place-items: center;
    color: #7194b4;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    #me-highlights-{{ sid }} {
      padding: 48px 28px 60px;
    }

    #me-highlights-{{ sid }} .me-highlights__heading {
      margin-bottom: 58px;
      font-size: 28px;
      line-height: 1.4;
    }

    #me-highlights-{{ sid }} .me-highlights__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      gap: 14px;
    }

    #me-highlights-{{ sid }} .me-highlights__card {
      grid-column: auto;
      grid-row: auto;
      height: auto;
      margin-top: 0;
      border-radius: 8px;
      aspect-ratio: 1 / 1;
    }

    #me-highlights-{{ sid }} .me-highlights__card--1,
    #me-highlights-{{ sid }} .me-highlights__card--6,
    #me-highlights-{{ sid }} .me-highlights__card--7 {
      grid-column: 1 / -1;
    }

    #me-highlights-{{ sid }} .me-highlights__card--1 { aspect-ratio: 1.12 / 1; }
    #me-highlights-{{ sid }} .me-highlights__card--2,
    #me-highlights-{{ sid }} .me-highlights__card--3 { aspect-ratio: .84 / 1; }
    #me-highlights-{{ sid }} .me-highlights__card--6 { aspect-ratio: 1.78 / 1; }
    #me-highlights-{{ sid }} .me-highlights__card--7 { aspect-ratio: 2.2 / 1; }

    #me-highlights-{{ sid }} .me-highlights__empty {
      min-height: 180px;
    }
  }
</style>

{% schema %}
{
  "name": "Ulike ME 产品特点拼图",
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Ulike MEの製品特徴" },
    { "type": "color", "id": "background", "label": "背景", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "产品特点图片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "PC 图片" },
        { "type": "image_picker", "id": "image_mobile", "label": "移动端图片" },
        { "type": "text", "id": "anchor_id", "label": "点击跳转锚点（可选）", "info": "填写目标元素的 ID，例如 features 或 #features；留空时图片不可点击。" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ulike 产品特点拼图",
      "blocks": [
        { "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
