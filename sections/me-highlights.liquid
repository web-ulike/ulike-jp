{% comment %} Ulike ME: six-card product feature grid. {% endcomment %}
{% assign sid = section.id %}

<section id="me-highlights-{{ sid }}" class="me-highlights" style="--me-bg: {{ section.settings.background }}; --me-accent: {{ section.settings.accent }};">
  <div class="me-highlights__inner">
    {% if section.settings.heading != blank %}<h2 class="me-highlights__heading">{{ section.settings.heading }}</h2>{% endif %}
    <div class="me-highlights__grid">
      {% for block in section.blocks %}
        <article class="me-highlights__card me-highlights__card--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <picture>
              {% if block.settings.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">{% endif %}
              {{ block.settings.image | image_url: width: 1400 | image_tag: class: 'me-highlights__image', loading: 'lazy', widths: '360, 600, 900, 1200, 1400' }}
            </picture>
          {% else %}
            <div class="me-highlights__empty">画像を設定</div>
          {% endif %}
          {% if block.settings.title != blank or block.settings.text != blank %}
            <div class="me-highlights__copy me-highlights__copy--{{ block.settings.copy_position }}">
              {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
              {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #me-highlights-{{ sid }} { background: var(--me-bg); padding: 110px 24px 120px; color: #111; }
  #me-highlights-{{ sid }} .me-highlights__inner { max-width: 1260px; margin: 0 auto; }
  #me-highlights-{{ sid }} .me-highlights__heading { margin: 0 0 55px; text-align: center; font-size: 42px; font-weight: 600; line-height: 1.35; }
  #me-highlights-{{ sid }} .me-highlights__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-template-rows: 260px 260px 310px; gap: 16px; }
  #me-highlights-{{ sid }} .me-highlights__card { position: relative; overflow: hidden; min-height: 0; background: #edf5fc; }
  #me-highlights-{{ sid }} .me-highlights__card--1 { grid-column: span 3; grid-row: span 2; }
  #me-highlights-{{ sid }} .me-highlights__card--2, #me-highlights-{{ sid }} .me-highlights__card--3 { grid-column: span 3; }
  #me-highlights-{{ sid }} .me-highlights__card--4, #me-highlights-{{ sid }} .me-highlights__card--5, #me-highlights-{{ sid }} .me-highlights__card--6 { grid-column: span 2; }
  #me-highlights-{{ sid }} .me-highlights__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  #me-highlights-{{ sid }} .me-highlights__empty { display: grid; width: 100%; height: 100%; min-height: 180px; place-items: center; color: #7194b4; font-size: 14px; }
  #me-highlights-{{ sid }} .me-highlights__copy { position: absolute; z-index: 1; max-width: 75%; padding: 30px; }
  #me-highlights-{{ sid }} .me-highlights__copy--top-left { top: 0; left: 0; text-align: left; }
  #me-highlights-{{ sid }} .me-highlights__copy--top-right { top: 0; right: 0; text-align: right; }
  #me-highlights-{{ sid }} .me-highlights__copy--bottom-left { bottom: 0; left: 0; text-align: left; }
  #me-highlights-{{ sid }} .me-highlights__copy--bottom-right { right: 0; bottom: 0; text-align: right; }
  #me-highlights-{{ sid }} .me-highlights__copy--center { inset: 50% auto auto 50%; width: 100%; max-width: 100%; transform: translate(-50%, -50%); text-align: center; }
  #me-highlights-{{ sid }} h3, #me-highlights-{{ sid }} p { margin: 0; font-weight: 600; line-height: 1.25; }
  #me-highlights-{{ sid }} h3 { font-size: 30px; } #me-highlights-{{ sid }} p { margin-top: 5px; font-size: 20px; color: var(--me-accent); }
  @media (max-width: 749px) {
    #me-highlights-{{ sid }} { padding: 43px 8px 46px; }
    #me-highlights-{{ sid }} .me-highlights__heading { margin-bottom: 25px; font-size: 18px; }
    #me-highlights-{{ sid }} .me-highlights__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto 150px 190px 145px; gap: 4px; }
    #me-highlights-{{ sid }} .me-highlights__card--1 { grid-column: 1 / -1; grid-row: 1; aspect-ratio: 1.45; }
    #me-highlights-{{ sid }} .me-highlights__card--2 { grid-column: 1; grid-row: 2; } #me-highlights-{{ sid }} .me-highlights__card--3 { grid-column: 2; grid-row: 2; }
    #me-highlights-{{ sid }} .me-highlights__card--4 { grid-column: 1 / -1; grid-row: 3; } #me-highlights-{{ sid }} .me-highlights__card--5 { grid-column: 1; grid-row: 4; } #me-highlights-{{ sid }} .me-highlights__card--6 { grid-column: 2; grid-row: 4; }
    #me-highlights-{{ sid }} .me-highlights__copy { max-width: 92%; padding: 13px; } #me-highlights-{{ sid }} h3 { font-size: 13px; } #me-highlights-{{ sid }} p { font-size: 12px; }
  }
</style>

{% schema %}
{"name":"Ulike ME 特长拼图","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"标题","default":"Ulike MEの製品特徴"},{"type":"color","id":"background","label":"背景","default":"#ffffff"},{"type":"color","id":"accent","label":"强调色","default":"#69b9f5"}],"blocks":[{"type":"feature","name":"特长卡片","settings":[{"type":"image_picker","id":"image","label":"PC 图片"},{"type":"image_picker","id":"image_mobile","label":"移动端图片"},{"type":"text","id":"title","label":"标题"},{"type":"text","id":"text","label":"说明"},{"type":"select","id":"copy_position","label":"文案位置","default":"top-left","options":[{"value":"top-left","label":"左上"},{"value":"top-right","label":"右上"},{"value":"bottom-left","label":"左下"},{"value":"bottom-right","label":"右下"},{"value":"center","label":"居中"}]}]}],"presets":[{"name":"Ulike ME 特长拼图","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"},{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]}
{% endschema %}
