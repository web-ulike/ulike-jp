{% liquid
  assign sid = section.id
  assign custom_class = section.settings.custom_class
%}

<section class="jp-home-hero jp-home-hero--{{ sid }}{% if custom_class != blank %} {{ custom_class | escape }}{% endif %}">
  <div class="jp-home-hero__inner">
    <div class="swiper jp-home-hero__swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% liquid
            assign pc_image = block.settings.image_pc
            assign mobile_image = block.settings.image_mobile
            assign title = block.settings.title
            assign subheading_logo = block.settings.subheading_logo
            assign desc = block.settings.desc
            assign button_text = block.settings.button_text
            assign button_link = block.settings.button_link
            assign info_text = block.settings.info_text
          %}
          <div class="swiper-slide jp-home-hero__item jp-home-hero__item{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="jp-home-hero__slide">
              <div class="jp-home-hero__media">
                {% if pc_image != blank or mobile_image != blank %}
                  <picture>
                    {% if mobile_image != blank %}
                      <source
                        media="(max-width: 989px)"
                        srcset="{{ mobile_image | image_url: width: 1200 }}"
                        width="{{ mobile_image.width }}"
                        height="{{ mobile_image.height }}"
                      >
                    {% elsif pc_image != blank %}
                      <source
                        media="(max-width: 989px)"
                        srcset="{{ pc_image | image_url: width: 1200 }}"
                        width="{{ pc_image.width }}"
                        height="{{ pc_image.height }}"
                      >
                    {% endif %}

                    {% if pc_image != blank %}
                      <img
                        class="jp-home-hero__image"
                        src="{{ pc_image | image_url }}"
                        alt="{{ mobile_image.alt | default: pc_image.alt | escape }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        width="{{ pc_image.width }}"
                        height="{{ pc_image.height }}"
                      >
                    {% elsif mobile_image != blank %}
                      <img
                        class="jp-home-hero__image"
                        src="{{ mobile_image | image_url: width: 1200 }}"
                        alt="{{ mobile_image.alt | escape }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        width="{{ mobile_image.width }}"
                        height="{{ mobile_image.height }}"
                      >
                    {% endif %}
                  </picture>
                {% endif %}
              </div>

              <div class="jp-home-hero__content-wrap">
                <div class="jp-container">
                  <div class="jp-home-hero__content-inner">
                    <div class="jp-home-hero__content">
                      {% if block.settings.subheading != blank or subheading_logo != blank %}
                        <div class="jp-home-hero__subheading-wrap">
                          {% if block.settings.subheading != blank %}
                            <div class="jp-home-hero__subheading">
                              <span class="jp-home-hero__subheading-text">{{ block.settings.subheading }}</span>
                            </div>
                          {% endif %}
                          {% if subheading_logo != blank %}
                            <img
                              class="jp-home-hero__subheading-logo"
                              src="{{ subheading_logo | image_url: width: 160 }}"
                              alt="{{ subheading_logo.alt | default: block.settings.subheading | escape }}"
                              loading="lazy"
                              width="{{ subheading_logo.width }}"
                              height="{{ subheading_logo.height }}"
                            >
                          {% endif %}
                        
                        </div>
                      {% endif %}

                      {% if title != blank %}
                        <div class="jp-home-hero__title rte">{{ title }}</div>
                      {% endif %}

                      {% if desc != blank %}
                        <div class="jp-home-hero__desc">{{ desc }}</div>
                      {% endif %}

                      {% if button_text != blank %}
                        <div class="jp-home-hero__buttons">
                          <a
                            class="jp-home-hero__btn jp-home-hero__btn--primary"
                            href="{{ button_link | default: '#' }}"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {{ button_text }}
                          </a>
                        </div>
                      {% endif %}

                    </div>

                  </div>
                </div>
              </div>

              {% if info_text != blank %}
                <div class="jp-home-hero__info-wrap">
                  <div class="jp-container">
                    <div class="jp-home-hero__info">
                      {{ info_text }}
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.show_pagination %}
        <div class="jp-home-hero__pagination swiper-pagination" aria-label="Slider pagination"></div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .jp-home-hero--{{ sid }} {
    --jp-home-hero-text-color: #000;
    --jp-home-hero-accent-color: #e51f6e;
    --jp-home-hero-primary-btn-bg: #000;
    --jp-home-hero-primary-btn-color: #ffffff;
    --jp-home-hero-secondary-btn-color: #000;
    --jp-home-hero-secondary-btn-border: #000;
    position: relative;
    overflow: hidden;
    background: #f6f4f5;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__inner,
  .jp-home-hero--{{ sid }} .jp-home-hero__swiper,
  .jp-home-hero--{{ sid }} .swiper-wrapper,
  .jp-home-hero--{{ sid }} .swiper-slide,
  .jp-home-hero--{{ sid }} .jp-home-hero__slide {
    position: relative;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__slide {
    position: relative;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__media {
    position: relative;
    z-index: 1;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__content-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 0;
    pointer-events: none;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__content-wrap > .jp-container {
    height: 100%;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__content-inner {
    position: relative;
    top: 22%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__content-wrap > .jp-container,
  .jp-home-hero--{{ sid }} .jp-home-hero__content,
  .jp-home-hero--{{ sid }} .jp-home-hero__btn,
  .jp-home-hero--{{ sid }} .jp-home-hero__info-wrap .jp-container,
  .jp-home-hero--{{ sid }} .jp-home-hero__info {
    pointer-events: auto;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__content {
    max-width: 850px;
    color: var(--jp-home-hero-text-color);
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__subheading-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__subheading {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 4px 10px;
    background: linear-gradient(290deg, #E0004D 12.6%, #FF7595 49.59%, #E0004D 85.57%);
    color: #FFF;
    font-size: 14px;
    line-height: 1;
    letter-spacing: .04em;
    margin-bottom: 15px;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__subheading-logo {
    display: block;
    width: auto;
    height: 106px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__subheading-text {
    display: inline-block;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__title {
    margin: 0;
    font-size: 60px;
    line-height: 1.2;
    font-weight: 500;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__title > *:first-child {
    margin-top: 0;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__title > *:last-child {
    margin-bottom: 0;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__title p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    font-weight: inherit;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__desc {
    margin-top: 20px;
    font-size: 24px;
    line-height: 1.3;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 50px;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
    min-height: 46px;
    padding: 12px 22px;
    text-decoration: none;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1;
    transition: all .25s ease;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__btn--primary {
    background: var(--jp-home-hero-primary-btn-bg);
    color: var(--jp-home-hero-primary-btn-color);
    border: 1px solid var(--jp-home-hero-primary-btn-bg);
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__btn--primary:hover {
    opacity: .88;
  }


  .jp-home-hero--{{ sid }} .jp-home-hero__info-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 30px;
    z-index: 3;
    pointer-events: none;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__info {
    max-width: 550px;
    margin: 0;
    font-size: 8px;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.50);
  }


  .jp-home-hero--{{ sid }} .jp-home-hero__pagination {
    position: absolute;
    left: 50%;
    bottom: 40px;
    transform: translateX(-50%);
    z-index: 3;
    width: max-content;
    min-height: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    line-height: 0;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__pagination.swiper-pagination-lock {
    display: none;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__pagination:empty {
    display: none;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__pagination .swiper-pagination-bullet {
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin: 0 30px 0 0 !important;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: #7a7a7a;
    opacity: 1;
    cursor: pointer;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    transition: all .25s ease;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__pagination .swiper-pagination-bullet:last-child {
    margin-right: 0 !important;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__pagination .swiper-pagination-bullet-active {
    width: 22px;
    height: 22px;
    margin-top: -7px !important;
    margin-bottom: -7px !important;
    background: transparent;
    border: 2px solid #000;
  }

  .jp-home-hero--{{ sid }} .jp-home-hero__pagination .swiper-pagination-bullet-active::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #000;
    transform: translate(-50%, -50%);
  }


  {% comment %} 自定义class名称 {% endcomment %}
  .jp-home-hero__item1 .jp-home-hero__title{
    display: none;
  }
  .jp-home-hero__item1 .jp-home-hero__subheading-wrap {
    display: block;
  }

  .jp-home-hero__item2 .jp-home-hero__title,
  .jp-home-hero__item2 .jp-home-hero__desc,
  .jp-home-hero__item3 .jp-home-hero__title {
    font-size: 55px;
    font-weight: 500;
    margin-top: 0px;
  }
  
  .jp-home-hero__item2 .jp-home-hero__title span{
    font-weight: bold;
    font-size: 24px;
    vertical-align: top;
    line-height: 1;
    padding-top: 10px;
    display: inline-block;
  }

  .jp-home-hero__item3 .jp-home-hero__content {
    color: #fff;
  }
  .jp-home-hero__item3 .jp-home-hero__btn--primary{
    background: var(--jp-home-hero-primary-btn-color);
    color: var(--jp-home-hero-text-color);
    border: 1px solid var(--jp-home-hero-primary-btn-color);
  }
  .jp-home-hero__item3 .jp-home-hero__info{
    color: rgba(255, 255, 255, 0.50);
  }
  .jp-home-hero__item2 .jp-home-hero__subheading-wrap{
    margin-bottom: 0px;
  }
  .jp-home-hero__item3 .jp-home-hero__subheading-wrap { 
    margin-bottom: 48px;
  }


  @media screen and (max-width: 989px) {
    .jp-home-hero--{{ sid }} .jp-home-hero__slide {
   
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__subheading-wrap {
      gap: 6px;
      margin-bottom: 14px;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__subheading {
      padding: 4px 15px;
      font-size: 10px;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__subheading-logo {
      height: 40px;
    }
    .jp-home-hero--{{ sid }} .jp-home-hero__info-wrap {
      bottom: 15px;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__info {
      max-width: none;
      margin: 0;
      text-align: left;
    }
    .jp-home-hero--{{ sid }} .jp-home-hero__content-wrap {
      inset: 0;
      padding: 0;
      text-align: center;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__content-inner {
      top: 5%;
      align-items: flex-start;
      justify-content: center;
      gap: 20px;
      padding-top: 0;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__content {
      padding-top: 10px;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__title {
      font-size: 28px;
      line-height: 1.3;
      width: 100%;
      margin: 0 auto;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__desc {
      margin-top: 10px;
      font-size: 14px;
      line-height: 1.4;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__buttons {
      margin-top: 20px;
      gap: 10px;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__btn {
      padding: 10px 16px;
      font-size: 12px;
      margin: 0 auto;
      min-height: 38px;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__pagination {
      bottom: 80px;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__pagination .swiper-pagination-bullet {
      width: 6px;
      height: 6px;
      margin: 0 24px 0 0 !important;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__pagination .swiper-pagination-bullet-active {
      width: 18px;
      height: 18px;
      margin-top: -6px !important;
      margin-bottom: -6px !important;
    }

    .jp-home-hero--{{ sid }} .jp-home-hero__pagination .swiper-pagination-bullet-active::after {
      width: 6px;
      height: 6px;
    }

    {% comment %} 自定义移动端样式 {% endcomment %}
    .jp-home-hero__item1 .jp-home-hero__title{
      display: block;
    }
    .jp-home-hero__item1 .jp-home-hero__subheading-logo {
       display: none;
    }

    .jp-home-hero__item2 .jp-home-hero__title{
      font-size: 20px;
      font-weight: 400;
    }
    .jp-home-hero__item2 .jp-home-hero__title span{
      font-size: 14px;
      padding-top: 2px;
    }

    .jp-home-hero__item2 .jp-home-hero__desc{
      font-size: 30px;
    }
    .jp-home-hero__item2 .jp-home-hero__subheading-wrap{
      margin-bottom: 0px;
    }
    .jp-home-hero__item3 .jp-home-hero__subheading-wrap{
      margin-bottom: 20px;
    }

    .jp-home-hero__item3 .jp-home-hero__desc{
      font-size: 16px;
    }


  }
</style>

<script>
  (() => {
    const sectionEl = document.querySelector('.jp-home-hero--{{ sid }}');
    if (!sectionEl) return;

    let initTimer = null;

    const buildSwiper = () => {
      const swiperEl = sectionEl.querySelector('.jp-home-hero__swiper');

      if (!swiperEl || typeof window.Swiper === 'undefined') return false;

      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }

      new window.Swiper(swiperEl, {
        loop: {{ section.settings.enable_loop | json }},
        speed: {{ section.settings.speed }},
        effect: 'slide',
        autoHeight: false,
        observer: true,
        observeParents: true,
        watchOverflow: true,
        {% if section.settings.enable_autoplay %}
        autoplay: {
          delay: {{ section.settings.autoplay_delay }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        {% endif %}
        pagination: {
          el: sectionEl.querySelector('.jp-home-hero__pagination'),
          type: 'bullets',
          clickable: true
        }
      });

      return true;
    };

    const initHeroSwiper = () => {
      if (buildSwiper()) return;

      let retryCount = 0;
      clearInterval(initTimer);
      initTimer = setInterval(() => {
        retryCount += 1;
        if (buildSwiper() || retryCount >= 40) {
          clearInterval(initTimer);
        }
      }, 150);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSwiper);
    } else {
      initHeroSwiper();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.contains(sectionEl)) {
        initHeroSwiper();
      }
    });

    document.addEventListener('shopify:block:select', function (event) {
      if (event.target && event.target.closest('.jp-home-hero--{{ sid }}')) {
        initHeroSwiper();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "JP Home Hero Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class name"
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Enable loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 5000
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Transition speed",
      "min": 300,
      "max": 1500,
      "step": 100,
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Pagination bullets are shown automatically when multiple slides exist."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_pc",
          "label": "PC image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "image_picker",
          "id": "subheading_logo",
          "label": "Subheading logo"
        },
        {
          "type": "html",
          "id": "title",
          "label": "Title",
          "default": "<p>我が家の光美容器<br>効果も、やさしさも</p>"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Primary button text",
          "default": "詳しく見る"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary button link"
        },
        {
          "type": "textarea",
          "id": "info_text",
          "label": "Info text",
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Home Hero Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}