      "default": "10"
    },
    {
      "type": "text",
      "id": "stat_2_unit",
      "label": "Stat 2 unit",
      "default": "+"
    },
    {
      "type": "text",
      "id": "stat_2_text",
      "label": "Stat 2 text",
      "default": "10年以上の研究"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 number",
      "default": "800"
    },
    {
      "type": "text",
      "id": "stat_3_unit",
      "label": "Stat 3 unit",
