{%- liquid
  assign section_id = 'jp-men-skin-sensor-2026-' | append: section.id
  assign default_title = 'スキンセンサー搭載'
  assign default_body = '小麦色に日焼けした肌や敏感な部位も含め、微妙な肌色の変化や部位による違いも瞬時に検知しリアルタイムで分析。最大10段階*のパワーレベルから細やかな出力調整を自動で行います。'
  assign default_note = '*Highモードでは10段階、Normalモードでは6段階の出力調整を自動で行います。'
-%}

<section id="{{ section_id }}" class="jp-men-skin-sensor-2026">
  <div class="jp-men-skin-sensor-2026__inner container">
    <div class="jp-men-skin-sensor-2026__copy">
      <h2 class="jp-men-skin-sensor-2026__title to-top">{{ section.settings.title | default: default_title }}</h2>
      <p class="jp-men-skin-sensor-2026__body to-top" style="transition-delay: .1s">
        {{ section.settings.body | default: default_body }}
      </p>
      <p class="jp-men-skin-sensor-2026__note jp-men-skin-sensor-2026__note--desktop">{{ section.settings.note | default: default_note | escape }}</p>
    </div>
    <div class="jp-men-skin-sensor-2026__media">
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1800 }}">
        {%- endif -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'jp-men-skin-sensor-2026__image',
              loading: 'lazy',
              widths: '750, 1000, 1360, 1600',
              alt: section.settings.image.alt
            | default: section.settings.title
          }}
        {%- elsif section.settings.image_mobile != blank -%}
          {{
            section.settings.image_mobile
            | image_url: width: 1800
            | image_tag:
              class: 'jp-men-skin-sensor-2026__image',
              loading: 'lazy',
              widths: '750, 1100, 1500, 1800',
              alt: section.settings.image_mobile.alt
            | default: section.settings.title
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'jp-men-skin-sensor-2026__placeholder' }}
        {%- endif -%}
      </picture>
      <p class="jp-men-skin-sensor-2026__note jp-men-skin-sensor-2026__note--mobile">{{ section.settings.note | default: default_note | escape }}</p>
    </div>
  </div>
</section>

<style>
  #{{ section_id }} { background: {{ section.settings.background | default: '#f7f8fa' }}; color: {{ section.settings.text_color | default: '#000000' }}; margin-top: {{ section.settings.margin_top | default: 0 }}px; margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px; overflow: hidden; }
  #{{ section_id }} .jp-men-skin-sensor-2026__inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #{{ section_id }} .jp-men-skin-sensor-2026__copy { align-self: stretch; grid-column: 1; grid-row: 1; padding: 15.92% 9.2% 12%; position: relative; }
  #{{ section_id }} .jp-men-skin-sensor-2026__title { 
    color: inherit; 
    font-size: 45px; font-weight: 500; line-height: 1.2; margin: 0; }
  #{{ section_id }} .jp-men-skin-sensor-2026__body { color: inherit; 
     font-size: 23px; font-weight: 400; line-height: 1.4; margin: 8.65% 0 0; }
  #{{ section_id }} .jp-men-skin-sensor-2026__media { background: {{ section.settings.media_background | default: '#ffffff' }}; grid-column: 2; grid-row: 1; position: relative; }
  #{{ section_id }} .jp-men-skin-sensor-2026__media picture { display: block; }
  #{{ section_id }} .jp-men-skin-sensor-2026__image, #{{ section_id }} .jp-men-skin-sensor-2026__placeholder { display: block; height: auto; width: 100%; }
  #{{ section_id }} .jp-men-skin-sensor-2026__placeholder { aspect-ratio: 1360 / 1023; fill: #d5d7da; }
  #{{ section_id }} .jp-men-skin-sensor-2026__note { font-family: inherit; line-height: 1.3; margin: 0; position: absolute; }
  #{{ section_id }} .jp-men-skin-sensor-2026__note--desktop { bottom: 6.6%; color: rgba(0, 0, 0, .5); font-size: min(.9809vw, 13.34px); left: 9.2%; white-space: nowrap; }
  #{{ section_id }} .jp-men-skin-sensor-2026__note--mobile { display: none; }
  @media screen and (max-width: 749px) {
    #{{ section_id }} { margin-top: {{ section.settings.mobile_margin_top | default: 0 }}px; margin-bottom: {{ section.settings.mobile_margin_bottom | default: 0 }}px; }
    #{{ section_id }} .jp-men-skin-sensor-2026__inner { display: flex; flex-direction: column; }
    #{{ section_id }} .jp-men-skin-sensor-2026__copy { align-self: auto; order: 1; padding: 11.78% 5.312% 8.9%; width: 100%; }
    #{{ section_id }} .jp-men-skin-sensor-2026__title { font-size: 5.773672vw; line-height: 1.2; }
    #{{ section_id }} .jp-men-skin-sensor-2026__body { font-size: 3.579677vw; line-height: 1.4; margin-top: 7.15%; text-align: justify; }
    #{{ section_id }} .jp-men-skin-sensor-2026__media { order: 2; width: 100%; }
    #{{ section_id }} .jp-men-skin-sensor-2026__placeholder { aspect-ratio: 1732 / 1158; }
    #{{ section_id }} .jp-men-skin-sensor-2026__note--desktop { display: none; }
    #{{ section_id }} .jp-men-skin-sensor-2026__note--mobile { bottom: .88%; color: {{ section.settings.note_color | default: '#ffffff' | color_modify: 'alpha', 0.5 }}; display: block; font-size: min(1.5405vw, 13.34px); left: 5.5427%; right: auto; white-space: nowrap; z-index: 1; }
  }
</style>

{% schema %}
{
  "name": "jp-men-skin-sensor-2026",
  "settings": [
    { "type": "header", "content": "外边距" },
    { "type": "range", "id": "margin_top", "label": "PC 上边距", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "PC 下边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_top", "label": "M 上边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_bottom", "label": "M 下边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "text", "id": "title", "label": "标题", "default": "スキンセンサー搭載" },
    {
      "type": "textarea",
      "id": "body",
      "label": "说明文案",
      "default": "小麦色に日焼けした肌や敏感な部位も含め、微妙な肌色の変化や部位による違いも瞬時に検知しリアルタイムで分析。最大10段階*のパワーレベルから細やかな出力調整を自動で行います。"
    },
    { "type": "image_picker", "id": "image", "label": "PC 完整识别图（建议 1360 × 1023）" },
    { "type": "image_picker", "id": "image_mobile", "label": "M 完整识别图（建议 1732 × 1158）" },
    {
      "type": "textarea",
      "id": "note",
      "label": "脚注",
      "default": "*Highモードでは10段階、Normalモードでは6段階の出力調整を自動で行います。"
    },
    { "type": "color", "id": "background", "label": "文案区背景色", "default": "#F7F8FA" },
    { "type": "color", "id": "media_background", "label": "图片区背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#000000" },
    { "type": "color", "id": "note_color", "label": "M 脚注颜色", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "jp-men-skin-sensor-2026" }]
}
{% endschema %}
