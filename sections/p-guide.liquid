{% assign sid = section.id %}

<style>
  #p-guide-{{ sid }} { padding: 100px 0;
    background: var(--p-guide-bg); 
    color: #000;
  }
  #p-guide-{{ sid }} .p-aps-guide__in { margin: 0 auto; }
  #p-guide-{{ sid }} .p-aps-guide__head {
    margin: 0 0 48px; font-size: 48px; font-weight: 500; line-height: 1.35; }
  #p-guide-{{ sid }} .p-aps-guide__grid { display: grid;
     grid-template-columns: repeat(4, minmax(0, 1fr));
     gap: 40px; }
  #p-guide-{{ sid }} .p-aps-guide__step { min-width: 0; }
  #p-guide-{{ sid }} .p-aps-guide__num {
     margin: 0 0 10px;
     font-size: 24px;
     font-weight: 500;
  }
  #p-guide-{{ sid }} .p-aps-guide__img { display: block; width: 100%;  }
  #p-guide-{{ sid }} .p-aps-guide__ttl { margin: 20px 0 0; font-size: 32px; font-weight: 500; line-height: 1.3; }
  #p-guide-{{ sid }} .p-aps-guide__text { 
    margin: 10px 0 0;
    font-size: 17px;
    line-height: 1.5;
    min-height: 130px; 
  }
  #p-guide-{{ sid }} .p-aps-guide__note { margin: 15px 0 0; color: rgba(0, 0, 0, 0.70);
    font-size: 14px; line-height: 1.5; }

  @media screen and (max-width: 749px) {
    #p-guide-{{ sid }} { padding: 40px 0; }
    #p-guide-{{ sid }} > .jp-container { padding-right: 16px; padding-left: 16px; }
    #p-guide-{{ sid }} .p-aps-guide__head { margin-bottom: 32px; text-align: center; font-size: 25px; line-height: 1.4; }
    #p-guide-{{ sid }} .p-aps-guide__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
    #p-guide-{{ sid }} .p-aps-guide__num { margin-bottom: 7px; font-size: 10px; line-height: 1.2; }
    #p-guide-{{ sid }} .p-aps-guide__img { aspect-ratio: 1.4; object-fit: cover; }
    #p-guide-{{ sid }} .p-aps-guide__ttl { margin-top: 9px; font-size: 13px; line-height: 1.35; }
    #p-guide-{{ sid }} .p-aps-guide__text { min-height: 0; margin-top: 5px; font-size: 8px; line-height: 1.5; }
    #p-guide-{{ sid }} .p-aps-guide__note { margin-top: 20px; font-size: 6px; }
  }
</style>

<section
  id="p-guide-{{ sid }}"
  class="p-aps-guide"
  style="--p-guide-bg: {{ section.settings.background }}; --p-guide-text: {{ section.settings.text_color }};"
>
  <div class="jp-container">
    <div class="p-aps-guide__in">
      {% if section.settings.heading != blank %}
        <h2 class="p-aps-guide__head to-top">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="p-aps-guide__grid">
        {% for block in section.blocks %}
          <article
            class="p-aps-guide__step to-top"
            style="transition-delay: .{{ forloop.index }}s"
            {{ block.shopify_attributes }}
          >
            <p class="p-aps-guide__num">STEP {{ forloop.index }}</p>
            {% if block.settings.image != blank -%}
              {{-
                block.settings.image
                | image_url: width: 700
                | image_tag: class: 'p-aps-guide__img', loading: 'lazy', widths: '200, 400, 700'
              -}}
            {%- endif %}
            {% if block.settings.title != blank %}
              <h3 class="p-aps-guide__ttl">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="p-aps-guide__text">{{ block.settings.text }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
      {% if section.settings.note != blank %}
        <p class="p-aps-guide__note to-top" style="transition-delay: .5s">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "P Air Pro S 使用方法",
  "max_blocks": 4,
  "settings": [
    { "type": "html", "id": "heading", "label": "标题", "default": "つるすべ肌への正しい使い方" },
    { "type": "textarea", "id": "note", "label": "脚注" },
    { "type": "color", "id": "background", "label": "背景色", "default": "#f7f7f7" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "使用步骤",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "title", "label": "标题", "default": "シェービング" },
        { "type": "textarea", "id": "text", "label": "说明" }
      ]
    }
  ],
  "presets": [
    {
      "name": "P Air Pro S 使用方法",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "title": "テスト" } },
        { "type": "step", "settings": { "title": "ムダ毛ケア" } },
        { "type": "step", "settings": { "title": "潤す＆紫外線対策" } }
      ]
    }
  ]
}
{% endschema %}
