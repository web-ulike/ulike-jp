{% assign sid = section.id %}<section id="me-lightweight-{{ sid }}" class="me-lightweight" style="--bg:{{ section.settings.background }}">{% if section.settings.image != blank %}<div class="me-lightweight__pc-image">{{ section.settings.image | image_url: width:2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400' }}</div>{% endif %}<div class="me-lightweight__copy"><div class="me-lightweight__pc">{{ section.settings.title_html }}{{ section.settings.copy_html }}</div><div class="me-lightweight__mobile">{{ section.settings.title_html_mobile }}{{ section.settings.copy_html_mobile }}</div></div><div class="me-lightweight__mobile-media">{% if section.settings.mobile_balance_image != blank %}{{ section.settings.mobile_balance_image | image_url: width:800 | image_tag: loading: 'lazy', widths: '360, 560, 800' }}{% endif %}{% if section.settings.mobile_product_image != blank %}{{ section.settings.mobile_product_image | image_url: width:800 | image_tag: loading: 'lazy', widths: '360, 560, 800' }}{% endif %}</div></section><style>#me-lightweight-{{ sid }}{position:relative;min-height:720px;overflow:hidden;background:var(--bg)}#me-lightweight-{{ sid }} .me-lightweight__pc-image{position:absolute;inset:0}#me-lightweight-{{ sid }} .me-lightweight__pc-image img{display:block;width:100%;height:100%;object-fit:cover}#me-lightweight-{{ sid }} .me-lightweight__copy{position:relative;z-index:1;width:min(500px,35vw);padding-top:140px;margin:auto;color:#111}#me-lightweight-{{ sid }} h2,#me-lightweight-{{ sid }} h3{margin:0;font-size:40px;line-height:1.28}#me-lightweight-{{ sid }} p{margin:24px 0 0;font-size:12px;line-height:1.8}#me-lightweight-{{ sid }} .me-lightweight__mobile,#me-lightweight-{{ sid }} .me-lightweight__mobile-media{display:none}@media(max-width:749px){#me-lightweight-{{ sid }}{min-height:0}#me-lightweight-{{ sid }} .me-lightweight__pc-image,#me-lightweight-{{ sid }} .me-lightweight__pc{display:none}#me-lightweight-{{ sid }} .me-lightweight__copy{width:auto;padding:38px 16px 22px;margin:0}#me-lightweight-{{ sid }} .me-lightweight__mobile{display:block}#me-lightweight-{{ sid }} h2,#me-lightweight-{{ sid }} h3{font-size:23px}#me-lightweight-{{ sid }} p{margin-top:14px;font-size:12px;line-height:1.7}#me-lightweight-{{ sid }} .me-lightweight__mobile-media{display:block}#me-lightweight-{{ sid }} .me-lightweight__mobile-media img{display:block;width:100%;height:auto}}
  #me-lightweight-{{ sid }} .me-lightweight__pc > :first-child{margin:0;font-size:48px;font-weight:500;line-height:1.4;letter-spacing:-.035em}#me-lightweight-{{ sid }} .me-lightweight__pc > :not(:first-child){margin:24px 0 0;font-size:14px;line-height:1.65}@media(max-width:749px){#me-lightweight-{{ sid }} .me-lightweight__mobile > :first-child{margin:0;font-size:30px;font-weight:600;line-height:1.4}#me-lightweight-{{ sid }} .me-lightweight__mobile > :not(:first-child){margin:14px 0 0;font-size:13px;line-height:1.65}}
</style>
{% schema %}{"name":"Ulike ME 轻量设计模块","settings":[{"type":"image_picker","id":"image","label":"PC 背景图"},{"type":"html","id":"title_html","label":"PC 标题（HTML）"},{"type":"html","id":"copy_html","label":"PC 描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"copy_html_mobile","label":"移动端描述（HTML）"},{"type":"image_picker","id":"mobile_balance_image","label":"移动端天平图片"},{"type":"image_picker","id":"mobile_product_image","label":"移动端产品图片"},{"type":"color","id":"background","label":"背景","default":"#eef6ff"}],"presets":[{"name":"Ulike ME 轻量设计模块"}]}{% endschema %}
