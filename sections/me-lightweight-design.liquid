{%- liquid
  assign sid = section.id
  assign st = section.settings
  assign mobile_image = st.image_mobile | default: st.mobile_balance_image | default: st.mobile_product_image

  capture default_desktop_title
    echo '<p>「重くて使いにくい…」を、この軽さが<br><span style="color:#75B5ED;">変える</span></p>'
  endcapture
  capture default_mobile_title
    echo '<p>「重くて使いにくい…」を、<br>この軽さが<span style="color:#75B5ED;">変える</span></p>'
  endcapture
  capture default_body
    echo '<p>「重くて腕が疲れてしまう」「ずっしり重くて続かない」――そんなおうちケアの負担をなくすために、Ulike Meは軽量化を追求。</p><p>実測わずか287gという軽さは、リンゴ1個よりも軽量。<span style="background:#75B5ED;color:#fff;">片手で使えて</span>、長時間のケアでも手首への負担になりません。</p><p>さらに、コンパクトなボディは、バッグにもスッキリ収納可能。<span style="background:#75B5ED;color:#fff;">旅行や帰省先にも気軽に持ち運べます。</span>この軽さだからこそ、毎日のルーティンをもっと楽に、気軽に実現。</p>'
  endcapture
  capture default_weight_title
    echo '<p>リンゴ1個よりも軽い</p>'
  endcapture
-%}

<section id="me-lightweight-{{ sid }}" class="me-lightweight" style="--me-lightweight-bg: {{ st.background }};">
  {% if st.image != blank %}
    <div class="me-lightweight__desktop-image">
      {{ st.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400', sizes: '100vw' }}
    </div>
  {% endif %}

  <div class="me-lightweight__desktop-copy">
    {{ st.title_html | default: default_desktop_title | replace_first: '<p', '<p class="to-top"' }}
    <div class="me-lightweight__body to-top" style="transition-delay: 0.2s">{{ st.body_html | default: default_body }}</div>
  </div>

  <div class="me-lightweight__mobile-content">
    {% if mobile_image != blank %}
      <picture class="me-lightweight__mobile-image">
        {{ mobile_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 750, 1000, 1200', sizes: '100vw' }}
      </picture>
    {% endif %}

    <div class="me-lightweight__mobile-copy">
      {{ st.title_html_mobile | default: st.title_html | default: default_mobile_title | replace_first: '<p', '<p class="to-top"' }}
      <div class="me-lightweight__body to-top" style="transition-delay: 0.2s">{{ st.body_html_mobile | default: st.body_html | default: default_body }}</div>
    </div>
  </div>
</section>

<style>
  #me-lightweight-{{ sid }} {
    position: relative;
    min-height: 1000px;
    overflow: hidden;
    background: var(--me-lightweight-bg);
    color: #000;
  }

  #me-lightweight-{{ sid }} .me-lightweight__desktop-image {
    position: absolute;
    inset: 0;
  }

  #me-lightweight-{{ sid }} .me-lightweight__desktop-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #me-lightweight-{{ sid }} .me-lightweight__desktop-copy {
    position: relative;
    z-index: 1;
    width: 928px;
    margin-left: clamp(38%, 39.3vw, 41%);
    padding-top: 6.5vw;
  }

  #me-lightweight-{{ sid }} .me-lightweight__desktop-copy > :first-child,
  #me-lightweight-{{ sid }} .me-lightweight__mobile-copy > :first-child {
    margin: 0;
    font-size: 48px;
    font-weight: 500;
    line-height: 1.4;
  }

  #me-lightweight-{{ sid }} .me-lightweight__body {
    margin-top: 70px;
    font-size: 14px;
    line-height: 1.5;
    max-width: 450px;
  }

  #me-lightweight-{{ sid }} .me-lightweight__body p + p {
    margin-top: 20px;
  }

  #me-lightweight-{{ sid }} .me-lightweight__mobile-content {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #me-lightweight-{{ sid }} {
      min-height: 0;
    }

    #me-lightweight-{{ sid }} .me-lightweight__desktop-image,
    #me-lightweight-{{ sid }} .me-lightweight__desktop-copy {
      display: none;
    }

    #me-lightweight-{{ sid }} .me-lightweight__mobile-content {
      display: block;
      position: relative;
      min-height: 1000px;
    }

    #me-lightweight-{{ sid }} .me-lightweight__mobile-copy {
      position: absolute;
      z-index: 1;
      top: 55px;
      left: 0;
      width: 100%;
      padding: 0px 20px;
    }

    #me-lightweight-{{ sid }} .me-lightweight__mobile-copy > :first-child {
      font-size: clamp(26px, calc(5vw + 8px), 30px);
      line-height: 1.4;
    }

    #me-lightweight-{{ sid }} .me-lightweight__mobile-copy .me-lightweight__body {
      margin-top: 25px;
      font-size: 14px;
    }

    #me-lightweight-{{ sid }} .me-lightweight__mobile-copy .me-lightweight__body p + p {
      margin-top: 20px;
    }

    #me-lightweight-{{ sid }} .me-lightweight__mobile-image,
    #me-lightweight-{{ sid }} .me-lightweight__mobile-image img {
      display: block;
      width: 100%;
      height: auto;
    }

    #me-lightweight-{{ sid }} .me-lightweight__mobile-image + .me-lightweight__mobile-copy {
      min-height: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Ulike 轻量设计模块",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "PC 背景图" },
    { "type": "image_picker", "id": "image_mobile", "label": "移动端底图（含天平、重量与产品画面）" },
    { "type": "html", "id": "title_html", "label": "PC 标题（HTML）", "default": "<p>「重くて使いにくい…」を、この軽さが<br><span style=\"color:#75B5ED;\">変える</span></p>" },
    { "type": "html", "id": "body_html", "label": "PC 正文（HTML）", "default": "<p>「重くて腕が疲れてしまう」「ずっしり重くて続かない」――そんなおうちケアの負担をなくすために、Ulike Meは軽量化を追求。</p><p>実測わずか287gという軽さは、リンゴ1個よりも軽量。<span style=\"background:#75B5ED;color:#fff;\">片手で使えて</span>、長時間のケアでも手首への負担になりません。</p><p>さらに、コンパクトなボディは、バッグにもスッキリ収納可能。<span style=\"background:#75B5ED;color:#fff;\">旅行や帰省先にも気軽に持ち運べます。</span>この軽さだからこそ、毎日のルーティンをもっと楽に、気軽に実現。</p>" },
    { "type": "html", "id": "title_html_mobile", "label": "移动端标题（HTML）", "default": "<p>「重くて使いにくい…」を、<br>この軽さが<span style=\"color:#75B5ED;\">変える</span></p>" },
    { "type": "html", "id": "body_html_mobile", "label": "移动端正文（HTML）", "default": "<p>「重くて腕が疲れてしまう」「ずっしり重くて続かない」――そんなおうちケアの負担をなくすために、Ulike Meは軽量化を追求。</p><p>実測わずか287gという軽さは、リンゴ1個よりも軽量。<span style=\"background:#75B5ED;color:#fff;\">片手で使えて</span>、長時間のケアでも手首への負担になりません。</p><p>さらに、コンパクトなボディは、バッグにもスッキリ収納可能。<span style=\"background:#75B5ED;color:#fff;\">旅行や帰省先にも気軽に持ち運べます。</span>この軽さだからこそ、毎日のルーティンをもっと楽に、気軽に実現。</p>" },
    { "type": "image_picker", "id": "mobile_balance_image", "label": "移动端天平图片" },
    { "type": "html", "id": "weight_html", "label": "重量说明（HTML）", "default": "<p>リンゴ1個よりも軽い</p>" },
    { "type": "image_picker", "id": "weight_image", "label": "重量圆形标识图片" },
    { "type": "image_picker", "id": "mobile_product_image", "label": "移动端产品图片" },
    { "type": "color", "id": "background", "label": "背景", "default": "#e9f2fc" }
  ],
  "presets": [{ "name": "Ulike 轻量设计模块" }]
}
{% endschema %}
