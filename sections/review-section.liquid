<style>
     #shopify-section-{{ section.id }} {
      --section-background: {{ section.settings.background }};
       background: var(--section-background);
   }
.media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px);
  }
}
/* .review-section start */
.review-section{
}
.review-section .review-wrapper{
  display: flex;
  gap: 110px;
  align-items: center;
}
.review__content-wrapper h4{
  color: #000;
font-size: 50px;
font-style: normal;
font-weight: 400;
line-height: 1.3;
margin-bottom: 32px;
}
.review__content-wrapper .review__content-txt{
  color: #000;
font-size: 24px;
font-style: normal;
font-weight: 400;
line-height: 1.3;
margin-bottom: 32px;
}
.review__content-wrapper .review__content-name{
  color: #000;
font-size: 20px;
font-style: normal;
font-weight: 400;
line-height: 1.3;
letter-spacing: 0.6px;
}
.review__content-wrapper .review__content-office{
  color: rgba(0, 0, 0, 0.50);
font-size: 15px;
font-style: normal;
font-weight: 400;
line-height: 1.3
}
.review-wrapper .review__content-wrapper{
  flex: 1;
}
@media (max-width: 767px) {
.review-section .review-wrapper{
  flex-direction: column;
  gap: 26px;
}
.review__images-wrapper,.review__images-wrapper img{
  width: 100%;
}
.review__content-wrapper h4{
font-size: 28px;
  margin-bottom: 20px;
}
.review__content-wrapper .review__content-txt{
font-size: 20px;
margin-bottom: 20px;
}
.review__content-wrapper .review__content-name{
}
}
/* review-section end */
</style>
   <section>
      <div class="review-section media-{{ section.id }}-padding">
      <div class="container">
        <div class="review-wrapper">
          <div class="review__images-wrapper to-top">
             {%- if section.settings.image -%}
            <img src="{{section.settings.image | image_url }}" alt="" width="{{  section.settings.image.width  | divided_by: 2  }}" height="{{  section.settings.image.height  | divided_by: 2  }}">
              {%- endif -%}
          </div>
          <div class="review__content-wrapper to-top">
            {%- if section.settings.tle != blank -%}
            <h4>{{ section.settings.tle }}</h4>
            {%- endif -%}
             {%- if section.settings.subtle != blank -%}
            <div class="review__content-txt">{{ section.settings.subtle }}</div>
             {%- endif -%}
               {%- if section.settings.name_txt != blank -%}
            <div class="review__content-name">{{ section.settings.name_txt }}</div>
            {%- endif -%}
              {%- if section.settings.note != blank -%}
            <div class="review__content-office">{{ section.settings.note }}</div>
             {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "review-section",
  "blocks": [
  ],
  "settings": [
    {
        "type": "image_picker",
        "id": "image",
        "label": "Images"
      },
      {
        "type": "image_picker",
        "id": "mobile_image",
        "label": "Mobile Images"
      },
     {
        
        "type": "text",
        "id": "tle",
        "label": "Title"
      },
      {
        
        "type": "richtext",
        "id": "subtle",
        "label": "subTitle"
      },
            {
        
        "type": "richtext",
        "id": "name_txt",
        "label": "Name"
      },
      {
        
        "type": "richtext",
        "id": "note",
        "label": "Note"
      },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "review-section"
    }
  ]
}
{% endschema %}
