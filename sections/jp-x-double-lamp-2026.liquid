{%- liquid
  assign section_id = 'jp-x-double-lamp-2026-' | append: section.id
  assign desktop_image = section.settings.background_image | default: section.settings.background_image_mobile
  assign mobile_image = section.settings.background_image_mobile | default: desktop_image
  assign desktop_feature_image = section.settings.feature_image | default: section.settings.feature_image_mobile
  assign mobile_feature_image = section.settings.feature_image_mobile | default: desktop_feature_image
-%}

<section id="{{ section_id }}" class="jp-x-double-lamp-2026">
  <div class="jp-x-double-lamp-2026__stage">
    <div class="jp-x-double-lamp-2026__background" aria-hidden="true">
      {%- if desktop_image != blank -%}
        <picture>
          {%- if mobile_image != blank -%}<source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 900 }}">{%- endif -%}
          {{ desktop_image | image_url: width: 2880 | image_tag: class: 'jp-x-double-lamp-2026__background-image', loading: 'lazy', widths: '375, 750, 1200, 1600, 1920, 2400, 2880', alt: '' }}
        </picture>
      {%- endif -%}
    </div>

    <div class="jp-x-double-lamp-2026__copy">
      <div class="jp-x-double-lamp-2026__headline to-top">
        <p><span class="jp-x-double-lamp-2026__gradient jp-x-double-lamp-2026__speed">{{ section.settings.speed_value | escape }}</span><span class="jp-x-double-lamp-2026__gradient">{{ section.settings.speed_unit | escape }}</span><span>{{ section.settings.speed_text | escape }}</span><span class="jp-x-double-lamp-2026__multiply">×</span></p>
        <p><span class="jp-x-double-lamp-2026__gradient jp-x-double-lamp-2026__lamp">{{ section.settings.lamp_value | escape }}</span><span>{{ section.settings.lamp_text | escape }}</span></p>
      </div>
      <div class="jp-x-double-lamp-2026__completion to-top" style="transition-delay: .1s">{{ section.settings.completion }}</div>
    </div>

    <div class="jp-x-double-lamp-2026__feature to-top" style="transition-delay: .2s">
      {%- if desktop_feature_image != blank -%}
        <picture>
          {%- if mobile_feature_image != blank -%}<source media="(max-width: 749px)" srcset="{{ mobile_feature_image | image_url: width: 500 }}">{%- endif -%}
          {{ desktop_feature_image | image_url: width: 1000 | image_tag: class: 'jp-x-double-lamp-2026__feature-image', loading: 'lazy', widths: '150, 300, 500, 750, 1000', alt: desktop_feature_image.alt }}
        </picture>
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'jp-x-double-lamp-2026__feature-placeholder' }}
      {%- endif -%}
    </div>

    {%- if section.settings.note != blank -%}<p class="jp-x-double-lamp-2026__note">{{ section.settings.note | escape | newline_to_br }}</p>{%- endif -%}
  </div>
</section>

<style>
  #{{ section_id }} { background: linear-gradient(70deg, #0c0c0c .8%, #7c7c7f 101.8%); color: #fff; overflow: hidden; }
  #{{ section_id }} * { box-sizing: border-box; }
  #{{ section_id }} .jp-x-double-lamp-2026__stage { height: min(1015px, 52.864583vw); margin: 0 auto; max-width: 1920px; overflow: hidden; position: relative; }
  #{{ section_id }} .jp-x-double-lamp-2026__background, #{{ section_id }} .jp-x-double-lamp-2026__background picture { display: block; inset: 0; position: absolute; }
  #{{ section_id }} .jp-x-double-lamp-2026__background-image { display: block; height: 100%; max-width: 100%; object-fit: contain; width: 100%; }
  #{{ section_id }} .jp-x-double-lamp-2026__copy { inset: 0; pointer-events: none; position: absolute; }
  #{{ section_id }} .jp-x-double-lamp-2026__headline { left: 17.19%; line-height: 1.5; position: absolute; top: 19.99%; }
  #{{ section_id }} .jp-x-double-lamp-2026__headline p { font-size: clamp(25px, 2.15vw, 41.3px); font-weight: 400; line-height: 1.5; margin: 0; white-space: nowrap; }
  #{{ section_id }} .jp-x-double-lamp-2026__headline .jp-x-double-lamp-2026__speed { font-size: clamp(33px, 2.85vw, 54.8px); font-weight: 600; }
  #{{ section_id }} .jp-x-double-lamp-2026__headline .jp-x-double-lamp-2026__lamp { font-weight: 700; }
  #{{ section_id }} .jp-x-double-lamp-2026__gradient { background: linear-gradient(180deg, #fff 0%, #b9e7ff 57%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  #{{ section_id }} .jp-x-double-lamp-2026__headline .jp-x-double-lamp-2026__multiply { display: inline-block; font-size: inherit; margin-left: .2em; }
  #{{ section_id }} .jp-x-double-lamp-2026__completion { font-size: clamp(25px, 2.14vw, 41.1px); left: 16.67%; line-height: 1.3; margin: 0; position: absolute; top: 37.29%; }
  #{{ section_id }} .jp-x-double-lamp-2026__completion p { margin: 0; }
  #{{ section_id }} .jp-x-double-lamp-2026__completion sup { 
    font-family: Saans, "Noto Sans JP", sans-serif; font-size: .645em; 
    font-style: normal; font-weight: 400; line-height: 1; }
  #{{ section_id }} .jp-x-double-lamp-2026__feature { height: 25.62%; left: 17.19%; overflow: hidden; position: absolute; top: 55.27%; width: 23.07%; }
  #{{ section_id }} .jp-x-double-lamp-2026__feature-image, #{{ section_id }} .jp-x-double-lamp-2026__feature-placeholder { display: block; height: 100%; object-fit: cover; width: 100%; }
  #{{ section_id }} .jp-x-double-lamp-2026__feature-placeholder { background: #373438; fill: #55515a; }
  #{{ section_id }} .jp-x-double-lamp-2026__note { color: #dcdcdc; font-size: clamp(9px, .625vw, 12px); left: 17.19%; line-height: 1.5; margin: 0; position: absolute; top: 93.19%; }
  @media screen and (max-width: 749px) {
    #{{ section_id }} { background: linear-gradient(221deg, #6b6b6e 30.7%, #0f0f0f 106.7%); }
    #{{ section_id }} .jp-x-double-lamp-2026__stage { aspect-ratio: auto; height: 696px; max-width: none; }
    #{{ section_id }} .jp-x-double-lamp-2026__background-image { height: auto; max-width: 100%; object-fit: initial; position: static; transform: none; width: 100%; }
    #{{ section_id }} .jp-x-double-lamp-2026__headline { left: 0; right: 0; text-align: center; top: 38px; }
    #{{ section_id }} .jp-x-double-lamp-2026__headline p { font-size: 22px; line-height: 1.5; }
    #{{ section_id }} .jp-x-double-lamp-2026__headline .jp-x-double-lamp-2026__speed { font-size: 30px; }
    #{{ section_id }} .jp-x-double-lamp-2026__headline .jp-x-double-lamp-2026__multiply { font-size: inherit; line-height: inherit; }
    #{{ section_id }} .jp-x-double-lamp-2026__completion { font-size: 18px; left: 0; line-height: 1.5; right: 0; text-align: center; top: 161px; }
    #{{ section_id }} .jp-x-double-lamp-2026__feature { border: 1px solid #fff; border-radius: 50%; height: 149px; left: 20px; top: 268px; width: 149px; }
    #{{ section_id }} .jp-x-double-lamp-2026__feature-image, #{{ section_id }} .jp-x-double-lamp-2026__feature-placeholder { object-fit: cover; }
    #{{ section_id }} .jp-x-double-lamp-2026__note { color: rgba(255,255,255,.5); font-size: 8px; left: 20px; line-height: 1.5; right: 13px; top: 653px; }
  }
</style>

{% schema %}
{
  "name": "jp-x-double-lamp-2026",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "PC 产品背景图（不含文案）" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "M 产品背景图（不含文案）" },
    { "type": "image_picker", "id": "feature_image", "label": "PC 功能展示图" },
    { "type": "image_picker", "id": "feature_image_mobile", "label": "M 功能展示图" },
    { "type": "text", "id": "speed_value", "label": "主标题高亮数字", "default": "0.2" },
    { "type": "text", "id": "speed_unit", "label": "主标题高亮单位", "default": "秒" },
    { "type": "text", "id": "speed_text", "label": "主标题第一行其余文案", "default": "の超高速フラッシュ連射" },
    { "type": "text", "id": "lamp_value", "label": "主标题第二行高亮文案", "default": "ダブルランプ" },
    { "type": "text", "id": "lamp_text", "label": "主标题第二行其余文案", "default": "設計で、" },
    { "type": "liquid", "id": "completion", "label": "完成说明（支持 HTML；脚注示例 <sup>*1</sup>）", "default": "<p>ヒゲのお手入れは<br>1回たったの2分で完了<sup>*1</sup></p>" },
    { "type": "textarea", "id": "note", "label": "底部注释", "default": "*1. 2分：当社調べに基づく。" }
  ],
  "presets": [
    { "name": "jp-x-double-lamp-2026" }
  ]
}
{% endschema %}
