    margin-bottom: 24px;
}
.product-instruction-module.faq-module .qa-content{
font-size: 12px;
  margin-bottom: 24px;
}
.product-instruction-module.faq-module .product-instruction-box{
  flex-direction: column;
}
    .product-instruction-module.faq-module .instruction-list-top {
    padding: 16px 0;
}
    .product-instruction-box .instruction-list-top {
    padding: 16px 0;
}
    .product-instruction-module.faq-module .instruction-list-top {
    padding: 16px 0;
}
.custom-txt__inner{
font-size: 14px;
    margin-top: 25px;
}
.custom-txt__inner a{
padding-left:6px;
}
}
@media (min-width: 1024px) and (max-width: 1450px) {
.product-instruction-box .instruction-list-tle {
    font-size: 19px;
}
.product-instruction-box .span {
    width: 15px;
    height: 15px;
}
.product-instruction-box .span::before {
