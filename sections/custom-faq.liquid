}
.product-instruction-box .instruction-list-ul {
    font-size: 13px;
    margin-bottom: 29px;
}
.product-instruction-module.faq-module .qa-content{
font-size: 13px;
  margin-bottom: 29px;
}
    .product-instruction-box .instruction-list-top {
    padding: 22px 0;
}
    .product-instruction-module.faq-module .instruction-list-top {
