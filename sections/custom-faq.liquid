}
.product-instruction-box .instn-li {
    width: calc(50% - 4px);
}
.product-instruction-box .instn-li-tle {
font-size: 12px;
}
.product-instruction-box .instn-li-txt {
font-size: 12px;
}
.product-instruction-box .instn-note {
    margin-top: 8px;
    font-size: 10px;
    margin-bottom: 24px;
}
.use_right-td .use_right-td1 {
    font-size: 10px;
    padding: 7px 0;
}
.use_right-td2 {
    padding: 15px 4px;
}
.use_right-td2 .ts2-p1 {
    font-size: 10px;
}
.use_right-td2 .ts2-p2 {
