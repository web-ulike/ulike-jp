{%- liquid
  assign sid = section.id
  assign bg_desktop = section.settings.background_image
  assign bg_mobile = section.settings.background_mobile | default: bg_desktop
  assign gift_desktop = section.settings.gift_image
  assign gift_mobile = section.settings.gift_mobile | default: gift_desktop
  assign reveal_class = 'to-top'
  if request.page_type == 'article' or request.page_type == 'blog' or request.design_mode
    assign reveal_class = ''
  endif
  assign loading = 'lazy'
  if section.index == 1 or section.index == null
    assign loading = 'eager'
  endif
-%}
<section id="bf-gifts-2026-{{ sid }}" class="bf-gifts" aria-label="{{ section.settings.heading | escape }}">
  <div class="bf-gifts__background" aria-hidden="true">
    {%- if bg_desktop != blank or bg_mobile != blank -%}
      <picture>
        {%- if bg_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ bg_mobile | image_url: width: 1200 }}">
        {%- endif -%}
        {%- assign bg_image = bg_desktop | default: bg_mobile -%}
        {{
          bg_image
          | image_url: width: 2400
          | image_tag: loading: loading, widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: ''
        }}
      </picture>
    {%- endif -%}
    {%- if section.settings.glow_one != blank -%}
      {{
        section.settings.glow_one
        | image_url: width: 1808
        | image_tag: class: 'bf-gifts__glow bf-gifts__glow--one', loading: 'lazy', alt: ''
      }}
    {%- endif -%}
    {%- if section.settings.glow_two != blank -%}
      {{
        section.settings.glow_two
        | image_url: width: 1808
        | image_tag: class: 'bf-gifts__glow bf-gifts__glow--two', loading: 'lazy', alt: ''
      }}
    {%- endif -%}
  </div>
  <div class="container bf-gifts__inner">
    <h2 class="bf-gifts__heading">{{ section.settings.heading | escape }}</h2>
    <div class="bf-gifts__cards">
      <div class="bf-gifts__hero">
        <div class="bf-gifts__hero-media" aria-hidden="true">
          {%- if gift_desktop != blank or gift_mobile != blank -%}
            <picture>
              {%- if gift_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ gift_mobile | image_url: width: 1200 }}">
              {%- endif -%}
              {%- assign gift_image = gift_desktop | default: gift_mobile -%}
              {{
                gift_image
                | image_url: width: 1800
                | image_tag:
                  loading: loading,
                  widths: '750, 1200, 1800',
                  sizes: '(max-width: 767px) 100vw, 1200px',
                  alt: ''
              }}
            </picture>
          {%- endif -%}
        </div>
        <div class="bf-gifts__hero-copy">
          {%- if section.settings.logo != blank -%}
            <div class="bf-gifts__logos">
              {{
                section.settings.logo
                | image_url: width: 600
                | image_tag:
                  loading: loading,
                  widths: '160, 320, 600',
                  sizes: '(max-width: 767px) 157px, 242px',
                  alt: section.settings.logo.alt
              }}
            </div>
          {%- endif -%}
          <div class="bf-gifts__description {{ reveal_class }}">{{ section.settings.description }}</div>
        </div>
      </div>
      <div class="bf-gifts__cashback">
        <div class="bf-gifts__cashback-heading {{ reveal_class }}">{{ section.settings.cashback_heading }}</div>
        <div class="bf-gifts__coupons">
          {%- for block in section.blocks -%}
            <div class="bf-gifts__coupon" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '270, 437, 600, 900',
                    sizes: '(max-width: 767px) 270px, 437px',
                    alt: block.settings.alt
                }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
    <div class="bf-gifts__notes {{ reveal_class }}">{{ section.settings.notes }}</div>
  </div>
</section>
{% stylesheet %}
  .bf-gifts {
    position: relative;
    overflow: hidden;
    background: #010101;
    color: #fff;
    padding: 62px 0 110px;
  }
  .bf-gifts__background,
  .bf-gifts__background picture,
  .bf-gifts__background picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bf-gifts__background picture img {
    object-fit: cover;
    opacity: 0.64;
  }
  .bf-gifts__glow {
    position: absolute;
    width: 1808px;
    max-width: none;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .bf-gifts__glow--one {
    right: -941px;
    top: -610px;
  }
  .bf-gifts__glow--two {
    right: calc(50% + 220px);
    top: -143px;
  }
  .bf-gifts__inner.container {
    position: relative;
    max-width: 1240px;
    padding-inline: 20px;
  }
  .bf-gifts__heading {
    margin: 0 0 77px;
    text-align: center;
    color: #f5e5ca;
    font-family: 'Noto Serif JP', serif;
    font-size: 40px;
    font-weight: 500;
    line-height: 1.3;
  }
  .bf-gifts__cards {
    display: grid;
    gap: 80px;
  }
  .bf-gifts__hero,
  .bf-gifts__cashback {
    position: relative;
    overflow: hidden;
    height: 408px;
    border-radius: 12px;
  }
  .bf-gifts__hero {
    border: 2px solid #ebbc8c;
    background: #634329;
  }
  .bf-gifts__hero-media,
  .bf-gifts__hero-media picture {
    position: absolute;
    inset: 0;
  }
  .bf-gifts__hero-media img {
    position: absolute;
    width: 126.6%;
    max-width: none;
    height: 147%;
    left: -20.2%;
    top: -44.5%;
    object-fit: cover;
  }
  .bf-gifts__hero-copy {
    position: absolute;
    right: 8.5%;
    top: 31%;
    width: 342px;
    text-align: center;
  }
  .bf-gifts__logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
  }
  .bf-gifts__logos img {
    display: block;
    width: 242px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
  .bf-gifts__description {
    margin-top: 31px;
    font-size: 16px;
    line-height: 1.5;
  }
  .bf-gifts__description p,
  .bf-gifts__cashback-heading p,
  .bf-gifts__notes p {
    margin: 0;
  }
  .bf-gifts__description strong {
    background: #fbecd8;
    color: #5d3e1f;
    font-weight: 500;
  }
  .bf-gifts__cashback {
    border: 2px solid #8f6132;
    background: linear-gradient(60deg, #1e1308 -3%, #5b4025 41%, #e4c38e 99%);
    text-align: center;
    padding: 54px 20px 30px;
  }
  .bf-gifts__cashback-heading {
    font-size: 16px;
    line-height: 1.3;
  }
  .bf-gifts__coupons {
    display: flex;
    justify-content: center;
    gap: 50px;
    margin-top: 65px;
  }
  .bf-gifts__coupon {
    width: min(437px, 45%);
  }
  .bf-gifts__coupon img {
    display: block;
    width: 100%;
    height: auto;
  }
  .bf-gifts__notes {
    margin-top: 64px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    line-height: 1.3;
  }
  @media screen and (max-width: 767px) {
    .bf-gifts {
      padding: 50px 0;
    }
    .bf-gifts__background picture img {
      opacity: 1;
    }
    .bf-gifts__glow {
      display: none;
    }
    .bf-gifts__inner.container {
      padding-inline: 16px;
    }
    .bf-gifts__heading {
      max-width: 284px;
      margin: 0 auto 30px;
      font-size: 24px;
    }
    .bf-gifts__cards {
      gap: 20px;
    }
    .bf-gifts__hero,
    .bf-gifts__cashback {
      height: 358px;
      border: 0;
      border-radius: 4px;
    }
    .bf-gifts__hero-media img {
      width: 234.2%;
      height: 88.6%;
      left: -48.7%;
      top: 11.4%;
    }
    .bf-gifts__hero:after {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 164px;
      background: linear-gradient(to bottom, #825c35 27%, rgba(159, 117, 70, 0));
    }
    .bf-gifts__hero-copy {
      z-index: 1;
      top: 26px;
      right: 0;
      width: 100%;
      padding: 0 12px;
    }
    .bf-gifts__logos {
      gap: 10px;
    }
    .bf-gifts__logos img {
      width: 157px;
    }
    .bf-gifts__description {
      margin: 18px auto 0;
      max-width: 320px;
      font-size: 16px;
      font-weight: 500;
    }
    .bf-gifts__cashback {
      padding: 34px 16px 20px;
      background: linear-gradient(84deg, #70410f -32%, #86613b 42%, #e4c28e 100%);
    }
    .bf-gifts__coupons {
      flex-direction: column;
      align-items: center;
      gap: 35px;
      margin-top: 34px;
    }
    .bf-gifts__coupon {
      width: min(270px, 100%);
    }
    .bf-gifts__notes {
      margin-top: 30px;
      color: rgba(255, 255, 255, 0.5);
      font-size: 8px;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "BF Gifts 2026",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "どなたでも参加できるチャンス！" },
    {
      "type": "richtext",
      "id": "description",
      "label": "プレゼント説明",
      "default": "<p>期間中にご購入いただいた方全員に、もれなく<strong>Ulikeハートミラー</strong>をプレゼント！</p>"
    },
    {
      "type": "richtext",
      "id": "cashback_heading",
      "label": "キャッシュバック説明",
      "default": "<p>ご購入いただいた方全員に<br/>キャッシュバックが当たるチャンス!</p>"
    },
    {
      "type": "richtext",
      "id": "notes",
      "label": "注意事項",
      "default": "<p>・本キャンペーンは、Ulike株式会社が主催・運営しております。<br/>・各賞品の提供元企業は、本キャンペーンのスポンサーではなく、一切関与しておりません。<br/>・賞品の換金、転売、および第三者への譲渡は禁止されています。<br/>・本キャンペーン内容の最終的な解釈権および変更権は、Ulike株式会社に帰属します。<br/>・賞品発送またはキャッシュバックの時点で、ご注文がキャンセルまたは返金されている場合は対象外となります。<br/>・当選したキャッシュバック金額が実際の決済金額を上回る場合は、決済金額を上限として払い戻しいたします。</p>"
    },
    { "type": "image_picker", "id": "background_image", "label": "背景画像（PC）" },
    { "type": "image_picker", "id": "background_mobile", "label": "背景画像（モバイル）" },
    { "type": "image_picker", "id": "gift_image", "label": "プレゼント画像（PC）" },
    { "type": "image_picker", "id": "gift_mobile", "label": "プレゼント画像（モバイル）" },
    { "type": "image_picker", "id": "logo", "label": "ロゴ画像" },
    { "type": "image_picker", "id": "glow_one", "label": "背景の光（右・PC）" },
    { "type": "image_picker", "id": "glow_two", "label": "背景の光（左・PC）" }
  ],
  "blocks": [
    {
      "type": "coupon",
      "name": "賞品画像",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "賞品画像" },
        { "type": "text", "id": "alt", "label": "画像の説明", "default": "キャッシュバック賞品" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BF Gifts 2026",
      "blocks": [
        { "type": "coupon", "settings": { "alt": "特賞 10,000円 キャッシュバック 10名様" } },
        { "type": "coupon", "settings": { "alt": "1等 5,000円 キャッシュバック 20名様" } }
      ]
    }
  ]
}
{% endschema %}
