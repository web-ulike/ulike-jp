    {
      "type": "image_picker",
      "id": "gift_image",
      "label": "赠品图片（电脑端）"
    },
    {
      "type": "image_picker",
      "id": "gift_mobile",
      "label": "赠品图片（移动端）"
    },
    {
      "type": "image_picker",
      "id": "logo",
