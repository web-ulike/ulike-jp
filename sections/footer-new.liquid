                    {%- for index in (1..3) -%}
                      {%- liquid
                        if index == 1
                          assign email_name_key = 'emailname'
                          assign email_url_key = 'emailurl'
                        else
                          assign email_name_key = 'emailname_' | append: index
                          assign email_url_key = 'emailurl_' | append: index
