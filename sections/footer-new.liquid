{%- liquid
  assign se_id = section.id
  assign se_bks = section.blocks
  assign se_stts = section.settings
-%}
<style>
  .common-btn{
    padding: 0px 1.5rem;
    border: none;
    cursor: pointer;
    transition: background 0.3s ease;
    width: 100%;
    border-radius: 4px;
    background: #E0004D;
    color: #fff;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    line-height: 48px;
    margin-top: 20px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .footer-new_{{ se_id }} {
    background: #000;
    color: #fff;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 615px;
    gap: 80px;
    align-items: start;
    padding: 82px 0 92px;
    border-bottom: 1px solid #292929;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-content {
    max-width: 470px;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-title {
    margin: 0 0 14px;
    color: #fff;
    font-size: 40px;
    font-weight: 500;
    line-height: 1.2;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-copy {
    color: #fff;
    font-size: 25px;
    line-height: 1.32;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-copy p,
  .footer-new_{{ se_id }} .footer-new__newsletter-note p {
    margin: 0;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-copy strong {
    color: #e0004d;
    font-weight: 500;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-form {
    width: 100%;
    max-width: 615px;
    min-width: 0;
    margin: 0;
    padding-top: 11px;
    justify-self: end;
  }

  .footer-new_{{ se_id }} .footer-new__form {
    display: block;
    width: 100%;
    margin: 0;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-fields {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    align-items: stretch;
    width: 100%;
    padding: 5px;
    border-radius: 5px;
    background: #fff;
    box-sizing: border-box;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-input {
    flex: 1 1 auto;
    width: 0;
    min-width: 0;
    height: 47px;
    padding: 0 12px;
    border: 0;
    border-radius: 3px;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 18px;
    outline: none;
    box-sizing: border-box;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-input::placeholder {
    color: #9f9f9f;
    opacity: 1;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 164px;
    width: 164px;
    min-width: 0;
    height: 47px;
    min-height: 47px;
    padding: 0 24px;
    border: 0;
    border-radius: 4px;
    background: #e0004d;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 16px;
    line-height: 1;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-note {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 20px;
    color: #696969;
    font-size: 14px;
    line-height: 1.45;
  }

  .footer-new_{{ se_id }} label.footer-new__newsletter-note {
    cursor: pointer;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-note img {
    display: block;
    width: 23px;
    height: 23px;
    object-fit: contain;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-check {
    position: relative;
    display: block;
    flex: 0 0 23px;
    width: 23px;
    height: 23px;
    overflow: hidden;
    border: 1px solid #d8d8d8;
    border-radius: 3px;
    background: #fff;
    box-sizing: border-box;
    cursor: pointer;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-checkbox {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-checkbox:checked + .footer-new__newsletter-check {
    border-color: #e0004d;
    background: #e0004d;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-checkbox:checked + .footer-new__newsletter-check img {
    opacity: 0;
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-checkbox:checked + .footer-new__newsletter-check::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 7px;
    width: 6px;
    height: 10px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .footer-new_{{ se_id }} .footer-new__newsletter-checkbox:focus-visible + .footer-new__newsletter-check {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .footer-new_{{ se_id }} .footer__inner {
    background: #000;
    padding: 46px 0 40px;
    display: flex;
    color: #919191;
    font-family: Saans;
    font-size: 16px;
    font-weight: 300;
    line-height: 24px;
    /* 171.429% */
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list {
    display: grid;
    gap: clamp(24px, calc(-51.714px + 8vw), 130px);
    width: 100%;
    grid-template-columns: minmax(260px, 280px) repeat(3, minmax(110px, 1fr)) minmax(260px, 315px);
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item {
    padding-left: 0;
    position: relative;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-title {
    color: #fff;
    margin: 0 0 30px;
    font-size: clamp(10px, 1.25vw, 24px);
    font-weight: 400;
    line-height: 1.3;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .down {
    display: none;
    position: absolute;
    right: 0px;
    top: 10px;
    padding: 2px 7px;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .down .add, .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .down .minus {
    height: 28px;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .down .minus {
    display: none;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content .linklist__item {
    margin: 0;
    color: #737577;
    font-size: clamp(12px, calc(9.143px + 0.357vw), 16px);
    line-height: 1.5625;
    padding: 0px;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content .linklist__item a {
    color: #737577;
    line-height: inherit;
    /* 171.429% */
    text-decoration: none;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content .linklist__item a:hover {
    color: #fbfaf4;
    text-decoration-line: underline;
    -moz-text-decoration-line: underline;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content .linklist__item:hover {
    color: #fbfaf4;
  }

  .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content .linklist__item:hover a {
    color: #fbfaf4;
    text-decoration-line: underline;
  }

  .footer-new_{{ se_id }} .footer__aside {
    color: #919191;
    padding: 28px 0 24px;
    border-top: 1px solid #292929;
    font-size: clamp(12px, calc(10.571px + 0.179vw), 14px);
  }

  .footer-new_{{ se_id }} .footer__aside .footer__payment-methods {
    width: 100%;
    margin-inline-start: 0;
    display: flex;
    justify-content: space-between;
  }

  .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .policy {
    width: auto;
    flex: 1 1 auto;
    gap: 40px;
    display: flex;
    align-items: center;
  }

  .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list {
    color: rgba(255, 255, 255, 0.7);
    text-align: right;
    font-family: Saans;
    font-size: inherit;
    font-style: normal;
    font-weight: 380;
    line-height: 1.5;
    /* 150% */
    width: auto;
    flex: 0 1 540px;
  }

  .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .text-pay {
    padding-right: 20px;
  }

  .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 0;
  }

  .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image img {
    width: 530px;
    pointer-events: none;
    /* Disables dragging */
    user-drag: none;
    /* Additional support for some browsers */
    -webkit-user-drag: none;
    /* Additional support for Safari */
  }

  .footer-new_{{ se_id }} .footer-brand-image {
    padding: 36px 0 56px;
  }

  .footer-new_{{ se_id }} .footer-brand-image img {
    width: 100%;
    pointer-events: none;
    /* Disables dragging */
    user-drag: none;
    /* Additional support for some browsers */
    -webkit-user-drag: none;
    /* Additional support for Safari */
  }

  .footer-new_{{ se_id }} .icon-wrapper.pc{
    display: flex;
  }

  .footer-new_{{ se_id }} .icon-wrapper.mobile{
    display: none;
  }

  .footer-new_{{ se_id }} .icon-wrapper{
    display: flex;
    flex-wrap: wrap;
    margin-top: 0;
    gap: 15px;
  }

  .footer-new_{{ se_id }} .icon-wrapper a,
  .footer-new_{{ se_id }} .icon-wrapper img {
    display: block;
    width: 40px;
    height: 40px;
  }

  .footer-new_{{ se_id }} .icon-wrapper img {
    object-fit: contain;
  }

  .footer-new_{{ se_id }} .footer-new__social-banner {
    display: block;
    width: min(100%, 315px);
    height: auto;
    margin-top: 27px;
  }

  .footer-new_{{ se_id }} .footer-new__policy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-new_{{ se_id }} .footer-new__policy-links a {
    color: #fff;
    text-decoration: none;
  }

  .footer-new_{{ se_id }} .icon-wrapper svg{
    width: 40px;
    height: 40px;
  }

  @media (min-width: 1200px) {
    .footer-new_{{ se_id }} .footer__inner .footer__item--social_media .footer__item-title {
      margin-bottom: 27px;
    }

    .footer-new_{{ se_id }} .footer__aside {
      padding: 36px 0 16px;
      color: #fff;
      line-height: normal;
    }

    .footer-new_{{ se_id }} .footer__aside .policy p {
      margin: 0;
      white-space: nowrap;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list {
      flex: 0 0 520px;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .text-pay,
    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image > span {
      display: none;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image img {
      width: 520px;
    }

    .footer-new_{{ se_id }} .footer-brand-image {
      padding: 52px 0 60px;
    }
  }

  @media (min-width: 1920px) {
    .footer-new_{{ se_id }} .footer__inner .footer__item-list {
      grid-template-columns: 328px 200px 160px 160px 320px;
      gap: 80px;
    }
  }

  @media (min-width: 800px) and (max-width: 1599px) {
    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods {
      flex-wrap: nowrap;
      gap: clamp(16px, 2.5vw, 40px);
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .policy {
      flex: 1 1 auto;
      gap: clamp(12px, 2vw, 32px);
      min-width: 0;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .policy p {
      flex: 0 0 auto;
      margin: 0;
      white-space: nowrap;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list {
      flex: 0 1 clamp(240px, 30vw, 480px);
      min-width: 0;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image picture {
      width: 100%;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
    }
  }

  @media (min-width: 769px) and (max-width: 1199px) {
    .footer-new_{{ se_id }} .footer-new__newsletter {
      grid-template-columns: minmax(0, 1fr) minmax(420px, 48%);
      gap: 40px;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  @media (max-width: 768px) {
    .footer-new_{{ se_id }} {
      background: #000;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter {
      display: block;
      padding: 23px 0 18px;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-content {
      max-width: none;
      padding-left: 3px;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-title {
      margin-bottom: 5px;
      font-size: 19px;
      line-height: 1.25;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-copy {
      max-width: 235px;
      font-size: 12px;
      line-height: 1.3;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-form {
      max-width: none;
      margin-top: 16px;
      padding-top: 0;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-fields {
      flex-wrap: nowrap;
      height: 32px;
      padding: 3px;
      border-radius: 3px;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-input {
      height: 26px;
      padding-inline: 7px;
      font-size: 12px;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-submit {
      flex-basis: 88px;
      width: 88px;
      height: 26px;
      min-height: 26px;
      padding-inline: 8px;
      border-radius: 2px;
      font-size: 10px;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-note {
      align-items: flex-start;
      gap: 4px;
      margin-left: 3px;
      margin-top: 13px;
      font-size: 10px;
      line-height: 1.45;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-note img,
    .footer-new_{{ se_id }} .footer-new__newsletter-check {
      flex-basis: 12px;
      width: 12px;
      height: 12px;
      border-radius: 2px;
    }

    .footer-new_{{ se_id }} .footer-new__newsletter-checkbox:checked + .footer-new__newsletter-check::after {
      top: 1px;
      left: 3px;
      width: 4px;
      height: 7px;
      border-width: 0 1px 1px 0;
    }

    .footer-new_{{ se_id }} .footer__inner {
      padding: 17px 0 18px;
      border-bottom: 1px solid #292929;
      font-size: 10px;
      line-height: 12px;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list {
      display: grid;
      grid-template-columns: 31.5% 25.5% 24% 19%;
      grid-template-rows: auto auto;
      gap: 22px 0;
      width: 100%;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item {
      min-width: 0;
      padding: 0;
      border: 0;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item:nth-child(1) {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item:nth-child(2) {
      grid-column: 3;
      grid-row: 1;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item:nth-child(3) {
      grid-column: 4;
      grid-row: 1;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item:nth-child(4) {
      grid-column: 1;
      grid-row: 2;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item:nth-child(5) {
      grid-column: 2 / 5;
      grid-row: 2;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-title {
      margin: 0 0 7px;
      font-size: 10px;
      line-height: 12px;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .down {
      display: none;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content {
      overflow: visible;
      max-height: none;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content .linklist__item {
      padding: 0;
      font-size: 12px;
      line-height: 16px;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content .linklist__item a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      padding-block: 8px;
      line-height: 16px;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item-list .footer__item .footer__item-content p {
      margin: 0;
    }

    .footer-new_{{ se_id }} .footer__inner .footer__item--social_media .footer__item-title {
      margin-bottom: 7px;
    }

    .footer-new_{{ se_id }} .icon-wrapper {
      flex-wrap: nowrap;
      gap: 5px;
    }

    .footer-new_{{ se_id }} .icon-wrapper a,
    .footer-new_{{ se_id }} .icon-wrapper img,
    .footer-new_{{ se_id }} .icon-wrapper svg {
      width: 19px;
      height: 19px;
    }

    .footer-new_{{ se_id }} .footer-new__social-banner {
      width: 138px;
      min-height: 33px;
      margin: 10px 0 0;
      border-radius: 2px;
      object-fit: contain;
    }

    .footer-new_{{ se_id }} p.footer-new__social-banner {
      display: flex;
      align-items: center;
      padding: 5px 8px;
      background: #202020;
      color: #fff;
      font-size: 10px;
      line-height: 12px;
      box-sizing: border-box;
    }

    .footer-new_{{ se_id }} .footer__aside {
      padding: 16px 1px 0 2px;
      border-top: 0;
      color: #737577;
      font-size: 8px;
      line-height: 10px;
      box-sizing: border-box;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods {
      flex-direction: column;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .policy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: 3px;
      margin: 0;
      color: #737577;
      font-size: 8px;
      line-height: 10px;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .policy p {
      margin: 0;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list {
      flex: none;
      margin-top: 9px;
      color: #737577;
      text-align: left;
      font-size: 8px;
      width: 100%;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .text-pay {
      display: none;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image {
      margin-top: 0;
      justify-content: flex-start;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image span{
      display: none;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image picture {
      width: 100%;
    }

    .footer-new_{{ se_id }} .footer__aside .footer__payment-methods .pay-list .pay-image img {
      display: block;
      width: 100%;
      height: auto;
    }

    .footer-new_{{ se_id }} .footer-brand-image {
      margin-top: 0;
      padding: 12px 0 18px;
    }

    .footer-new_{{ se_id }} .footer-brand-image img {
      display: block;
      width: 100%;
      pointer-events: none;
      /* Disables dragging */
      user-drag: none;
      /* Additional support for some browsers */
      -webkit-user-drag: none;
      /* Additional support for Safari */
    }


    .footer-new_{{ se_id }} .icon-wrapper.pc{
      display: none;
    }

    .footer-new_{{ se_id }} .icon-wrapper.mobile{
      display: none;
    }

    .footer-new_{{ se_id }} .footer-new__policy-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: start;
      column-gap: 16px;
      row-gap: 4px;
      width: 100%;
      font-size: 12px;
      line-height: 16px;
    }

    .footer-new_{{ se_id }} .footer-new__policy-links li {
      min-width: 0;
    }

    .footer-new_{{ se_id }} .footer-new__policy-links li:nth-child(6) {
      grid-column: 1 / -1;
    }

    .footer-new_{{ se_id }} .footer-new__policy-links a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      padding-block: 8px;
      color: #737577;
    }

  }
</style>

<footer class="footer-new_{{ se_id }}" id="footer-new">
  <div class="container">
    {%- if se_stts.show_newsletter -%}
      <div class="footer-new__newsletter">
        <div class="footer-new__newsletter-content">
          {%- if se_stts.newsletter_title != blank -%}
            <h2 class="footer-new__newsletter-title">{{ se_stts.newsletter_title }}</h2>
          {%- endif -%}
          {%- if se_stts.newsletter_copy != blank -%}
            <div class="footer-new__newsletter-copy">{{ se_stts.newsletter_copy }}</div>
          {%- endif -%}
        </div>
        <div class="footer-new__newsletter-form">
          {%- form 'customer', id: 'footer-new-newsletter', class: 'footer-new__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="hidden" name="contact[context]" value="footer-new">
            <div class="footer-new__newsletter-fields">
              <input
                class="footer-new__newsletter-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocomplete="email"
                autocapitalize="off"
                autocorrect="off"
                placeholder="{{ se_stts.newsletter_placeholder | escape }}"
                aria-label="{{ se_stts.newsletter_placeholder | escape }}"
                required
              >
              <button class="footer-new__newsletter-submit" type="submit">{{ se_stts.newsletter_button }}</button>
            </div>
            {%- if se_stts.newsletter_note != blank -%}
              <label class="footer-new__newsletter-note" for="FooterNewsletterConsent--{{ section.id }}">
                <input
                  id="FooterNewsletterConsent--{{ section.id }}"
                  class="footer-new__newsletter-checkbox"
                  type="checkbox"
                  name="contact[accepts_terms]"
                  value="yes"
                  required
                >
                <span class="footer-new__newsletter-check" aria-hidden="true">
                  {%- if se_stts.newsletter_note_image != blank -%}
                    {{ se_stts.newsletter_note_image | image_url: width: 46 | image_tag: loading: 'lazy', widths: '23,46' }}
                  {%- endif -%}
                </span>
                <div>{{ se_stts.newsletter_note }}</div>
              </label>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="footer-new__newsletter-note">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="footer-new__newsletter-note">{{ 'general.newsletter.success' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}
