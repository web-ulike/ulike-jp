                          <a href="{{ email_url | escape }}" class="link--faded">
                            {{- email_name | default: email_url | escape -}}
                          </a>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- when 'social_media' -%}
