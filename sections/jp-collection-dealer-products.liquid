{{ 'jp-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jp-collection.js' | asset_url }}" defer="defer"></script>
{% render 'jp-collection-grid', module_class: 'jp-collection--dealer', mobile_limit: 2 %}

{% schema %}
{
  "name": "JP 製品一覧・販売店限定",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "IPL光美容器" },
    { "type": "text", "id": "subheading", "label": "小見出し", "default": "販売店限定" },
    { "type": "text", "id": "more_label", "label": "もっと見るボタン", "default": "View More" },
    { "type": "range", "id": "padding_top", "label": "PC上余白", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 85 },
    { "type": "range", "id": "padding_bottom", "label": "PC下余白", "min": 0, "max": 250, "step": 5, "unit": "px", "default": 200 },
    { "type": "range", "id": "padding_top_mobile", "label": "モバイル上余白", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "モバイル下余白", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 }
  ],
  "blocks": [{ "type": "product", "name": "販売店限定製品", "settings": [
    { "type": "product", "id": "product", "label": "製品" }, { "type": "image_picker", "id": "image", "label": "PC画像" }, { "type": "image_picker", "id": "image_mobile", "label": "モバイル画像" }, { "type": "text", "id": "heading", "label": "製品名" }, { "type": "text", "id": "badge", "label": "ラベル" }, { "type": "inline_richtext", "id": "subtitle", "label": "キャッチコピー" }, { "type": "text", "id": "summary", "label": "閉じた時の説明" }, { "type": "richtext", "id": "text", "label": "展開する説明" }, { "type": "text", "id": "button_label", "label": "リンクテキスト", "default": "詳しく見る" }, { "type": "url", "id": "button_link", "label": "リンク先" }
  ]}],
  "presets": [{ "name": "JP 製品一覧・販売店限定" }]
}
{% endschema %}
