{% assign sid = section.id %}

<style>
  #p-airpro-s-compact-body-{{ sid }} { padding: 128px 0; background: var(--p-compact-bg); color: var(--p-compact-text); }
  #p-airpro-s-compact-body-{{ sid }} picture { display: block; }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__img { display: block; width: 100%; height: auto; }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__row { width: min(1220px, 100%); margin: 0 auto; display: grid; align-items: center; }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__top {
    grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); gap: 60px; }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__body {
     margin-top: 120px;
     grid-template-columns: .78fr 1fr .46fr;
     gap: 60px;
  }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__body > picture { width: min(516px, 100%); justify-self: center; }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__copy h2 {
     margin: 0; font-size: 48px; line-height: 1.5;
    }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__copy > div {
     margin-top: 30px; font-size: 24px;
     line-height: 1.5;
  }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__icons {
    display: flex; gap: 90px; margin-top: 40px; }
  #p-airpro-s-compact-body-{{ sid }}
   .p-aps-compact__icon { min-width: 130px;
     text-align: center;
    font-size: 20px; }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__icon img {
     display: block; width: 130px; height: 130px; margin: 0 auto 8px; object-fit: contain;
    }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__list { display: grid; gap: 13px; }
  #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__list span { display: block;
    padding: 7px 8px;
    height: 35px;
    color: #000;
    background: #EBEBEB;
    text-align: center; font-size: 16px; line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    #p-airpro-s-compact-body-{{ sid }} { padding: 32px 0 46px; }
    #p-airpro-s-compact-body-{{ sid }} > .container { padding-right: 10px; padding-left: 10px; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__row { width: 100%; gap: 18px; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__top { grid-template-columns: 1fr; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__top .p-aps-compact__copy { order: -1; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__top > picture { width: 100%; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__body { margin-top: 32px; grid-template-columns: minmax(0, 1fr) 110px; 
      column-gap: 15px; row-gap: 15px; 
    }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__body .p-aps-compact__copy { grid-column: 1 / -1; order: -1; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__copy { max-width: 100%; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__copy h2 { font-size: clamp(21px, 6.4vw, 25px); line-height: 1.3; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__copy > div { margin-top: 9px; font-size: 11px; line-height: 1.68; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__copy > .p-aps-compact__icons { gap: 20px; margin-top: 16px; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__icon { min-width: 58px; font-size: 9px; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__icon img { width: 46px; height: 46px; margin-bottom: 5px; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__img { width: 100%; margin: 0 auto; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__body > picture { width: 100%; align-self: end; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__list { gap: 4px; width: 100px; padding-right: 10px; justify-self: center; align-self: end; }
    #p-airpro-s-compact-body-{{ sid }} .p-aps-compact__list span { height: 20px; padding: 2px; font-size: 10px; }
  }
</style>

<section
  id="p-airpro-s-compact-body-{{ sid }}"
  class="p-aps-compact"
  style="--p-compact-bg: {{ section.settings.background }}; --p-compact-text: {{ section.settings.text_color }};"
>
  <div class="container">
    <div class="p-aps-compact__row p-aps-compact__top">
      <picture>
        {%- if section.settings.compact_image_mobile != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.compact_image_mobile | image_url: width: 900 }}"
          >
        {% endif -%}
        {%- if section.settings.compact_image != blank -%}
          {{-
            section.settings.compact_image
            | image_url: width: 1200
            | image_tag: class: 'p-aps-compact__img', loading: 'lazy', widths: '500, 800, 1200'
          -}}
        {%- endif -%}
      </picture>
      <div class="p-aps-compact__copy">
        {% if section.settings.compact_title != blank %}
          <h2>{{ section.settings.compact_title }}</h2>
        {% endif %}
        {% if section.settings.compact_text != blank %}
          <div>{{ section.settings.compact_text }}</div>
        {% endif %}
        <div class="p-aps-compact__icons">
          {% if section.settings.icon_1 != blank %}
            <div class="p-aps-compact__icon">
              {{ section.settings.icon_1 | image_url: width: 120 | image_tag: loading: 'lazy' -}}
              <span>{{ section.settings.icon_1_label }}</span>
            </div>
          {% endif %}
          {% if section.settings.icon_2 != blank %}
            <div class="p-aps-compact__icon">
              {{ section.settings.icon_2 | image_url: width: 120 | image_tag: loading: 'lazy' -}}
              <span>{{ section.settings.icon_2_label }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="p-aps-compact__row p-aps-compact__body">
      <div class="p-aps-compact__copy">
        {% if section.settings.body_title != blank %}
          <h2>{{ section.settings.body_title }}</h2>
        {% endif -%}
        {%- if section.settings.body_text != blank %}
          <div>{{ section.settings.body_text }}</div>
        {% endif %}
      </div>
      <picture>
        {%- if section.settings.body_image_mobile != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.body_image_mobile | image_url: width: 900 }}">
        {% endif -%}
        {%- if section.settings.body_image != blank -%}
          {{-
            section.settings.body_image
            | image_url: width: 1200
            | image_tag: class: 'p-aps-compact__img', loading: 'lazy', widths: '500, 800, 1200'
          -}}
        {%- endif -%}
      </picture>
      <div class="p-aps-compact__list" aria-label="対応部位">
        <span>顔</span><span>ワキ</span><span>腕</span><span>お腹</span><span>背中</span><span>脚</span
        ><span>手（指／足の甲）</span><span>VIOゾーン</span><span>足</span><span>ほかの部位</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "P Air Pro S 轻量与全身",
  "settings": [
    { "type": "image_picker", "id": "compact_image", "label": "轻量设计 PC 图片" },
    { "type": "image_picker", "id": "compact_image_mobile", "label": "轻量设计移动端图片" },
    { "type": "html", "id": "compact_title", "label": "轻量设计标题", "default": "コンパクトな軽量デザイン" },
    {
      "type": "html",
      "id": "compact_text",
      "label": "轻量设计说明",
      "default": "直感的な操作性と人間工学に基づいたデザインで、初めてでもスムーズに使えるシンプル操作。長時間の使用でも腕や手首に負担がかかりにくい設計で、しっかりケアできます。"
    },
    { "type": "image_picker", "id": "icon_1", "label": "特点图标 1" },
    { "type": "text", "id": "icon_1_label", "label": "特点图标 1 文字", "default": "シンプル操作" },
    { "type": "image_picker", "id": "icon_2", "label": "特点图标 2" },
    { "type": "text", "id": "icon_2_label", "label": "特点图标 2 文字", "default": "細部まで" },
    { "type": "html", "id": "body_title", "label": "全身标题", "default": "お顔からVIOまで<br>1台で全身対応" },
    {
      "type": "html",
      "id": "body_text",
      "label": "全身说明",
      "default": "お顔、ヒゲ、腕、脚、脇、VIOなど、アタッチメント付け替えの手間なしで、全身*トータルケアが1台で完結。"
    },
    { "type": "image_picker", "id": "body_image", "label": "全身部位 PC 图片" },
    { "type": "image_picker", "id": "body_image_mobile", "label": "全身部位移动端图片" },
    { "type": "color", "id": "background", "label": "背景色", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "文字色", "default": "#111111" }
  ],
  "presets": [{ "name": "P Air Pro S 轻量与全身" }]
}
{% endschema %}
