      "id": "air10_max_layout",
      "label": "使用 Air 10 Max 2026 设计",
      "default": false
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "主标题"
    }
  ],
  "presets": [
    {
      "name": "jp-air10-skin-sensor-2026"
    }
  ]
}
{% endschema %}
