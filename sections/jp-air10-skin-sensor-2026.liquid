      "default": "#F4F4F1"
    },
    {
      "type": "video",
      "id": "video",
      "label": "PC 肤色识别视频"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "M 肤色识别视频"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 肤色识别图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "M 肤色识别图片"
    },
    {
      "type": "image_picker",
      "id": "benefit_icon",
      "label": "自动识别图标"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "标题",
      "default": "肌の色を自動で感知し、\n最適な出力パワーを適宜に判別。"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "说明文案",
      "default": "進化したスキンセンサー。認識範囲をダークブラウン*の肌まで拡張し、幅広い肌色をカバー。日焼けの状態や肌色の個人差を見極め、常に安全なパワーを維持。"
    },
    {
      "type": "text",
      "id": "benefit_text",
