{% liquid
  assign sid = section.id
%}

<section class="jp-home-product-showcase-grid jp-home-product-showcase-grid--{{ sid }}">
  <div class="jp-home-product-showcase-grid__list">
    {% for block in section.blocks %}
      <div class="jp-home-product-showcase-grid__item to-top" {{ block.shopify_attributes }}>
        <div class="jp-home-product-showcase-grid__card">
          {% if block.settings.link != blank %}
            <a class="jp-home-product-showcase-grid__image-wrap" target="_blank" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}">
          {% else %}
            <div class="jp-home-product-showcase-grid__image-wrap">
          {% endif %}

          {% if block.settings.image_pc != blank or block.settings.image_mobile != blank %}
            {% assign mobile_image = block.settings.image_mobile | default: block.settings.image_pc %}
            {% assign desktop_image = block.settings.image_pc | default: mobile_image %}
            <picture>
              <source
                media="(max-width: 989px)"
                srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 900 }} 900w"
                sizes="100vw"
              >
              <img
                class="jp-home-product-showcase-grid__image"
                src="{{ desktop_image | image_url: width: 1400 }}"
                srcset="{{ desktop_image | image_url: width: 1000 }} 1000w, {{ desktop_image | image_url: width: 1400 }} 1400w, {{ desktop_image | image_url: width: 2000 }} 2000w"
                sizes="50vw"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
              >
            </picture>
          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

          <div class="jp-home-product-showcase-grid__content">
            <div class="jp-home-product-showcase-grid__content-main">
              {% if block.settings.title_image != blank %}
                <div class="jp-home-product-showcase-grid__title">
                  {% if block.settings.link != blank %}
                    <a target="_blank" href="{{ block.settings.link }}">
                      <img
                        src="{{ block.settings.title_image | image_url: width: 600 }}"
                        alt="{{ block.settings.title_image.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.title_image.width }}"
                        height="{{ block.settings.title_image.height }}"
                      >
                    </a>
                  {% else %}
                    <img
                      src="{{ block.settings.title_image | image_url: width: 600 }}"
                      alt="{{ block.settings.title_image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.title_image.width }}"
                      height="{{ block.settings.title_image.height }}"
                    >
                  {% endif %}
                </div>
              {% elsif block.settings.title != blank %}
                <h3 class="jp-home-product-showcase-grid__title">
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
                  {% else %}
                    {{ block.settings.title }}
                  {% endif %}
                </h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="jp-home-product-showcase-grid__text">{{ block.settings.text }}</div>
              {% endif %}
            </div>

            {% if block.settings.button_text != blank %}
              <div class="jp-home-product-showcase-grid__actions">
                <a class="jp-home-product-showcase-grid__btn" target="_blank" href="{{ block.settings.link | default: '#' }}">
                  <span>{{ block.settings.button_text }}</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 3.5L10.5 8L6 12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .jp-home-product-showcase-grid--{{ sid }} {
    --jp-home-product-showcase-grid-title: #000;
    --jp-home-product-showcase-grid-text: #000;
    --jp-home-product-showcase-grid-link: #000;
    --jp-home-product-showcase-grid-border: #ebe5e8;
    --jp-home-product-showcase-grid-bg: #ffffff;
    padding: 28px 0 56px;
    background: var(--jp-home-product-showcase-grid-bg);
    position: relative;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__list {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__item {
    min-width: 0;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__image-wrap {
    display: block;
    overflow: hidden;
    background: #f7f5f6;
    text-decoration: none;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__image {
    width: 100%;
    display: block;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 58px 60px;
    background: #F9F2EC;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__item:nth-child(2n) .jp-home-product-showcase-grid__content {
    background: #F3F5FD;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__content-main {
    min-width: 0;
    flex: 1 1 auto;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__title {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 500;
    color: var(--jp-home-product-showcase-grid-title);
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__title a {
    color: inherit;
    text-decoration: none;
    display: inline-block;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__title img {
    display: block;
    max-width: 100%;
    width: auto;
    height: auto;
    max-height: 28px;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__text {
    margin-top: 20px;
    max-width: 420px;
    font-size: 20px;
    line-height: 1.5;
    color: var(--jp-home-product-showcase-grid-text);
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__actions {
    flex: 0 0 auto;
    margin-top: 0;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--jp-home-product-showcase-grid-link);
    text-decoration: none;
    font-size: 16px;
    line-height: 1;
    letter-spacing: .02em;
    white-space: nowrap;
  }

  .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__btn svg {
    flex: 0 0 auto;
  }

  @media screen and (max-width: 989px) {
    .jp-home-product-showcase-grid--{{ sid }} {
      padding: 20px 16px 40px;
    }

    .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__list {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__content {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      padding: 30px 20px ;
    }

    .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__title {
      font-size: 20px;
    }

    .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__title img {
      max-height: 20px;
    }

    .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__text {
      margin-top: 6px;
      font-size: 14px;
      line-height: 1.4;
    }

    .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__actions {
      margin-top: 0;
    }

    .jp-home-product-showcase-grid--{{ sid }} .jp-home-product-showcase-grid__btn {
      font-size: 11px;
    }
  }
</style>

{% schema %}
{
  "name": "JP Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Showcase item",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image_pc",
          "label": "PC image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "image_picker",
          "id": "title_image",
          "label": "Title image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ulike Air 10 max"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "より効率的にパワフル。美肌効果の新しい光美容器。"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "詳しく見る"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Product Grid",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Ulike Air 10 max",
            "text": "より効率的にパワフル。美肌効果の新しい光美容器。"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Ulike X max",
            "text": "さらに使いやすい設計で全身ケアを叶える光美容器。"
          }
        }
      ]
    }
  ]
}
{% endschema %}
