{% comment %}
  Air 10 Max 2026: care-modes. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-care-modes-2026-{{ section.id }}" class="a10-2026 a10-2026__modes">
<div class="container a10-2026__container">
<div class="a10-2026__inner">
<div class="a10-2026__mode-list">
<div class="a10-2026__mode-end">{{ section.settings.weak_label | escape | newline_to_br }}</div>
{% for block in section.blocks %}
<article class="a10-2026__mode to-top" style="transition-delay: {{ forloop.index | times: 0.1 | round: 1 }}s;" {{ block.shopify_attributes }}>{%- assign a10_image = block.settings.image | default: block.settings.image -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}
<h3>{{ block.settings.text | escape | newline_to_br }}</h3>

<div class="a10-2026__body">{{ block.settings.text1 }}</div>
</article>
{% endfor %}
<div class="a10-2026__mode-end">{{ section.settings.strong_label | escape | newline_to_br }}</div>
</div>
</div>
</div>
</section>

<style>
#a10-max-care-modes-2026-{{ section.id }} { color: #190a0a;  overflow: hidden; }
#a10-max-care-modes-2026-{{ section.id }} *, #a10-max-care-modes-2026-{{ section.id }} *::before, #a10-max-care-modes-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-care-modes-2026-{{ section.id }} h2, #a10-max-care-modes-2026-{{ section.id }} h3, #a10-max-care-modes-2026-{{ section.id }} p { margin: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__wide { width: min(1600px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-care-modes-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-care-modes-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-care-modes-2026-{{ section.id }}.a10-2026__modes { padding: 60px 0 150px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-list { display: flex; align-items: center; justify-content: space-between; gap: 30px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-end { background: #f1f1f1; border-radius: 50%; width: 105px; height: 105px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 26px; line-height: 1.2; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode { flex: 1; position: relative; text-align: center; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode + .a10-2026__mode::before { content: '→'; position: absolute; left: -28px; top: 75px; font-size: 30px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode .a10-2026__media { width: 100px; margin: auto auto 15px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode h3 { background: #fde5ee; border-radius: 20px; display: inline-block; padding: 0 10px; font-size: 17px; font-weight: 500; line-height: 1.5; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode .a10-2026__body { font-size: 14px; margin-top: 15px; }
@media (min-width:750px) and (max-width:1400px) {
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__title { font-size: 32px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__subtitle { font-size: 26px; }
}
@media (max-width:749px) {
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__desktop { display: none !important; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mobile { display: block; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__title { font-size: 24px; line-height: 1.3; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__subtitle { font-size: 24px; line-height: 1.5; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__body { font-size: 14px; line-height: 1.5; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__note { font-size: 10px; line-height: 1.5; }
#a10-max-care-modes-2026-{{ section.id }}.a10-2026__modes { padding: 48px 0 40px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-list { flex-direction: column; gap: 30px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-end { width: 65px; height: 65px; font-size: 20px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode { display: grid; grid-template-columns: 65px 1fr; column-gap: 12px; align-items: center; width: 100%; text-align: left; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode .a10-2026__media { width: 55px; margin: 0; grid-row: span 2; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode h3 { font-size: 17px; justify-self: start; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode .a10-2026__body { font-size: 14px; margin: 8px 0 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode + .a10-2026__mode::before { content: '↓'; left: 50%; top: -28px; font-size: 18px; }
}

/* Keep short copy inside clipped cards while it enters the viewport. */
@media (prefers-reduced-motion: no-preference) {
#a10-max-care-modes-2026-{{ section.id }} .to-top:not(.appear) { transform: translateY(20px); }
}

</style>

{% schema %}
{
  "name": "A10 Max 四种模式",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "weak_label",
      "label": "弱输出文案",
      "default": "弱\n出力"
    },
    {
      "type": "textarea",
      "id": "strong_label",
      "label": "强输出文案",
      "default": "強\n出力"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "richtext",
          "id": "text1",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A10 Max 四种模式",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Fastモード",
            "text1": "<p>細くて柔らかいムダ毛ケア または4週間継続使用後の日常ケア</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Normalモード",
            "text1": "<p>脇、VIOや男性のヒゲなどの硬くて太い毛ケア</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Highモード",
            "text1": "<p>28Jハイパワーで、VIO、脇や男性のヒゲなどの硬くて太い毛ケア</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "USHRモード",
            "text1": "<p>ファストモードより照射パワーがUP。脚、腕などの全身ケア</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
