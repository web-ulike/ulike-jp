{% comment %}
  Air 10 Max 2026: care-modes. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-care-modes-2026-{{ section.id }}" class="a10-2026 a10-2026__modes">
<div class="container a10-2026__container">
<div class="a10-2026__inner">
<div class="a10-2026__mode-list">
<div class="a10-2026__mode-end">{% assign a10_label_lines = section.settings.weak_label | newline_to_br | split: '<br />' %}{% for line in a10_label_lines %}<span{% if forloop.first %} class="a10-2026__mode-strength"{% endif %}>{{ line | strip | escape }}</span>{% endfor %}</div>
{% for block in section.blocks %}
<article class="a10-2026__mode to-top" style="transition-delay: {{ forloop.index | times: 0.1 | round: 1 }}s;" {{ block.shopify_attributes }}>
<div class="a10-2026__mode-image">{%- assign a10_image = block.settings.image -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media">{{ a10_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '100, 200, 300', sizes: '(max-width: 749px) 54px, 100px', alt: a10_image.alt }}</picture>
{%- endif -%}</div>
<h3>{{ block.settings.text | escape | newline_to_br }}</h3>

<div class="a10-2026__body">{{ block.settings.text1 | replace: 'ムダ毛ケア または', 'ムダ毛ケア<br>または' }}</div>
</article>
{% endfor %}
<div class="a10-2026__mode-end">{% assign a10_label_lines = section.settings.strong_label | newline_to_br | split: '<br />' %}{% for line in a10_label_lines %}<span{% if forloop.first %} class="a10-2026__mode-strength"{% endif %}>{{ line | strip | escape }}</span>{% endfor %}</div>
</div>
</div>
</div>
</section>

<style>
#a10-max-care-modes-2026-{{ section.id }} { color: #190a0a;  overflow: hidden; }
#a10-max-care-modes-2026-{{ section.id }} *, #a10-max-care-modes-2026-{{ section.id }} *::before, #a10-max-care-modes-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-care-modes-2026-{{ section.id }} h2, #a10-max-care-modes-2026-{{ section.id }} h3, #a10-max-care-modes-2026-{{ section.id }} p { margin: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-care-modes-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-care-modes-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-care-modes-2026-{{ section.id }}.a10-2026__modes { padding: 53.15px 0 64.43px; background: #fff; }
#a10-max-care-modes-2026-{{ section.id }} > .a10-2026__container { width: 100%; max-width: 1300px; padding-inline: 40px; margin-inline: auto; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-list { display: grid; grid-template-columns: 8.607% repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)) 8.607%; align-items: start; column-gap: clamp(16px, 3.3vw, 63.14px); }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-end { background: #f0f0f0; border-radius: 50%; aspect-ratio: 1; width: 100%; margin-top: 54.71px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #000; font-size: 20px; line-height: 1.3; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-end:first-child { color: #6b6b6b; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-strength { font-size: 32px; font-weight: 700; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode { position: relative; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: 100px auto auto; justify-items: center; align-content: start; text-align: center; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode + .a10-2026__mode::before { content: '→'; position: absolute; right: calc(100% + clamp(16px, 3.3vw, 63.14px) / 2); top: 78px; transform: translateX(50%); font-size: 30px; line-height: 1; color: #000; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-image { width: 100px; height: 100px; grid-column: 1; grid-row: 1; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-image .a10-2026__media, #a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-image img { width: 100%; height: 100%; object-fit: contain; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode h3 { grid-column: 1; grid-row: 2; background: #fdebf1; border-radius: 80px; padding: 0 10px; margin-top: 15.21px; font-size: 16px; font-weight: 500; line-height: 1.5; letter-spacing: 0; color: #000; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode:nth-child(3) h3 { background: #fbd9e4; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode:nth-child(4) h3 { background: #f7bfd2; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode:nth-child(5) h3 { background: #f6b3ca; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode .a10-2026__body { grid-column: 1; grid-row: 3; width: 100%; margin-top: 12.21px; font-size: 14px; font-weight: 400; line-height: 1.5; text-align: center; }
@media (min-width:750px) and (max-width:1099px) {
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-list { column-gap: 16px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode + .a10-2026__mode::before { right: calc(100% + 8px); font-size: 22px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode h3 { padding-inline: 6px; font-size: 13px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-strength { font-size: 26px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-end { font-size: 16px; }
}
@media (max-width:749px) {
#a10-max-care-modes-2026-{{ section.id }}.a10-2026__modes { padding: 48.32px 0 43.02px; }
#a10-max-care-modes-2026-{{ section.id }} > .a10-2026__container { max-width: 439px; padding-inline: 32px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-list { display: flex; flex-direction: column; align-items: stretch; gap: 0; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-end { width: 63.98px; height: 63.98px; margin: 0 0 0 calc(50% - 42.89px); font-size: 14px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-strength { font-size: 20px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode { grid-template-columns: 53.56px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 19.43px; row-gap: 5px; justify-items: start; margin-left: 24.92px; text-align: left; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-end + .a10-2026__mode { margin-top: 31.27px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode + .a10-2026__mode { margin-top: 45.23px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode:nth-child(3) { margin-top: 52px; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode-image { width: 53.56px; height: 53.56px; grid-column: 1; grid-row: 1 / 3; align-self: center; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode h3 { grid-column: 2; grid-row: 1; margin: 0; font-size: 16px; line-height: 1.5; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode .a10-2026__body { grid-column: 2; grid-row: 2; margin: 0; font-size: 14px; line-height: 1.5; text-align: left; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode + .a10-2026__mode::before { content: '↓'; left: calc(50% - 23.37px); right: auto; top: -36px; transform: translateX(-50%); font-size: 18px; line-height: 1; }
#a10-max-care-modes-2026-{{ section.id }} .a10-2026__mode + .a10-2026__mode-end { margin-top: 26.2px; }
}

/* Keep short copy inside clipped cards while it enters the viewport. */
@media (prefers-reduced-motion: no-preference) {
#a10-max-care-modes-2026-{{ section.id }} .to-top:not(.appear) { transform: translateY(20px); }
}

</style>

{% schema %}
{
  "name": "A10 Max 四种模式",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "weak_label",
      "label": "弱输出文案",
      "default": "弱\n出力"
    },
    {
      "type": "textarea",
      "id": "strong_label",
      "label": "强输出文案",
      "default": "強\n出力"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "richtext",
          "id": "text1",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A10 Max 四种模式",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Fastモード",
            "text1": "<p>細くて柔らかいムダ毛ケア または4週間継続使用後の日常ケア</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Normalモード",
            "text1": "<p>脇、VIOや男性のヒゲなどの硬くて太い毛ケア</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Highモード",
            "text1": "<p>28Jハイパワーで、VIO、脇や男性のヒゲなどの硬くて太い毛ケア</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "USHRモード",
            "text1": "<p>ファストモードより照射パワーがUP。脚、腕などの全身ケア</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
