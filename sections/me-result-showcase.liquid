{% assign sid = section.id %}
<section id="me-result-showcase-{{ sid }}" class="me-result-showcase" style="--bg:{{ section.settings.background }};">
  {% if section.settings.image != blank %}<picture class="me-result-showcase__bg">{% if section.settings.image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.image_mobile | image_url: width:1000 }}">{% endif %}{{ section.settings.image | image_url: width:2400 | image_tag: class: 'me-result-showcase__bg-image', loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400' }}</picture>{% endif %}
  <div class="me-result-showcase__content"><div class="me-result-showcase__desktop"><div class="me-result-showcase__title">{{ section.settings.title_html }}</div><div class="me-result-showcase__description">{{ section.settings.description_html }}</div></div><div class="me-result-showcase__mobile"><div class="me-result-showcase__title">{{ section.settings.title_html_mobile }}</div><div class="me-result-showcase__description">{{ section.settings.description_html_mobile }}</div></div>{% if section.settings.bottom_image != blank or section.settings.bottom_image_mobile != blank %}{% assign fallback = section.settings.bottom_image | default: section.settings.bottom_image_mobile %}<picture class="me-result-showcase__bottom">{% if section.settings.bottom_image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.bottom_image_mobile | image_url: width:720 }}">{% endif %}{{ fallback | image_url: width:800 | image_tag: loading: 'lazy' }}</picture>{% endif %}</div>
</section>
<style>
 #me-result-showcase-{{ sid }}{position:relative;min-height:710px;overflow:hidden;background:var(--bg)}#me-result-showcase-{{ sid }} .me-result-showcase__bg{position:absolute;inset:0;display:block}#me-result-showcase-{{ sid }} .me-result-showcase__bg-image{display:block;width:100%;height:100%;object-fit:cover}#me-result-showcase-{{ sid }} .me-result-showcase__content{position:relative;z-index:1;width:min(455px,31vw);padding-top:150px;margin-left:max(24px,calc((100% - 1280px)/2));color:#111}#me-result-showcase-{{ sid }} h2,#me-result-showcase-{{ sid }} h3{margin:0;font-size:42px;line-height:1.25}#me-result-showcase-{{ sid }} p{margin:25px 0 0;font-size:15px;line-height:1.8}#me-result-showcase-{{ sid }} .me-result-showcase__bottom{display:block;width:300px;max-width:100%;margin-top:36px}#me-result-showcase-{{ sid }} .me-result-showcase__bottom img{display:block;width:100%;height:auto}#me-result-showcase-{{ sid }} .me-result-showcase__mobile{display:none}@media(max-width:749px){#me-result-showcase-{{ sid }}{min-height:680px}#me-result-showcase-{{ sid }} .me-result-showcase__content{width:auto;padding:44px 18px 0;margin:0}#me-result-showcase-{{ sid }} .me-result-showcase__desktop{display:none}#me-result-showcase-{{ sid }} .me-result-showcase__mobile{display:block}#me-result-showcase-{{ sid }} h2,#me-result-showcase-{{ sid }} h3{font-size:25px}#me-result-showcase-{{ sid }} p{margin-top:13px;font-size:11px;line-height:1.7}#me-result-showcase-{{ sid }} .me-result-showcase__bottom{width:240px;margin-top:26px}}
  #me-result-showcase-{{ sid }} .me-result-showcase__title,
  #me-result-showcase-{{ sid }} .me-result-showcase__title p { margin: 0; font-size: 40px; line-height: 1.28; font-weight: 600; letter-spacing: -.035em; }
  #me-result-showcase-{{ sid }} .me-result-showcase__description { margin-top: 24px; }
  #me-result-showcase-{{ sid }} .me-result-showcase__description p { margin: 0; font-size: 14px; line-height: 1.8; font-weight: 400; }
  @media (max-width: 749px) {
    #me-result-showcase-{{ sid }} .me-result-showcase__title,
    #me-result-showcase-{{ sid }} .me-result-showcase__title p { font-size: 25px; line-height: 1.32; }
    #me-result-showcase-{{ sid }} .me-result-showcase__description { margin-top: 14px; }
    #me-result-showcase-{{ sid }} .me-result-showcase__description p { font-size: 12px; line-height: 1.7; }
  }
</style>
{% schema %}{"name":"Ulike ME 效果模块","settings":[{"type":"image_picker","id":"image","label":"PC 背景图"},{"type":"image_picker","id":"image_mobile","label":"移动端背景图"},{"type":"html","id":"title_html","label":"PC 标题（HTML）"},{"type":"html","id":"description_html","label":"PC 描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"description_html_mobile","label":"移动端描述（HTML）"},{"type":"image_picker","id":"bottom_image","label":"PC 底部图片"},{"type":"image_picker","id":"bottom_image_mobile","label":"移动端底部图片"},{"type":"color","id":"background","label":"背景","default":"#edf6fe"}],"presets":[{"name":"Ulike ME 效果模块"}]}{% endschema %}
