    const select = root.querySelector('[data-store-select]');
    const trigger = root.querySelector('[data-store-trigger]');
    const selectedLabel = root.querySelector('[data-store-selected]');
    const menu = root.querySelector('[data-store-menu]');
    const options = root.querySelector('[data-store-options]');
    const list = root.querySelector('[data-store-list]');
    const closeMenu = () => {
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    };
    const openMenu = () => {
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
    };
    Object.keys(storeData).forEach((prefecture) => {
      select.add(new Option(prefecture, prefecture));
      const option = document.createElement('button');
      option.type = 'button';
      option.className = 'where-to-purchase__select-option';
      option.setAttribute('role', 'option');
      option.dataset.value = prefecture;
      option.textContent = prefecture;
      option.addEventListener('click', () => {
        select.value = prefecture;
        select.dispatchEvent(new Event('change', { bubbles: true }));
        closeMenu();
        trigger.focus();
      });
      options.appendChild(option);
    });
    const render = (prefecture) => {
      const fragment = document.createDocumentFragment();
      storeData[prefecture].forEach((item) => {
        const store = Array.isArray(item) ? item : [item];
        const card = document.createElement('article');
        card.className = 'where-to-purchase__store';
        const title = document.createElement('h4');
        title.textContent = store[0];
        card.appendChild(title);
        if (store[1] || store[2]) {
          const details = document.createElement('div');
          details.className = 'where-to-purchase__store-details';
          if (store[1]) {
            const address = document.createElement('p');
            address.textContent = `住所：${store[1]}`;
            details.appendChild(address);
          }
          if (store[2]) {
            const phone = document.createElement('p');
            phone.textContent = `電話番号：${store[2]}`;
            details.appendChild(phone);
          }
          card.appendChild(details);
        }
        fragment.appendChild(card);
      });
      list.replaceChildren(fragment);
      list.scrollTop = 0;
    };
    const updateSelection = (prefecture) => {
      selectedLabel.textContent = prefecture;
      options
        .querySelectorAll('[role="option"]')
        .forEach((option) => option.setAttribute('aria-selected', String(option.dataset.value === prefecture)));
      render(prefecture);
    };
    trigger.addEventListener('click', () => (menu.hidden ? openMenu() : closeMenu()));
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
    select.addEventListener('change', (event) => updateSelection(event.target.value));
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target) || !event.target.closest('.where-to-purchase__select-wrap')) closeMenu();
    });
    updateSelection(select.value);
  })();
</script>

