{%- liquid
  assign hero_desktop = section.settings.hero_desktop
  assign hero_mobile = section.settings.hero_mobile
  assign amazon_url = section.settings.amazon_url | default: 'https://www.amazon.co.jp/ulike/'
  assign rakuten_url = section.settings.rakuten_url | default: 'https://www.rakuten.ne.jp/gold/ulike-store/'
  assign qoo10_url = section.settings.qoo10_url | default: 'https://www.qoo10.jp/shop/ulikejpofficial'
  assign tiktok_url = section.settings.tiktok_url | default: 'https://www.tiktok.com/@ulikejp'
  assign yahoo_url = section.settings.yahoo_url | default: 'https://store.shopping.yahoo.co.jp/ulike/'
-%}
<section
  id="where-to-purchase-{{ section.id }}"
  class="where-to-purchase"
  aria-label="{{ section.settings.hero_title | escape }}"
>
  <div class="where-to-purchase__hero">
    <picture class="where-to-purchase__hero-media">
      <source
        media="(max-width: 749px)"
        srcset="{% if hero_mobile != blank %}{{ hero_mobile | image_url: width: 1440 }}{% else %}{{ 'where-to-purchase-hero-mobile.jpg' | asset_url }}{% endif %}"
      >
      {%- if hero_desktop != blank -%}
        {{
          hero_desktop
          | image_url: width: 2560
          | image_tag:
            class: 'where-to-purchase__hero-image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '960, 1440, 1920, 2560',
            sizes: '100vw',
            alt: section.settings.hero_title
        }}
      {%- else -%}
        <img
          class="where-to-purchase__hero-image"
          src="{{ 'where-to-purchase-hero-desktop.jpg' | asset_url }}"
          width="2560"
          height="1155"
          loading="eager"
          fetchpriority="high"
          alt="{{ section.settings.hero_title | escape }}"
        >
      {%- endif -%}
    </picture>
    <div class="where-to-purchase__hero-copy">
      <h1>{{ section.settings.hero_title | escape }}</h1>
      <p>{{ section.settings.hero_text | escape }}</p>
    </div>
  </div>

  <div class="where-to-purchase__offline-intro">
    <div class="where-to-purchase__intro">
      <img
        class="where-to-purchase__icon"
        src="{% if section.settings.location_icon != blank %}{{ section.settings.location_icon | image_url: width: 100 }}{% else %}{{ 'where-to-purchase-location.svg' | asset_url }}{% endif %}"
        width="50"
        height="50"
        loading="lazy"
        alt=""
      >
      <div class="where-to-purchase__copy">
        <h2>{{ section.settings.offline_title | escape }}</h2>
        <p>{{ section.settings.offline_text | escape | newline_to_br }}</p>
      </div>
    </div>
    <div class="where-to-purchase__picker">
      <h3>{{ section.settings.store_list_title | escape }}</h3>
      <label class="visually-hidden" for="store-prefecture-{{ section.id }}">都道府県</label>
      <div class="where-to-purchase__select-wrap">
        <select
          id="store-prefecture-{{ section.id }}"
          class="where-to-purchase__native-select visually-hidden"
          data-store-select
          tabindex="-1"
          aria-hidden="true"
          aria-controls="store-list-{{ section.id }}"
        ></select>
        <button
          class="where-to-purchase__select-trigger"
          type="button"
          data-store-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="store-options-{{ section.id }}"
        >
          <span data-store-selected>北海道</span>
          <span class="where-to-purchase__select-arrow" aria-hidden="true"></span>
        </button>
        <div
          id="store-options-{{ section.id }}"
          class="where-to-purchase__select-menu"
          data-store-menu
          role="listbox"
          aria-label="都道府県"
          hidden
        >
          <div class="where-to-purchase__select-menu-label">都道府県</div>
          <div data-store-options></div>
        </div>
      </div>
    </div>
  </div>

  <div class="where-to-purchase__stores-shell">
    <div id="store-list-{{ section.id }}" class="where-to-purchase__stores" data-store-list aria-live="polite"></div>
  </div>

  <div class="where-to-purchase__online">
    <div class="where-to-purchase__intro">
      <img
        class="where-to-purchase__icon"
        src="{% if section.settings.online_icon != blank %}{{ section.settings.online_icon | image_url: width: 100 }}{% else %}{{ 'where-to-purchase-online-icon.svg' | asset_url }}{% endif %}"
        width="50"
        height="50"
        loading="lazy"
        alt=""
      >
      <div class="where-to-purchase__copy">
        <h2>{{ section.settings.online_title | escape }}</h2>
        <p>{{ section.settings.online_text | escape | newline_to_br }}</p>
      </div>
    </div>
    <h3 class="where-to-purchase__online-heading">{{ section.settings.online_list_title | escape }}</h3>
    <div class="where-to-purchase__online-grid">
      {% if section.settings.amazon_logo != blank %}
        <a href="{{ amazon_url }}" target="_blank" rel="noopener" aria-label="Amazon"
          ><img
          src="{{ section.settings.amazon_logo | image_url: width: 300 }}"
          width="123"
          height="46"
          loading="lazy"
          alt="Amazon"
        ></a>
      {% endif %}
      {% if section.settings.rakuten_logo != blank %}
        <a href="{{ rakuten_url }}" target="_blank" rel="noopener" aria-label="Rakuten"
          ><img
          src="{{ section.settings.rakuten_logo | image_url: width: 300 }}"
          width="101"
          height="30"
          loading="lazy"
          alt="Rakuten"
        ></a>
      {% endif %}
      {% if section.settings.qoo10_logo != blank %}
        <a href="{{ qoo10_url }}" target="_blank" rel="noopener" aria-label="Qoo10"
          ><img
          src="{{ section.settings.qoo10_logo | image_url: width: 300 }}"
          width="94"
          height="24"
          loading="lazy"
          alt="Qoo10"
        ></a>
      {% endif %}
      {% if section.settings.tiktok_logo != blank %}
        <a href="{{ tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok Shop"
          ><img
          src="{{ section.settings.tiktok_logo | image_url: width: 300 }}"
          width="105"
          height="28"
          loading="lazy"
          alt="TikTok Shop"
        ></a>
      {% endif %}
      {% if section.settings.yahoo_logo != blank %}
        <a href="{{ yahoo_url }}" target="_blank" rel="noopener" aria-label="Yahoo!ショッピング"
          ><img
          src="{{ section.settings.yahoo_logo | image_url: width: 300 }}"
          width="180"
          height="90"
          loading="lazy"
          alt="Yahoo! JAPAN"
        ></a>
      {% endif %}
    </div>
  </div>
</section>

