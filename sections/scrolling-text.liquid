<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
    --section-grid-gap: {{ section.settings.grid_horizontal }}px;
  }

  #shopify-section-{{ section.id }} .scrolling-text__marquee {
    --scroll-duration: {{ 40.0 | divided_by: section.settings.speed }}s;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .scrolling-text__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: scrolling-text-{{ section.id }} var(--scroll-duration) linear infinite;
  }

  #shopify-section-{{ section.id }} .scrolling-text__marquee--right .scrolling-text__track {
    animation-direction: reverse;
  }

  #shopify-section-{{ section.id }} .scrolling-wrapper.with-left .scrolling-text__track {
    animation-direction: normal;
  }

  #shopify-section-{{ section.id }} .scrolling-wrapper.with-right .scrolling-text__track {
    animation-direction: reverse;
  }

  #shopify-section-{{ section.id }} .scrolling-text__marquee:hover .scrolling-text__track,
  #shopify-section-{{ section.id }} .scrolling-text__marquee:focus-within .scrolling-text__track {
    animation-play-state: paused;
  }

  #shopify-section-{{ section.id }} .scrolling-text__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--section-grid-gap);
    padding-inline-end: var(--section-grid-gap);
    white-space: nowrap;
  }

  @media screen and (min-width: 900px) and (max-width: 1600px) {
    #shopify-section-{{ section.id }} .scrolling-text__group {
      gap: calc(var(--section-grid-gap) * 0.8);
    }
  }

  #shopify-section-{{ section.id }} .scrolling-text__item {
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .scrolling-text__item.with-text {
    font-size: var(--font-size);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .scrolling-text__item.with-media {
    height: var(--image-height);
  }

  #shopify-section-{{ section.id }} .scrolling-text__item.with-media img,
  #shopify-section-{{ section.id }} .scrolling-text__item.with-media .placeholder {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }

  @keyframes scrolling-text-{{ section.id }} {
    to { transform: translate3d(calc(-1 * var(--scroll-distance, 50%)), 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .scrolling-text__track { animation: none; }
  }

  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: min({{ section.settings.padding_top }}px, 20px);
      --section-padding-bottom: min({{ section.settings.padding_bottom }}px, 20px);
    }

    #shopify-section-{{ section.id }} .scrolling-text__group {
      gap: clamp(20px, 6vw, 32px);
      padding-inline-end: clamp(20px, 6vw, 32px);
    }
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .section {
      display: flex;
      height: 180px;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .section > .relative {
      width: 100%;
    }
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}{% if section.settings.enable_twin %} section--plain{% endif %}">
  <div class="relative z-1">
    {%- assign direction = section.settings.direction -%}
    {%- capture marquee_items -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div class="scrolling-text__item with-text{% if block.settings.stencil_text %} with-stencil{% endif %} {{ block.settings.text_font }} tracking-heading" style="--font-size: {{ block.settings.text_size }}px;" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </div>
          {%- when 'image' -%}
            {%- liquid
              assign image_height = block.settings.height
              assign image_height_2x = block.settings.height | times: 2
            -%}
            <div class="scrolling-text__item with-media" style="--image-height: {{ image_height }}px;" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  srcset="{{ block.settings.image | image_url: height: image_height }} 1x, {{ block.settings.image | image_url: height: image_height_2x }} 2x"
                  src="{{ block.settings.image | image_url: height: image_height }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ image_height | times: block.settings.image.aspect_ratio }}"
                  height="{{ image_height }}"
                >
              {%- else -%}
                {{- 'logo' | placeholder_svg_tag: 'placeholder' -}}
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- capture marquee -%}
      <div class="scrolling-text__marquee scrolling-text__marquee--{{ direction }}" data-scrolling-text-marquee>
        <div class="scrolling-text__track">
          <div class="scrolling-text__group" data-scrolling-text-source>
            {{- marquee_items -}}
          </div>
        </div>
      </div>
    {%- endcapture -%}

    {%- if section.blocks.size > 0 -%}
      {%- if section.settings.enable_twin -%}
        {%- liquid
          assign direction = section.settings.direction
          if direction == 'left'
            assign reversed = 'right'
          else
            assign reversed = 'left'
          endif
        -%}
        <div class="scrolling-wrapper with-{{ direction }} relative z-1">
          {%- assign direction = section.settings.direction -%}
          {{- marquee -}}
        </div>
        <div class="scrolling-wrapper with-{{ reversed }} relative">
          {%- assign direction = reversed -%}
          {{- marquee -}}
        </div>
      {%- else -%}
        {%- assign direction = section.settings.direction -%}
        {{- marquee -}}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section || section.dataset.scrollingTextReady) return;
    section.dataset.scrollingTextReady = 'true';

    const rebuild = (marquee) => {
      const track = marquee.querySelector('.scrolling-text__track');
      const source = marquee.querySelector('[data-scrolling-text-source]');
      if (!track || !source) return;

      track.querySelectorAll('[data-scrolling-text-clone]').forEach((clone) => clone.remove());
      const template = source._scrollingTextTemplate || (source._scrollingTextTemplate = source.innerHTML);
      source.innerHTML = template;
      const originalItems = Array.from(source.children);
      if (!originalItems.length) return;

      let repeats = 0;
      while (source.getBoundingClientRect().width < marquee.getBoundingClientRect().width * 1.25 && repeats < 20) {
        originalItems.forEach((item) => source.append(item.cloneNode(true)));
        repeats += 1;
      }

      const clone = source.cloneNode(true);
      clone.dataset.scrollingTextClone = 'true';
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelectorAll('[id]').forEach((element) => element.removeAttribute('id'));
      track.append(clone);
      track.style.setProperty('--scroll-distance', `${source.getBoundingClientRect().width}px`);
    };

    const marquees = Array.from(section.querySelectorAll('[data-scrolling-text-marquee]'));
    const refresh = () => marquees.forEach(rebuild);
    requestAnimationFrame(refresh);

    const resizeObserver = new ResizeObserver(() => requestAnimationFrame(refresh));
    marquees.forEach((marquee) => {
      resizeObserver.observe(marquee);
      marquee.querySelectorAll('img').forEach((image) => image.addEventListener('load', refresh, { once: true }));
    });

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target === section) resizeObserver.disconnect();
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.scrolling-text.name",
  "class": "scrolling-text-section",
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "options": [
        {
          "value": "left",
          "label": "t:sections.scrolling-text.settings.direction.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.scrolling-text.settings.direction.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.scrolling-text.settings.direction.label"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 0.5,
      "max": 2.5,
      "step": 0.1,
      "label": "t:sections.scrolling-text.settings.speed.label",
      "unit": "t:sections.scrolling-text.settings.speed.unit",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "grid_horizontal",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 70,
      "unit": "px",
      "label": "t:sections.scrolling-text.settings.grid_horizontal.label"
    },
    {
      "type": "checkbox",
      "id": "enable_twin",
      "label": "t:sections.scrolling-text.settings.enable_twin.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "t:sections.global.settings.enable_parallax.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.global.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.global.settings.text.label"
        },
        {
          "type": "range",
          "id": "text_size",
          "default": 160,
          "min": 12,
          "max": 180,
          "step": 2,
          "unit": "px",
          "label": "t:sections.global.settings.text_size.label"
        },
        {
          "type": "select",
          "id": "text_font",
          "options": [
            {
              "value": "body",
              "label": "t:sections.global.settings.text_font.options__1.label"
            },
            {
              "value": "heading",
              "label": "t:sections.global.settings.text_font.options__2.label"
            }
          ],
          "default": "body",
          "label": "t:sections.global.settings.text_font.label"
        },
        {
          "type": "checkbox",
          "id": "stencil_text",
          "label": "t:sections.scrolling-text.blocks.text.settings.stencil_text.label",
          "info": "t:sections.scrolling-text.blocks.text.settings.stencil_text.info",
          "default": false
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.global.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.global.settings.image.label"
        },
        {
          "type": "range",
          "id": "height",
          "min": 0,
          "max": 200,
          "step": 4,
          "default": 80,
          "unit": "px",
          "label": "t:sections.scrolling-text.blocks.image.settings.image_height.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.scrolling-text.presets.name",
      "blocks": [
        {
          "type": "text"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["custom.overlay"]
  }
}
{% endschema %}
