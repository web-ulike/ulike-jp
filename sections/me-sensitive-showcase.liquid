{% assign sid = section.id %}
<section id="me-sensitive-showcase-{{ sid }}" class="me-sensitive-showcase" style="--bg:{{ section.settings.background }};">
  {% if section.settings.image != blank %}<picture class="me-sensitive-showcase__bg">{% if section.settings.image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.image_mobile | image_url: width:1000 }}">{% endif %}{{ section.settings.image | image_url: width:2400 | image_tag: class: 'me-sensitive-showcase__bg-image', loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400' }}</picture>{% endif %}
  <div class="me-sensitive-showcase__content"><div class="me-sensitive-showcase__desktop">{{ section.settings.title_html }}{{ section.settings.description_html }}</div><div class="me-sensitive-showcase__mobile">{{ section.settings.title_html_mobile }}{{ section.settings.description_html_mobile }}</div></div>
</section>
<style>
 #me-sensitive-showcase-{{ sid }}{position:relative;min-height:720px;overflow:hidden;background:var(--bg)}#me-sensitive-showcase-{{ sid }} .me-sensitive-showcase__bg{position:absolute;inset:0;display:block}#me-sensitive-showcase-{{ sid }} .me-sensitive-showcase__bg-image{display:block;width:100%;height:100%;object-fit:cover}#me-sensitive-showcase-{{ sid }} .me-sensitive-showcase__content{position:relative;z-index:1;width:min(450px,31vw);padding-top:260px;margin-left:calc(50% + 45px);color:#111}#me-sensitive-showcase-{{ sid }} h2,#me-sensitive-showcase-{{ sid }} h3{margin:0;font-size:42px;line-height:1.28}#me-sensitive-showcase-{{ sid }} p{margin:27px 0 0;font-size:15px;line-height:1.85}#me-sensitive-showcase-{{ sid }} .me-sensitive-showcase__mobile{display:none}@media(max-width:749px){#me-sensitive-showcase-{{ sid }}{min-height:640px}#me-sensitive-showcase-{{ sid }} .me-sensitive-showcase__content{width:auto;padding:44px 18px 0;margin:0}#me-sensitive-showcase-{{ sid }} .me-sensitive-showcase__desktop{display:none}#me-sensitive-showcase-{{ sid }} .me-sensitive-showcase__mobile{display:block}#me-sensitive-showcase-{{ sid }} h2,#me-sensitive-showcase-{{ sid }} h3{font-size:25px}#me-sensitive-showcase-{{ sid }} p{margin-top:13px;font-size:11px;line-height:1.7}}
</style>
{% schema %}{"name":"Ulike ME 敏感肌模块","settings":[{"type":"image_picker","id":"image","label":"PC 背景图"},{"type":"image_picker","id":"image_mobile","label":"移动端背景图"},{"type":"html","id":"title_html","label":"PC 标题（HTML）"},{"type":"html","id":"description_html","label":"PC 描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"description_html_mobile","label":"移动端描述（HTML）"},{"type":"color","id":"background","label":"背景","default":"#dceafa"}],"presets":[{"name":"Ulike ME 敏感肌模块"}]}{% endschema %}
