{% schema %}
{
  "name": "temperature-section",
  "blocks": [
        {
    "name": "xaxis",
    "type": "xaxis",
    "settings": [
       
      {
        "type": "text",
        "id": "text",
        "label": "Text"
      }
    ]
    },
      {
    "name": "yaxis",
    "type": "yaxis",
    "settings": [
       
      {
        "type": "text",
        "id": "text",
        "label": "Text"
      }
    ]
    }
  ],
  "settings": [
      {
        
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      },
    {
        "type": "image_picker",
        "id": "image",
        "label": "Images"
      },
      {
        "type": "image_picker",
        "id": "mobile_image",
        "label": "Mobile Images"
      },
     {
        
        "type": "text",
        "id": "tle",
        "label": "Title"
      },
           {
        
        "type": "text",
        "id": "left_tle",
        "label": "left Title"
      },
      {
        
        "type": "richtext",
        "id": "left_subtle",
        "label": "left subTitle"
      },
        {
      "type": "url",
      "id": "link_url",
      "label": "Button Link"
    },
     {
      "type": "text",
      "id": "link_text",
      "label": "Button Link Text"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#fff"
    },
     {
          "type": "range",
          "id": "border_raidus",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "border raidus",
          "default": 0
        },
        {
        
        "type": "richtext",
        "id": "left_note",
        "label": "left Note"
      },

       {
        
        "type": "text",
        "id": "line_txt1",
        "label": "Line Text1"
      },
       {
        
        "type": "text",
        "id": "line_txt2",
        "label": "Line Text2"
      },
       {
        
        "type": "text",
        "id": "line_txt3",
        "label": "Line Text3"
      },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
