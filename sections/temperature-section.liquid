                        <path d="M12.9051 25.0485C19.9173 25.0485 25.6016 21.2092 25.6016 14.2462V0.53418H0.208603V14.2462C0.208603 21.2092 5.89291 25.0485 12.9051 25.0485Z" fill="#40C4FC"/>
