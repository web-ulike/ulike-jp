<style>
     #shopify-section-{{ section.id }} {
      --section-background: {{ section.settings.background }};
       background: var(--section-background);
   }
.media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px);
  }
}

/* temperature-section start */
    @keyframes draw-line{
      100% {
          stroke-dashoffset: 0;
      }
    }

  table th, table td {
    text-align: left;
    line-height: normal;
    font-size: initial;
    padding: 0;
}
.temperature-section{
  position: relative;
}
.temperature__content-box{
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  display: flex;
    align-items: center;
    justify-content: center;
}
.temperature__content-container{
  padding: 68px 0;
}
.temperature__content-box h3{
  color: #000;
text-align: center;
font-size: 50px;
font-style: normal;
font-weight: 400;
line-height: 1.3;
margin-bottom: 54px;
}
.temperature__wrapper {
  display: flex;
  align-items: center;
  gap: 125px;
}
.temperature__wrapper .temperature__content-lt{
  flex: 1;
}
.temperature__wrapper .temperature__content-rt{
  width: 48%;
  background: rgba(255, 255, 255, 0.80);
}
.temperature__table-wrapper{
  padding: 66px 90px;
}
 .temperature__content-rt table{
    width: 100%;
    position: relative;
    box-shadow: none;
    border-radius: 0;
    border: none;
    border-collapse: initial;
}

.temperature__content-lt h4{
  color: #000;
font-size: 40px;
font-style: normal;
font-weight: 400;
line-height: 1.3;
margin-bottom: 23px;
}
.temperature__content-lt .temperature__content-txt{
  color: #000;
font-size: 18px;
font-style: normal;
font-weight: 350;
line-height: 1.5;
letter-spacing: 0.9px;
}
.temperature__content-box .temperature__content-note{
  color: rgba(0, 0, 0, 0.70);
font-size: 14px;
font-style: normal;
font-weight: 300;
line-height: 1.5;
letter-spacing: 0.7px;
margin-top: 44px;
}
.temperature__table-wrapper .chart .y-label{
  width: 10%;
  color: #000;
font-size: 23px;
font-style: normal;
font-weight: 250;
line-height: 2.5;
letter-spacing: 0.912px;
}
.temperature__table-wrapper .x-line{
  position: relative;
}
.temperature__table-wrapper .x-line::before{
  display: block;
  content: '';
  width: 100%;
  height: 1px;
  top: 0;
  left: 0;
  background: repeating-linear-gradient(
    to right,
    rgba(0, 0, 0, 0.5) 0,
    rgba(0, 0, 0, 0.5) 5px,
    transparent 5px,
    transparent 10px
  );
}
.temperature__table-wrapper .x-label{
  width: 14%;
  color: #000;
font-size: 23px;
font-style: normal;
font-weight: 250;
line-height: 2.5;
letter-spacing: -0.228px;
}
.table__bottom-wrapper{
  display: flex;
  padding-left: 10%;
  color: #000;
font-size: 12px;
font-style: normal;
font-weight: 300;
line-height: 1; 
letter-spacing: 0.48px;
justify-content: space-between;
margin-top: 28px;
}
.table__bottom-wrapper .table__bottom{
  display: flex;
  align-items: center;
  gap: 5px;
}
.table__bottom-wrapper .table__bottom-line{
  width: 15px;
  height: 3px;
  background: #000;
  display: block;
}
.table__bottom-wrapper .table__bottom-line2{
    background: #57C8F8;
}
.table__bottom-wrapper .table__bottom-line3{
    background: #E00004;
}
.temperature__table-container{
  position: relative;
}
.temperature__table-container .temperature__table-line1{
  position: absolute;
    top: 11%;
  left: 10%;
  width: 90%;
      stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
}
.temperature__content-rt.appear .temperature__table-container .temperature__table-line{
      animation: draw-line 2s ease forwards 1s;
}
.temperature__table-container .temperature__table-line2{
  position: absolute;
  top: 33%;
  left: 10%;
  width: 90%;
      stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
}
.temperature__table-container .temperature__table-line3{
  position: absolute;
  top: 34%;
  left: 10%;
  width: 90%;
      stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
}
.temperature__table-container .temperature__table-snowflake1{
  position: absolute;
top: 51%;
    left: 23%;
    opacity: 0;
}
.temperature__table-container .temperature__table-snowflake2{
  position: absolute;
top: 50%;
left: 38%;
opacity: 0;
}
.temperature__images-box img{
  min-height: 755px;
}
.temperature__content-rt .temperature__table-snowflake{
      transition: opacity 1s ease-in-out 2s;
}
.temperature__content-rt.appear .temperature__table-snowflake{
      opacity: 1;
}
.temperature-section .btn-link{
display: inline-flex;
padding: 14px 60px;
justify-content: center;
align-items: center;
gap: 10px;
border-radius: var(--br);
background:  var(--bg);
color: var(--cr);
text-align: center;
font-size: 20px;
font-style: normal;
margin-top:36px;
margin-bottom:60px;
}
.blast_friday-2025 .temperature__content-lt h4{
color:#FFFFFC;
}
.blast_friday-2025 .temperature__content-lt .temperature__content-txt{
color:#FFFFFC;
}
.blast_friday-2025  .temperature__content-box .temperature__content-note{
color: #FFF;
}
.blast_friday-2025.temperature-section .btn-link{
    border-radius: 0;
}
.temperature__content-note.mobile_show_box{
display:none;
}
@media (max-width: 1550px) {
  .temperature__wrapper {
    gap: 80px;
}
.temperature__table-wrapper {
    padding: 40px 60px;
}
}
@media (max-width: 991px) {
.temperature__wrapper{
  flex-direction: column;
  gap: 25px;
}
.temperature__images-box img{
  min-height: 627px;
}
.temperature__content-box h3{
  font-size: 28px;
margin-bottom: 15px;
}
.temperature__content-lt h4{
  font-size: 28px;
  text-align: left;
      margin-bottom: 15px;
}
.temperature__content-lt .temperature__content-txt{
  font-size: 14px;
}
.temperature__content-box .temperature__content-note{
  font-size: 10px;
  margin-top: 0px;
  position: absolute;
  bottom: 23px;
}
.temperature__wrapper .temperature__content-rt {
    width: 100%;
    max-width: 335px;
}
.temperature__content-container {
    padding: 43px 0px 23px;
}
.temperature__table-wrapper {
       padding: 27px 42px 20px;
    }
    .temperature__table-wrapper .chart .y-label {
    font-size: 10.493px;
line-height: 2.5;
letter-spacing: 0.42px;
}
.temperature__table-wrapper .x-label {
    font-size: 10px;
line-height: 2.5;
letter-spacing: -0.105px;
}
.table__bottom-wrapper {
   font-size: 10px;
   margin-top: 6px;
   flex-wrap: wrap;
   row-gap: 5px;
   column-gap: 10px;
}
.temperature__table-container .temperature__table-line1 {
    top: 0;
}
.temperature__table-container .temperature__table-line3 {
    top: 20%;
}
.temperature__table-container .temperature__table-snowflake1,.temperature__table-container .temperature__table-snowflake2{
  width: 13px;
  height: 13px;
  top: 45%;
}
.table__bottom-wrapper .table__bottom {
  width: calc(50% - 5px);
}
.temperature__table-container .temperature__table-line2 {
    top: 30.3%;
}
.temperature-section .btn-link{
  display:block;
          width: max-content;
padding: 11px 45px;
font-size: 15px;
margin:20px auto 0;
margin-left:0;
}
.temperature__content-box .temperature__content-note.visibile_note{
display:none;
}
.temperature__content-note.mobile_show_box{
display:block;
}
}
/* temperature-section  end*/
</style>
   <section>
 <div class="temperature-section{% if section.settings.custom_class!=blank %} {{section.settings.custom_class}}{% endif %}">
      <div class="temperature__images-box">
         {%- if section.settings.image -%}
        <picture class="temperature__images">
          <source media="(max-width: 767px)" srcset="{{section.settings.mobile_image | image_url }}">
          <img src="{{section.settings.image | image_url }}" alt=""></img>
        </picture>
        {%- endif -%}
      </div>
      <div class="temperature__content-box">
        <div class="temperature__content-container">
          <div class="jp-container">
             {%- if section.settings.tle != blank -%}
            <h3 class="to-top">{{section.settings.tle }}</h3>
             {%- endif -%}
            <div class="temperature__wrapper">
              <div class="temperature__content-lt to-top">
                 {%- if section.settings.left_tle != blank -%}
                <h4>{{ section.settings.left_tle }}</h4>
                 {%- endif -%}
                  {%- if section.settings.left_subtle != blank -%}
                <div class="temperature__content-txt">{{ section.settings.left_subtle }}</div>
                  {%- endif -%}

                   {%- if section.settings.link_text != blank -%}
                      <a href="{{ section.settings.link_url }}"  target="_blank" class="btn-link" style="--bg:{{ section.settings.button_background }};--cr:{{ section.settings.button_text_color }};--br:{{ section.settings.border_raidus }}px">{{ section.settings.link_text }}</a>
                         {%- endif -%}



                    {%- if section.settings.left_note != blank -%}
                <div class="temperature__content-note  {% if section.settings.link_text != blank %} visibile_note{% endif %}">{{ section.settings.left_note }}</div>
                {%- endif -%}
              </div>
              <div class="temperature__content-rt to-top">
                <div class="temperature__table-wrapper">
                  <div class="temperature__table-container">
                   <table class="chart">
                    <tbody>
                      <!-- y轴刻度行 -->
                        {%- for block in section.blocks -%}
                          {%- case block.type -%}
                         {%- when 'xaxis' -%}
                      <tr>
                        <td class="y-label">{{ block.settings.text  }}</td>
                        <td colspan="12" class="x-line"></td>
                      </tr>

                          {%- endcase -%}
                       {%- endfor -%}

                      <!-- x轴刻度 -->
                      <tr>
                        <td></td>
                          {%- for block in section.blocks -%}
                          {%- case block.type -%}
                         {%- when 'yaxis' -%}
                        <td class="x-label">{{ block.settings.text  }}</td>
                            {%- endcase -%}
                       {%- endfor -%}
                        <td colspan="6"></td>
                      </tr>
                      </tbody>
