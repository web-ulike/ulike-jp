                    <div class="table__bottom-wrapper">
                      <div class="table__bottom">
                        <div class="table__bottom-line table__bottom-line1"></div>
                        <div class="table__bottom-txt">{{section.settings.line_txt1 }}</div>
                      </div>
                       <div class="table__bottom">
                        <div class="table__bottom-line table__bottom-line2"></div>
                        <div class="table__bottom-txt">{{section.settings.line_txt2 }}</div>
                      </div>
                       <div class="table__bottom">
                        <div class="table__bottom-line table__bottom-line3"></div>
                        <div class="table__bottom-txt">{{section.settings.line_txt3 }}</div>
