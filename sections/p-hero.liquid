{%- if section.settings.air10_max_layout -%}

<section id="a10-max-{{ section.id }}" class="a10-2026 to-top a10-2026__lifestyle">{%- assign a10_image = section.settings.image | default: section.settings.image_mobile -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{% if section.settings.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 375 }} 375w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}{% if section.settings.title != blank %}
<h2 class="a10-2026__title">{{ section.settings.title | escape | newline_to_br }}</h2>
{% endif %}</section>

<style>
#a10-max-{{ section.id }}{ color: #190a0a;  overflow: hidden; }
#a10-max-{{ section.id }} *, #a10-max-{{ section.id }} *::before, #a10-max-{{ section.id }} *::after{ box-sizing: border-box; }
#a10-max-{{ section.id }} h2, #a10-max-{{ section.id }} h3, #a10-max-{{ section.id }} p{ margin: 0; }
#a10-max-{{ section.id }} .a10-2026__inner{ width: min(1220px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-{{ section.id }} .a10-2026__wide{ width: min(1600px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-{{ section.id }} .a10-2026__title{ font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-{{ section.id }} .a10-2026__body{ color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__body p + p{ margin-top: 0; }
#a10-max-{{ section.id }} .a10-2026__note{ color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__note p{ margin: 0; }
#a10-max-{{ section.id }} .a10-2026__media{ display: block; min-width: 0; }
#a10-max-{{ section.id }} .a10-2026__media img{ display: block; width: 100%; height: auto; }
#a10-max-{{ section.id }} .a10-2026__center{ text-align: center; }
#a10-max-{{ section.id }} .a10-2026__mobile{ display: none; }
#a10-max-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-{{ section.id }} .a10-2026__note a{ color: inherit; }
#a10-max-{{ section.id }} sup{ font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-{{ section.id }}.a10-2026__lifestyle{ position: relative; background: #fff; }
#a10-max-{{ section.id }}.a10-2026__lifestyle .a10-2026__title{ position: absolute; top: 15%; left: 20px; right: 20px; text-align: center;  letter-spacing: .1em; }
#a10-max-{{ section.id }}.a10-2026__lifestyle:not(:has(picture)) .a10-2026__title{ position: relative; padding: 60px 0; }
@media (min-width:750px) and (max-width:1400px){#a10-max-{{ section.id }} .a10-2026__title{ font-size: 32px; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 26px; }
}@media (max-width:749px){#a10-max-{{ section.id }} .a10-2026__inner, #a10-max-{{ section.id }} .a10-2026__wide{ width: calc(100% - 40px); }
#a10-max-{{ section.id }} .a10-2026__desktop{ display: none !important; }
#a10-max-{{ section.id }} .a10-2026__mobile{ display: block; }
#a10-max-{{ section.id }} .a10-2026__title{ font-size: 24px; line-height: 1.3; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 24px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__body{ font-size: 14px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__note{ font-size: 10px; line-height: 1.5; }
#a10-max-{{ section.id }}.a10-2026__lifestyle .a10-2026__title{ font-size: 24px; top: 10%; letter-spacing: .08em; }
}
</style>
{%- else -%}
{% comment %}
  Air Pro S landing page hero. Configure separate desktop and mobile artwork in the theme editor.
{% endcomment %}
{% assign sid = section.id %}

<style>
  .p-aps-hero {
    overflow: hidden;
    background: var(--p-hero-bg);
  }
  .p-aps-hero__inner {
    position: relative;
  }

  .p-aps-hero__media picture {
    display: block;
    width: 100%;
  }
  .p-aps-hero__image {
    display: block;
    width: 100%;
    height: auto;
  }
  .p-aps-hero__content {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: 0;
    left: 0;
    width: auto;
    transform: translateY(-50%);
    color: var(--p-hero-text);
    padding: 0;
  }
  .p-aps-hero__content-inner {
    width: 800px;
  }
  .p-aps-hero__title {
    margin: 0;
    font-size: 46px;
    line-height: 1.25;
    text-align: center;
    font-weight: 600;
  }
  .p-aps-hero__title em {
    font-style: normal;
    font-weight: 300;
  }
  .p-aps-hero__title--mobile {
    display: none;
  }
  .p-aps-hero__subtitle {
    margin: 14px 0 0;
    font-size: clamp(17px, 1.28vw, 25px);
    line-height: 1.4;
    letter-spacing: 0.06em;
  }
  .p-aps-hero__copy {
    margin: 28px 0 0;
    font-size: 14px;
    line-height: 1.8;
    letter-spacing: 0.08em;
  }
  .p-aps-hero__award {
    display: block;
    width: 780px;
    margin-top: 40px;
  }
  .p-aps-hero__note {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 94px;
    left: 0;
    width: auto;
    color: #000;
    font-size: 10px;
    line-height: 1.5;
    opacity: 0.5;
  }
  .p-aps-hero__note-inner {
    width: 600px;
    margin: 0;
    padding-left: 10%;
    text-align: center;
  }
  .p-aps-hero__note-inner--mobile {
    display: none;
  }
  @media screen and (max-width: 749px) {
    .p-aps-hero__inner {
      background: var(--p-hero-bg);
    }
    .p-aps-hero__media {
      position: relative;
    }
    .p-aps-hero__media picture,
    .p-aps-hero__image {
      width: 100%;
      height: auto;
    }
    .p-aps-hero__image {
      object-fit: initial;
    }
    .p-aps-hero__content {
      top: 50px;
      right: 0;
      bottom: auto;
      left: 0;
      width: auto;
      transform: none;
    }
    .p-aps-hero__content-inner {
      width: 100%;
    }
    .p-aps-hero__title {
      font-size: 20px;
      text-align: center;
    }
    .p-aps-hero__title--desktop {
      display: none;
    }
    .p-aps-hero__title--mobile {
      display: block;
    }
    .p-aps-hero__subtitle {
      margin-top: 8px;
      font-size: clamp(14px, 4.2vw, 17px);
    }
    .p-aps-hero__copy {
      margin-top: 14px;
      font-size: 11px;
      line-height: 1.65;
    }
    .p-aps-hero__award {
      width: 305px;
      margin: 24px auto 0;
    }
    .p-aps-hero__note {
      right: 0;
      bottom: 20px;
      left: 0;
      width: auto;
      font-size: 10px;
    }
    .p-aps-hero__note-inner {
      width: 100%;
      margin: 0;
      padding: 0;
      text-align: left;
    }
    .p-aps-hero__note-inner--desktop {
      display: none;
    }
    .p-aps-hero__note-inner--mobile {
      display: block;
    }
  }
</style>

<section
  id="p-hero-{{ sid }}"
  class="p-aps-hero"
  style="--p-hero-bg: {{ section.settings.background }}; --p-hero-text: {{ section.settings.text_color }};"
>
  <div class="p-aps-hero__inner">
    <div class="p-aps-hero__media">
      <picture>
        {% if section.settings.image_mobile != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w, {{ section.settings.image_mobile | image_url: width: 1600 }} 1600w, {{ section.settings.image_mobile | image_url: width: 2000 }} 2000w"
            sizes="100vw"
          >
        {% endif %}
        {% if section.settings.image != blank -%}
          {{-
            section.settings.image
            | image_url: width: 3840
            | image_tag: class: 'p-aps-hero__image', loading: 'eager', widths: '750, 1100, 1500, 1920, 2400, 3000, 3840', sizes: '100vw'
          -}}
        {%- endif %}
      </picture>
    </div>
    {% if section.settings.title != blank
      or section.settings.title_mobile != blank
      or section.settings.subtitle != blank
      or section.settings.copy != blank
      or section.settings.content_image != blank
    %}
      <div class="p-aps-hero__content container">
        <div class="p-aps-hero__content-inner">
          {% if section.settings.title != blank or section.settings.title_mobile != blank %}
            <h2 class="p-aps-hero__title p-aps-hero__title--desktop to-top">{{ section.settings.title }}</h2>
            <h2 class="p-aps-hero__title p-aps-hero__title--mobile to-top">{{ section.settings.title_mobile | default: section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.subtitle != blank %}
            <p class="p-aps-hero__subtitle to-top" style="transition-delay: .1s">{{ section.settings.subtitle }}</p>
          {% endif %}
          {% if section.settings.copy != blank %}
            <div class="p-aps-hero__copy to-top" style="transition-delay: .2s">{{ section.settings.copy }}</div>
          {% endif %}
          {% if section.settings.content_image != blank %}
            <picture>
              {% if section.settings.content_image_mobile != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ section.settings.content_image_mobile | image_url: width: 700 }}"
                >
              {% endif %}
              {{
                section.settings.content_image
                | image_url: width: 1200
                | image_tag: class: 'p-aps-hero__award to-top', style: 'transition-delay: .3s', loading: 'eager', widths: '360, 540, 760, 1000, 1200'
              }}
            </picture>
          {% endif %}
        </div>
      </div>
    {% endif %}
    {% if section.settings.note != blank or section.settings.note_mobile != blank %}
      <div class="p-aps-hero__note container">
        {% if section.settings.note != blank %}
          <p class="p-aps-hero__note-inner p-aps-hero__note-inner--desktop">{{ section.settings.note | escape | newline_to_br }}</p>
        {% endif %}
        <p class="p-aps-hero__note-inner p-aps-hero__note-inner--mobile">{{ section.settings.note_mobile | default: section.settings.note | escape | newline_to_br }}</p>
      </div>
    {% endif %}
  </div>
</section>


{%- endif -%}
{% schema %}
{
  "name": "P Air Pro S 首屏",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 主视觉图片（1920）"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端图片"
    },
    {
      "type": "html",
      "id": "title",
      "label": "标题",
      "default": "Ulike <em>Air Pro S</em>"
    },
    {
      "type": "html",
      "id": "title_mobile",
      "label": "移动端标题（留空则沿用标题）"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题",
      "default": "IPL光美容器"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "说明",
      "default": "<p>キレイもコスパも、欲張っていい。</p>"
    },
    {
      "type": "image_picker",
      "id": "content_image",
      "label": "文案区 PC 图片（奖项图）"
    },
    {
      "type": "image_picker",
      "id": "content_image_mobile",
      "label": "文案区移动端图片（奖项图）"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "底部注释"
    },
    {
      "type": "textarea",
      "id": "note_mobile",
      "label": "移动端底部注释（留空则沿用底部注释）"
    },
    {
      "type": "color",
      "id": "background",
      "label": "背景色",
      "default": "#f3f6f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字色",
      "default": "#101010"
    },
    {
      "type": "checkbox",
      "id": "air10_max_layout",
      "label": "使用 Air 10 Max 2026 设计",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "P 首屏"
    }
  ]
}
{% endschema %}
