{% assign sid = section.id %}

<style>
  #p-trust-{{ sid }} { padding: 100px 0 84px; background: var(--p-trust-bg); color: var(--p-trust-text); }
  #p-trust-{{ sid }} .p-aps-trust__in { margin: 0 auto; }
  #p-trust-{{ sid }} .p-aps-trust__lead {
    margin: 0;
    font-size: 48px;
    font-weight: 500;
    line-height: 1.45;
  }
  #p-trust-{{ sid }} .p-aps-trust__mobile { display: none; }
  #p-trust-{{ sid }} .p-aps-trust__row {
    display: grid;
    grid-template-columns: 530px 1fr;
    align-items: center;
    gap: 20px;
     margin-top: 50px; }
  #p-trust-{{ sid }} .p-aps-trust__award { display: block; width: 100%; height: auto; }
  #p-trust-{{ sid }} .p-aps-trust__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)); }
  #p-trust-{{ sid }} .p-aps-trust__stat { min-height: 86px;
    padding: 0px; border-left: 1px solid #dedede; text-align: center;
   }
  #p-trust-{{ sid }} .p-aps-trust__stat:first-child { border-left: 0; border-top: 0;  }
  #p-trust-{{ sid }} .p-aps-trust__mark { display: none; }
  #p-trust-{{ sid }} .p-aps-trust__mark img { display: block; width: 100%; height: 100%; object-fit: contain; }
  #p-trust-{{ sid }} .p-aps-trust__num {
    margin: 0;
    font-size: 66px;
    font-weight: 500;
    line-height: 1;
   }
  #p-trust-{{ sid }} .p-aps-trust__num sup {
    font-size: .52em;
    line-height: 1;
    margin-left: 2px;
    font-weight: bold;
    vertical-align: .2em;
   }
  #p-trust-{{ sid }} .p-aps-trust__label {
     margin: 10px 0 0; 
     font-size: 28px;
     font-weight: 500;
     line-height: 1.35;
  }
  #p-trust-{{ sid }} .p-aps-trust__label sup { 
    font-weight: bold;
    font-size: 12px;
    line-height: 1;
    margin-left: 2px;
    vertical-align: .4em; 
  }
  #p-trust-{{ sid }} .p-aps-trust__note {
     margin: 34px 0 0;
     color: #000;
     max-width: 530px;
      opacity: 0.5;
      font-size: 10px;
  }

  @media screen and (max-width: 749px) {
    #p-trust-{{ sid }} .p-aps-trust__desktop { display: none; }
    #p-trust-{{ sid }} .p-aps-trust__mobile { display: block; }
    #p-trust-{{ sid }} { padding: 40px 0 40px; }
    #p-trust-{{ sid }} > .jp-container { padding-right: 14px; padding-left: 14px; }
    #p-trust-{{ sid }} .p-aps-trust__in { width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box; }
    #p-trust-{{ sid }} .p-aps-trust__lead {
      font-size: 32px;
      font-weight: 600;
      line-height: 1.5;
      text-align: center;
    }
    #p-trust-{{ sid }} .p-aps-trust__row { display: block; margin-top: 26px; }
    #p-trust-{{ sid }} .p-aps-trust__award { width: min(282px, 100%); margin: 0 auto 28px; }
    #p-trust-{{ sid }} .p-aps-trust__row,
    #p-trust-{{ sid }} .p-aps-trust__stats { min-width: 0; max-width: 100%; }
    #p-trust-{{ sid }} .p-aps-trust__stats { display: block; margin: 0 6px; }
    #p-trust-{{ sid }} .p-aps-trust__stat {
      display: grid;
      grid-template-columns: clamp(48px, 14vw, 80px) minmax(0, 1fr);
      column-gap: clamp(12px, 4vw, 24px);
      align-items: center;
      min-height: clamp(98px, 31vw, 174px);
      padding: clamp(10px, 2vw, 18px) clamp(4px, 2vw, 16px);
      border-top: 1px solid #e8e8e8;
      border-left: 0;
      text-align: left;
    }
    #p-trust-{{ sid }} .p-aps-trust__stat > div { min-width: 0; }
    #p-trust-{{ sid }} .p-aps-trust__stat:last-child { border-bottom: 1px solid #e5e5e5; }
    #p-trust-{{ sid }} .p-aps-trust__mark { display: block; width: 100%; height: auto; aspect-ratio: 1; }
    #p-trust-{{ sid }} .p-aps-trust__num { font-size: 50px; font-weight: 500; line-height: .92; letter-spacing: -.045em; }
    #p-trust-{{ sid }} .p-aps-trust__num sup { 
      font-size: 30px;
      font-weight: bold;
      vertical-align: -0.2em;
      margin-left: 2px;
    }
    #p-trust-{{ sid }} .p-aps-trust__stat:nth-child(3) .p-aps-trust__num { font-size: 45px; }
    #p-trust-{{ sid }} .p-aps-trust__label { 
      margin: clamp(4px, 1vw, 8px) 0 0; 
      font-size: 14px;
    }
    #p-trust-{{ sid }} .p-aps-trust__label sup { font-size: 12px; vertical-align: -0.2em; }
    #p-trust-{{ sid }} .p-aps-trust__note {
      margin-top: 32px;
      color: #000;
      opacity: 0.5;
      font-size: 10px;
     }
  }
</style>

<section
  id="p-trust-{{ sid }}"
  class="p-aps-trust"
  style="--p-trust-bg: {{ section.settings.background }}; --p-trust-text: {{ section.settings.text_color }};"
>
  <div class="jp-container">
    <div class="p-aps-trust__in">
      {% if section.settings.heading_pc != blank %}
        <div class="p-aps-trust__lead p-aps-trust__desktop to-top">{{ section.settings.heading_pc }}</div>
      {% endif %}
      {% if section.settings.heading_mobile != blank %}
        <div class="p-aps-trust__lead p-aps-trust__mobile to-top">{{ section.settings.heading_mobile }}</div>
      {% endif %}
      <div class="p-aps-trust__row">
        {% if section.settings.award_image != blank -%}
          {{-
            section.settings.award_image
            | image_url: width: 800
            | image_tag:
              class: 'p-aps-trust__award to-top',
              style: 'transition-delay: .1s',
              loading: 'lazy',
              widths: '300, 500, 800'
          -}}
        {%- endif %}
        <div class="p-aps-trust__stats">
          {% for block in section.blocks %}
            <div
              class="p-aps-trust__stat to-top"
              style="transition-delay: .{{ forloop.index | plus: 1 }}s"
              {{ block.shopify_attributes }}
            >
              <span class="p-aps-trust__mark" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{
                    block.settings.icon_image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', widths: '80, 160'
                  }}
                {% endif %}
              </span>
              <div>
                <p class="p-aps-trust__num">{{ block.settings.number }}</p>
                <p class="p-aps-trust__label">{{ block.settings.label }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% if section.settings.note != blank %}
        <p class="p-aps-trust__note to-top" style="transition-delay: .5s">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "P Air Pro S 信赖背书",
  "max_blocks": 3,
  "settings": [
    { "type": "html", "id": "heading_pc", "label": "PC 标题 HTML", "default": "日本一だから、<br>安心して選べる。" },
    {
      "type": "html",
      "id": "heading_mobile",
      "label": "移动端标题 HTML",
      "default": "日本一だから、<br>安心して選べる。"
    },
    { "type": "image_picker", "id": "award_image", "label": "奖项图片" },
    { "type": "textarea", "id": "note", "label": "脚注" },
    { "type": "color", "id": "background", "label": "背景色", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "数据项",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "图标图片" },
        { "type": "html", "id": "number", "label": "数字", "default": "1000<sup>+</sup>" },
        { "type": "html", "id": "label", "label": "说明（支持 HTML）", "default": "取得特許<sup>*2</sup>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "P Air Pro S 信赖背书",
      "blocks": [
        { "type": "stat" },
        { "type": "stat", "settings": { "number": "10年<sup>+</sup>", "label": "IPL開発経験" } },
        { "type": "stat", "settings": { "number": "1000万<sup>+</sup>", "label": "販売台数" } }
      ]
    }
  ]
}
{% endschema %}
