{%- liquid
  if section.settings.show_image
    if article.image != blank
      assign article_image = article.image
    elsif section.settings.image != blank
      assign article_image = section.settings.image
    endif
  endif

  assign article_alt = article_image.alt | default: article.title

  assign number_of_comments = article.comments_count
  if comment.status == 'pending'
    assign number_of_comments = article.comments_count | plus: 1
  endif

  assign desktop_position = section.settings.content_position | split: ' '
  assign desktop_items = desktop_position | first | remove: 'md:items-'
  assign desktop_justify = desktop_position | last | remove: 'md:justify-'
  assign mobile_position = section.settings.content_position_mobile | split: ' '
  assign mobile_items = mobile_position | first | remove: 'items-'
  assign mobile_justify = mobile_position | last | remove: 'justify-'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if article_image != blank %}
      {%- render 'section-variables', section: section -%}
      {%- if section.settings.image_height == 'adapt' %}
        --ratio-percent: {{ 1 | divided_by: article_image.aspect_ratio | times: 100 }}%;
      {% endif -%}
    {% endif -%}
  }

  #shopify-section-{{ section.id }} .article-banner {
    display: block;
    position: relative;
    min-height: {% if article_image != blank and section.settings.image_height != 'adapt' %}{{ section.settings.image_height }}{% elsif article_image != blank %}min(56.25vw, 760px){% else %}0{% endif %};
    padding: 0;
    overflow: hidden;
    color: {% if article_image != blank %}{{ section.settings.color_text }}{% else %}#202124{% endif %};
    background: {% if article_image != blank %}#1f1f1f{% else %}#f7f7f8{% endif %};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .article-banner__media,
  #shopify-section-{{ section.id }} .article-banner__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .article-banner__media,
  #shopify-section-{{ section.id }} .article-banner__image {
    display: block;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .article-banner__image,
  #shopify-section-{{ section.id }} .article-banner__image img {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .article-banner__image img {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .article-banner__overlay {
    background: rgba({{ section.settings.color_overlay.rgb }}, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .article-banner__content {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .article-banner__inner {
    display: flex;
    align-items: {{ desktop_items }};
    justify-content: {{ desktop_justify }};
    min-height: {% if article_image != blank and section.settings.image_height != 'adapt' %}{{ section.settings.image_height }}{% elsif article_image != blank %}min(56.25vw, 760px){% else %}0{% endif %};
    padding-block: clamp(48px, 6vw, 96px);
  }

  #shopify-section-{{ section.id }} .article-banner:not(.article-banner--has-image) .article-banner__inner {
    padding-block: 32px 48px;
  }

  #shopify-section-{{ section.id }} .article-banner__box {
    width: fit-content;
    max-width: min(900px, 100%);
    text-align: {{ section.settings.text_alignment }};
  }

  #shopify-section-{{ section.id }} .article-banner__title-group {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .article-banner__tags,
  #shopify-section-{{ section.id }} .article-banner__meta-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }

  #shopify-section-{{ section.id }} .article-banner__meta-list {
    justify-content: {{ section.settings.text_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' }};
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .article-banner__meta-list li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .article-banner__meta-list li::after {
    content: none;
  }

  #shopify-section-{{ section.id }} .article-banner__title {
    order: 3;
    margin: 0;
    font-size: clamp(34px, 4.2vw, 64px);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .article-banner__title.title-sm { font-size: clamp(32px, 3vw, 44px); }
  #shopify-section-{{ section.id }} .article-banner__title.title-md { font-size: clamp(36px, 3.5vw, 52px); }
  #shopify-section-{{ section.id }} .article-banner__title.title-xl { font-size: clamp(42px, 5vw, 72px); }

  #shopify-section-{{ section.id }} .article-banner__title split-words {
    display: block;
  }

  #shopify-section-{{ section.id }} .article-banner__meta {
    order: 2;
    display: block;
  }

  #shopify-section-{{ section.id }} .article-banner__tags {
    order: 1;
  }

  #shopify-section-{{ section.id }} .article-banner__spacing {
    display: block;
    height: var(--spacing-height-desktop);
  }

  #shopify-section-{{ section.id }} .article-banner__breadcrumb {
    display: block;
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .article-banner__breadcrumb ul,
  #shopify-section-{{ section.id }} .article-banner__breadcrumb li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .article-banner__breadcrumb ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .article-banner,
    #shopify-section-{{ section.id }} .article-banner__inner {
      min-height: {% if article_image != blank and section.settings.image_height_mobile != 'auto' and section.settings.image_height_mobile != 'adapt' %}{{ section.settings.image_height_mobile }}{% elsif article_image != blank and section.settings.image_height_mobile == 'adapt' %}{{ 100 | divided_by: article_image.aspect_ratio }}vw{% elsif article_image != blank %}clamp(360px, 100vw, 520px){% else %}0{% endif %};
    }

    #shopify-section-{{ section.id }} .article-banner__inner {
      align-items: {{ mobile_items }};
      justify-content: {{ mobile_justify }};
      padding-block: 40px;
    }

    #shopify-section-{{ section.id }} .article-banner:not(.article-banner--has-image) .article-banner__inner {
      padding-block: 32px;
    }

    #shopify-section-{{ section.id }} .article-banner__box {
      width: 100%;
      text-align: {{ section.settings.text_alignment_mobile }};
    }

    #shopify-section-{{ section.id }} .article-banner__title-group { gap: 14px; }
    #shopify-section-{{ section.id }} .article-banner__title { order: 2; font-size: 36px; }
    #shopify-section-{{ section.id }} .article-banner__title.title-sm { font-size: 28px; }
    #shopify-section-{{ section.id }} .article-banner__title.title-md { font-size: 32px; }
    #shopify-section-{{ section.id }} .article-banner__title.title-xl { font-size: 40px; }
    #shopify-section-{{ section.id }} .article-banner__meta { order: 3; }
    #shopify-section-{{ section.id }} .article-banner__meta-list {
      justify-content: {{ section.settings.text_alignment_mobile | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' }};
    }
    #shopify-section-{{ section.id }} .article-banner__spacing { height: var(--spacing-height-mobile); }
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded{% endif %}"{% if section.settings.transparent_header and article_image != blank %} allow-transparent-header{% endif %}>
  <div class="{% unless section.settings.full_width %}container{% endunless %}">
    <article class="article banner article-banner{% if article_image != blank %} article-banner--has-image{% endif %}" itemscope itemtype="http://schema.org/BlogPosting">
      {%- if article_image != blank -%}
        <media-element class="banner__media article-banner__media"{% if section.settings.enable_parallax %} data-parallax="0.3" data-parallax-dir="{{ section.settings.parallax_direction }}"{% endif %}>
          <animate-element data-animate="zoom-out" class="media media--height article-banner__image" itemprop="image">
            {%- capture sizes -%}{% if section.settings.full_width %}100vw{% else %}min({{ settings.page_width }}px, 100vw){% endif %}{%- endcapture -%}
            {{- article_image | image_url: width: article_image.width | image_tag: loading: 'eager', widths: '300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', sizes: sizes, is: 'lazy-image', alt: article_alt -}}
          </animate-element>
        </media-element>
        <span class="banner__overlay article-banner__overlay"></span>
      {%- endif -%}
    
      {%- if section.blocks.size > 0 -%}
        <div class="banner__content article-banner__content">
          <div class="container article-banner__inner">
            <div class="banner__box article-banner__box">
              {%- assign delay = 0 -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  if block.type != 'spacing'
                    assign delay = delay | plus: 1
                  endif
                -%}
                {%- case block.type -%}
                  {%- when 'spacing' -%}
                    <empty-element class="spacing-section article-banner__spacing" style="--spacing-height-desktop: {{ block.settings.height }}px; --spacing-height-mobile: {{ block.settings.height_mobile }}px;" {{ block.shopify_attributes }}></empty-element>

                  {%- when 'breadcrumb' -%}
                    <animate-element class="article-banner__breadcrumb" data-animate="fade-up" data-animate-delay="{{ delay | times: 250 }}" {{ block.shopify_attributes }}>
                      <nav class="breadcrumb" aria-label="breadcrumbs">
                        <ul>
                          <li>
                            <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home_link_title' | t | escape }}" is="magnet-link">
                              {%- render 'icon', icon: 'home', size: 'sm' -%}
                            </a>
                          </li>
                          <li>
                            <a href="{{ blog.url }}" is="magnet-link">{{ blog.title }}</a>
                          </li>
                          <li>{{ article.title }}</li>
                        </ul>
                      </nav>
                    </animate-element>

                  {%- when 'title' -%}
                    <div class="article-banner__title-group" {{ block.shopify_attributes }}>
                      {%- if block.settings.show_tags and article.tags.size > 0 -%}
                        <animate-element class="article-banner__tags" data-animate="fade-up" data-animate-delay="{{ delay | times: 250 }}">
                          {%- if article.metafields.theme.tag_color.value != blank and article.metafields.theme.tag_background.value != blank -%}
                            {%- capture badge_style -%}
                              --badge-foreground: rgb({{ article.metafields.theme.tag_color.value.rgb }}); --badge-background: rgb({{ article.metafields.theme.tag_background.value.rgb }});
                            {%- endcapture -%}
                          {%- endif -%}
                          {%- for tag in article.tags -%}
                            {% if tag contains "_" %}{%- assign tag_starts_with = tag | slice: 0 -%}{% if tag_starts_with == "_" %}{% continue %}{% endif %}{% endif %}
                            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="badge{% if badge_style %} badge--custom{% endif %}"{% if badge_style %} style="{{ badge_style }}"{% endif %}>{{ tag }}</a>
                          {%- endfor -%}
                        </animate-element>
                        {%- assign delay = delay | plus: 1 -%}
                      {%- endif -%}

                      {%- if block.settings.show_date or block.settings.show_comments or block.settings.show_author -%}
                        <animate-element class="article-banner__meta" data-animate="fade-up" data-animate-delay="{{ delay | times: 250 }}">
                          <ul class="article__top article-banner__meta-list">
                            {%- if block.settings.show_date -%}
                              <li itemprop="dateCreated pubdate datePublished">
                                {%- render 'icon', icon: 'calendar', size: 'xs', class: 'stroke-1' -%}
                                {{- article.published_at | time_tag: format: 'month_day_year' -}}
                              </li>
                            {%- endif -%}
                            {%- if block.settings.show_comments -%}
                              <li>
                                {%- render 'icon', icon: 'comment', size: 'xs', class: 'stroke-1' -%}
                                <a class="reversed-link" href="#comments">{{- 'blogs.comments.with_count' | t: count: number_of_comments -}}</a>
                              </li>
                            {%- endif -%}
                            {%- if block.settings.show_author -%}
                              <li itemprop="author" itemscope itemtype="http://schema.org/Person">
                                {%- capture author -%}<span itemprop="name">{{ article.author }}</span>{%- endcapture -%}
                                {{- 'blogs.article.written_by_html' | t: author: author -}}
                              </li>
                            {%- endif -%}
                          </ul>
                        </animate-element>
                        {%- assign delay = delay | plus: 1 -%}
                      {%- endif -%}

                      <h1 class="banner__title heading article-banner__title {{ block.settings.title_size }}" itemprop="headline">
                        <split-words class="split-words" data-animate="fade-up-large" data-animate-delay="{{ delay | times: 250 }}">{{ article.title }}</split-words>
                      </h1>
                    </div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </article>
  </div>
</div>

