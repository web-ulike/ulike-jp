{% comment %}
  Air 10 Max 2026: power. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-power-2026-{{ section.id }}" class="a10-2026 a10-2026__power">
{%- assign a10_background = section.settings.product_image | default: section.settings.product_image_mobile -%}
{%- if a10_background != blank -%}
<picture class="a10-2026__power-background" aria-hidden="true">
  {% if section.settings.product_image_mobile != blank %}
    <source media="(max-width: 749px)" srcset="{{ section.settings.product_image_mobile | image_url: width: 375 }} 375w, {{ section.settings.product_image_mobile | image_url: width: 750 }} 750w, {{ section.settings.product_image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
  {% endif %}
  {{ a10_background | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: '' }}
</picture>
{%- endif -%}
<div class="container a10-2026__container">
<div class="a10-2026__inner a10-2026__power-grid">
<div class="a10-2026__power-copy">
<div class="a10-2026__eyebrow to-top" style="transition-delay: 0.1s;">{%- assign a10_image = section.settings.label_icon | default: section.settings.label_icon -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}{{ section.settings.label | escape | newline_to_br }}</div>
{% if section.settings.heading_html != blank %}
<h2 class="a10-2026__title a10-2026__power-title to-top" style="transition-delay: 0.2s;">{{ section.settings.heading_html }}</h2>
{% endif %}{% if section.settings.description != blank %}
<div class="a10-2026__body to-top" style="transition-delay: 0.3s;">{{ section.settings.description | escape | replace: '*1', '<sup>*1</sup>' | replace: '*2', '<sup>*2</sup>' | newline_to_br }}</div>
{% endif %}</div>

<div class="a10-2026__power-spacer">
  {% if section.settings.scene_image_mobile != blank %}
    {{ section.settings.scene_image_mobile | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500', sizes: '100vw', alt: section.settings.scene_image_mobile.alt }}
  {% endif %}
</div>
{% if section.settings.note != blank %}
<div class="a10-2026__note to-top" style="transition-delay: 0.5s;">{{ section.settings.note | escape | newline_to_br }}</div>
{% endif %}
</div>
</div>
</section>

<style>
#a10-max-power-2026-{{ section.id }} { position: relative; color: #190a0a; overflow: hidden; }
#a10-max-power-2026-{{ section.id }} *, #a10-max-power-2026-{{ section.id }} *::before, #a10-max-power-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-power-2026-{{ section.id }} h2, #a10-max-power-2026-{{ section.id }} h3, #a10-max-power-2026-{{ section.id }} p { margin: 0; }
#a10-max-power-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-power-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-power-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-power-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-power-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-power-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-power-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-power-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-power-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-power-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-power-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-power-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-background { position: absolute; inset: 0; display: block; width: 100%; height: 100%; pointer-events: none; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-background img { display: block; width: 100%; height: 100%; object-fit: fill; }
#a10-max-power-2026-{{ section.id }} > .a10-2026__container { position: relative; z-index: 1; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-spacer { display: none; }
/* The 1920px design uses a 1220px content area and a 910px scene. */
#a10-max-power-2026-{{ section.id }}.a10-2026__power { --a10-power-unit: min(1px, calc((100vw - 80px) / 1220)); background: linear-gradient(212deg,#fbfbfb 9.77%,#e3e6f0 158.84%); }

#a10-max-power-2026-{{ section.id }} .a10-2026__power-grid { min-height: calc(910 * var(--a10-power-unit)); display: grid; grid-template-columns: 40.45% minmax(0,1fr); grid-template-rows: minmax(calc(746.47 * var(--a10-power-unit)),auto) auto minmax(calc(88 * var(--a10-power-unit)),1fr); position: relative; align-items: start; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-copy { grid-column: 1; grid-row: 1; position: relative; z-index: 2; min-width: 0; margin-top: calc(271 * var(--a10-power-unit)); padding-bottom: calc(40 * var(--a10-power-unit)); }
#a10-max-power-2026-{{ section.id }} .a10-2026__eyebrow { display: flex; align-items: center; gap: calc(15 * var(--a10-power-unit)); color: #3f3636; font-size: calc(22 * var(--a10-power-unit)); line-height: 1.2; font-weight: 400; margin-bottom: calc(13.62 * var(--a10-power-unit)); }
#a10-max-power-2026-{{ section.id }} .a10-2026__eyebrow .a10-2026__media { width: calc(47 * var(--a10-power-unit)); height: calc(25 * var(--a10-power-unit)); flex-shrink: 0; }
#a10-max-power-2026-{{ section.id }} .a10-2026__eyebrow img { height: 100%; object-fit: contain; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-title { margin-bottom: calc(32.79 * var(--a10-power-unit)) !important; font-size: calc(40 * var(--a10-power-unit)); line-height: 1.3; letter-spacing: 0; white-space: nowrap; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-copy .a10-2026__body { font-size: max(12px, calc(16 * var(--a10-power-unit))); line-height: 1.5; }
#a10-max-power-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-grid > .a10-2026__note { grid-column: 1; grid-row: 2; position: relative; z-index: 2; }
@media (max-width:749px) {
#a10-max-power-2026-{{ section.id }}.a10-2026__power { --a10-power-unit: calc(100vw / 375); background: #f4f4f7; padding: 27.59px 0 30px; }
#a10-max-power-2026-{{ section.id }} > .a10-2026__container { max-width: none; padding-inline: 20px; }
#a10-max-power-2026-{{ section.id }} .a10-2026__inner { width: 100%; max-width: none; margin: 0; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-grid { min-height: 0; display: flex; flex-direction: column; align-items: stretch; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-copy { margin: 0; padding: 0; display: contents; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-background img { object-fit: cover; object-position: center top; }
{% if section.settings.scene_image_mobile != blank %}
#a10-max-power-2026-{{ section.id }} .a10-2026__power-background { display: none; }
{% endif %}
#a10-max-power-2026-{{ section.id }} .a10-2026__power-spacer { display: block; order: 2; height: calc(350 * var(--a10-power-unit)); margin: 32.68px -20px 18px; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-spacer img { display: block; width: 100%; height: 100%; object-fit: contain; }
#a10-max-power-2026-{{ section.id }} .a10-2026__eyebrow { font-size: 12px; line-height: 1.2; gap: 5.9px; min-height: 29.54px; justify-content: center; margin-bottom: -.89px; order: 0; }
#a10-max-power-2026-{{ section.id }} .a10-2026__eyebrow .a10-2026__media { width: 25.85px; height: 12.78px; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-title { order: 1; margin: 0 !important; font-size: 23.71px; line-height: 1.3; font-weight: 400; text-align: center; white-space: normal; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-copy .a10-2026__body { order: 3; font-size: 12px; line-height: 1.5; font-weight: 400; letter-spacing: 0; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-copy .a10-2026__body br { display: none; }
#a10-max-power-2026-{{ section.id }} .a10-2026__power-grid > .a10-2026__note { order: 4; margin-top: 20px; font-size: 10px; line-height: 1.5; font-weight: 400; letter-spacing: 0; text-align: justify; }
}

/* Keep short copy inside clipped cards while it enters the viewport. */
@media (prefers-reduced-motion: no-preference) {
#a10-max-power-2026-{{ section.id }} .to-top:not(.appear) { transform: translateY(20px); }
}

</style>

{% schema %}
{
  "name": "A10 Max 28J能量",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "说明文案",
      "default": "出力エネルギーが28J*2へとアップグレード。たった週3回の新習慣が、目に見える肌の変化をいち早く体験いただけます*1。\nさらに「ダブルランプ」搭載で、高出力エネルギーを均一かつ精密に照射し、打ち漏れやムラを大幅に減少。\n従来のケアでは太刀打ちできなかった太くて硬い毛の根元まで強力にアプローチし、再生を効果的に抑制します。"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "脚注文案",
      "default": "*1.国際認証機関SGSによる報告：GZCPCH24001216-01S1_CN。トリートメントスケジュールに従って週3回使用した場合、効果を実感し始めます。効果には個人差及び部位差があります。\n*2.国際認証機関CVCにより：WTS2024-15864、最大出力エネルギーはUSHRモード使用時に限られている、結果はテスト条件による異なる可能性もあります。"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "PC 整体背景图"
    },
    {
      "type": "image_picker",
      "id": "product_image_mobile",
      "label": "M 整体背景图",
      "info": "保留原整屏背景配置。上传下方 M 产品展示图后，移动端改用独立产品图。"
    },
    {
      "type": "image_picker",
      "id": "scene_image_mobile",
      "label": "M 产品展示图",
      "info": "建议 750 × 700 px，包含产品、箭头和28J标识，不含标题、正文和脚注。完整显示，不拉伸。"
    },
    {
      "type": "image_picker",
      "id": "label_icon",
      "label": "双灯管标签图标"
    },
    {
      "type": "text",
      "id": "label",
      "label": "标签文案",
      "default": "ダブルランプ搭載"
    },
    {
      "type": "html",
      "id": "heading_html",
      "label": "标题 HTML",
      "default": "たった 3 回<sup>*1</sup>で効果実感"
    }
  ],
  "presets": [
    {
      "name": "A10 Max 28J能量"
    }
  ]
}
{% endschema %}
