<script>
  (() => {
    const section = document.getElementById('me-product-comparison-{{ sid }}');
    if (!section || section.dataset.scrollbarBound === 'true') return;

    const viewport = section.querySelector('.me-product-comparison__viewport');
    const track = section.querySelector('.me-product-comparison__scrollbar');
    const thumb = track && track.querySelector('span');
    if (!viewport || !track || !thumb) return;

    const updateScrollbar = () => {
      const maxScroll = viewport.scrollWidth - viewport.clientWidth;
      const maxOffset = Math.max(0, track.clientWidth - thumb.clientWidth);
      const progress = maxScroll > 0 ? viewport.scrollLeft / maxScroll : 0;
      thumb.style.transform = `translateX(${maxOffset * progress}px)`;
    };

    const scrollToPointer = (clientX) => {
      const maxScroll = viewport.scrollWidth - viewport.clientWidth;
      const maxOffset = track.clientWidth - thumb.clientWidth;
      if (maxScroll <= 0 || maxOffset <= 0) return;
      const trackLeft = track.getBoundingClientRect().left;
      const offset = Math.min(maxOffset, Math.max(0, clientX - trackLeft - thumb.clientWidth / 2));
      viewport.scrollLeft = maxScroll * (offset / maxOffset);
    };

    track.addEventListener('pointerdown', (event) => {
      track.setPointerCapture(event.pointerId);
      scrollToPointer(event.clientX);
    });
    track.addEventListener('pointermove', (event) => {
      if (track.hasPointerCapture(event.pointerId)) scrollToPointer(event.clientX);
    });
    track.addEventListener('pointerup', (event) => track.releasePointerCapture(event.pointerId));
    track.addEventListener('pointercancel', (event) => track.releasePointerCapture(event.pointerId));

    section.dataset.scrollbarBound = 'true';
    viewport.addEventListener('scroll', updateScrollbar, { passive: true });
    window.addEventListener('resize', updateScrollbar, { passive: true });
    requestAnimationFrame(updateScrollbar);
  })();
</script>

