ock.settings.pink_6_icon_image | image_url: width: 120 | image_tag: loading: "lazy", widths: "60, 120", sizes: "30px" }}</span>{% else %}{{ icon_speed }}{% endif %}{{ block.settings.pink_6 | default: flashes[product_index] }}</div><div>{% if block.settings.pink_7_icon_image != blank %}<span class="me-product-comparison__icon me-product-comparison__icon--custom">{{ block.settings.pink_7_icon_image | image_url: width: 120 | image_tag: loading: "lazy", widths: "60, 120", sizes: "30px" }}</span>{% else %}{{ icon_time }}{% endif %}{{ block.settings.pink_7 | default: durations[product_index] }}</div><div class="me-product-comparison__power{% if block.settings.power_image != blank %} me-product-comparison__power--image{% endif %}">{% if block.settings.power_image != blank %}{{ block.settings.power_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '180, 250, 350, 500', sizes: '(max-width: 749px) 182px, 237px' }}{% else %}{% case product_index %}{% when 0 %}{{ x_max_power }}{% when 1 %}{{ air10_power }}{% when 2 %}{{ airpro_power }}{% else %}{{ me_power }}{% endcase %}{% endif %}</div>
