<section id="me-product-comparison-{{ sid }}" class="me-product-comparison">
  <div class="me-product-comparison__heading">
    {{ section.settings.heading_html }}
  </div>

  {% if section.settings.content_type == 'image' and replacement_image != blank %}
    <div class="me-product-comparison__replacement me-product-comparison__replacement--image">
      <picture>
        {% if section.settings.comparison_image_mobile != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.comparison_image_mobile | image_url: width: 1200 }}">
        {% endif %}
        {{ replacement_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1000, 1500, 2000, 2400', sizes: '100vw' }}
      </picture>
    </div>
  {% else %}
  <div class="me-product-comparison__viewport" aria-label="Ulike 光美容器比較表">
    <div class="me-product-comparison__table" style="--columns: {{ comparison_column_count }}; --product-columns: {{ comparison_column_count | minus: 1 }};">
      {% if section.blocks.size == 0 %}
      <div class="me-product-comparison__column me-product-comparison__column--labels">
        <div class="me-product-comparison__image-label">
          {{ default_image_label_html }}
        </div>
        <div class="me-product-comparison__product-label">商品名</div>
        <div class="me-product-comparison__group me-product-comparison__group--pink">
          <div>効果実感のスピード</div><div>最大パワー</div><div>エネルギー密度(J/cm²)</div><div>フラッシュランプ本数</div><div>照射面積(縦×横)mm</div><div>照射スピード</div><div>全身ケア所要時間</div><div>パワー調整</div>
        </div>
        <div class="me-product-comparison__group me-product-comparison__group--cream">
          <div>起動時の冷却</div><div>冷却機能の有無</div><div>使用可能部位</div><div>肌色識別機能</div><div>使用可能な毛色</div><div>使用可能な肌色</div><div>最大照射回数</div>
        </div>
        <div class="me-product-comparison__group me-product-comparison__group--blue">
          <div>電源方式(光エステ)</div><div>充電時間</div><div>コードの長さ（ｍ）</div><div>電気用品安全法(PSE)</div><div>対応電圧</div><div>消費電力</div><div>出力設定数</div><div>本体サイズ<br>(W・H・D)(mm)</div><div>本体重量(g)</div><div>同梱物</div>
        </div>
      </div>
      {% endif %}

      {% capture x_max_power %}<span class="power-arrow">弱<br>↓<br>強</span>Fast mode (パワー固定)<br>Normal mode (1~6 level)<br>High mode (1~10 level)<br>USHR mode (パワー固定){% endcapture %}
      {% capture air10_power %}<span class="power-arrow">弱<br>↓<br>強</span>Fast mode (パワー固定)<br>Normal mode (1~6 level)<br>High mode (1~10 level)<br>USHR mode (パワー固定){% endcapture %}
      {% capture airpro_power %}<span class="power-arrow">弱<br>↓<br>強</span>Soft mode<br>Body mode<br>Power mode<br>USHR mode{% endcapture %}
      {% capture me_power %}<span class="power-arrow">弱<br>↓<br>強</span>ソフトモード<br>フェイスモード<br>ボディモード<br>デリケートゾーンモード{% endcapture %}
      {% capture available_areas %}顔、胸、ワキ、お腹、VIOゾーン、手、太もも、脚、他ほぼ全身*⁹{% endcapture %}
      {% capture hair_colours %}<span class="dot dot--gold"></span>暗い金色/薄い茶色<br><span class="dot dot--brown"></span>茶色<br><span class="dot dot--brown"></span>濃い茶色<br><span class="dot dot--black"></span>黒色{% endcapture %}
      {% capture skin_colours %}<span class="dot dot--white"></span>ホワイト<br><span class="dot dot--beige"></span>ベージュ<br><span class="dot dot--lightbrown"></span>ライトブラウン<br><span class="dot dot--brown"></span>ミドルブラウン<br><span class="dot dot--darkbrown"></span>ダークブラウン{% endcapture %}
      {% capture included %}本体<br>取扱説明書<br>クイックガイド<br>ゴーグル<br>AC アダプター<br>電源コード<br>巾着袋（下等）<br>カミソリ（折畳式）<br>アタッチメント{% endcapture %}
