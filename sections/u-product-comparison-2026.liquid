              {{ section.settings[image_setting] | image_url: width: 500 | image_tag: loading: 'lazy', widths: '150, 250, 350, 500', sizes: '(max-width: 749px) 182px, 237px' }}
            {% else %}
              <span>画像を設定</span>
            {% endif %}
          </div>
          <div class="me-product-comparison__product-name">
            {% if product_logo_html != blank %}
              {{ product_logo_html }}
            {% else %}
              <strong>{{ name }}</strong><small>{{ product_subtitles[product_index] }}</small>
            {% endif %}
          </div>
          <div class="me-product-comparison__group me-product-comparison__group--pink me-product-comparison__values">
            <div>{{ icon_calendar }}{{ speeds[product_index] }}</div><div>{{ icon_power }}{{ powers[product_index] }}</div><div>{{ icon_density }}{{ densities[product_index] }}</div><div>{{ icon_lamp }}{{ lamps[product_index] }}</div><div>{{ icon_area }}{{ areas[product_index] }}</div><div>{{ icon_speed }}{{ flashes[product_index] }}</div><div>{{ icon_time }}{{ durations[product_index] }}</div><div class="me-product-comparison__power">{% case product_index %}{% when 0 %}{{ x_max_power }}{% when 1 %}{{ air10_power }}{% when 2 %}{{ airpro_power }}{% else %}{{ me_power }}{% endcase %}</div>
          </div>
          <div class="me-product-comparison__group me-product-comparison__group--cream me-product-comparison__values">
            <div>{{ icon_cold_start }}{{ cold_start[product_index] }}</div><div>{{ icon_cooling }}{{ cooling[product_index] }}</div><div>{{ icon_areas }}{{ available_areas }}</div><div class="me-product-comparison__detector">{{ detectors[product_index] }}</div><div class="me-product-comparison__colours">{{ hair_colours }}</div><div class="me-product-comparison__colours">{{ skin_colours }}</div><div>{{ icon_shots }}{{ shots[product_index] }}</div>
          </div>
          <div class="me-product-comparison__group me-product-comparison__group--blue me-product-comparison__values">
            <div>{{ icon_power_source }}交流（コード）式</div><div>{{ icon_charge }}充電時間</div><div>{{ icon_cord }}{{ cords[product_index] }}</div><div>{{ icon_pse }}対象</div><div>{{ icon_voltage }}100-240V</div><div>{{ icon_wattage }}{{ watts[product_index] }}</div><div>{{ icon_output }}{{ outputs[product_index] }}</div><div>{{ icon_dimensions }}{{ sizes[product_index] }}</div><div>{{ icon_weight }}{{ weights[product_index] }}</div><div class="me-product-comparison__included">{{ included }}</div>
          </div>
        </div>
      {% endfor %}
      {% endif %}
    </div>
  </div>
  <div class="me-product-comparison__scrollbar" aria-hidden="true"><span></span></div>
  <div class="me-product-comparison__notes">{{ section.settings.notes_html | default: default_notes_html }}</div>
