{%- liquid
  assign se_id = section.id
  assign se_bks = section.blocks
  assign se_stts = section.settings
-%}

<section id="refer-friend-steps-{{ se_id }}" class="refer-friend-steps refer-friend-steps_{{ se_id }}">
  <div class="container rel">
    <h2 class="refer-friend-title refer-friend-title_{{ se_id }}">{{ se_stts.title }}</h2>
    <div class="refer-friend-list refer-friend-list_{{ se_id }} swiper-container">
      <div class="swiper-wrapper">
        {%- for block in se_bks -%}
          <div class="refer-friend-item refer-friend-item_{{ se_id }} swiper-slide">
            {%- if block.settings.image != blank -%}
              <div class="refer-friend-image refer-friend-image_{{ se_id }}">
                <img
                  loading="lazy"
                  src="{{ block.settings.image | img_url: '600x' }}"
                  alt="{{ block.settings.image.alt | escape }}"
                >
              </div>
            {%- endif -%}
            <div class="refer-friend-text">
              <h3 class="refer-friend-step">Step {{ forloop.index }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="refer-friend-navigation ">
        <div class="swiper-button-prev ">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="41" viewBox="0 0 40 41" fill="none">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M23.6003 33.9318L24.1054 34.4369L25.1155 33.4267L24.6104 32.9217L19.9992 28.3104L15.6526 23.9638C15.0947 23.406 14.1902 23.406 13.6323 23.9638L18.9891 29.3206L23.6003 33.9318ZM11.1003 20.4217C10.8213 20.7006 10.8213 21.1529 11.1003 21.4318C11.1942 21.5257 11.3078 21.588 11.4278 21.6187L11.4278 21.641L11.6038 21.641L11.6069 21.641L12.1421 21.641L19.4639 21.641L26.7857 21.641L28.5715 21.641C29.3605 21.641 30.0001 21.0014 30.0001 20.2125L26.7857 20.2125L13.3298 20.2125L24.6104 8.93182L25.1155 8.42674L24.1054 7.41659L23.6003 7.92166L11.1003 20.4217Z" fill="#190A0A"></path>
              <circle cx="20" cy="20.8655" r="19.2857" stroke="#190A0A" stroke-width="1.42857"></circle>
            </svg>
        </div>

        <div class="swiper-button-next">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="41" viewBox="0 0 40 41" fill="none">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M16.3997 7.79914L15.8946 7.29407L14.8845 8.30422L15.3896 8.8093L20.0008 13.4205L24.3474 17.7671C24.9053 18.325 25.8098 18.325 26.3677 17.7671L21.011 12.4104L16.3997 7.79914ZM28.8997 21.3093C29.1787 21.0303 29.1787 20.5781 28.8997 20.2991C28.8058 20.2052 28.6922 20.1429 28.5722 20.1122V20.0899H28.3962H28.3931H27.8579H20.5361H13.2143H11.4285C10.6395 20.0899 9.99995 20.7295 9.99995 21.5185H13.2143H26.6702L15.3896 32.7991L14.8845 33.3042L15.8946 34.3144L16.3997 33.8093L28.8997 21.3093Z" fill="#190A0A"></path>
              <circle cx="20" cy="20.8655" r="19.2857" stroke="#190A0A" stroke-width="1.42857"></circle>
            </svg>
        </div>
       
      </div>
    </div>
  </div>
</section>

<script>
  window.addEventListener('load', function () {
    new Swiper('.refer-friend-list_{{ se_id }}', {
      slidesPerView: 'auto',
      spaceBetween: window.UlikeCommon.isMobile() ? 20 : 30,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      breakpoints: {
        768: {
          slidesPerView: 1.4, // 小屏幕上水平方向滚动
        },
        1024: {
          slidesPerView: 4.0, // 大屏幕上垂直方向滚动
        },
      },
      on: {
        slideChange: function () {
          window.UlikeCommon.commonGtmEvent(`老带新，点击如何邀请`, '', 'Product');
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Refer Friend Steps",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "How It Works"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Description",
          "default": "Description of this step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Refer Friend Steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .swiper-button-next:after, .swiper-rtl .swiper-button-prev:after,
  .swiper-button-prev:after, .swiper-rtl .swiper-button-next:after{
      content: '';
  }
  .refer-friend-steps_{{ se_id }} {
    padding: 50px 0;
    background: #fff;
    text-align: center;
  }
  .rel {
    position: relative;
  }
  .refer-friend-title {
    font-size: 48px;
    color: #000;
    margin-bottom: 50px;
    text-align: left;
    font-weight: 500;
  }

    .refer-friend-list {
      overflow: hidden;
      padding-bottom: 40px; /* 预留箭头按钮空间 */
    }

    .refer-friend-item {
      text-align: center;
      flex-shrink: 0;
    }

    .refer-friend-steps_{{ se_id }} .refer-friend-image img {
      width: 100%;
      border-radius: 10px;
    }

    .refer-friend-step {
      font-size: 16px;
      font-weight: 500;
      margin-top: 10px;
    }

    .refer-friend-steps_{{ se_id }}  .refer-friend-text p {
      font-size: 16px;
      color: #333;
      line-height: 22px;
      text-align: left;
    }

    /* 轮播箭头 */
    .refer-friend-navigation {
      position: absolute;
      top: 8%;
      right: 40px;
      display: flex;
      gap: 40px;
      z-index: 1;
    }

    .swiper-button-prev,
    .swiper-button-next {
      cursor: pointer;
      transition: 0.3s;
      background: #fff;
      {% comment %} border: 2px solid #000; {% endcomment %}
      width: 40px;
      height: 40px;
      border-radius: 50%;
      position: relative;
      cursor: pointer;
      transition: all .4s ease;
    }

    .refer-friend-steps_{{ se_id }} .swiper-button-prev:hover,
    .refer-friend-steps_{{ se_id }} .swiper-button-next:hover{
      background: #000;
    }

    .refer-friend-navigation .swiper-button-prev {
      left: inherit;
      right: 0px;
    }

    .swiper-button-prev svg,
    .swiper-button-next svg {
      width: 100%;
      height: 100%;
      border-radius: 50%;
    }

    .swiper-button-prev:hover svg,
    .swiper-button-next:hover svg {
      background: #f0f0f0;
    }

    .refer-friend-steps_{{ se_id }}  .refer-friend-text {
      font-size: 16px;
    }

    .refer-friend-steps_{{ se_id }} .refer-friend-text .refer-friend-step {
      font-size: 28px;
      width: 110px;
      text-align: left;
      line-height: 36px;
      padding: 10px 0px 4px;
    }

    /* 🛠️ 移动端适配 */
    @media (max-width: 768px) {
      .refer-friend-steps_{{ se_id }} {
        padding: 0px 0 40px;
      }
      .refer-friend-title {
        font-size: 28px;
        margin-bottom: 10px;
      }

      .refer-friend-item {
        width: 260px; /* 让轮播更紧凑 */
      }
      .refer-friend-steps_{{ se_id }} .refer-friend-image {
        height: 380px;
      }

      .swiper-button-prev,
      .swiper-button-next {
        width: 36px;
        height: 36px;
        margin: 0px;
        left: 0px;
        right: 0px;
      }
      .refer-friend-list {
        padding-bottom: 60px; /* 预留箭头按钮空间 */
      }

      .refer-friend-navigation {
        top: inherit;
        bottom: 0px;
        right: inherit;
        left: 0px;
        width: 100%;
        justify-content: center;
        gap: 40px;
      }
      .refer-friend-steps_{{ se_id }} .refer-friend-text {
        font-size: 14px;
        gap: 10px;
      }
      .refer-friend-steps_{{ se_id }} .refer-friend-text .refer-friend-step {
         font-size: 22px;
      }
      .refer-friend-steps_{{ se_id }}  .refer-friend-text p {
        font-size: 12px;
        line-height: 16px;
        text-align: left;
      }
    }
</style>
