{%- if section.settings.air10_max_layout -%}

<section id="a10-max-{{ section.id }}" class="a10-2026 to-top a10-2026__icons">
<div class="a10-2026__icon-grid">{% for block in section.blocks %}
<article class="a10-2026__feature" {{ block.shopify_attributes }}>
<div class="a10-2026__feature-icon">{%- assign a10_image = block.settings.icon | default: block.settings.icon -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}</div>
{% if block.settings.title != blank %}
<h3 class="a10-2026__feature-title">{{ block.settings.title | escape | newline_to_br }}</h3>
{% endif %}{% if block.settings.text != blank %}<p class="a10-2026__feature-text">{{ block.settings.text | escape | newline_to_br }}</p>{% endif %}</article>
{% endfor %}</div>
</section>

<style>
#a10-max-{{ section.id }}{ color: #190a0a;  overflow: hidden; }
#a10-max-{{ section.id }} *, #a10-max-{{ section.id }} *::before, #a10-max-{{ section.id }} *::after{ box-sizing: border-box; }
#a10-max-{{ section.id }} h2, #a10-max-{{ section.id }} h3, #a10-max-{{ section.id }} p{ margin: 0; }
#a10-max-{{ section.id }} .a10-2026__inner{ width: min(1220px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-{{ section.id }} .a10-2026__wide{ width: min(1600px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-{{ section.id }} .a10-2026__title{ font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-{{ section.id }} .a10-2026__body{ color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__body p + p{ margin-top: 0; }
#a10-max-{{ section.id }} .a10-2026__note{ color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-{{ section.id }} .a10-2026__note p{ margin: 0; }
#a10-max-{{ section.id }} .a10-2026__media{ display: block; min-width: 0; }
#a10-max-{{ section.id }} .a10-2026__media img{ display: block; width: 100%; height: auto; }
#a10-max-{{ section.id }} .a10-2026__center{ text-align: center; }
#a10-max-{{ section.id }} .a10-2026__mobile{ display: none; }
#a10-max-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-{{ section.id }} .a10-2026__note a{ color: inherit; }
#a10-max-{{ section.id }}.a10-2026__icons{ padding: 77px 0; background: #fff; }
#a10-max-{{ section.id }} .a10-2026__icon-grid{ display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; width: min(1692px, calc(100% - 80px)); margin: auto; }
#a10-max-{{ section.id }} .a10-2026__feature{ text-align: center; min-width: 0; }
#a10-max-{{ section.id }} .a10-2026__feature-icon{ height: 50px; width: 78px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; }
#a10-max-{{ section.id }} .a10-2026__feature-icon img{ max-height: 55px; width: auto; max-width: 78px; }
#a10-max-{{ section.id }} .a10-2026__feature h3{ font-size: clamp(15px, 1.25vw, 24px); line-height: 2; font-weight: 500; }
#a10-max-{{ section.id }} .a10-2026__feature p{ color: #3f3636; font-size: 14px; line-height: 2; }
#a10-max-{{ section.id }} sup{ font-size: .645em; line-height: 0; vertical-align: super; }
@media (min-width:750px) and (max-width:1400px){#a10-max-{{ section.id }} .a10-2026__title{ font-size: 32px; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 26px; }
}@media (max-width:749px){#a10-max-{{ section.id }} .a10-2026__inner, #a10-max-{{ section.id }} .a10-2026__wide{ width: calc(100% - 40px); }
#a10-max-{{ section.id }} .a10-2026__desktop{ display: none !important; }
#a10-max-{{ section.id }} .a10-2026__mobile{ display: block; }
#a10-max-{{ section.id }} .a10-2026__title{ font-size: 24px; line-height: 1.3; }
#a10-max-{{ section.id }} .a10-2026__subtitle{ font-size: 24px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__body{ font-size: 14px; line-height: 1.5; }
#a10-max-{{ section.id }} .a10-2026__note{ font-size: 10px; line-height: 1.5; }
#a10-max-{{ section.id }}.a10-2026__icons{ padding: 50px 0 20px; }
#a10-max-{{ section.id }} .a10-2026__icon-grid{ width: calc(100% - 24px); grid-template-columns: repeat(3,minmax(0,1fr)); gap: 32px 8px; }
#a10-max-{{ section.id }} .a10-2026__feature-icon{ height: 26px; width: 42px; margin-bottom: 10px; }
#a10-max-{{ section.id }} .a10-2026__feature-icon img{ max-height: 28px; max-width: 40px; }
#a10-max-{{ section.id }} .a10-2026__feature h3{ font-size: 10px; line-height: 1.5; white-space: nowrap; }
#a10-max-{{ section.id }} .a10-2026__feature p{ font-size: 10px; line-height: 1.3; margin: 5px auto 0; max-width: 100px; }
}
</style>
{%- else -%}


{% comment %}
  Section: p-feature-icons
  用途：产品页核心卖点 icon 展示
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .p-feature-icons {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__inner {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: start;
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__icon {
    width: 34px;
    height: 34px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: 13px;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__text {
    margin: 4px 0 0;
    color: {{ section.settings.text_color }};
    font-size: 11px;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .p-feature-icons {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__inner {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px 16px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__icon {
      width: 36px;
      height: 36px;
      margin-bottom: 9px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__title {
      font-size: 13px;
      line-height: 1.45;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__text {
      margin-top: 4px;
      font-size: 12px;
      line-height: 1.55;
    }
  }

  @media screen and (max-width: 374px) {
    #shopify-section-{{ section.id }} .p-feature-icons__inner {
      gap: 28px 10px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__title {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__text {
      font-size: 11px;
    }
  }
</style>

<section class="p-feature-icons">
  <div class="container">
    <div class="p-feature-icons__inner">
      {% for block in section.blocks %}
        <div class="p-feature-icons__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="p-feature-icons__icon">
              <img
                src="{{ block.settings.icon | image_url: width: 160 }}"
                alt="{{ block.settings.title | escape }}"
                width="34"
                height="34"
                loading="lazy"
              >
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="p-feature-icons__title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="p-feature-icons__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>


{%- endif -%}
{% schema %}
{
  "name": "P 卖点图标",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "描述颜色",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "PC 上间距",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "PC 下间距",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "移动端上间距",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "移动端下间距",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "air10_max_layout",
      "label": "使用 Air 10 Max 2026 设计",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "卖点",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "图标"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "28Jハイパワー"
        },
        {
          "type": "text",
          "id": "text",
          "label": "描述",
          "default": "わずか3回で減毛実感"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "p-feature-icons",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "28Jハイパワー",
            "text": "わずか3回で減毛効果を実感"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "ダブルランプ搭載",
            "text": "ムラなく均一にケア"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "サファイア冷感技術",
            "text": "痛みレスでやさしくケア"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "スキンセンサー搭載",
            "text": "照射もれを防ぎ、肌に配慮"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "アプリでスマート管理",
            "text": "AIが最適プランを提案"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "最大90万回照射",
            "text": "長寿命ランプ採用"
          }
        }
      ]
    }
  ]
}
{% endschema %}
