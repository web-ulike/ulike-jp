

{% comment %}
  Section: p-feature-icons
  用途：产品页核心卖点 icon 展示
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .p-feature-icons {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__inner {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: start;
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__icon {
    width: 34px;
    height: 34px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: 13px;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .p-feature-icons__text {
    margin: 4px 0 0;
    color: {{ section.settings.text_color }};
    font-size: 11px;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .p-feature-icons {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__inner {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px 16px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__icon {
      width: 36px;
      height: 36px;
      margin-bottom: 9px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__title {
      font-size: 13px;
      line-height: 1.45;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__text {
      margin-top: 4px;
      font-size: 12px;
      line-height: 1.55;
    }
  }

  @media screen and (max-width: 374px) {
    #shopify-section-{{ section.id }} .p-feature-icons__inner {
      gap: 28px 10px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__title {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .p-feature-icons__text {
      font-size: 11px;
    }
  }
</style>

<section class="p-feature-icons">
  <div class="jp-container">
    <div class="p-feature-icons__inner">
      {% for block in section.blocks %}
        <div class="p-feature-icons__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="p-feature-icons__icon">
              <img
                src="{{ block.settings.icon | image_url: width: 160 }}"
                alt="{{ block.settings.title | escape }}"
                width="34"
                height="34"
                loading="lazy"
              >
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="p-feature-icons__title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="p-feature-icons__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "P 卖点图标",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "描述颜色",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "PC 上间距",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "PC 下间距",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "移动端上间距",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "移动端下间距",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "卖点",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "图标"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "28Jハイパワー"
        },
        {
          "type": "text",
          "id": "text",
          "label": "描述",
          "default": "わずか3回で減毛実感"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "p-feature-icons",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "28Jハイパワー",
            "text": "わずか3回で減毛効果を実感"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "ダブルランプ搭載",
            "text": "ムラなく均一にケア"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "サファイア冷感技術",
            "text": "痛みレスでやさしくケア"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "スキンセンサー搭載",
            "text": "照射もれを防ぎ、肌に配慮"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "アプリでスマート管理",
            "text": "AIが最適プランを提案"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "最大90万回照射",
            "text": "長寿命ランプ採用"
          }
        }
      ]
    }
  ]
}
{% endschema %}