{% assign sid = section.id %}
<section id="me-cooling-performance-{{ sid }}" class="me-cooling-performance" style="--me-cooling-bg:{{ section.settings.background }};--me-cooling-color:{{ section.settings.text_color }};">
  {% if section.settings.background_image != blank or section.settings.background_image_mobile != blank %}
    {% assign background_fallback = section.settings.background_image | default: section.settings.background_image_mobile %}
    <picture class="me-cooling-performance__background">
      {% if section.settings.background_image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.background_image_mobile | image_url: width:1000 }}">{% endif %}
      {{ background_fallback | image_url: width:2400 | image_tag: class: 'me-cooling-performance__background-image', loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400' }}
    </picture>
  {% endif %}
  <div class="me-cooling-performance__content">
    <div class="me-cooling-performance__desktop">{{ section.settings.title_html }}{{ section.settings.description_html }}</div>
    <div class="me-cooling-performance__mobile">{{ section.settings.title_html_mobile }}{{ section.settings.description_html_mobile }}</div>
    {% if section.settings.badge_image != blank or section.settings.badge_image_mobile != blank %}
      {% assign badge_fallback = section.settings.badge_image | default: section.settings.badge_image_mobile %}
      <picture class="me-cooling-performance__badge">{% if section.settings.badge_image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.badge_image_mobile | image_url: width:700 }}">{% endif %}{{ badge_fallback | image_url: width:800 | image_tag: loading: 'lazy', widths: '240, 360, 560, 800' }}</picture>
    {% endif %}
    {% if section.settings.note_html != blank %}<div class="me-cooling-performance__note">{{ section.settings.note_html }}</div>{% endif %}
  </div>
</section>
<style>
 #me-cooling-performance-{{ sid }}{position:relative;min-height:720px;overflow:hidden;background:var(--me-cooling-bg);color:var(--me-cooling-color)}#me-cooling-performance-{{ sid }} .me-cooling-performance__background{position:absolute;inset:0;display:block}#me-cooling-performance-{{ sid }} .me-cooling-performance__background-image{display:block;width:100%;height:100%;object-fit:cover}#me-cooling-performance-{{ sid }} .me-cooling-performance__content{position:relative;z-index:1;width:min(430px,31vw);padding-top:176px;margin-left:calc(50% + 42px)}#me-cooling-performance-{{ sid }} h2,#me-cooling-performance-{{ sid }} h3{margin:0;font-size:38px;line-height:1.28;letter-spacing:-.03em}#me-cooling-performance-{{ sid }} p{margin:28px 0 0;font-size:14px;line-height:1.8}#me-cooling-performance-{{ sid }} .me-cooling-performance__badge{display:block;width:235px;max-width:100%;margin-top:18px}#me-cooling-performance-{{ sid }} .me-cooling-performance__badge img{display:block;width:100%;height:auto}#me-cooling-performance-{{ sid }} .me-cooling-performance__note{margin-top:35px;font-size:10px;line-height:1.75}#me-cooling-performance-{{ sid }} .me-cooling-performance__note p{margin:0;font-size:inherit;line-height:inherit}#me-cooling-performance-{{ sid }} .me-cooling-performance__mobile{display:none}@media(max-width:749px){#me-cooling-performance-{{ sid }}{display:flex;min-height:0;flex-direction:column}#me-cooling-performance-{{ sid }} .me-cooling-performance__background{position:relative;inset:auto;flex:0 0 auto;width:100%;height:min(88vw,340px);order:1}#me-cooling-performance-{{ sid }} .me-cooling-performance__background-image{object-fit:cover;object-position:center top}#me-cooling-performance-{{ sid }} .me-cooling-performance__content{width:auto;padding:0 17px 43px;margin:0;order:2;background:var(--me-cooling-bg)}#me-cooling-performance-{{ sid }} .me-cooling-performance__desktop{display:none}#me-cooling-performance-{{ sid }} .me-cooling-performance__mobile{display:block}#me-cooling-performance-{{ sid }} h2,#me-cooling-performance-{{ sid }} h3{font-size:23px;line-height:1.35}#me-cooling-performance-{{ sid }} p{margin-top:15px;font-size:11px;line-height:1.72}#me-cooling-performance-{{ sid }} .me-cooling-performance__badge{width:190px;margin-top:11px}#me-cooling-performance-{{ sid }} .me-cooling-performance__note{margin-top:23px;font-size:9px;line-height:1.65}}
  #me-cooling-performance-{{ sid }} .me-cooling-performance__desktop > :first-child{margin:0;font-size:48px;font-weight:500;line-height:1.4;letter-spacing:-.035em}#me-cooling-performance-{{ sid }} .me-cooling-performance__desktop > :not(:first-child){margin:28px 0 0;font-size:14px;line-height:1.65}#me-cooling-performance-{{ sid }} .me-cooling-performance__note,#me-cooling-performance-{{ sid }} .me-cooling-performance__note p{font-size:12px;line-height:1.7}@media(max-width:749px){#me-cooling-performance-{{ sid }} .me-cooling-performance__mobile > :first-child{margin:0;font-size:26px;font-weight:600;line-height:1.4}#me-cooling-performance-{{ sid }} .me-cooling-performance__mobile > :not(:first-child){margin:14px 0 0;font-size:12px;line-height:1.65}}
</style>
{% schema %}
{"name":"Ulike ME 冷感持久力模块","settings":[{"type":"image_picker","id":"background_image","label":"PC 背景图"},{"type":"image_picker","id":"background_image_mobile","label":"移动端背景图"},{"type":"html","id":"title_html","label":"PC 右侧标题（HTML）"},{"type":"html","id":"description_html","label":"PC 右侧描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"description_html_mobile","label":"移动端描述（HTML）"},{"type":"image_picker","id":"badge_image","label":"PC 强调图片"},{"type":"image_picker","id":"badge_image_mobile","label":"移动端强调图片"},{"type":"richtext","id":"note_html","label":"底部注释"},{"type":"color","id":"background","label":"背景底色","default":"#eef7ff"},{"type":"color","id":"text_color","label":"文字颜色","default":"#111111"}],"presets":[{"name":"Ulike ME 冷感持久力模块"}]}
{% endschema %}
