{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section class="jp-amb-hero jp-amb-hero--{{ sid }}">
  <picture>
    {%- if st.mobile_image != blank -%}
      <source media="(max-width: 768px)" srcset="{{ st.mobile_image | image_url: width: 900 }}">
    {%- endif -%}

    {%- if st.image != blank -%}
      <img
        class="jp-amb-hero__image"
        src="{{ st.image | image_url: width: 2400 }}"
        alt="{{ st.image.alt | escape }}"
        loading="eager"
      >
    {%- endif -%}
  </picture>

  <div class="jp-amb-hero__content">
    <div class="jp-container jp-amb-hero__container">
      <div class="jp-amb-hero__text">
        {%- if st.kicker != blank -%}
          <div class="jp-amb-hero__kicker">{{ st.kicker }}</div>
        {%- endif -%}

        {%- if st.title != blank -%}
          <div class="jp-amb-hero__title">{{ st.title }}</div>
        {%- endif -%}

        {%- if st.icon_image != blank -%}
          <img
            class="jp-amb-hero__icon"
            src="{{ st.icon_image | image_url: width: 280 }}"
            alt="{{ st.icon_image.alt | escape }}"
            loading="lazy"
          >
        {%- endif -%}

        {%- if st.feature_image != blank or st.mobile_feature_image != blank -%}
          <picture class="jp-amb-hero__feature-picture">
            {%- if st.mobile_feature_image != blank -%}
              <source media="(max-width: 768px)" srcset="{{ st.mobile_feature_image | image_url: width: 900 }}">
            {%- endif -%}

            {%- assign feature_image = st.feature_image | default: st.mobile_feature_image -%}
            <img
              class="jp-amb-hero__feature-image"
              src="{{ feature_image | image_url: width: 1440 }}"
              alt="{{ feature_image.alt | escape }}"
              loading="lazy"
            >
          </picture>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if st.info != blank -%}
    <div class="jp-amb-hero__info-wrap">
      <div class="jp-container jp-amb-hero__info-container">
        <div class="jp-amb-hero__info">{{ st.info }}</div>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  .jp-amb-hero--{{ sid }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #eef5ff;
  }

  .jp-amb-hero--{{ sid }} picture {
    display: block;
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__container {
    width: 100%;
  }


  .jp-amb-hero--{{ sid }} .jp-amb-hero__text {
    {% comment %} width: 560px;
    max-width: 42vw; {% endcomment %}
    padding-left: 0;
    {% comment %} transform: translateY(-6px); {% endcomment %}
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__kicker {
    margin-bottom: 8px;
    font-size: 36px;
    line-height: 1.5;
    color: #000;
    font-weight: 400;
    font-family: var(--font-hd-family);
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__title {
    font-size: 72px;
    line-height: 1.2;
    color: #000;
    letter-spacing: .12em;
    font-weight: 400;
    font-family: var(--font-hd-family);
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__icon {
    width: 174px;
    margin-top: 120px;
    display: block;
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__feature-picture {
    display: block;
    width: 720px;
    max-width: 100%;
    margin-top: 40px;
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__feature-image {
    width: 100%;
    display: block;
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__info-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    z-index: 2;
    pointer-events: none;
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__info-container {
    width: 100%;
  }

  .jp-amb-hero--{{ sid }} .jp-amb-hero__info {
    max-width: 630px;
    font-size: 10px;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.50);
    letter-spacing: .02em;
    white-space: pre-line;
  }

  @media (max-width: 768px) {
    .jp-amb-hero--{{ sid }} .jp-amb-hero__content {
      inset: 0;
      display: block;
      padding-top: 30px;
      box-sizing: border-box;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__container {
      width: 100%;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__text {
      width: 100%;
      max-width: none;
      padding-left: 0;
      transform: none;
      text-align: center;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__kicker {
      font-size: 20px;
      line-height: 1.45;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__title {
      font-size: 36px;
      line-height: 1.3;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__icon {
      width: 80px;
      margin: 40px 0 0 40px;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__feature-picture {
      width: 80%;
      max-width: 80%;
      margin: 24px auto 0;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__info-wrap {
      left: 0;
      right: 0;
      bottom: 14px;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__info-container {
      width: 100%;
    }

    .jp-amb-hero--{{ sid }} .jp-amb-hero__info {
      max-width: none;
      font-size: 7px;
      line-height: 1.38;
      color: rgba(0, 0, 0, 0.45);
      letter-spacing: 0;
    }
  }
</style>

{% schema %}
{
  "name": "JP Amb Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Small title",
      "default": "痛みレス*1な冷感サファイヤで"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "default": "輝く美肌へ"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon image"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature image - PC"
    },
    {
      "type": "image_picker",
      "id": "mobile_feature_image",
      "label": "Feature image - Mobile"
    },
    {
      "type": "textarea",
      "id": "info",
      "label": "Info text",
      "default": "*1 刺激や痛みの感じ方には個人差と部位差があります。\n*フロスト&サリバン調べ; 2023 年世界の光美容器の小売販売台数から算出。2024 年 10 月に実施された調査に基づく。光美容器とは、レーザーやIPLといった技術を利用して無駄毛を処理する美容機器を指す。"
    }
  ],
  "presets": [
    {
      "name": "JP Amb Hero"
    }
  ]
}
{% endschema %}