{% comment %}
  Air 10 Max 2026: cost-comparison. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-cost-comparison-2026-{{ section.id }}" class="a10-2026 to-top a10-2026__cost">
<div class="a10-2026__inner">{% if section.settings.title != blank %}
<h2 class="a10-2026__title a10-2026__center">{{ section.settings.title | escape | newline_to_br }}</h2>
{% endif %}{% if section.settings.subtitle != blank %}<p class="a10-2026__subtitle">{{ section.settings.subtitle | escape | newline_to_br }}</p>{% endif %}
<table class="a10-2026__cost-table">
<caption class="visually-hidden">{{ section.settings.subtitle | escape | newline_to_br }}</caption>

<tbody>{% for block in section.blocks %}
<tr  {{ block.shopify_attributes }}>
<th scope="row">
<div class="a10-2026__cost-label">{%- assign a10_image = block.settings.image | default: block.settings.image -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}<span>{{ block.settings.label | escape | newline_to_br }}</span></div>
{% if forloop.first and section.settings.vs_label != blank %}<span class="a10-2026__cost-vs">{{ section.settings.vs_label | escape }}</span>{% endif %}</th>

<td>{% if forloop.first %}<small>{{ section.settings.price_label | escape | newline_to_br }}</small>{% endif %}{{ block.settings.price | escape | newline_to_br }}</td>

<td>{{ block.settings.detail | escape | newline_to_br }}</td>
</tr>
{% endfor %}</tbody>
</table>
{% if section.settings.note != blank %}
<div class="a10-2026__note">{{ section.settings.note }}</div>
{% endif %}</div>
</section>

<style>
#a10-max-cost-comparison-2026-{{ section.id }} { color: #190a0a;  overflow: hidden; }
#a10-max-cost-comparison-2026-{{ section.id }} *, #a10-max-cost-comparison-2026-{{ section.id }} *::before, #a10-max-cost-comparison-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-cost-comparison-2026-{{ section.id }} h2, #a10-max-cost-comparison-2026-{{ section.id }} h3, #a10-max-cost-comparison-2026-{{ section.id }} p { margin: 0; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__inner { width: min(1220px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__wide { width: min(1600px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-cost-comparison-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost { background: #fff; padding: 90px 0 55px; }
#a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost .a10-2026__subtitle { margin: 45px auto 100px; display: flex; align-items: center; gap: 30px; color: #3f3636; }
#a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost .a10-2026__subtitle::before, #a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost .a10-2026__subtitle::after { content: ''; height: 1px; background: #aaa; flex: 1; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table :is(th,td) { padding: 35px 15px; background: #f9f9f9; text-align: center; font-weight: 400; border: 0; font-size: 24px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table th { width: 45%; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table td:nth-child(2) {  font-size: 40px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table td:last-child { font-size: 24px; color: #3f3636; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table .a10-2026__media { width: 105px; flex: 0 0 auto; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-label { display: flex; align-items: center; gap: 40px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table tr:first-child :is(th,td) { background: #fff0f5; border-bottom: 30px solid white; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table tr:first-child td:nth-child(2) { color: #e0004d; font-size: 60px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table small { display: block; font-size: 20px; color: #000; }
#a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost .a10-2026__note { margin-top: 90px; max-width: 1000px; }
@media (min-width:750px) and (max-width:1400px) {
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__title { font-size: 32px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__subtitle { font-size: 26px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table :is(th,td), #a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table td:last-child { font-size: 18px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-label { gap: 18px; }
}
@media (max-width:749px) {
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__inner, #a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__wide { width: calc(100% - 40px); }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__desktop { display: none !important; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__mobile { display: block; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__title { font-size: 24px; line-height: 1.3; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__subtitle { font-size: 24px; line-height: 1.5; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__body { font-size: 14px; line-height: 1.5; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__note { font-size: 10px; line-height: 1.5; }
#a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost { padding: 34px 0 30px; }
#a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost .a10-2026__title { font-size: 20px; font-weight: 500; max-width: 260px; margin: auto; }
#a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost .a10-2026__subtitle { font-size: 14px; gap: 8px; margin: 20px 0; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table :is(th,td) { font-size: 9px; padding: 10px 2px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table th { width: 45%; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table td:nth-child(2) { font-size: 18px; white-space: nowrap; width: 26%; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table td:last-child { font-size: 10px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table tr:first-child td:nth-child(2) { font-size: 20px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table tr:first-child :is(th,td) { border-bottom-width: 10px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table .a10-2026__media { width: 38px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-label { gap: 6px; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table small { font-size: 10px; }
#a10-max-cost-comparison-2026-{{ section.id }}.a10-2026__cost .a10-2026__note { margin-top: 26px; }
}
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table { border:0; margin:0; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table th { font-weight:400; }
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-table th {position:relative;}
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-vs {position:absolute;bottom:-35px;left:50px;z-index:1;display:flex;align-items:center;justify-content:center;width:72px;height:72px;border-radius:50%;background:#e0004d;color:#fff;font-size:35px;font-style:italic;}
@media(max-width:749px) {
#a10-max-cost-comparison-2026-{{ section.id }} .a10-2026__cost-vs {width:24px;height:24px;bottom:-12px;left:25px;font-size:14px;}
}

</style>

{% schema %}
{
  "name": "A10 Max 费用对比",
  "tag": "section",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "标题",
      "default": "エステ・医療脱毛より圧倒的なコスパ！"
    },
    {
      "type": "html",
      "id": "note",
      "label": "脚注",
      "default": "<p>*回数無制限：90w回15年。<br>*当社調べ（2026年3月時点）。公開されている各サービスの料金情報およびユーザー調査に基づき算出。実際の費用・回数・期間は個人差やプランにより異なる場合があります。</p>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "对比副标题",
      "default": "全身脱毛のコスト比較"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "价格上方标签",
      "default": "定価"
    },
    {
      "type": "text",
      "id": "vs_label",
      "label": "对比标记",
      "default": "VS"
    }
  ],
  "blocks": [
    {
      "type": "comparison",
      "name": "费用对比行",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "缩略图"
        },
        {
          "type": "text",
          "id": "label",
          "label": "项目名称"
        },
        {
          "type": "text",
          "id": "price",
          "label": "金额"
        },
        {
          "type": "textarea",
          "id": "detail",
          "label": "回数与期间"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A10 Max 费用对比",
      "blocks": [
        {
          "type": "comparison",
          "settings": {
            "label": "Ulike Air 10 Max",
            "price": "¥69,800",
            "detail": "回数無制限*"
          }
        },
        {
          "type": "comparison",
          "settings": {
            "label": "美容脱毛サロン（全身）",
            "price": "¥150,000～",
            "detail": "10～20回／1～2年"
          }
        },
        {
          "type": "comparison",
          "settings": {
            "label": "医療脱毛（全身）",
            "price": "¥300,000～",
            "detail": "5～8回／1年"
          }
        },
        {
          "type": "comparison",
          "settings": {
            "label": "カミソリ・シェーバー",
            "price": "¥50,000～",
            "detail": "生涯続く（時間・肌へのダメージ）"
          }
        }
      ]
    }
  ]
}
{% endschema %}
