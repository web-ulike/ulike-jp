<style>

#shopify-section-{{ section.id }} {
    --text-color: {{  section.settings.text_color.red }}, {{  section.settings.text_color.green }}, {{  section.settings.text_color.blue }};
    --section-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    --color-border: 255, 255, 255;
    /* background: rgb(var(--section-background, var(--background)));  */
  }
     .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
  @media screen and (max-width: 768px){
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px );
  }
}
.list-recommend{
  overflow: hidden;
}
.list-recommend h3{
  color: #000;
font-size: 32px;
font-style: normal;
font-weight: 500;
line-height: 150%;
letter-spacing: 0.64px;
}
.list-inner{
  display: flex;
  gap: 30px;
}
.list-tb{
  margin-bottom: 60px;
}


.list-tb-rt{
  display: none;
  gap: 20px;
}
.list-tb-rt svg{
  cursor: pointer;
}
.list-tb{
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.list-svg{
  cursor: pointer;
}
.list-list {
    flex: 1;
}

.list-top{
display:flex;
}
.list_link{
color: #E0004D;
font-size: 16px;
font-style: normal;
font-weight: 400;
line-height: 125%;
letter-spacing: 1.6px;
text-decoration: underline;
}
.moblie-list-link{
display:none;
margin-top:35px;
}
@media (max-width: 768px){
    .list_link{
        display:none;
}
  .list-tb-rt{
  display: flex;
}
  .list-inner {
    gap: 0px;
}
.list-recommend h3{
  font-size: 24px;
}
.list-list {
    flex: none;
}
.list-tb {
    margin-bottom: 34px;
}
.moblie-list-link{
display:block;
}
}
</style>
 <section class="section-{{ section.id }}-padding">
 <div class="list-recommend to-top">
                <div class="container">
                   <custom-swiper
              slides-per-view="1.2" 
              space-between="20" 
              loop="false" 
              centered-slides="false"
              pagination="false"
              navigation="true"
              disable-on="desktop"
              breakpoints='{"768":{"slidesPerView": 1,"spaceBetween": 20}}'
            >
                  <div class="list-tb">
                     <h3>{{ section.settings.tle }}</h3>
                      {%- if section.settings.link_txt != blank -%}
                     <a href="{{ section.settings.link_url }}" class="list_link">{{ section.settings.link_txt }}</a>
                        {%- endif -%}
                     <div class="list-tb-rt">
                      <svg xmlns="http://www.w3.org/2000/svg" width="25" height="19" viewBox="0 0 25 19" fill="none" class="swiper-prev">
                        <g clip-path="url(#clip0_11941_6750)">
                          <path d="M-5.72205e-05 9.09359C-5.72205e-05 9.23717 0.0543137 9.37959 0.158329 9.48843L8.43225 18.1726L9.29628 17.3829L1.95022 9.67254H24.2307C24.2307 9.03338 23.7012 8.51465 23.0487 8.51465H0.618122C0.394726 8.51465 0.177242 8.62465 0.0708618 8.81802C0.0224018 8.90486 -5.72205e-05 8.9998 -5.72205e-05 9.09359Z" fill="#190A0A"/>
                          <path d="M1.23671 7.06313C1.69887 7.5147 2.44707 7.5147 2.90805 7.06313L9.28369 0.818628L8.44803 0L1.2379 7.06313H1.23671Z" fill="#190A0A"/>
                        </g>
                        <defs>
                          <clipPath id="clip0_11941_6750">
                            <rect width="24.2308" height="18.1731" fill="white" transform="matrix(-1 0 0 1 24.2307 0)"/>
                          </clipPath>
                        </defs>
                      </svg>
                      <svg xmlns="http://www.w3.org/2000/svg" width="25" height="19" viewBox="0 0 25 19" fill="none" class="swiper-next">
                        <g clip-path="url(#clip0_11941_6753)">
                          <path d="M25.0001 9.09359C25.0001 9.23717 24.9457 9.37959 24.8417 9.48843L16.5677 18.1726L15.7037 17.3829L23.0498 9.67254H0.769287C0.769287 9.03338 1.29882 8.51465 1.95128 8.51465H24.3819C24.6053 8.51465 24.8228 8.62465 24.9291 8.81802C24.9776 8.90486 25.0001 8.9998 25.0001 9.09359Z" fill="#190A0A"/>
                          <path d="M23.7633 7.06313C23.3011 7.5147 22.5529 7.5147 22.092 7.06313L15.7163 0.818628L16.552 0L23.7621 7.06313H23.7633Z" fill="#190A0A"/>
                        </g>
                        <defs>
                          <clipPath id="clip0_11941_6753">
                            <rect width="24.2308" height="18.1731" fill="white" transform="translate(0.769287)"/>
                          </clipPath>
                        </defs>
                      </svg>
                     </div>
                  </div>
                  <div class="swiper-container">
                    <div class="list-inner swiper-wrapper">
                     

                       {%- for block in section.blocks -%}
                      <div class="list-list swiper-slide">
                        <a class="list-top" href="{{ block.settings.link_url }}">
                         <picture>
                         {%- if block.settings.image_mobile -%}
                            <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url }}">
                                 {%- endif -%}
                             {%- if block.settings.image -%}
                            <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}">
                            {%- endif -%}
                       </picture>
                    </a>

                      </div>
                       {%- endfor -%}
                      
                                
                    </div>
                  </div>


                    {%- if section.settings.link_txt != blank -%}
                     <a href="{{ section.settings.link_url }}" class="list_link moblie-list-link">{{ section.settings.link_txt }}</a>
                        {%- endif -%}


                  </custom-swiper>
                </div>
              </div>
  </section>
<script>
</script>
{% schema %}
{
  "name": "list-img",
  "class": "list-img", 
  "settings": [
           {
      "type": "text",
      "id": "tle",
      "label": "Title"
    },
                {
      "type": "url",
      "id": "link_url",
      "label": "Button Link"
    },
                {
      "type": "text",
      "id": "link_txt",
      "label": "Button Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
     {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 10
    }
  ],
  "blocks": [
         {
        "type": "item",
        "name": "item",
        "settings": [
           {
          "type": "image_picker",
          "id": "image",
          "label": "Images"
        },
     {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Images"
        },
            {
      "type": "url",
      "id": "link_url",
      "label": "Button Link"
    },
        {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
        ]
      }
  ],
  "presets": [
    {
      "name": "list-img"
    }
  ]
}
{% endschema %}
