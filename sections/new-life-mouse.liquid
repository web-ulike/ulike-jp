<style>
  canvas {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index:10;
  }
</style>
<canvas id="canvas"></canvas>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

// 樱花 SVG
const img = new Image();
img.src = 'https://cdn.shopify.com/s/files/1/0553/7392/2352/files/Vectoryinghua.svg?v=1770622723';

const petals = [];

class Petal {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.size = Math.random() * 14 + 10;

    this.speedY = Math.random() * 1 + 0.6;
    this.speedX = Math.random() * 0.6 - 0.3;

    this.rotate = Math.random() * Math.PI * 2;
    this.rotateSpeed = Math.random() * 0.02 - 0.01;

    this.alpha = 1;
  }

  update() {
    this.y += this.speedY;
    this.x += this.speedX + Math.sin(this.y * 0.01);

    this.rotate += this.rotateSpeed;

    // 🌸 关键：指数衰减透明度（不会抖）
    this.alpha *= 0.98;

    // 模拟空气阻力
    this.speedY *= 0.995;
    this.speedX *= 0.99;
  }

  draw() {
    if (this.alpha <= 0) return;

    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rotate);

    ctx.globalAlpha = this.alpha;
    ctx.globalCompositeOperation = 'source-over';

    ctx.drawImage(
      img,
      -this.size / 2,
      -this.size / 2,
      this.size,
      this.size
    );

    ctx.restore();
  }
}

// 鼠标生成樱花
window.addEventListener('mousemove', e => {
  for (let i = 0; i < 2; i++) {
    petals.push(new Petal(e.clientX, e.clientY));
  }
});

function animate() {
  // 🔒 每一帧强制重置状态（防止 alpha 回弹）
  ctx.globalAlpha = 1;
  ctx.globalCompositeOperation = 'source-over';
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  for (let i = petals.length - 1; i >= 0; i--) {
    const p = petals[i];
    p.update();
    p.draw();

    // 🌸 提前删除，看不到“最后一闪”
    if (p.alpha <= 0.05 || p.y > canvas.height + 50) {
      petals.splice(i, 1);
    }
  }

  requestAnimationFrame(animate);
}

animate();
</script>



