{%- liquid
  assign bg_desktop = section.settings.background_image
  assign bg_mobile = section.settings.background_mobile | default: bg_desktop
  assign gift_desktop = section.settings.gift_image
  assign gift_mobile = section.settings.gift_mobile | default: gift_desktop
  assign reveal_class = 'to-top'
  if request.page_type == 'article' or request.page_type == 'blog' or request.design_mode
    assign reveal_class = ''
  endif
  assign loading = 'lazy'
  if section.index == 1 or section.index == nil
    assign loading = 'eager'
  endif
-%}
<section class="jp-bf-gift" aria-label="{{ section.settings.heading | escape }}">
  <div class="jp-bf-gift__background" aria-hidden="true">
    <picture>
      {%- if bg_mobile != blank -%}<source media="(max-width: 767px)" srcset="{{ bg_mobile | image_url: width: 1200 }}">{%- elsif bg_desktop == blank -%}<source media="(max-width: 767px)" srcset="{{ 'jp-bf-gift-bg-m.png' | asset_url }}">{%- endif -%}
      {%- if bg_desktop != blank -%}{{ bg_desktop | image_url: width: 2400 | image_tag: loading: loading, widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: '' }}{%- elsif bg_mobile != blank -%}{{ bg_mobile | image_url: width: 1200 | image_tag: loading: loading, alt: '' }}{%- else -%}<img src="{{ 'jp-bf-gift-bg.png' | asset_url }}" alt="" loading="{{ loading }}" width="1024" height="1024">{%- endif -%}
    </picture>
    <img class="jp-bf-gift__glow jp-bf-gift__glow--one" src="{{ 'jp-bf-gift-glow1.svg' | asset_url }}" alt="" loading="lazy">
    <img class="jp-bf-gift__glow jp-bf-gift__glow--two" src="{{ 'jp-bf-gift-glow2.svg' | asset_url }}" alt="" loading="lazy">
  </div>
  <div class="container jp-bf-gift__inner">
    <h2 class="jp-bf-gift__heading">{{ section.settings.heading | escape }}</h2>
    <div class="jp-bf-gift__cards">
      <div class="jp-bf-gift__hero">
        <div class="jp-bf-gift__hero-media" aria-hidden="true">
          <picture>
            {%- if gift_mobile != blank -%}<source media="(max-width: 767px)" srcset="{{ gift_mobile | image_url: width: 1200 }}">{%- elsif gift_desktop == blank -%}<source media="(max-width: 767px)" srcset="{{ 'jp-bf-gift-gift-m.png' | asset_url }}">{%- endif -%}
            {%- if gift_desktop != blank -%}{{ gift_desktop | image_url: width: 1800 | image_tag: loading: loading, widths: '750, 1200, 1800', sizes: '(max-width: 767px) 100vw, 1200px', alt: '' }}{%- elsif gift_mobile != blank -%}{{ gift_mobile | image_url: width: 1200 | image_tag: loading: loading, alt: '' }}{%- else -%}<img src="{{ 'jp-bf-gift-gift.png' | asset_url }}" alt="" loading="{{ loading }}" width="1024" height="405">{%- endif -%}
          </picture>
          {%- if gift_desktop == blank and gift_mobile == blank -%}<img class="jp-bf-gift__hero-layer" src="{{ 'jp-bf-gift-gift-layer.png' | asset_url }}" alt="" width="1515" height="598" loading="{{ loading }}">{%- endif -%}
        </div>
        <div class="jp-bf-gift__hero-copy">
          <div class="jp-bf-gift__logos" aria-label="Ulike × Black Friday"><img src="{{ 'jp-bf-gift-logo.svg' | asset_url }}" alt="" width="95" height="22"><img src="{{ 'jp-bf-gift-cross.svg' | asset_url }}" alt="" width="15" height="15"><img src="{{ 'jp-bf-gift-blackfriday.png' | asset_url }}" alt="" width="102" height="40" loading="lazy"></div>
          <div class="jp-bf-gift__description {{ reveal_class }}">{{ section.settings.description }}</div>
        </div>
      </div>
      <div class="jp-bf-gift__cashback">
        <div class="jp-bf-gift__cashback-heading {{ reveal_class }}">{{ section.settings.cashback_heading }}</div>
        <div class="jp-bf-gift__coupons">
          {%- for block in section.blocks -%}
            <div class="jp-bf-gift__coupon" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '270, 437, 600, 900', sizes: '(max-width: 767px) 270px, 437px', alt: block.settings.alt }}
              {%- elsif forloop.index == 1 -%}<img src="{{ 'jp-bf-gift-coupon1.png' | asset_url }}" width="437" height="141" loading="lazy" alt="{{ block.settings.alt | escape }}">
              {%- elsif forloop.index == 2 -%}<img src="{{ 'jp-bf-gift-coupon2.png' | asset_url }}" width="437" height="141" loading="lazy" alt="{{ block.settings.alt | escape }}">{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
    <div class="jp-bf-gift__notes {{ reveal_class }}">{{ section.settings.notes }}</div>
  </div>
</section>
{% stylesheet %}
.jp-bf-gift { position: relative; overflow: hidden; background: #010101; color: #fff; padding: 62px 0 110px; }
.jp-bf-gift__background, .jp-bf-gift__background picture, .jp-bf-gift__background picture img { position: absolute; inset: 0; width: 100%; height: 100%; }
.jp-bf-gift__background picture img { object-fit: cover; opacity: .64; }
.jp-bf-gift__glow { position: absolute; width: 1808px; max-width: none; mix-blend-mode: screen; pointer-events: none; }
.jp-bf-gift__glow--one { right: -941px; top: -610px; }
.jp-bf-gift__glow--two { right: calc(50% + 220px); top: -143px; }
.jp-bf-gift__inner.container { position: relative; max-width: 1240px; padding-inline: 20px; }
.jp-bf-gift__heading { margin: 0 0 77px; text-align: center; color: #f5e5ca; font-family: 'Noto Serif JP', serif; font-size: 40px; font-weight: 500; line-height: 1.3; }
.jp-bf-gift__cards { display: grid; gap: 80px; }
.jp-bf-gift__hero, .jp-bf-gift__cashback { position: relative; overflow: hidden; height: 408px; border-radius: 12px; }
.jp-bf-gift__hero { border: 2px solid #ebbc8c; background: #634329; }
.jp-bf-gift__hero-media, .jp-bf-gift__hero-media picture { position: absolute; inset: 0; }
.jp-bf-gift__hero-media img { position: absolute; width: 126.6%; max-width: none; height: 147%; left: -20.2%; top: -44.5%; object-fit: cover; }
.jp-bf-gift__hero-copy { position: absolute; right: 8.5%; top: 31%; width: 342px; text-align: center; }
.jp-bf-gift__logos { display: flex; justify-content: center; align-items: center; gap: 15px; }
.jp-bf-gift__logos img { display: block; max-width: none; object-fit: contain; }
.jp-bf-gift__description { margin-top: 31px; font-size: 16px; line-height: 1.5; }
.jp-bf-gift__description p, .jp-bf-gift__cashback-heading p, .jp-bf-gift__notes p { margin: 0; }
.jp-bf-gift__description strong { background: #fbecd8; color: #5d3e1f; font-weight: 500; }
.jp-bf-gift__cashback { border: 2px solid #8f6132; background: linear-gradient(60deg, #1e1308 -3%, #5b4025 41%, #e4c38e 99%); text-align: center; padding: 54px 20px 30px; }
.jp-bf-gift__cashback-heading { font-size: 16px; line-height: 1.3; }
.jp-bf-gift__coupons { display: flex; justify-content: center; gap: 50px; margin-top: 65px; }
.jp-bf-gift__coupon { width: min(437px, 45%); }
.jp-bf-gift__coupon img { display: block; width: 100%; height: auto; }
.jp-bf-gift__notes { margin-top: 64px; color: rgba(255,255,255,.7); font-size: 12px; line-height: 1.3; }
@media screen and (max-width: 767px) {
  .jp-bf-gift { padding: 50px 0; }
  .jp-bf-gift__background picture img { opacity: 1; }
  .jp-bf-gift__glow { display: none; }
  .jp-bf-gift__inner.container { padding-inline: 16px; }
  .jp-bf-gift__heading { max-width: 284px; margin: 0 auto 30px; font-size: 24px; }
  .jp-bf-gift__cards { gap: 20px; }
  .jp-bf-gift__hero, .jp-bf-gift__cashback { height: 358px; border: 0; border-radius: 4px; }
  .jp-bf-gift__hero-media .jp-bf-gift__hero-layer { display: none; }
  .jp-bf-gift__hero-media img { width: 234.2%; height: 88.6%; left: -48.7%; top: 11.4%; }
  .jp-bf-gift__hero:after { content: ''; position: absolute; inset: 0 0 auto; height: 164px; background: linear-gradient(to bottom, #825c35 27%, rgba(159,117,70,0)); }
  .jp-bf-gift__hero-copy { z-index: 1; top: 26px; right: 0; width: 100%; padding: 0 12px; }
  .jp-bf-gift__logos { gap: 10px; }
  .jp-bf-gift__logos img:nth-child(1) { width: 61px; height: 14px; }
  .jp-bf-gift__logos img:nth-child(2) { width: 10px; height: 10px; }
  .jp-bf-gift__logos img:nth-child(3) { width: 66px; height: 26px; }
  .jp-bf-gift__description { margin: 18px auto 0; max-width: 320px; font-size: 16px; font-weight: 500; }
  .jp-bf-gift__cashback { padding: 34px 16px 20px; background: linear-gradient(84deg, #70410f -32%, #86613b 42%, #e4c28e 100%); }
  .jp-bf-gift__coupons { flex-direction: column; align-items: center; gap: 35px; margin-top: 34px; }
  .jp-bf-gift__coupon { width: min(270px, 100%); }
  .jp-bf-gift__notes { margin-top: 30px; color: rgba(255,255,255,.5); font-size: 8px; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "BF Gifts 2026",
  "settings": [
    {"type":"text","id":"heading","label":"見出し","default":"どなたでも参加できるチャンス！"},
    {"type":"richtext","id":"description","label":"プレゼント説明","default":"<p>期間中にご購入いただいた方全員に、もれなく<strong>Ulikeハートミラー</strong>をプレゼント！</p>"},
    {"type":"richtext","id":"cashback_heading","label":"キャッシュバック説明","default":"<p>ご購入いただいた方全員に<br/>キャッシュバックが当たるチャンス!</p>"},
    {"type":"richtext","id":"notes","label":"注意事項","default":"<p>・本キャンペーンは、Ulike株式会社が主催・運営しております。<br/>・各賞品の提供元企業は、本キャンペーンのスポンサーではなく、一切関与しておりません。<br/>・賞品の換金、転売、および第三者への譲渡は禁止されています。<br/>・本キャンペーン内容の最終的な解釈権および変更権は、Ulike株式会社に帰属します。<br/>・賞品発送またはキャッシュバックの時点で、ご注文がキャンセルまたは返金されている場合は対象外となります。<br/>・当選したキャッシュバック金額が実際の決済金額を上回る場合は、決済金額を上限として払い戻しいたします。</p>"},
    {"type":"image_picker","id":"background_image","label":"背景画像（PC）"},
    {"type":"image_picker","id":"background_mobile","label":"背景画像（モバイル）"},
    {"type":"image_picker","id":"gift_image","label":"プレゼント画像（PC）"},
    {"type":"image_picker","id":"gift_mobile","label":"プレゼント画像（モバイル）"}
  ],
  "blocks": [{"type":"coupon","name":"賞品画像","settings":[{"type":"image_picker","id":"image","label":"賞品画像"},{"type":"text","id":"alt","label":"画像の説明","default":"キャッシュバック賞品"}]}],
  "presets": [{"name":"BF Gifts 2026","blocks":[{"type":"coupon","settings":{"alt":"特賞 10,000円 キャッシュバック 10名様"}},{"type":"coupon","settings":{"alt":"1等 5,000円 キャッシュバック 20名様"}}]}]
}
{% endschema %}
