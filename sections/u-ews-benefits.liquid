{% comment %}
  Section: u-ews-benefits
  Usage:
  - Extended warranty service page top benefits section
  - Text and icons are configurable
  - Layout/style is fixed
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section id="u-ews-benefits-{{ sid }}" class="u-ews-benefits">
  <div class="u-ews-benefits__inner">
    {%- if st.top_note != blank -%}
      <div class="u-ews-benefits__top-note to-top">
        <div class="container">
          {{ st.top_note }}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="container u-ews-benefits__grid to-top">
        {%- for block in section.blocks -%}
          <div class="u-ews-benefits__item to-top" {{ block.shopify_attributes }}>
            <div class="u-ews-benefits__icon-wrap">
              {%- if block.settings.icon != blank -%}
                <img
                  class="u-ews-benefits__icon"
                  src="{{ block.settings.icon | image_url: width: 120 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="60"
                  height="{{ 60 | divided_by: block.settings.icon.aspect_ratio | round }}"
                >
              {%- else -%}
                <div class="u-ews-benefits__icon-placeholder"></div>
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank -%}
              <div class="u-ews-benefits__title">
                {{ block.settings.title }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #u-ews-benefits-{{ sid }} {
    padding: 0px 0 80px;
    position: relative;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__inner {
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__top-note {
    margin: 0 auto;
    background: #FFF1F6;
    text-align: center;
    min-height: 50px;
    color: #000;
    font-size: 12px;
    line-height: 1.75;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__top-note p {
    margin: 0;
  }
  #u-ews-benefits-{{ sid }} .u-ews-benefits__top-note a{
    color: #E0004D;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__top-note .container {
    width: 100%;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
    margin: 80px auto 0px;
    width: 90%;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80px;
    margin-bottom: 20px;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__icon {
    display: block;
    height: auto;
    object-fit: contain;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__icon-placeholder {
    width: 44px;
    height: 44px;
    border: 1px solid #111;
    border-radius: 50%;
  }

  #u-ews-benefits-{{ sid }} .u-ews-benefits__title {
    color: #111;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0;
  }

  @media screen and (max-width: 749px) {
    #u-ews-benefits-{{ sid }} {
      padding: 0px 0 20px;
    }

    #u-ews-benefits-{{ sid }} .u-ews-benefits__inner {
    }

    #u-ews-benefits-{{ sid }} .u-ews-benefits__top-note {
      margin: 0 auto 18px;
      padding: 30px 0px;
      font-size: 12px;
      line-height: 1.5;
    }

    #u-ews-benefits-{{ sid }} .u-ews-benefits__grid {
      gap: 8px;
      margin-top: 40px;
      width: 100%;
    }

    #u-ews-benefits-{{ sid }} .u-ews-benefits__item {
      min-height: 92px;
    }

    #u-ews-benefits-{{ sid }} .u-ews-benefits__icon-wrap {
      height: 42px;
      margin-bottom: 8px;
    }

    #u-ews-benefits-{{ sid }} .u-ews-benefits__icon,
    #u-ews-benefits-{{ sid }} .u-ews-benefits__icon-placeholder {
      width: 28px;
      height: 28px;
    }

    #u-ews-benefits-{{ sid }} .u-ews-benefits__title {
      font-size: 14px;
      line-height: 1.45;
      width: 90px;
    }
  }
</style>

{% schema %}
{
  "name": "u-ews-benefits",
  "tag": "section",
  "class": "section section-u-ews-benefits",
  "settings": [
    {
      "type": "richtext",
      "id": "top_note",
      "label": "Top note",
      "default": "<p>当社製品をご購入いただいたお客様にメーカー有償延長保証サービスを別途ご利用いただけるよう、2年間メーカー保証以外に「有償延長保証サービス」を提供しております。</p>"
    }
  ],
  "blocks": [
    {
      "type": "benefit_item",
      "name": "Benefit item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "最大５年まで延長"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "u-ews-benefits",
      "blocks": [
        {
          "type": "benefit_item",
          "settings": {
            "title": "最大５年まで延長"
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "title": "修理・交換サービス"
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "title": "安心なサポート"
          }
        }
      ]
    }
  ]
}
{% endschema %}