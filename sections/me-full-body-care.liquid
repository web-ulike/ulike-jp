{% assign sid = section.id %}<section id="me-full-body-{{ sid }}" class="me-full-body" style="--bg:{{ section.settings.background }}"><div class="me-full-body__copy"><div class="pc">{{ section.settings.title_html }}{{ section.settings.copy_html }}</div><div class="mobile">{{ section.settings.title_html_mobile }}{{ section.settings.copy_html_mobile }}</div></div>{% if section.settings.image != blank or section.settings.image_mobile != blank %}{% assign fallback=section.settings.image | default:section.settings.image_mobile %}<picture class="me-full-body__media">{% if section.settings.image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.image_mobile | image_url: width:1000 }}">{% endif %}{{ fallback | image_url: width:1600 | image_tag: loading: 'lazy', widths: '500, 900, 1200, 1600' }}</picture>{% endif %}</section><style>#me-full-body-{{ sid }}{display:grid;grid-template-columns:40% 60%;align-items:center;min-height:540px;background:var(--bg);overflow:hidden}#me-full-body-{{ sid }} .me-full-body__copy{width:min(390px,80%);margin-left:auto;margin-right:55px;color:#111}#me-full-body-{{ sid }} h2,#me-full-body-{{ sid }} h3{margin:0;font-size:40px;line-height:1.28}#me-full-body-{{ sid }} p{margin:22px 0 0;font-size:12px;line-height:1.8}#me-full-body-{{ sid }} .me-full-body__media img{display:block;width:100%;height:auto}#me-full-body-{{ sid }} .mobile{display:none}@media(max-width:749px){#me-full-body-{{ sid }}{display:flex;min-height:0;flex-direction:column}#me-full-body-{{ sid }} .me-full-body__media{order:1;width:100%}#me-full-body-{{ sid }} .me-full-body__copy{order:2;width:auto;margin:0;padding:25px 16px 36px}#me-full-body-{{ sid }} .pc{display:none}#me-full-body-{{ sid }} .mobile{display:block}#me-full-body-{{ sid }} h2,#me-full-body-{{ sid }} h3{font-size:23px}#me-full-body-{{ sid }} p{margin-top:13px;font-size:12px;line-height:1.7}}
  #me-full-body-{{ sid }} .pc > :first-child{margin:0;font-size:40px;font-weight:600;line-height:1.4;letter-spacing:-.035em}#me-full-body-{{ sid }} .pc > :not(:first-child){margin:22px 0 0;font-size:14px;line-height:1.65}@media(max-width:749px){#me-full-body-{{ sid }} .mobile > :first-child{margin:0;font-size:26px;font-weight:600;line-height:1.4}#me-full-body-{{ sid }} .mobile > :not(:first-child){margin:14px 0 0;font-size:12px;line-height:1.7}}
</style>
{% schema %}{"name":"Ulike ME 全身护理模块","settings":[{"type":"image_picker","id":"image","label":"PC 右侧图片"},{"type":"image_picker","id":"image_mobile","label":"移动端顶部图片"},{"type":"html","id":"title_html","label":"PC 标题（HTML）"},{"type":"html","id":"copy_html","label":"PC 描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"copy_html_mobile","label":"移动端描述（HTML）"},{"type":"color","id":"background","label":"背景","default":"#ffffff"}],"presets":[{"name":"Ulike ME 全身护理模块"}]}{% endschema %}
