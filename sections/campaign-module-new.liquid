<style>
           #shopify-section-{{ section.id }} {
      --text-color: {{  section.settings.text_color }};
      --section-background: {{ section.settings.background }};
      background:var(--section-background);
    }
        .media-{{ section.id }}-padding {
        padding-top: calc({{ section.settings.padding_top }}px);
        padding-bottom: calc({{ section.settings.padding_bottom }}px);
      }
    @media screen and (max-width: 768px){
      .media-{{ section.id }}-padding {
        padding-top: calc({{ section.settings.mobile_padding_top }}px);
        padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px);
      }
    }
  .campaign-module {
    display: flex;
    align-items: center;
  }
  .header-text{
      max-width: 851px;
      margin: 0 auto;
      text-align: center;
      color: #000;
      text-align: center;
      font-size: 32px;
      font-style: normal;
      font-weight: 400;
      line-height: 150%;
  }
  .header-text strong{
    color: #E0004D;
    font-weight: 500;
  }
  .header-text .sns-campaign-title {
    font-size: 45px;
    font-weight: 500;
    color: #000;
    line-height: 130%;
  }
  .header-text .sns-campaign-desc {
    font-size: 20px;
    color: #000;
  }
  .header-text-box--mobile {
    display: none;
  }


  .qr-section{
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 100px;
  }
  .qr-section .qr-box{
      max-width: 260px;
  }
  .features-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 48px;
  }
  .features-list li {
      display: flex;
      align-items: center;
      gap: 38px;
  color: #000;
  font-size: 20px;
  font-style: normal;
  font-weight: 400;
  line-height: 2;
  }
  .social-section{
  display: flex;
      justify-content: center;
      gap: 45px;
      align-items: center;
      margin:60px 0 100px;
  }
   @media (max-width: 768px) {
  .header-text-box--desktop {
      display: none;
  }
  .header-text-box--mobile {
      display: block;
  }
  .header-text {
      max-width: 307px;
     font-size: 16px;
      {% comment %} margin-bottom: 30px; {% endcomment %}
  }
  .header-text .sns-campaign-title {
      font-size: 24px;
  }
  .header-text .sns-campaign-desc {
    font-size: 14px;
    margin-top: 10px;
  }
  .qr-section {
      gap: 30px;
  }
  .qr-section .qr-box {
      max-width: 133px;
  }
  .features-list {
      gap: 22px;
  }
  .features-list li {
      gap: 16px;
      font-size: 10px;
      line-height: 1.3;
  }
  .features-list li img{
  max-width:23px;
  }
  .social-section{
  gap:20px;
      margin:30px 0 50px;
  }
  .social-section img{
  max-width:31px;
  }
  }
</style>
<div class="campaign-module media-{{ section.id }}-padding">
  <div class="jp-container">
    <div class="header-text to-top">
      <div class="header-text-box header-text-box--desktop">
        {{ section.settings.txt }}
      </div>
      <div class="header-text-box header-text-box--mobile">
        {{ section.settings.mobile_txt | default: section.settings.txt }}
      </div>
    </div>

    <div class="social-section to-top" style="transition-delay: 0.6s;">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'media' -%}
            <a href="{{ block.settings.link }}" class="social_link">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url }}" alt="">
              {% endif %}
            </a>
        {% endcase %}
      {%- endfor -%}
    </div>

    <div class="qr-section to-top" style="transition-delay: 0.2s;">
      <div class="qr-box">
        {% if section.settings.qr_image %}
          <img src="{{ section.settings.qr_image  | image_url }}" alt="{{ block.settings.qr_image.alt }}">
        {% endif %}
      </div>
      <ul class="features-list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'item' -%}
              <li>
                {% if block.settings.image %}
                  <img src="{{ block.settings.image  | image_url }}" alt="{{ block.settings.image.alt }}">
                {% endif %}
                <div class="features-list__txt">{{ block.settings.text }}</div>
              </li>
          {% endcase %}
        {%- endfor -%}
      </ul>
    </div>

    <picture class="gallery-section to-top" style="transition-delay: 0.4s;">
      {% if section.settings.mobile_image %}
        <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url }}">
      {% endif %}
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url }}" alt="">
      {% endif %}
    </picture>
  </div>
</div>
{% schema %}
{
  "name": "campaign-module-new",
  "settings": [
    {
      "type": "html",
      "id": "txt",
      "label": "Text"
    },
    {
      "type": "html",
      "id": "mobile_txt",
      "label": "Mobile Text"
    },
    {
      "type": "image_picker",
      "id": "qr_image",
      "label": "Qr Image",
      "info": "Format: 1x SVG image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "media",
      "name": "media",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "campaign-module-new"
    }
  ]
}
{% endschema %}
