{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section class="jp-amb-intro jp-amb-intro--{{ sid }}">
  <div class="container">
    <div class="jp-amb-intro__inner">
      {%- if st.title != blank -%}
        <h2 class="jp-amb-intro__title">{{ st.title }}</h2>
      {%- endif -%}

      {%- if st.text_left != blank or st.text_right != blank or st.text != blank -%}
        <div class="jp-amb-intro__text">
          <div class="jp-amb-intro__text-col jp-amb-intro__text-col--left">
            {%- if st.text_left != blank -%}
              {{ st.text_left }}
            {%- else -%}
              {{ st.text }}
            {%- endif -%}
          </div>

          {%- if st.text_right != blank -%}
            <div class="jp-amb-intro__text-col jp-amb-intro__text-col--right">
              {{ st.text_right }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .jp-amb-intro--{{ sid }} {
    background: #fff;
    padding: 120px 0 120px;
    color: #000;
  }

  .jp-amb-intro--{{ sid }} .jp-amb-intro__inner {
    max-width: 1036px;
    margin: 0 auto;
  }

  .jp-amb-intro--{{ sid }} .jp-amb-intro__title {
    margin: 0 0 20px;
    font-size: 12px;
    line-height: 2;
    letter-spacing: 1.6px;
    font-weight: 400;
    text-align: left;
  }

  .jp-amb-intro--{{ sid }} .jp-amb-intro__text {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 118px;
    font-size: 18px;
    line-height: 2;
    color: #666767;
    letter-spacing: 1.6px;
    text-align: left;
  }

  .jp-amb-intro--{{ sid }} .jp-amb-intro__text p {
    margin: 0 0 24px;
  }

  .jp-amb-intro--{{ sid }} .jp-amb-intro__text p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .jp-amb-intro--{{ sid }} {
      padding: 60px 0 60px;
    }

    .jp-amb-intro--{{ sid }} .jp-amb-intro__inner {
      max-width: 80%;
      text-align: center;
    }

    .jp-amb-intro--{{ sid }} .jp-amb-intro__title {
      margin-bottom: 22px;
      font-size: 16px;
      line-height: 1.65;
      letter-spacing: .08em;
      text-align: center;
    }

    .jp-amb-intro--{{ sid }} .jp-amb-intro__text {
      display: block;
      font-size: 12px;
      line-height: 1.3;
      letter-spacing: 2.4px;
      text-align: center;
    }

    .jp-amb-intro--{{ sid }} .jp-amb-intro__text p {
      margin: 0 0 20px;
    }
  }
</style>

{% schema %}
{
  "name": "JP Amb Intro",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "html",
      "id": "text_left",
      "label": "Text Left",
      "default": "<p>新アンバサダー・桐谷美玲<br>その美しさは、凛として、しなやか。</p><p>新CM「We like Ulike」が描き出すのは、<br>美しさを分かち合う、新しいライフスタイル。</p><p>「あなたも、あなたの大切な人も、<br>綺麗でいたい気持ちは一緒だ。」</p>"
    },
    {
      "type": "html",
      "id": "text_right",
      "label": "Text Right",
      "default": "<p>パワフルな手応えと、肌にやさしい使い心地。<br>自宅で叶える、サロンクオリティ。</p><p>自分のために、<br>大切な誰かのために。<br>その肌に、確かな満足を。</p><p>We like Ulike。</p>"
    },
    {
      "type": "html",
      "id": "text",
      "label": "Text HTML Backup"
    }
  ],
  "presets": [
    {
      "name": "JP Amb Intro"
    }
  ]
}
{% endschema %}
