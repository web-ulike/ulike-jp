{% assign sid = section.id %}
<section id="me-precision-care-{{ sid }}" class="me-precision-care" style="--bg:{{ section.settings.background }}"><div class="me-precision-care__top"><div class="pc">{{ section.settings.title_html }}{{ section.settings.copy_html }}</div><div class="mobile">{{ section.settings.title_html_mobile }}{{ section.settings.copy_html_mobile }}</div></div>{% if section.settings.image != blank %}<div class="me-precision-care__pc-image">{{ section.settings.image | image_url: width:1600 | image_tag: loading: 'lazy', widths: '750, 1200, 1600' }}</div>{% endif %}{% if section.settings.image_mobile != blank %}<div class="me-precision-care__mobile-image">{{ section.settings.image_mobile | image_url: width:1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000' }}</div>{% endif %}<div class="me-precision-care__bottom">{{ section.settings.bottom_html }}</div></section>
<style>#me-precision-care-{{ sid }}{position:relative;min-height:720px;overflow:hidden;background:var(--bg);color:#111}#me-precision-care-{{ sid }} .me-precision-care__top{position:relative;z-index:1;width:min(630px,43vw);padding-top:115px;margin:auto;text-align:center}#me-precision-care-{{ sid }} h2,#me-precision-care-{{ sid }} h3{margin:0;font-size:40px;line-height:1.3}#me-precision-care-{{ sid }} p{margin:20px 0 0;font-size:12px;line-height:1.8}#me-precision-care-{{ sid }} .me-precision-care__pc-image{position:absolute;bottom:0;left:0;width:50%;height:62%}#me-precision-care-{{ sid }} .me-precision-care__pc-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:left bottom}#me-precision-care-{{ sid }} .me-precision-care__bottom{position:relative;z-index:1;width:min(440px,32vw);margin:160px 12% 0 auto;font-size:12px;line-height:1.8}#me-precision-care-{{ sid }} .mobile,#me-precision-care-{{ sid }} .me-precision-care__mobile-image{display:none}@media(max-width:749px){#me-precision-care-{{ sid }}{min-height:0}#me-precision-care-{{ sid }} .pc,#me-precision-care-{{ sid }} .me-precision-care__pc-image{display:none}#me-precision-care-{{ sid }} .me-precision-care__top{width:auto;padding:42px 16px 22px;margin:0;text-align:center}#me-precision-care-{{ sid }} .mobile{display:block}#me-precision-care-{{ sid }} h2,#me-precision-care-{{ sid }} h3{font-size:23px}#me-precision-care-{{ sid }} p{margin-top:14px;font-size:12px;line-height:1.7}#me-precision-care-{{ sid }} .me-precision-care__mobile-image{display:block}#me-precision-care-{{ sid }} .me-precision-care__mobile-image img{display:block;width:100%;height:auto}#me-precision-care-{{ sid }} .me-precision-care__bottom{width:auto;margin:0;padding:26px 16px 40px;font-size:12px;line-height:1.7}}
  #me-precision-care-{{ sid }} .pc > :first-child{margin:0;font-size:40px;font-weight:600;line-height:1.4;letter-spacing:-.035em}#me-precision-care-{{ sid }} .pc > :not(:first-child){margin:20px 0 0;font-size:14px;line-height:1.65}#me-precision-care-{{ sid }} .me-precision-care__bottom,#me-precision-care-{{ sid }} .me-precision-care__bottom p{font-size:12px;line-height:1.7}@media(max-width:749px){#me-precision-care-{{ sid }} .mobile > :first-child{margin:0;font-size:26px;font-weight:600;line-height:1.4}#me-precision-care-{{ sid }} .mobile > :not(:first-child){margin:14px 0 0;font-size:12px;line-height:1.7}}
</style>
{% schema %}{"name":"Ulike ME 精准护理模块","settings":[{"type":"image_picker","id":"image","label":"PC 左侧图片"},{"type":"image_picker","id":"image_mobile","label":"移动端产品图片"},{"type":"html","id":"title_html","label":"PC 标题（HTML）"},{"type":"html","id":"copy_html","label":"PC 描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"copy_html_mobile","label":"移动端描述（HTML）"},{"type":"html","id":"bottom_html","label":"模式说明（HTML）"},{"type":"color","id":"background","label":"背景","default":"#ffffff"}],"presets":[{"name":"Ulike ME 精准护理模块"}]}{% endschema %}
