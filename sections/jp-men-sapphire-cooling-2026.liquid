{%- liquid
  assign section_id = 'jp-men-sapphire-cooling-2026-' | append: section.id
  assign default_title = 'サファイア冷感技術で痛みレス*'
  assign default_body = '日本国内でも特許取得済みのサファイア冷感技術*¹により、痛みレス*なケアを実現。\n照射面と冷却面を一体化させたデザインだから、照射ヘッドを当てるだけてお肌をひんやり冷却しながらそのまま照射可能。'
  assign default_note = '*痛みの感じ方には個人差と部位差があります。'
-%}

<section id="{{ section_id }}" class="jp-men-sapphire-cooling-2026">
  <div class="jp-men-sapphire-cooling-2026__inner jp-container">
  <div class="jp-men-sapphire-cooling-2026__media">
    <picture>
      {%- if section.settings.image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1800 }}">
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'jp-men-sapphire-cooling-2026__image', loading: 'lazy', widths: '750, 1000, 1360, 1600', alt: section.settings.image.alt | default: section.settings.title }}
      {%- elsif section.settings.image_mobile != blank -%}
        {{ section.settings.image_mobile | image_url: width: 1800 | image_tag: class: 'jp-men-sapphire-cooling-2026__image', loading: 'lazy', widths: '750, 1100, 1500, 1800', alt: section.settings.image_mobile.alt | default: section.settings.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'jp-men-sapphire-cooling-2026__placeholder' }}
      {%- endif -%}
    </picture>
    <p class="jp-men-sapphire-cooling-2026__note jp-men-sapphire-cooling-2026__note--mobile">{{ section.settings.note | default: default_note | escape }}</p>
  </div>

  <div class="jp-men-sapphire-cooling-2026__copy">
    <h2 class="jp-men-sapphire-cooling-2026__title to-top">{{ section.settings.title | default: default_title }}</h2>
    <div class="jp-men-sapphire-cooling-2026__body to-top" style="transition-delay: .1s">{{ section.settings.body | default: default_body | escape | newline_to_br }}</div>
    <p class="jp-men-sapphire-cooling-2026__note jp-men-sapphire-cooling-2026__note--desktop">{{ section.settings.note | default: default_note | escape }}</p>
  </div>
  </div>
</section>

<style>
  #{{ section_id }} { background: {{ section.settings.background | default: '#f7f8fa' }}; color: {{ section.settings.text_color | default: '#000000' }}; margin-top: {{ section.settings.margin_top | default: 0 }}px; margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px; overflow: hidden; }

  #{{ section_id }} .jp-men-sapphire-cooling-2026__inner { 
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0 auto; padding: 0; }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__media { background: none; grid-column: 1; grid-row: 1; position: relative; }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__media picture { display: block; }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__image, #{{ section_id }} .jp-men-sapphire-cooling-2026__placeholder { display: block; height: auto; width: 100%; }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__placeholder {  fill: #d0d3d7; }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__copy { align-self: stretch; grid-column: 2; grid-row: 1; padding: 14.63% 16.47% 10% 10.07%; }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__title {
     color: inherit; font-family: inherit; font-size: 45px; font-weight: 500; line-height: 1.2; margin: 0; 
  }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__body { 
    color: inherit;
    font-size: 23px; font-weight: 400; line-height: 1.4; margin-top: 8.05%;
  }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__note { font-family: inherit; font-size: 10px;
     font-weight: 400; line-height: 1.3; margin: 0; }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__note--desktop { color: {{ section.settings.note_color | default: '#000000' }}; margin-top: 3.5%; opacity: .5; white-space: nowrap; }
  #{{ section_id }} .jp-men-sapphire-cooling-2026__note--mobile { display: none; }

  @media screen and (max-width: 749px) {
    #{{ section_id }} { margin-top: {{ section.settings.mobile_margin_top | default: 0 }}px; margin-bottom: {{ section.settings.mobile_margin_bottom | default: 0 }}px; }
    #{{ section_id }} .jp-men-sapphire-cooling-2026__inner { display: flex; flex-direction: column; }
    #{{ section_id }} .jp-men-sapphire-cooling-2026__copy { order: 1; padding: 9.815% 5.831% 8.78%; width: 100%; }
    #{{ section_id }} .jp-men-sapphire-cooling-2026__title { font-size: 5.773672vw; line-height: 1.2; white-space: nowrap; }
    #{{ section_id }} .jp-men-sapphire-cooling-2026__body { font-size: 3.579677vw; line-height: 1.4; margin-top: 3.64%; text-align: justify; }
    #{{ section_id }} .jp-men-sapphire-cooling-2026__media { order: 2; width: 100%; }
    #{{ section_id }} .jp-men-sapphire-cooling-2026__placeholder { aspect-ratio: 1732 / 1434; }
    #{{ section_id }} .jp-men-sapphire-cooling-2026__note--desktop { display: none; }
    #{{ section_id }} .jp-men-sapphire-cooling-2026__note--mobile { bottom: 2.67%; color: {{ section.settings.mobile_note_color | default: '#ffffff' }}; display: block; font-size: 1.540473vw; left: 5.543%; opacity: .5; position: absolute; white-space: nowrap; }
  }
</style>

{% schema %}
{
  "name": "Men Sapphire Cooling",
  "settings": [
    { "type": "header", "content": "外边距" },
    { "type": "range", "id": "margin_top", "label": "PC 上边距", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "PC 下边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_top", "label": "M 上边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_bottom", "label": "M 下边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "image_picker", "id": "image", "label": "PC 冷感图片（建议 1360 × 1153）" },
    { "type": "image_picker", "id": "image_mobile", "label": "M 冷感图片（建议 1732 × 1434）" },
    { "type": "text", "id": "temperature", "label": "温度文字", "default": "16℃" },
    { "type": "text", "id": "title", "label": "标题", "default": "サファイア冷感技術で痛みレス*" },
    { "type": "textarea", "id": "body", "label": "说明文案", "default": "日本国内でも特許取得済みのサファイア冷感技術*¹により、痛みレス*なケアを実現。\n照射面と冷却面を一体化させたデザインだから、照射ヘッドを当てるだけてお肌をひんやり冷却しながらそのまま照射可能。" },
    { "type": "textarea", "id": "note", "label": "脚注", "default": "*痛みの感じ方には個人差と部位差があります。" },
    { "type": "color", "id": "background", "label": "文案区背景色", "default": "#F7F8FA" },
    { "type": "color", "id": "media_background", "label": "图片区背景色", "default": "#E7E9EB" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#000000" },
    { "type": "color", "id": "temperature_color", "label": "温度文字颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "note_color", "label": "PC 脚注颜色", "default": "#000000" },
    { "type": "color", "id": "mobile_note_color", "label": "M 脚注颜色", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "jp-men-sapphire-cooling-2026" }]
}
{% endschema %}
