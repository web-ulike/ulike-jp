{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .section {
    /* The selected Focal color scheme supplies a black foreground. The
       reference footer is intentionally a fixed dark panel with white type. */
    --color-foreground: 255 255 255;
    --color-button-text: 255 255 255;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  /* Focal's base .footer styles otherwise reset this container to a white
     surface. Keep the visual tokens on the actual footer element. */
  #shopify-section-{{ section.id }} .section .footer {
    display: grid;
    width: 100%;
    max-width: none;
    padding-inline: clamp(40px, 4.6875vw, 96px);
    background: rgb(var(--color-background)) !important;
    color: rgb(var(--color-foreground)) !important;
  }

  #shopify-section-{{ section.id }} .footer :is(a, p, li, summary, .rte, .details__summary) {
    color: inherit !important;
  }

  #shopify-section-{{ section.id }} .footer input {
    color: rgb(var(--color-foreground)) !important;
  }

  #shopify-section-{{ section.id }} .footer__left,
  #shopify-section-{{ section.id }} .footer__accordions {
    display: flex;
  }

  #shopify-section-{{ section.id }} .footer__left {
    flex-direction: column;
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .footer__accordions {
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .footer__accordions .details {
    padding-inline: 20px;
    border: solid rgb(var(--color-foreground) / 0.15);
    border-width: 1px 1px 0;
  }

  #shopify-section-{{ section.id }} .footer__accordions .details:last-of-type {
    border-bottom-width: 1px;
  }

  #shopify-section-{{ section.id }} .footer__accordions .details__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 20px;
  }

  #shopify-section-{{ section.id }} .footer__accordions .details__content { padding: 0 0 20px; }
  #shopify-section-{{ section.id }} .footer__accordions .details__content ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .footer__right {
    display: grid;
    gap: 32px;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid rgb(var(--color-foreground) / 0.15);
  }

  #shopify-section-{{ section.id }} .footer__newsletter .h3 { margin: 0; font-size: 28px; }
  #shopify-section-{{ section.id }} .newsletter-form { max-width: 546px; }
  #shopify-section-{{ section.id }} .newsletter-form .input {
    min-height: 98px;
    padding: 24px 104px 24px 40px;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-foreground) / 0.04);
    border: 0;
    border-radius: 20px;
  }
  #shopify-section-{{ section.id }} .newsletter-form .self-button {
    width: 64px;
    height: 64px;
    border: 0;
    border-radius: 50%;
    background: #e0004d;
  }
  #shopify-section-{{ section.id }} .newsletter-form .self-button svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
  }
  #shopify-section-{{ section.id }} .footer__socials,
  #shopify-section-{{ section.id }} .footer__socials ul {
    display: flex;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .footer__socials ul {
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .footer__socials li,
  #shopify-section-{{ section.id }} .footer__socials .social_platform {
    display: block;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
  }
  #shopify-section-{{ section.id }} .footer__socials svg {
    display: block;
    width: 34px;
    height: 34px;
    max-width: none;
    max-height: none;
  }
  #shopify-section-{{ section.id }} .footer__socials .sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer__left { flex-direction: row; gap: clamp(64px, 8.421vw, 160px); }
    #shopify-section-{{ section.id }} .footer__accordions { flex: 1; flex-direction: row; flex-wrap: wrap; gap: 32px; }
    #shopify-section-{{ section.id }} .footer__accordions .details,
    #shopify-section-{{ section.id }} .footer__accordions .no-details { flex: 1 1 calc(25% - 24px); padding: 0; border: 0; }
    #shopify-section-{{ section.id }} .footer__accordions .details__content { padding: 0; }
  }

  @media screen and (min-width: 1280px) {
    #shopify-section-{{ section.id }} .footer { grid-template-columns: minmax(0, 1.78fr) minmax(546px, 1fr); min-height: 518px; }
    #shopify-section-{{ section.id }} .footer__left { padding-right: clamp(40px, 4.1vw, 80px); border-right: 1px solid rgb(var(--color-foreground) / 0.15); }
    #shopify-section-{{ section.id }} .footer__right { align-content: space-between; margin-top: 0; padding: 0 0 0 clamp(40px, 3.125vw, 64px); border-top: 0; }
    #shopify-section-{{ section.id }} .footer__accordions .details,
    #shopify-section-{{ section.id }} .footer__accordions .no-details { flex: 0 0 auto; }
    #shopify-section-{{ section.id }} .footer__accordions .details__summary { padding: 0 0 36px; pointer-events: none; }
    #shopify-section-{{ section.id }} .footer__accordions .details__summary svg { display: none; }
    #shopify-section-{{ section.id }} .footer__accordions .details:not([open]) > .details__content { display: block; }
    #shopify-section-{{ section.id }} .footer__accordions .details__summary span { font-size: 18px; font-weight: 600; }
    #shopify-section-{{ section.id }} .footer__accordions a,
    #shopify-section-{{ section.id }} .footer__accordions .rte { font-size: 16px; line-height: 1.45; }
  }
{%- endstyle -%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded{% endif %}"{% if section.settings.enable_parallax %} is="footer-parallax"{% endif %}>
  <footer class="footer container relative grid">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__left flex flex-col md:flex-row gap-10">
        {%- liquid
          assign block = section.blocks | where: "type", "logo_social" | first
          if block
            render 'footer-logo', block: block
          endif
        -%}

        <div class="footer__accordions flex flex-wrap flex-col md:flex-row md:grow md:gap-12">
          {%- liquid
            for block in section.blocks
              case block.type
                when 'link_list'
                  render 'footer-menu', block: block

                when 'text'
                  render 'footer-text', block: block

                when 'brand_information'
                  render 'footer-contact', block: block
              endcase
            endfor
          -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.enable_newsletter or section.settings.show_social or shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
      <div class="footer__right grid gap-10">
        {%- if section.settings.enable_newsletter -%}
          <div class="footer__newsletter grid gap-6">
            <p class="h3 text-xl leading-none tracking-none font-medium lg:font-bold">{{ section.settings.newsletter_heading | escape }}</p>
            {%- render 'newsletter-form', section_id: section.id, context: 'footer' -%}

            {%- if section.settings.newsletter_text != blank -%}
              <div class="rte private-text">{{ section.settings.newsletter_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="footer__socials flex justify-start md:justify-end xl:justify-start">
            {%- render 'social-icons', size: 'lg', gap: '7' -%}
          </div>
        {%- endif -%}

        {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
          <div class="follow-on-shop">
            {{- shop | login_button: action: 'follow' -}}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </footer>

  {%- if section.settings.enable_parallax -%}
    <parallax-overlay class="footer-overlay hidden md:block z-20 absolute left-0 top-0 w-full pointer-events-none" data-target="height" data-start="100%" data-stop="0%"></parallax-overlay>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.footer.name",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__newsletter.content",
      "info": "t:sections.footer.settings.header__newsletter.info"
    },
    {
      "type": "checkbox",
      "id": "enable_newsletter",
      "default": true,
      "label": "t:sections.footer.settings.enable_newsletter.label"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Subscribe to our emails",
      "label": "t:sections.global.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "t:sections.global.settings.text.label",
      "info": "t:sections.global.settings.optional.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__social.content",
      "info": "t:sections.footer.settings.header__social.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__follow.content",
      "info": "t:sections.footer.settings.header__follow.info"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label",
      "default": "#1f1f1f"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "t:sections.global.settings.color_button_text.label",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_button_background",
      "label": "t:sections.global.settings.color_button_background.label",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "color_button_gradient",
      "label": "t:sections.global.settings.color_button_gradient.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.global.settings.full_width.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "default": true,
      "label": "t:sections.global.settings.enable_parallax.label"
    }
  ],
  "blocks": [
    {
      "type": "logo_social",
      "name": "t:sections.footer.blocks.logo_social.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.footer.blocks.logo_social.settings.logo.label"
        },
        {
          "type": "range",
          "id": "logo_height",
          "label": "t:sections.footer.blocks.logo_social.settings.logo_height.label",
          "default": 50,
          "min": 20,
          "max": 120,
          "unit": "px"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": false,
          "label": "t:sections.footer.settings.show_social.label"
        },
        {
          "type": "checkbox",
          "id": "enable_follow_on_shop",
          "default": false,
          "label": "t:sections.footer.settings.enable_follow_on_shop.label"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.global.settings.heading.label",
          "info": "t:sections.global.settings.optional.label",
          "default": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        },
        {
          "type": "range",
          "id": "container_width",
          "label": "t:sections.footer.blocks.link_list.settings.container_width.label",
          "default": 50,
          "min": 15,
          "max": 95,
          "unit": "%"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.global.settings.heading.label",
          "info": "t:sections.global.settings.optional.label",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.global.settings.text.label",
          "default": "<p>Share contact information, store details, and brand content with your customers.</p>"
        },
        {
          "type": "range",
          "id": "container_width",
          "label": "t:sections.footer.blocks.text.settings.container_width.label",
          "default": 50,
          "min": 15,
          "max": 95,
          "unit": "%"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.global.settings.heading.label",
          "info": "t:sections.global.settings.optional.label",
          "default": "Heading"
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "t:sections.footer.blocks.brand_information.settings.button_label_1.label"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "t:sections.footer.blocks.brand_information.settings.button_link_1.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.footer.blocks.brand_information.settings.button_label_2.label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.footer.blocks.brand_information.settings.button_link_2.label"
        },
        {
          "type": "text",
          "id": "button_label_3",
          "label": "t:sections.footer.blocks.brand_information.settings.button_label_3.label"
        },
        {
          "type": "url",
          "id": "button_link_3",
          "label": "t:sections.footer.blocks.brand_information.settings.button_link_3.label"
        },
        {
          "type": "text",
          "id": "button_label_4",
          "label": "t:sections.footer.blocks.brand_information.settings.button_label_4.label"
        },
        {
          "type": "url",
          "id": "button_link_4",
          "label": "t:sections.footer.blocks.brand_information.settings.button_link_4.label"
        },
        {
          "type": "range",
          "id": "container_width",
          "label": "t:sections.footer.blocks.brand_information.settings.container_width.label",
          "default": 50,
          "min": 15,
          "max": 95,
          "unit": "%"
        }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      {
        "type": "logo_social",
        "settings": {}
      },
      {
        "type": "link_list",
        "settings": {}
      }
    ]
  },
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
