{% comment %}
  Air 10 Max 2026: full-body-care. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-full-body-care-2026-{{ section.id }}" class="a10-2026 a10-2026__bodycare">
<div class="container a10-2026__container">
<div class="a10-2026__inner a10-2026__bodycare-grid">
<div class="a10-2026__bodycare-copy">{% if section.settings.title != blank %}
<h2 class="a10-2026__title to-top" style="transition-delay: 0.1s;">{{ section.settings.title | escape | replace: 'まで、1台', 'まで、<br class="a10-2026__bodycare-break">1台' | newline_to_br }}</h2>
{% endif %}{% if section.settings.description != blank %}
<div class="a10-2026__body to-top" style="transition-delay: 0.2s;">{{ section.settings.description | escape | newline_to_br }}</div>
{% endif %}{% if section.settings.note != blank %}
<div class="a10-2026__note to-top" style="transition-delay: 0.3s;">{{ section.settings.note | escape | newline_to_br }}</div>
{% endif %}</div>

<div class="a10-2026__bodycare-visual">
<div class="a10-2026__bodycare-art">
<div class="a10-2026__bodycare-photo">{%- assign a10_image = section.settings.chart | default: section.settings.chart_mobile -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{% if section.settings.chart_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.chart_mobile | image_url: width: 375 }} 375w, {{ section.settings.chart_mobile | image_url: width: 750 }} 750w, {{ section.settings.chart_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}</div>


</div>
</div>
</div>
</div>
</section>

<style>
#a10-max-full-body-care-2026-{{ section.id }} { color: #190a0a;  overflow: hidden; }
#a10-max-full-body-care-2026-{{ section.id }} *, #a10-max-full-body-care-2026-{{ section.id }} *::before, #a10-max-full-body-care-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-full-body-care-2026-{{ section.id }} h2, #a10-max-full-body-care-2026-{{ section.id }} h3, #a10-max-full-body-care-2026-{{ section.id }} p { margin: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-full-body-care-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-full-body-care-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-full-body-care-2026-{{ section.id }}.a10-2026__bodycare { background: #fff; padding: 0 0 50px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-grid { display: grid; grid-template-columns: 38% 62%; align-items: center; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy { padding-right: 45px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__body { margin-top: 32px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__note { margin-top: 120px; }
@media (min-width:750px) and (max-width:1400px) {
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__title { font-size: 32px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__subtitle { font-size: 26px; }
}
@media (max-width:749px) {
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__desktop { display: none !important; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__mobile { display: block; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__title { font-size: 24px; line-height: 1.3; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__subtitle { font-size: 24px; line-height: 1.5; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__body { font-size: 14px; line-height: 1.5; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__note { font-size: 10px; line-height: 1.5; }
#a10-max-full-body-care-2026-{{ section.id }}.a10-2026__bodycare { padding: 46px 0 20px; background: #f7f8fa; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-grid { display: flex; flex-direction: column; width: 100%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy { display: contents; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__title { margin: 0; order: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__body { margin: 30px 0 40px; order: 1; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-visual { order: 2; width: 100%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__note { order: 3; margin: 30px 0 0; }
}
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-art { width: 100%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-photo { width: 100%; }

/* Desktop copy coordinates follow Figma node 8104:1967 (1920px frame). */
@media (min-width:750px) {
#a10-max-full-body-care-2026-{{ section.id }} { --a10-bodycare-unit: min(1px, calc((100vw - 80px) / 1225.92)); }
#a10-max-full-body-care-2026-{{ section.id }} > .a10-2026__container { width: 100%; max-width: 1305.92px; padding-inline: 40px; margin-inline: auto; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-grid { grid-template-columns: calc(479.69 * var(--a10-bodycare-unit)) minmax(0,1fr); align-items: start; min-height: calc(697.116 * var(--a10-bodycare-unit)); }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy { display: flex; flex-direction: column; width: calc(412.5 * var(--a10-bodycare-unit)); min-height: calc(686.225 * var(--a10-bodycare-unit)); padding: calc(187.516 * var(--a10-bodycare-unit)) 0 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__title { font-size: calc(40 * var(--a10-bodycare-unit)); line-height: 1.3; font-weight: 400; color: #000; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__body { width: calc(403.664 * var(--a10-bodycare-unit)); margin: calc(29.216 * var(--a10-bodycare-unit)) 0 0 calc(1.418 * var(--a10-bodycare-unit)); font-size: max(12px, calc(16 * var(--a10-bodycare-unit))); line-height: 1.5; color: rgba(0,0,0,.8); }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__note { width: calc(325 * var(--a10-bodycare-unit)); margin: auto 0 0 calc(4.418 * var(--a10-bodycare-unit)); font-size: max(8px, calc(10 * var(--a10-bodycare-unit))); line-height: 1.3; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-visual { width: 100%; max-width: calc(739.5 * var(--a10-bodycare-unit)); }
}
@media (max-width:749px) {
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-break { display: none; }
}

/* Keep short copy inside clipped cards while it enters the viewport. */
@media (prefers-reduced-motion: no-preference) {
#a10-max-full-body-care-2026-{{ section.id }} .to-top:not(.appear) { transform: translateY(20px); }
}

</style>

{% schema %}
{
  "name": "A10 Max 全身护理",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "chart",
      "label": "PC 完整护理示意图"
    },
    {
      "type": "image_picker",
      "id": "chart_mobile",
      "label": "M 完整护理示意图"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "标题",
      "default": "お顔からVIOまで、1台で全身に対応可能"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "说明文案",
      "default": "お顔、ヒゲ、脇、腕、脚、VIOなど、アタッチメント付け替えの手間なしで、全身*トータルケアが1台で完結。"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "脚注文案",
      "default": "注意事項:\n*一部使用できない箇所があります。取扱説明書をご確認ください。\n*毛の太さや刺激の感じ方に応じて、ご自身でモードをご調整ください。"
    }
  ],
  "blocks": [
    {
      "type": "area",
      "name": "护理部位",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "部位图标"
        },
        {
          "type": "text",
          "id": "label",
          "label": "部位名称"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "护理时间"
        },
        {
          "type": "select",
          "id": "position",
          "label": "设计位置",
          "options": [
            {
              "value": "left-top",
              "label": "左上"
            },
            {
              "value": "left-middle",
              "label": "左中"
            },
            {
              "value": "left-bottom",
              "label": "左下"
            },
            {
              "value": "right-top",
              "label": "右上"
            },
            {
              "value": "right-middle",
              "label": "右中"
            },
            {
              "value": "right-bottom",
              "label": "右下"
            }
          ],
          "default": "left-top"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A10 Max 全身护理"
    }
  ]
}
{% endschema %}
