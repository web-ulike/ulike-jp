{% comment %}
  Air 10 Max 2026: full-body-care. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-full-body-care-2026-{{ section.id }}" class="a10-2026 to-top a10-2026__bodycare">
<div class="a10-2026__inner a10-2026__bodycare-grid">
<div class="a10-2026__bodycare-copy">{% if section.settings.title != blank %}
<h2 class="a10-2026__title">{{ section.settings.title | escape | newline_to_br }}</h2>
{% endif %}{% if section.settings.description != blank %}
<div class="a10-2026__body">{{ section.settings.description | escape | newline_to_br }}</div>
{% endif %}{% if section.settings.note != blank %}
<div class="a10-2026__note">{{ section.settings.note | escape | newline_to_br }}</div>
{% endif %}</div>

<div class="a10-2026__bodycare-visual">
<div class="a10-2026__bodycare-art">
<div class="a10-2026__bodycare-photo">{%- assign a10_image = section.settings.chart | default: section.settings.chart_mobile -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{% if section.settings.chart_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.chart_mobile | image_url: width: 375 }} 375w, {{ section.settings.chart_mobile | image_url: width: 750 }} 750w, {{ section.settings.chart_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}</div>

<div class="a10-2026__bodycare-orbit" aria-hidden="true"></div>
{% for block in section.blocks %}
<div class="a10-2026__area a10-2026__area--{{ block.settings.position | escape }}" {{ block.shopify_attributes }}>{%- assign a10_image = block.settings.icon | default: block.settings.icon -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}<span>{{ block.settings.label | escape | newline_to_br }}</span><small>{{ block.settings.duration | escape | newline_to_br }}</small></div>
{% endfor %}
<div class="a10-2026__area-total"><strong>{{ section.settings.total_number | escape | newline_to_br }}</strong><span>{{ section.settings.total_label | escape | newline_to_br }}</span></div>
</div>
</div>
</div>
</section>

<style>
#a10-max-full-body-care-2026-{{ section.id }} { color: #190a0a;  overflow: hidden; }
#a10-max-full-body-care-2026-{{ section.id }} *, #a10-max-full-body-care-2026-{{ section.id }} *::before, #a10-max-full-body-care-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-full-body-care-2026-{{ section.id }} h2, #a10-max-full-body-care-2026-{{ section.id }} h3, #a10-max-full-body-care-2026-{{ section.id }} p { margin: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__inner { width: min(1220px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__wide { width: min(1600px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-full-body-care-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-full-body-care-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-full-body-care-2026-{{ section.id }}.a10-2026__bodycare { background: #fff; padding: 0 0 50px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-grid { display: grid; grid-template-columns: 38% 62%; align-items: center; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy { padding-right: 45px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__body { margin-top: 32px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__note { margin-top: 120px; }
@media (min-width:750px) and (max-width:1400px) {
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__title { font-size: 32px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__subtitle { font-size: 26px; }
}
@media (max-width:749px) {
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__inner, #a10-max-full-body-care-2026-{{ section.id }} .a10-2026__wide { width: calc(100% - 40px); }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__desktop { display: none !important; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__mobile { display: block; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__title { font-size: 24px; line-height: 1.3; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__subtitle { font-size: 24px; line-height: 1.5; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__body { font-size: 14px; line-height: 1.5; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__note { font-size: 10px; line-height: 1.5; }
#a10-max-full-body-care-2026-{{ section.id }}.a10-2026__bodycare { padding: 46px 0 20px; background: #f7f8fa; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-grid { display: flex; flex-direction: column; width: 100%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy { display: contents; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__title { margin: 0 20px; order: 0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__body { margin: 30px 20px 40px; order: 1; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-visual { order: 2; width: 100%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-copy .a10-2026__note { order: 3; margin: 30px 20px 0; }
}
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-art { position:relative; aspect-ratio:740/700; padding:0 12% 20%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-photo { overflow:hidden; border-radius:0 0 50% 50%; position:relative; z-index:1; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-orbit { position:absolute; border:1px dashed #dce7fb; border-radius:50%; width:98%; height:80%; left:1%; top:0; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area { width:80px; position:absolute; z-index:2; text-align:center; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area picture { width:74px; margin:auto auto 8px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area span, #a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area small { display:block; background:#e5eeff; font-size:14px; line-height:1.3; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area--left-top { left:0;top:3%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area--left-middle { left:0;top:35%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area--left-bottom { left:14%;top:68%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area--right-top { right:0;top:3%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area--right-middle { right:0;top:35%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area--right-bottom { right:14%;top:68%; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area-total { position:absolute; left:40%;top:79%;width:20%;background:#e5eeff;border-radius:0 0 50% 50%;text-align:center;padding:16px 4px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area-total strong { display:block;font-size:48px;font-weight:400;line-height:1.1; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area-total span { font-size:18px; }
@media(max-width:749px) {
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__bodycare-art { margin:0 20px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area { width:40px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area picture { width:38px;margin-bottom:3px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area span, #a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area small { font-size:8px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area-total { padding:10px 2px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area-total strong { font-size:24px; }
#a10-max-full-body-care-2026-{{ section.id }} .a10-2026__area-total span { font-size:9px; }
}

</style>

{% schema %}
{
  "name": "A10 Max 全身护理",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "chart",
      "label": "PC 人物照片（不含图标和文案）"
    },
    {
      "type": "image_picker",
      "id": "chart_mobile",
      "label": "M 人物照片（不含图标和文案）"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "标题",
      "default": "お顔からVIOまで、1台で全身に対応可能"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "说明文案",
      "default": "お顔、ヒゲ、脇、腕、脚、VIOなど、アタッチメント付け替えの手間なしで、全身*トータルケアが1台で完結。"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "脚注文案",
      "default": "注意事項:\n*一部使用できない箇所があります。取扱説明書をご確認ください。\n*毛の太さや刺激の感じ方に応じて、ご自身でモードをご調整ください。"
    },
    {
      "type": "text",
      "id": "total_number",
      "label": "全身护理数量",
      "default": "1台"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "全身护理标签",
      "default": "全身対応"
    }
  ],
  "blocks": [
    {
      "type": "area",
      "name": "护理部位",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "部位图标"
        },
        {
          "type": "text",
          "id": "label",
          "label": "部位名称"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "护理时间"
        },
        {
          "type": "select",
          "id": "position",
          "label": "设计位置",
          "options": [
            {
              "value": "left-top",
              "label": "左上"
            },
            {
              "value": "left-middle",
              "label": "左中"
            },
            {
              "value": "left-bottom",
              "label": "左下"
            },
            {
              "value": "right-top",
              "label": "右上"
            },
            {
              "value": "right-middle",
              "label": "右中"
            },
            {
              "value": "right-bottom",
              "label": "右下"
            }
          ],
          "default": "left-top"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A10 Max 全身护理",
      "blocks": [
        {
          "type": "area",
          "settings": {
            "label": "足",
            "duration": "2.5 mins",
            "position": "left-top"
          }
        },
        {
          "type": "area",
          "settings": {
            "label": "腕",
            "duration": "2 mins",
            "position": "left-middle"
          }
        },
        {
          "type": "area",
          "settings": {
            "label": "顔",
            "duration": "1 min",
            "position": "left-bottom"
          }
        },
        {
          "type": "area",
          "settings": {
            "label": "ワキ",
            "duration": "2 mins",
            "position": "right-top"
          }
        },
        {
          "type": "area",
          "settings": {
            "label": "VIO",
            "duration": "1 min",
            "position": "right-middle"
          }
        },
        {
          "type": "area",
          "settings": {
            "label": "胸",
            "duration": "2.5 mins",
            "position": "right-bottom"
          }
        }
      ]
    }
  ]
}
{% endschema %}
