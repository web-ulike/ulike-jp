{% assign sid = section.id %}

<style>
  .p-aps-high {
    padding: var(--p-airpro-s-highlights-padding-top) 0 var(--p-airpro-s-highlights-padding-bottom);
    background: var(--p-airpro-s-highlights-bg);
  }
  .p-airpro-s-highlights__heading {
    margin: 0 0 70px;
    color: #000;
    text-align: center;
    font-size: 48px;
    font-weight: 500;
  }
  .p-airpro-s-highlights__grid {
    width: 1250px;
    max-width: 100%;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 268px 268px 330px;
    grid-auto-rows: 330px;
    gap: 18px;
  }
  .p-airpro-s-highlights__card {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: #eef1f2;
  }
  .p-airpro-s-highlights__card:nth-child(1) {
    grid-column: span 3;
    grid-row: 1 / 3;
    height: 554px;
    align-self: start;
  }
  .p-airpro-s-highlights__card:nth-child(2) {
    grid-column: span 3;
    grid-row: 1;
  }
  .p-airpro-s-highlights__card:nth-child(3) {
    grid-column: span 3;
    grid-row: 2;
  }
  .p-airpro-s-highlights__card:nth-child(n + 4) {
    grid-column: span 2;
    grid-row: 3;
  }
  .p-airpro-s-highlights__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .p-airpro-s-highlights__copy {
    position: relative;
    z-index: 1;
    display: inline-block;
    box-sizing: border-box;
    max-width: 78%;
    padding: 40px;
    color: #000;
    text-shadow: none;
  }
  .p-airpro-s-highlights__title {
    margin: 0;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -.04em;
  }
  .p-airpro-s-highlights__text {
    margin: 10px 0 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -.03em;
  }
  .p-airpro-s-highlights__card:nth-child(1) .p-airpro-s-highlights__copy { padding: 52px 40px; }
  .p-airpro-s-highlights__card:nth-child(2) .p-airpro-s-highlights__copy,
  .p-airpro-s-highlights__card:nth-child(3) .p-airpro-s-highlights__copy { padding: 40px 44px; }
  .p-airpro-s-highlights__card:nth-child(4) .p-airpro-s-highlights__copy { max-width: calc(100% - 150px); padding: 44px 0 0 150px; }
  .p-airpro-s-highlights__card:nth-child(5) .p-airpro-s-highlights__copy { padding: 44px 0 0 78px; }
  .p-airpro-s-highlights__card:nth-child(6) .p-airpro-s-highlights__copy { padding: 44px 0 0 42px; }
  @media screen and (max-width: 749px) {
    .p-aps-high {
      padding: 42px 0 24px;
    }
    .p-aps-high > .container {
      padding-right: 10px;
      padding-left: 10px;
    }
    .p-airpro-s-highlights__heading {
      margin: 0 0 23px;
      padding: 0 23px;
      text-align: center;
      font-size: 20px;
      font-weight: 600;
      line-height: 1.4;
    }
    .p-airpro-s-highlights__grid {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto clamp(130px, 45vw, 180px) clamp(160px, 56vw, 225px) clamp(130px, 45vw, 180px);
      grid-auto-rows: auto;
      gap: 5px;
    }
    .p-airpro-s-highlights__card:nth-child(1) {
      grid-column: 1 / 3;
      grid-row: 1;
      height: auto;
    }
    .p-airpro-s-highlights__card:nth-child(1) picture { display: block; }
    .p-airpro-s-highlights__card:nth-child(1) .p-airpro-s-highlights__image {
      position: relative;
      width: 100%;
      height: auto;
      object-fit: initial;
    }
    .p-airpro-s-highlights__card:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
    }
    .p-airpro-s-highlights__card:nth-child(3) {
      grid-column: 2;
      grid-row: 2;
    }
    .p-airpro-s-highlights__card:nth-child(4) {
      grid-column: 1 / 3;
      grid-row: 3;
    }
    .p-airpro-s-highlights__card:nth-child(5) {
      grid-column: 1;
      grid-row: 4;
    }
    .p-airpro-s-highlights__card:nth-child(6) {
      grid-column: 2;
      grid-row: 4;
    }
    .p-airpro-s-highlights__copy {
      max-width: 82%;
      padding: 0;
    }
    .p-airpro-s-highlights__title {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.18;
      letter-spacing: -.03em;
    }
    .p-airpro-s-highlights__text {
      margin-top: 5px;
      font-size: 11px;
      line-height: 1.35;
      letter-spacing: -.02em;
    }
    .p-airpro-s-highlights__card:nth-child(1) .p-airpro-s-highlights__copy {
      position: absolute;
      z-index: 1;
      top: 0;
      left: 0;
      padding: 29px 17px;
    }
    .p-airpro-s-highlights__card:nth-child(1) .p-airpro-s-highlights__title {
      font-size: 16px;
    }
    .p-airpro-s-highlights__card:nth-child(2) .p-airpro-s-highlights__copy,
    .p-airpro-s-highlights__card:nth-child(3) .p-airpro-s-highlights__copy,
    .p-airpro-s-highlights__card:nth-child(5) .p-airpro-s-highlights__copy,
    .p-airpro-s-highlights__card:nth-child(6) .p-airpro-s-highlights__copy {
      position: absolute;
      right: 6px;
      bottom: 10px;
      left: 6px;
      max-width: none;
      padding: 0;
      text-align: center;
    }
    .p-airpro-s-highlights__card:nth-child(2) .p-airpro-s-highlights__text,
    .p-airpro-s-highlights__card:nth-child(3) .p-airpro-s-highlights__text,
    .p-airpro-s-highlights__card:nth-child(5) .p-airpro-s-highlights__text,
    .p-airpro-s-highlights__card:nth-child(6) .p-airpro-s-highlights__text {
      display: none;
    }
    .p-airpro-s-highlights__card:nth-child(4) .p-airpro-s-highlights__copy {
      position: absolute;
      right: 8px;
      bottom: 15px;
      left: 8px;
      max-width: none;
      padding: 0;
      text-align: center;
    }
    .p-airpro-s-highlights__card:nth-child(4) .p-airpro-s-highlights__title,
    .p-airpro-s-highlights__card:nth-child(4) .p-airpro-s-highlights__text {
      display: inline;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.3;
    }
    .p-airpro-s-highlights__card:nth-child(4) .p-airpro-s-highlights__text { margin-left: .3em; }
  }
</style>

<section
  id="p-airpro-s-highlights-{{ sid }}"
  class="p-aps-high"
  style="--p-airpro-s-highlights-bg: {{ section.settings.background }}; --p-airpro-s-highlights-text: {{ section.settings.text_color }}; --p-airpro-s-highlights-padding-top: {{ section.settings.padding_top }}px; --p-airpro-s-highlights-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="p-airpro-s-highlights__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="p-airpro-s-highlights__grid">
      {% for block in section.blocks %}
        <article class="p-airpro-s-highlights__card" {{ block.shopify_attributes }}>
          <picture>
            {% if block.settings.image_mobile != blank %}
              <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
            {% endif %}
            {% if block.settings.image != blank -%}
              {{-
                block.settings.image
                | image_url: width: 1200
                | image_tag: class: 'p-airpro-s-highlights__image', loading: 'lazy', widths: '400, 600, 900, 1200'
              -}}
            {%- endif %}
          </picture>
          <div class="p-airpro-s-highlights__copy">
            <h3 class="p-airpro-s-highlights__title">{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p class="p-airpro-s-highlights__text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "P Air Pro S 卖点拼图",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "まずは、ハイライトから。" },
    { "type": "color", "id": "background", "label": "背景色", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "文字色", "default": "#000000" },
    { "type": "range", "id": "padding_top", "label": "PC 上边距", "min": 20, "max": 140, "step": 10, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "PC 下边距", "min": 20, "max": 140, "step": 10, "default": 100 }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "卖点卡片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "PC 图片" },
        { "type": "image_picker", "id": "image_mobile", "label": "移动端图片" },
        { "type": "text", "id": "title", "label": "标题", "default": "コンパクト" },
        { "type": "text", "id": "text", "label": "说明", "default": "全身ケアをより手軽に" }
      ]
    }
  ],
  "presets": [
    {
      "name": "P Air Pro S 売点拼图",
      "blocks": [
        { "type": "highlight", "settings": { "title": "2週間で効果実感", "text": "コンパクトなのにパワフル" } },
        { "type": "highlight", "settings": { "title": "痛みレス", "text": "＜18℃の冷却ケア" } },
        { "type": "highlight", "settings": { "title": "USHRモード", "text": "スピーディーなケア" } },
        { "type": "highlight", "settings": { "title": "時短", "text": "全身ケアがより早く" } },
        { "type": "highlight", "settings": { "title": "コンパクト", "text": "手軽に使いやすい" } },
        { "type": "highlight", "settings": { "title": "全身", "text": "気になる部位に" } }
      ]
    }
  ]
}
{% endschema %}
