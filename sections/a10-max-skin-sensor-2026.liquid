{% comment %}
  Air 10 Max 2026: skin-sensor. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-skin-sensor-2026-{{ section.id }}" class="a10-2026 a10-2026__sensor">
<div class="container a10-2026__container">
<div class="a10-2026__inner a10-2026__sensor-grid">
<div class="a10-2026__sensor-copy">
<div class="a10-2026__sensor-icon">{%- assign a10_image = section.settings.benefit_icon -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- else -%}<img class="a10-2026__sensor-icon-fallback" src="{{ 'a10-max-skin-sensor-icon-mobile-2026.svg' | asset_url }}" alt="" width="46" height="44" loading="lazy">{%- endif -%}</div>
{% if section.settings.heading != blank %}
<h2 class="a10-2026__title a10-2026__desktop to-top" style="transition-delay: 0.1s;">{{ section.settings.heading | escape | newline_to_br }}</h2>
<h2 class="a10-2026__title a10-2026__mobile to-top" style="transition-delay: 0.1s;">{{ section.settings.heading_mobile | default: section.settings.heading | escape | newline_to_br }}</h2>
{% endif %}{% if section.settings.title != blank %}
<h3 class="a10-2026__subtitle a10-2026__desktop to-top" style="transition-delay: 0.2s;">{{ section.settings.title | escape | newline_to_br }}</h3>
{% endif %}{% if section.settings.description != blank %}
<div class="a10-2026__body to-top" style="transition-delay: 0.3s;">{{ section.settings.description | escape | newline_to_br }}</div>
{% endif %}{% if section.settings.note != blank %}
<div class="a10-2026__note to-top" style="transition-delay: 0.4s;">{{ section.settings.note | escape | newline_to_br }}</div>
{% endif %}</div>

<div class="a10-2026__sensor-visual">{%- assign a10_image = section.settings.image | default: section.settings.image_mobile -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media">{% if section.settings.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 375 }} 375w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% else %}<source media="(max-width: 749px)" srcset="{{ 'a10-max-skin-sensor-mobile-2026.png' | asset_url }}">{% endif %}{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- else -%}<picture class="a10-2026__media a10-2026__sensor-visual-fallback"><img src="{{ 'a10-max-skin-sensor-mobile-2026.png' | asset_url }}" alt="スキンセンサーを搭載した脱毛器" loading="lazy" width="375" height="264"></picture>{%- endif -%}
{% if section.settings.image_mobile == blank %}<img class="a10-2026__sensor-tone" src="{{ 'a10-max-skin-sensor-tone-mobile-2026.png' | asset_url }}" alt="肌色ごとの照射イメージ" loading="lazy" width="173" height="67">{% endif %}</div>
</div>
</div>
</section>

<style>
#a10-max-skin-sensor-2026-{{ section.id }} { color: #190a0a;  overflow: hidden; }
#a10-max-skin-sensor-2026-{{ section.id }} *, #a10-max-skin-sensor-2026-{{ section.id }} *::before, #a10-max-skin-sensor-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-skin-sensor-2026-{{ section.id }} h2, #a10-max-skin-sensor-2026-{{ section.id }} h3, #a10-max-skin-sensor-2026-{{ section.id }} p { margin: 0; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-skin-sensor-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-skin-sensor-2026-{{ section.id }}.a10-2026__sensor { padding: 140px 0 100px; background: #f7f8fa; }
#a10-max-skin-sensor-2026-{{ section.id }} > .a10-2026__container { width: 100%; max-width: 1300px; padding-inline: 40px; margin-inline: auto; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-grid { display: grid; grid-template-columns: 45% 55%; align-items: center; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-copy { padding-right: 75px; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-icon { width: 80px; margin-bottom: 30px; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-copy .a10-2026__subtitle { font-size: 22px; margin-top: 28px; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-copy .a10-2026__body { margin-top: 30px; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-copy .a10-2026__note { margin-top: 45px; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-icon-fallback, #a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-visual-fallback, #a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-tone { display: none; }
@media (min-width:750px) and (max-width:1400px) {
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__title { font-size: 32px; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__subtitle { font-size: 26px; }
}
@media (max-width:749px) {
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__desktop { display: none !important; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__mobile { display: block; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__title { font-size: 24px; line-height: 1.3; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__subtitle { font-size: 24px; line-height: 1.5; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__body { font-size: 14px; line-height: 1.5; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__note { font-size: 10px; line-height: 1.5; }
#a10-max-skin-sensor-2026-{{ section.id }}.a10-2026__sensor { padding: 0; }
#a10-max-skin-sensor-2026-{{ section.id }} > .a10-2026__container { max-width: none; padding-inline: 0; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-grid { display: block; width: 100%; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-copy { position: relative; min-height: 283px; padding: 20px 20px 0; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-icon { width: 46px; height: 44px; margin-bottom: 26px; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-icon-fallback { display: block; width: 46px; height: 44px; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__title { line-height: 1.3; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-copy .a10-2026__body { margin-top: 20px; color: #000; line-height: 1.3; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-copy .a10-2026__note { position: absolute; bottom: 8px; left: 20px; margin: 0; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-visual { position: relative; width: 100%; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-visual-fallback { display: block; }
#a10-max-skin-sensor-2026-{{ section.id }} .a10-2026__sensor-tone { position: absolute; top: 45.1%; left: 2.9%; display: block; width: 45.9%; height: auto; }
}

/* Keep short copy inside clipped cards while it enters the viewport. */
@media (prefers-reduced-motion: no-preference) {
#a10-max-skin-sensor-2026-{{ section.id }} .to-top:not(.appear) { transform: translateY(20px); }
}

</style>

{% schema %}
{
  "name": "A10 Max 肤色识别",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 肤色识别图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "M 肤色识别图片"
    },
    {
      "type": "image_picker",
      "id": "benefit_icon",
      "label": "自动识别图标"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "标题",
      "default": "肌の色を自動で感知し、最適な出力パワーを適宜に判別。"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "说明文案",
      "default": "進化したスキンセンサー。認識範囲をダークブラウン*の肌まで拡張し、幅広い肌色をカバー。日焼けの状態や肌色の個人差を見極め、常に安全なパワーを維持。"
    },
    {
      "type": "text",
      "id": "note",
      "label": "脚注",
      "default": "*フィッツパトリックV型を指す。"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "主标题",
      "default": "スキンセンサーで、家族みんなに安心を。"
    },
    {
      "type": "textarea",
      "id": "heading_mobile",
      "label": "M 主标题",
      "default": "スキンセンサーで、\n家族みんなに安心を。"
    }
  ],
  "presets": [
    {
      "name": "A10 Max 肤色识别"
    }
  ]
}
{% endschema %}
