{% assign sid = section.id %}

<style>
  #p-airpro-s-use-guide-{{ sid }} { padding: 72px 0 64px; background: var(--p-guide-bg); color: var(--p-guide-text); }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__in { margin: 0 auto; }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__head { margin: 0 0 48px; font-size: 30px; font-weight: 600; line-height: 1.35; }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__step { min-width: 0; }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__num { margin: 0 0 10px; font-size: 12px; font-weight: 600; }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__img { display: block; width: 100%; aspect-ratio: 1.35; object-fit: cover; }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__ttl { margin: 16px 0 0; font-size: 17px; font-weight: 600; line-height: 1.3; }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__text { margin: 8px 0 0; font-size: 12px; line-height: 1.6; }
  #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__note { margin: 34px 0 0; color: #666; font-size: 9px; line-height: 1.5; }

  @media screen and (max-width: 749px) {
    #p-airpro-s-use-guide-{{ sid }} { padding: 28px 0 24px; }
    #p-airpro-s-use-guide-{{ sid }} > .container { padding-right: 10px; padding-left: 10px; }
    #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__head { margin-bottom: 24px; text-align: center; font-size: 20px; line-height: 1.35; }
    #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 8px; }
    #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__num { margin-bottom: 6px; font-size: 8px; }
    #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__ttl { margin-top: 8px; font-size: 10px; }
    #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__text { margin-top: 4px; font-size: 7px; line-height: 1.45; }
    #p-airpro-s-use-guide-{{ sid }} .p-aps-guide__note { margin-top: 20px; font-size: 6px; }
  }
</style>

<section id="p-airpro-s-use-guide-{{ sid }}" class="p-aps-guide" style="--p-guide-bg: {{ section.settings.background }}; --p-guide-text: {{ section.settings.text_color }};">
  <div class="container"><div class="p-aps-guide__in">
    {% if section.settings.heading != blank %}<h2 class="p-aps-guide__head">{{ section.settings.heading }}</h2>{% endif %}
    <div class="p-aps-guide__grid">
      {% for block in section.blocks %}
        <article class="p-aps-guide__step" {{ block.shopify_attributes }}>
          <p class="p-aps-guide__num">STEP {{ forloop.index }}</p>
          {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: class: 'p-aps-guide__img', loading: 'lazy', widths: '200, 400, 700' }}{% endif %}
          {% if block.settings.title != blank %}<h3 class="p-aps-guide__ttl">{{ block.settings.title }}</h3>{% endif %}
          {% if block.settings.text != blank %}<p class="p-aps-guide__text">{{ block.settings.text }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
    {% if section.settings.note != blank %}<p class="p-aps-guide__note">{{ section.settings.note }}</p>{% endif %}
  </div></div>
</section>

{% schema %}
{
  "name": "P Air Pro S 使用方法",
  "max_blocks": 4,
  "settings": [
    { "type": "html", "id": "heading", "label": "标题", "default": "つるすべ肌への正しい使い方" },
    { "type": "textarea", "id": "note", "label": "脚注" },
    { "type": "color", "id": "background", "label": "背景色", "default": "#f7f7f7" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#111111" }
  ],
  "blocks": [{ "type": "step", "name": "使用步骤", "settings": [
    { "type": "image_picker", "id": "image", "label": "图片" },
    { "type": "text", "id": "title", "label": "标题", "default": "シェービング" },
    { "type": "textarea", "id": "text", "label": "说明" }
  ]}],
  "presets": [{ "name": "P Air Pro S 使用方法", "blocks": [{ "type": "step" }, { "type": "step", "settings": { "title": "テスト" } }, { "type": "step", "settings": { "title": "ムダ毛ケア" } }, { "type": "step", "settings": { "title": "潤す＆紫外線対策" } }] }]
}
{% endschema %}
