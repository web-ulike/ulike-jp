{% assign sid = section.id %}<section id="me-sensitive-skin-{{ sid }}" class="me-sensitive-skin" style="--bg:{{ section.settings.background }}"><picture class="me-sensitive-skin__bg">{% if section.settings.image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.image_mobile | image_url: width:1000 }}">{% endif %}{% if section.settings.image != blank %}{{ section.settings.image | image_url: width:2400 | image_tag: class: 'me-sensitive-skin__image', loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400' }}{% endif %}</picture><div class="me-sensitive-skin__content"><div class="me-sensitive-skin__pc">{{ section.settings.title_html }}{{ section.settings.copy_html }}</div><div class="me-sensitive-skin__mobile">{{ section.settings.title_html_mobile }}{{ section.settings.copy_html_mobile }}</div>{% if section.settings.note_html != blank %}<div class="me-sensitive-skin__note">{{ section.settings.note_html }}</div>{% endif %}</div></section><style>#me-sensitive-skin-{{ sid }}{position:relative;min-height:720px;overflow:hidden;background:var(--bg)}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__bg{position:absolute;inset:0;display:block}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__image{display:block;width:100%;height:100%;object-fit:cover}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__content{position:relative;z-index:1;width:min(500px,34vw);padding-top:285px;margin-left:calc(50% + 20px);color:#111}#me-sensitive-skin-{{ sid }} h2,#me-sensitive-skin-{{ sid }} h3{margin:0;font-size:44px;line-height:1.28;letter-spacing:-.035em}#me-sensitive-skin-{{ sid }} p{margin:28px 0 0;font-size:14px;line-height:1.85}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__note{margin-top:38px;font-size:10px;line-height:1.7}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__note p{margin:0;font-size:inherit}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__mobile{display:none}@media(max-width:749px){#me-sensitive-skin-{{ sid }}{display:flex;min-height:0;flex-direction:column}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__bg{position:relative;height:270px;order:1}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__image{object-position:center top}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__content{width:auto;padding:28px 16px 36px;margin:0;order:2}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__pc{display:none}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__mobile{display:block}#me-sensitive-skin-{{ sid }} h2,#me-sensitive-skin-{{ sid }} h3{font-size:23px}#me-sensitive-skin-{{ sid }} p{margin-top:14px;font-size:11px;line-height:1.7}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__note{margin-top:20px;font-size:9px}}
  #me-sensitive-skin-{{ sid }} .me-sensitive-skin__pc > :first-child{margin:0;font-size:48px;font-weight:500;line-height:1.4;letter-spacing:-.035em}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__pc > :not(:first-child){margin:28px 0 0;font-size:14px;line-height:1.65}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__note,#me-sensitive-skin-{{ sid }} .me-sensitive-skin__note p{font-size:12px;line-height:1.7}@media(max-width:749px){#me-sensitive-skin-{{ sid }} .me-sensitive-skin__mobile > :first-child{margin:0;font-size:26px;font-weight:600;line-height:1.4}#me-sensitive-skin-{{ sid }} .me-sensitive-skin__mobile > :not(:first-child){margin:14px 0 0;font-size:14px;line-height:1.65}}
</style>
{% schema %}{"name":"Ulike ME 敏感肌模块","settings":[{"type":"image_picker","id":"image","label":"PC 背景图"},{"type":"image_picker","id":"image_mobile","label":"移动端图片"},{"type":"html","id":"title_html","label":"PC 右侧标题（HTML）"},{"type":"html","id":"copy_html","label":"PC 右侧描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"copy_html_mobile","label":"移动端描述（HTML）"},{"type":"richtext","id":"note_html","label":"注释"},{"type":"color","id":"background","label":"背景","default":"#e4efff"}],"presets":[{"name":"Ulike ME 敏感肌模块"}]}{% endschema %}
