{% comment %}
  Section: u-ews-conditions
  Usage:
  - Extended warranty conditions section
  - Text is configurable
  - Layout/style is fixed
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section id="u-ews-conditions-{{ sid }}" class="u-ews-conditions">
  <div class="u-ews-conditions__inner container">
    {%- if st.heading != blank -%}
      <div class="u-ews-conditions__heading rte to-top">
        {{ st.heading }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="u-ews-conditions__grid to-top">
        {%- for block in section.blocks -%}
          <div class="u-ews-conditions__item" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <div class="u-ews-conditions__title">
                {{ block.settings.title }}
              </div>
            {%- endif -%}

            {%- if block.settings.desc != blank -%}
              <div class="u-ews-conditions__desc">
                {{ block.settings.desc }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #u-ews-conditions-{{ sid }} {
   background: #F8F9FC;
    padding: 80px 0 ;
    position: relative;
  }

  #u-ews-conditions-{{ sid }} .u-ews-conditions__inner {
    
  }

  #u-ews-conditions-{{ sid }} .u-ews-conditions__heading {
    margin: 0 auto 60px;
    text-align: center;
    color: #000;
    font-size: 24px;
    line-height: 1.5;
    font-weight: 500;
  }

  #u-ews-conditions-{{ sid }} .u-ews-conditions__heading p {
    margin: 0;
  }

  #u-ews-conditions-{{ sid }} .u-ews-conditions__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0 auto;
  }

  #u-ews-conditions-{{ sid }} .u-ews-conditions__item {
    padding: 0 38px;
    min-height: 150px;
    text-align: left;
    position: relative;
  }

  #u-ews-conditions-{{ sid }} .u-ews-conditions__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 4px;
    right: 0;
    width: 1px;
    height: 96px;
    background: #d9d9de;
  }

  #u-ews-conditions-{{ sid }} .u-ews-conditions__title {
    margin-bottom: 20px;
    color: #000;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 500;
  }

  #u-ews-conditions-{{ sid }} .u-ews-conditions__desc {
    color: rgba(0, 0, 0, 0.70);
    font-size: 14px;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    #u-ews-conditions-{{ sid }} {
      padding: 50px 0 40px;
    }

    #u-ews-conditions-{{ sid }} .u-ews-conditions__inner {
    }

    #u-ews-conditions-{{ sid }} .u-ews-conditions__heading {
      margin: 0 auto 40px;
      font-size: 20px;
      line-height: 1.55;
      text-align: left;
    }

    #u-ews-conditions-{{ sid }} .u-ews-conditions__grid {
      grid-template-columns: 1fr;
      max-width: 100%;
    }

    #u-ews-conditions-{{ sid }} .u-ews-conditions__item {
      min-height: auto;
      padding: 0 0 20px;
      margin-bottom: 20px;
    }

    #u-ews-conditions-{{ sid }} .u-ews-conditions__item:not(:last-child)::after {
      top: auto;
      right: auto;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 1px;
    }

    #u-ews-conditions-{{ sid }} .u-ews-conditions__title {
      margin-bottom: 10px;
      font-size: 18px;
      line-height: 1.5;
    }

    #u-ews-conditions-{{ sid }} .u-ews-conditions__desc {
      font-size: 14px;
      line-height: 1.6;
    }
  }
</style>

{% schema %}
{
  "name": "u-ews-conditions",
  "tag": "section",
  "class": "section section-u-ews-conditions",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>下記の条件を満足した場合は<br>すべて有償延長保証サービスにご参加いただけます</p>"
    }
  ],
  "blocks": [
    {
      "type": "condition_item",
      "name": "Condition item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "対象製品"
        },
        {
          "type": "html",
          "id": "desc",
          "label": "Description",
          "default": "当社オンライン公式ストア上に販売されている製品をご購入いただいたお客様。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "u-ews-conditions",
      "blocks": [
        {
          "type": "condition_item",
          "settings": {
            "title": "対象製品",
            "desc": "当社オンライン公式ストア上に販売されている製品をご購入いただいたお客様。"
          }
        },
        {
          "type": "condition_item",
          "settings": {
            "title": "対象パーツ",
            "desc": "製品端末本体・付属の電源コード・付属品の交換プログラム。"
          }
        },
        {
          "type": "condition_item",
          "settings": {
            "title": "対象範囲",
            "desc": "付属品の配送時間内に、同梱商品の正常に認められる使用方法に従って動作している時の停止した場合。"
          }
        },
        {
          "type": "condition_item",
          "settings": {
            "title": "対象期間",
            "desc": "本サービスご加入した際に表示されたメーカー保証期間中である場合。"
          }
        }
      ]
    }
  ]
}
{% endschema %}