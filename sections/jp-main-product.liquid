{% if section.settings.product and template.name != 'product' %}
  {% assign product = section.settings.product %}
{% endif %}

{{ 'jp-main-product-new.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-media-new.js' | asset_url }}" defer></script>

{%- liquid
  assign sid = section.id
-%}

<section id="jp-main-product-{{ sid }}" class="jp-main-product-new" data-section-id="{{ sid }}">
  <div class="jp-container jp-main-product-new__container">
    <div class="jp-main-product-new__media">
      {%- render 'product-media-new', product: product -%}
    </div>

    <div class="jp-main-product-new__info">
      {%- render 'product-info-new', product: product, update_url: true, section: section -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JP Main Product New",
  "class": "shopify-section--jp-main-product-new",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "产品标题",
      "limit": 1
    },
    {
      "type": "review_badge",
      "name": "评分插件",
      "limit": 1
    },
    {
      "type": "product_description",
      "name": "产品描述",
      "limit": 1
    },
    {
      "type": "price",
      "name": "价格",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "折扣价标签",
          "default": "期間限定"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "折扣价"
        },
        {
          "type": "text",
          "id": "original_price_label",
          "label": "原价标签",
          "default": "定価"
        },
        {
          "type": "text",
          "id": "original_price",
          "label": "原价"
        },
        {
          "type": "html",
          "id": "discount_information",
          "label": "折扣信息"
        }
      ]
    },
    {
      "type": "discount_code",
      "name": "优惠码",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "背景图片"
        },
        {
          "type": "text",
          "id": "discount_text",
          "label": "折扣文案",
          "default": "30%OFF"
        },
        {
          "type": "text",
          "id": "copy_text",
          "label": "复制文案",
          "default": "Copy:"
        },
        {
          "type": "text",
          "id": "code_text",
          "label": "优惠码",
          "default": "AIR10MAX"
        },
        {
          "type": "html",
          "id": "tip_text",
          "label": "优惠券底部提示文案",
          "default": "決済画面でコードを入力すると、表示価格からさらに割引されます。"
        },
        {
          "type": "html",
          "id": "success_text",
          "label": "复制成功文案",
          "default": "コピーしました"
        },
        {
          "type": "checkbox",
          "id": "is_auto_apply",
          "label": "是否自动应用优惠码",
          "default": false
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "变体选择器",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "hide_sold_out_variants",
          "label": "隐藏售罄变体",
          "default": false
        },
        {
          "type": "select",
          "id": "selector_mode",
          "label": "选择器类型",
          "options": [
            {
              "value": "block",
              "label": "块状"
            },
            {
              "value": "dropdown",
              "label": "下拉"
            }
          ],
          "default": "block"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "数量选择器",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "购买按钮",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "add_to_cart_text",
          "label": "加购按钮文案",
          "default": "カートに追加する"
        },
        {
          "type": "checkbox",
          "id": "show_buy_button",
          "label": "显示立即购买按钮",
          "default": true
        },
        {
          "type": "text",
          "id": "buy_now_text",
          "label": "立即购买按钮文案",
          "default": "今すぐ注文"
        }
      ]
    },
    {
      "type": "aftermarket",
      "name": "服务图标",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图标 1"
        },
        {
          "type": "text",
          "id": "text",
          "label": "文案 1"
        },
        {
          "type": "image_picker",
          "id": "image1",
          "label": "图标 2"
        },
        {
          "type": "text",
          "id": "text1",
          "label": "文案 2"
        },
        {
          "type": "image_picker",
          "id": "image2",
          "label": "图标 3"
        },
        {
          "type": "text",
          "id": "text2",
          "label": "文案 3"
        },
        {
          "type": "image_picker",
          "id": "image3",
          "label": "图标 4"
        },
        {
          "type": "text",
          "id": "text3",
          "label": "文案 4"
        },
        {
          "type": "image_picker",
          "id": "image4",
          "label": "图标 5"
        },
        {
          "type": "text",
          "id": "text4",
          "label": "文案 5"
        },
        {
          "type": "html",
          "id": "note_text",
          "label": "底部备注文案"
        }
      ]
    },
    {
      "type": "liquid",
      "name": "自定义 Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "liquid",
          "label": "Liquid 代码"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "产品"
    }
  ],
  "presets": [
    {
      "name": "JP Main Product New",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "review_badge"
        },
        {
          "type": "product_description"
        },
        {
          "type": "price"
        },
        {
          "type": "discount_code"
        },
        {
          "type": "quantity_selector"
        },
        {
          "type": "buy_buttons"
        },
        {
          "type": "aftermarket"
        }
      ]
    }
  ]
}
{% endschema %}
