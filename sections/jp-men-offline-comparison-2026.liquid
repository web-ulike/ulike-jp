{%- liquid
  assign section_id = 'jp-men-offline-comparison-2026-' | append: section.id
  assign x_plus_label = section.settings.x_plus_label | default: 'Ulike X +'
  assign x_label = section.settings.x_label | default: 'Ulike X'
-%}
{%- capture default_heading -%}Ulike X 店舗販売専用モデルとUlikeX＋では、
付属するカミソリの仕様が異なります。{%- endcapture -%}

<section id="{{ section_id }}" class="jp-men-offline-comparison-2026" aria-label="{{ section.settings.heading | default: default_heading | escape }}">
  {%- if section.settings.anchor_id != blank -%}<span id="{{ section.settings.anchor_id | handleize }}" class="jp-men-offline-comparison-2026__anchor"></span>{%- endif -%}
  <div class="jp-men-offline-comparison-2026__canvas">
    <h2 class="jp-men-offline-comparison-2026__heading">
      {{ section.settings.heading | default: default_heading | escape | newline_to_br }}
    </h2>

    <div class="jp-men-offline-comparison-2026__product jp-men-offline-comparison-2026__product--x-plus">
      <div class="jp-men-offline-comparison-2026__media">
        {%- if section.settings.x_plus_image != blank or section.settings.x_plus_image_mobile != blank -%}
          <picture>
            {%- if section.settings.x_plus_image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ section.settings.x_plus_image_mobile | image_url: width: 1800 }}">
            {%- endif -%}
            {%- assign x_plus_image = section.settings.x_plus_image | default: section.settings.x_plus_image_mobile -%}
            {{ x_plus_image | image_url: width: 2200 | image_tag: class: 'jp-men-offline-comparison-2026__image', loading: 'lazy', widths: '500, 800, 1200, 1600, 2200', sizes: '38vw', alt: x_plus_label }}
          </picture>
        {%- else -%}
          <div class="jp-men-offline-comparison-2026__placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      <p class="jp-men-offline-comparison-2026__label">{{ x_plus_label | escape }}</p>
    </div>

    <div class="jp-men-offline-comparison-2026__product jp-men-offline-comparison-2026__product--x">
      <div class="jp-men-offline-comparison-2026__media">
        {%- if section.settings.x_image != blank or section.settings.x_image_mobile != blank -%}
          <picture>
            {%- if section.settings.x_image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ section.settings.x_image_mobile | image_url: width: 1800 }}">
            {%- endif -%}
            {%- assign x_image = section.settings.x_image | default: section.settings.x_image_mobile -%}
            {{ x_image | image_url: width: 2200 | image_tag: class: 'jp-men-offline-comparison-2026__image', loading: 'lazy', widths: '500, 800, 1200, 1600, 2200', sizes: '38vw', alt: x_label }}
          </picture>
        {%- else -%}
          <div class="jp-men-offline-comparison-2026__placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      <p class="jp-men-offline-comparison-2026__label">{{ x_label | escape }}</p>
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    background: {{ section.settings.background | default: '#FAFAFA' }};
    color: {{ section.settings.text_color | default: '#000000' }};
    margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px;
    margin-top: {{ section.settings.margin_top | default: 0 }}px;
    overflow: hidden;
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__canvas {
    aspect-ratio: 2720 / 1306;
    margin: 0 auto;
    max-width: 1360px;
    position: relative;
    width: 100%;
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__anchor {
    position: absolute;
    scroll-margin-top: 100px;
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__heading {
    color: inherit;
    font-family: inherit;
    font-size: clamp(18px, 2.5735vw, 35px);
    font-weight: 500;
    left: 50%;
    line-height: 1.3;
    margin: 0;
    position: absolute;
    text-align: center;
    top: 11.1026%;
    transform: translateX(-50%);
    width: 53.5662%;
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__product {
    position: absolute;
    top: 34.4564%;
    width: 38.3088%;
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__product--x-plus { left: 9.3382%; }
  #{{ section_id }} .jp-men-offline-comparison-2026__product--x { left: 52.3529%; }
  #{{ section_id }} .jp-men-offline-comparison-2026__media {
    aspect-ratio: 1042 / 599;
    position: relative;
    width: 100%;
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__media picture,
  #{{ section_id }} .jp-men-offline-comparison-2026__image,
  #{{ section_id }} .jp-men-offline-comparison-2026__placeholder {
    display: block;
    height: 100%;
    width: 100%;
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__image {
    object-fit: contain;
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__placeholder {
    background: linear-gradient(135deg, rgba(0, 0, 0, .04), rgba(0, 0, 0, .1));
  }

  #{{ section_id }} .jp-men-offline-comparison-2026__label {
    color: inherit;
    font-family: inherit;
    font-size: clamp(15px, 1.4706vw, 20px);
    font-weight: 500;
    left: 50%;
    line-height: 1.3;
    margin: 0;
    position: absolute;
    text-align: center;
    top: 107.346%;
    transform: translateX(-50%);
    white-space: nowrap;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      background: {{ section.settings.mobile_background | default: '#FFFFFF' }};
      margin-bottom: {{ section.settings.mobile_margin_bottom | default: 0 }}px;
      margin-top: {{ section.settings.mobile_margin_top | default: 0 }}px;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__canvas {
      aspect-ratio: 1732 / 1028;
      max-width: 866px;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__heading {
      font-size: clamp(14px, 4.2667vw, 16px);
      left: 50.352%;
      top: 12.1132%;
      white-space: nowrap;
      width: auto;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__product {
      top: 41.1479%;
      width: 43.1264%;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__product--x-plus {
      left: 51.3279%;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__product--x {
      left: 5.5427%;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__media {
      aspect-ratio: 747 / 439;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__label {
      font-size: clamp(10px, 3.2vw, 12px);
      top: 108.656%;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__product--x-plus .jp-men-offline-comparison-2026__label {
      left: 50%;
    }

    #{{ section_id }} .jp-men-offline-comparison-2026__product--x .jp-men-offline-comparison-2026__label {
      left: 50%;
    }
  }
</style>

{% schema %}
{
  "name": "jp-men-offline-comparison",
  "settings": [
    { "type": "header", "content": "锚点与外边距" },
    { "type": "text", "id": "anchor_id", "label": "锚点 ID" },
    { "type": "range", "id": "margin_top", "label": "PC 上边距", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "PC 下边距", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_top", "label": "M 上边距", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_bottom", "label": "M 下边距", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 0 },
    { "type": "textarea", "id": "heading", "label": "标题", "default": "Ulike X 店舗販売専用モデルとUlikeX＋では、\n付属するカミソリの仕様が異なります。" },
    { "type": "text", "id": "x_plus_label", "label": "Ulike X+ 下方文案", "default": "Ulike X +" },
    { "type": "text", "id": "x_label", "label": "Ulike X 下方文案", "default": "Ulike X" },
    { "type": "image_picker", "id": "x_plus_image", "label": "Ulike X+ PC 产品图", "info": "请上传 Figma 导出的透明底产品图。" },
    { "type": "image_picker", "id": "x_plus_image_mobile", "label": "Ulike X+ M 产品图", "info": "请上传 Figma 导出的透明底产品图。" },
    { "type": "image_picker", "id": "x_image", "label": "Ulike X PC 产品图", "info": "请上传 Figma 导出的透明底产品图。" },
    { "type": "image_picker", "id": "x_image_mobile", "label": "Ulike X M 产品图", "info": "请上传 Figma 导出的透明底产品图。" },
    { "type": "color", "id": "background", "label": "PC 背景色", "default": "#FAFAFA" },
    { "type": "color", "id": "mobile_background", "label": "M 背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#000000" }
  ],
  "presets": [
    { "name": "jp-men-offline-comparison" }
  ]
}
{% endschema %}
