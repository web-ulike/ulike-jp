{% comment %}
  Air 10 Max 2026: long-life. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-long-life-2026-{{ section.id }}" class="a10-2026 a10-2026__scene">
<div class="container a10-2026__container">
<div class="a10-2026__inner a10-2026__scene-grid">
<div class="a10-2026__scene-background">{%- assign a10_image = section.settings.image | default: section.settings.image_mobile -%}{%- if a10_image != blank -%}
<picture class="a10-2026__media ">{% if section.settings.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 375 }} 375w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}</picture>
{%- endif -%}</div>

<div class="a10-2026__scene-copy">{% if section.settings.title != blank %}
<h2 class="a10-2026__title to-top" style="transition-delay: 0.1s;">{{ section.settings.title | escape | newline_to_br }}</h2>
{% endif %}{% if section.settings.description != blank %}
<div class="a10-2026__body to-top" style="transition-delay: 0.2s;">{{ section.settings.description }}</div>
{% endif %}
<div class="a10-2026__stats">
<div class="a10-2026__stat"><strong>{{ section.settings.lifetime_value | escape | newline_to_br }}</strong><span class="unit">{{ section.settings.lifetime_unit | escape | newline_to_br }}</span><span class="label">{{ section.settings.lifetime_label | escape | newline_to_br }}</span></div>

<div class="a10-2026__stat"><strong>{{ section.settings.cost_value | escape | newline_to_br }}</strong><span class="unit">{{ section.settings.cost_unit | escape | newline_to_br }}</span><span class="label">{{ section.settings.cost_label | escape | newline_to_br }}</span></div>
</div>
{% if section.settings.note != blank %}
<div class="a10-2026__note to-top" style="transition-delay: 0.3s;">{{ section.settings.note }}</div>
{% endif %}</div>
</div>
</div>
</section>

<style>
#a10-max-long-life-2026-{{ section.id }} { color: #190a0a;  overflow: hidden; }
#a10-max-long-life-2026-{{ section.id }} *, #a10-max-long-life-2026-{{ section.id }} *::before, #a10-max-long-life-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-long-life-2026-{{ section.id }} h2, #a10-max-long-life-2026-{{ section.id }} h3, #a10-max-long-life-2026-{{ section.id }} p { margin: 0; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__wide { width: min(1600px, calc(100% - 80px)); margin: 0 auto; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-long-life-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-long-life-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stats { display: flex; gap: 55px; margin-top: 55px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat { text-align: center; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat .a10-2026__media { width: 116px; margin: 0 auto 20px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat strong {  font-size: 64px; line-height: 1.1; font-weight: 600; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat .unit { font-size: 24px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat .label { display: block; font-size: 16px; margin-top: 8px; }
#a10-max-long-life-2026-{{ section.id }}.a10-2026__scene { position: relative; background: linear-gradient(135deg,#edf0f7,#fff); }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-grid { position: relative; min-height: 800px; display: flex; align-items: center; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-background { position: absolute; inset: 0; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-background .a10-2026__media, #a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-background img { width: 100%; height: 100%; object-fit: cover; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy { position: relative; width: 43%; padding: 90px 0 60px; z-index: 1; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__body { margin-top: 32px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__stats { gap: 35px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__stat + .a10-2026__stat { border-left: 1px solid #bbb; padding-left: 35px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__note { margin-top: 200px; }
@media (min-width:750px) and (max-width:1400px) {
#a10-max-long-life-2026-{{ section.id }} .a10-2026__title { font-size: 32px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__subtitle { font-size: 26px; }
}
@media (max-width:749px) {
#a10-max-long-life-2026-{{ section.id }} .a10-2026__desktop { display: none !important; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__mobile { display: block; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__title { font-size: 24px; line-height: 1.3; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__subtitle { font-size: 24px; line-height: 1.5; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__body { font-size: 14px; line-height: 1.5; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__note { font-size: 10px; line-height: 1.5; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stats { gap: 50px; justify-content: center; margin: 50px var(--container-gutter); }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat .a10-2026__media { width: 68px; margin-bottom: 12px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat strong { font-size: 40px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat .unit { font-size: 14px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__stat .label { font-size: 12px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-grid { width: 100%; min-height: 0; display: flex; flex-direction: column; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-background { position: static; order: 1; width: 100%; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-background .a10-2026__media, #a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-background img { height: auto; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy { display: contents; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__title { order: 0; margin: 38px var(--container-gutter) 0; font-size: 20px; font-weight: 500; align-self: start; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__body { order: 0; margin: 22px var(--container-gutter) 0; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__stats { order: 0; margin: 30px var(--container-gutter) 25px; align-self: start; gap: 24px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__stat + .a10-2026__stat { padding-left: 24px; }
#a10-max-long-life-2026-{{ section.id }} .a10-2026__scene-copy .a10-2026__note { order: 2; background: #fff; width: 100%; margin: 0; padding: 22px var(--container-gutter); }
#a10-max-long-life-2026-{{ section.id }}.a10-2026__scene--attachment .a10-2026__title { text-align: center; align-self: center; }
}

/* Keep short copy inside clipped cards while it enters the viewport. */
@media (prefers-reduced-motion: no-preference) {
#a10-max-long-life-2026-{{ section.id }} .to-top:not(.appear) { transform: translateY(var(--container-gutter)); }
}

@media (max-width:749px) {
#a10-max-long-life-2026-{{ section.id }} > .a10-2026__container { padding-inline: 0; }
}

</style>

{% schema %}
{
  "name": "A10 Max 使用寿命",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端图片"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "PC 标题（换行请回车）",
      "default": "長く付き合える、納得の一台"
    },
    {
      "type": "html",
      "id": "description",
      "label": "说明文字",
      "default": "<p>最大90万回<sup>*1</sup>の長寿命ランプを採用し、毎日のケアを長く支える一台。1回あたりのケアコストは約116円と<sup>*2</sup>、サロン施術と比べても無理のない使い続けやすさを叶えます。</p>"
    },
    {
      "type": "text",
      "id": "lifetime_value",
      "label": "寿命数值",
      "default": "90"
    },
    {
      "type": "text",
      "id": "lifetime_unit",
      "label": "寿命单位",
      "default": "万回"
    },
    {
      "type": "text",
      "id": "lifetime_label",
      "label": "寿命说明",
      "default": "長寿命ランプ"
    },
    {
      "type": "text",
      "id": "cost_value",
      "label": "成本数值",
      "default": "116"
    },
    {
      "type": "text",
      "id": "cost_unit",
      "label": "成本单位",
      "default": "円/回"
    },
    {
      "type": "text",
      "id": "cost_label",
      "label": "成本说明",
      "default": "自宅でサロン級"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "脚注",
      "default": "<p>*1.当社の耐久性試験結果。最大90万回連続で照射できます。<br>*2.116円の算出根拠：本体価格69,800円 ÷ 最大照射回数90万発 ＝ 約0.078円／発。全身ケア1回あたり約1,500発使用した場合、約116円相当。</p>"
    }
  ],
  "presets": [
    {
      "name": "A10 Max 使用寿命"
    }
  ]
}
{% endschema %}
