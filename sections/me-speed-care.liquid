{% assign sid = section.id %}<section id="me-speed-care-{{ sid }}" class="me-speed-care" style="--bg:{{ section.settings.background }}"><div class="me-speed-care__pc-bg">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width:2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400' }}{% endif %}</div><div class="me-speed-care__content"><div class="me-speed-care__pc">{{ section.settings.title_html }}{{ section.settings.copy_html }}</div><div class="me-speed-care__mobile">{{ section.settings.title_html_mobile }}{{ section.settings.copy_html_mobile }}</div></div><div class="me-speed-care__mobile-media">{% if section.settings.image_mobile != blank %}{{ section.settings.image_mobile | image_url: width:1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000' }}{% endif %}</div><div class="me-speed-care__mobile me-speed-care__mobile-bottom">{{ section.settings.copy_html_mobile_bottom }}</div></section><style>#me-speed-care-{{ sid }}{position:relative;min-height:720px;overflow:hidden;background:var(--bg)}#me-speed-care-{{ sid }} .me-speed-care__pc-bg{position:absolute;inset:0}#me-speed-care-{{ sid }} .me-speed-care__pc-bg img{display:block;width:100%;height:100%;object-fit:cover}#me-speed-care-{{ sid }} .me-speed-care__content{position:relative;z-index:1;width:min(490px,33vw);padding-top:190px;margin-left:max(24px,calc((100% - 1280px)/2));color:#111}#me-speed-care-{{ sid }} h2,#me-speed-care-{{ sid }} h3{margin:0;font-size:44px;line-height:1.28;letter-spacing:-.035em}#me-speed-care-{{ sid }} p{margin:28px 0 0;font-size:14px;line-height:1.85}#me-speed-care-{{ sid }} .me-speed-care__mobile,#me-speed-care-{{ sid }} .me-speed-care__mobile-media{display:none}@media(max-width:749px){#me-speed-care-{{ sid }}{min-height:0}#me-speed-care-{{ sid }} .me-speed-care__pc-bg,#me-speed-care-{{ sid }} .me-speed-care__pc{display:none}#me-speed-care-{{ sid }} .me-speed-care__content{width:auto;padding:45px 16px 28px;margin:0}#me-speed-care-{{ sid }} .me-speed-care__mobile{display:block}#me-speed-care-{{ sid }} h2,#me-speed-care-{{ sid }} h3{font-size:23px}#me-speed-care-{{ sid }} p{margin-top:14px;font-size:11px;line-height:1.7}#me-speed-care-{{ sid }} .me-speed-care__mobile-media{display:block}#me-speed-care-{{ sid }} .me-speed-care__mobile-media img{display:block;width:100%;height:auto}#me-speed-care-{{ sid }} .me-speed-care__mobile-bottom{padding:25px 16px 38px;color:#111}}
  #me-speed-care-{{ sid }} .me-speed-care__pc > :first-child{margin:0;font-size:48px;font-weight:500;line-height:1.4;letter-spacing:-.035em}#me-speed-care-{{ sid }} .me-speed-care__pc > :not(:first-child){margin:28px 0 0;font-size:14px;line-height:1.65}@media(max-width:749px){#me-speed-care-{{ sid }} .me-speed-care__mobile:not(.me-speed-care__mobile-bottom) > :first-child{margin:0;font-size:30px;font-weight:600;line-height:1.4}#me-speed-care-{{ sid }} .me-speed-care__mobile:not(.me-speed-care__mobile-bottom) > :not(:first-child){margin:14px 0 0;font-size:13px;line-height:1.65}#me-speed-care-{{ sid }} .me-speed-care__mobile-bottom,#me-speed-care-{{ sid }} .me-speed-care__mobile-bottom p{font-size:12px;line-height:1.7}}
</style>
{% schema %}{"name":"Ulike ME 高速护理模块","settings":[{"type":"image_picker","id":"image","label":"PC 背景图"},{"type":"image_picker","id":"image_mobile","label":"移动端中间图片"},{"type":"html","id":"title_html","label":"PC 左侧标题（HTML）"},{"type":"html","id":"copy_html","label":"PC 左侧描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"copy_html_mobile","label":"移动端顶部描述（HTML）"},{"type":"html","id":"copy_html_mobile_bottom","label":"移动端图片下描述（HTML）"},{"type":"color","id":"background","label":"背景","default":"#f5faff"}],"presets":[{"name":"Ulike ME 高速护理模块"}]}{% endschema %}
