      <div class="bf-tab-cont">
        <div class="bf-tab-scroll">
          <div class="bf-tab-list">
            {%- for block in section.blocks -%}
              <button type="button" class="bf-tab-item" data-rout="{{ block.settings.text1 | escape }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}

                {% if section.settings.is_love %}
                  <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 26 26" fill="none">
