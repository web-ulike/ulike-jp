                    <path d="M1 10.1004C0.99997 8.68774 1.42135 7.30715 2.21024 6.13525C2.99914 4.96335 4.11968 4.05342 5.42855 3.52184C6.73741 2.99027 8.1751 2.86122 9.55771 3.15119C10.9403 3.44117 12.205 4.137 13.19 5.14967C14.175 4.137 15.4397 3.44117 16.8223 3.15119C18.2049 2.86122 19.6426 2.99027 20.9514 3.52184C22.2603 4.05342 23.3808 4.96335 24.1697 6.13525C24.9586 7.30715 25.38 8.68774 25.38 10.1004C25.3827 11.2094 25.1243 12.3034 24.6256 13.294C24.1269 14.2845 23.4021 15.1438 22.5096 15.8021L14.4748 22.4229C14.028 22.7911 13.4648 22.9884 12.8859 22.9793C12.307 22.9702 11.7502 22.7554 11.3152 22.3733L3.4892 15.499C2.70799 14.8332 2.08078 14.0055 1.65099 13.0734C1.22119 12.1413 0.999073 11.1269 1 10.1004Z" fill="#E0004D"/>
                  </svg>
                {% endif %}
              </button>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </bf-tab-box>
</section>

{% javascript %}
  class BfTabBox extends HTMLElement {
    connectedCallback() {
      this.events = new AbortController();
      const { signal } = this.events;

      this.addEventListener('click', this.handleClick, { signal });
      window.addEventListener('scroll', this.scheduleUpdate, { passive: true, signal });
      window.addEventListener('resize', this.scheduleUpdate, { signal });
      window.addEventListener('load', this.scheduleUpdate, { once: true, signal });
      this.scheduleUpdate();
    }

    disconnectedCallback() {
      this.events.abort();
      cancelAnimationFrame(this.frame);
      this.frame = null;
    }

    getRoute(item) {
      return item.dataset.rout.trim().replace(/^#/, '');
    }

    getScrollBehavior() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
    }

    handleClick = (event) => {
      const item = event.target.closest('.bf-tab-item[data-rout]');
      if (!item) return;

      const route = this.getRoute(item);
      const behavior = this.getScrollBehavior();

      if (route === 'to-top') {
        window.scrollTo({ top: 0, behavior });
        return;
      }

      const target = document.getElementById(route);
      if (target) {
        const top = window.scrollY + target.getBoundingClientRect().top - 100;
        window.scrollTo({ top, behavior });
      }
    };

    scheduleUpdate = () => {
      if (this.frame != null) return;

      this.frame = requestAnimationFrame(() => {
        this.frame = null;
        this.updateActiveItem();
      });
    };

    updateActiveItem() {
      const items = this.querySelectorAll('.bf-tab-item[data-rout]');
      const previousItem = this.querySelector('.bf-tab-item.active');
      const atTop = window.scrollY <= 0;
      let activeItem = null;

      for (const item of items) {
        const route = this.getRoute(item);
        if (atTop) {
          if (route === 'to-top') {
            activeItem = item;
            break;
          }
          continue;
        }

        if (route === 'to-top') continue;
        const target = document.getElementById(route);
        if (!target) continue;

        const { top, bottom } = target.getBoundingClientRect();
        if (top <= 120 && bottom > 150) activeItem = item;
      }

      if (activeItem === previousItem) return;

      previousItem?.classList.remove('active');
      if (!activeItem) return;

      activeItem.classList.add('active');
      if (window.innerWidth < 768) {
        const scroller = this.querySelector('.bf-tab-scroll');
        const left = scroller.scrollLeft + activeItem.getBoundingClientRect().left - scroller.getBoundingClientRect().left;
        scroller.scrollTo({ left, behavior: this.getScrollBehavior() });
      }
    }
  }

  if (!customElements.get('bf-tab-box')) {
    customElements.define('bf-tab-box', BfTabBox);
  }
{% endjavascript %}

{% schema %}
{
  "name": "bf-tab-box",
  "class": "bf-tab-box-section",
  "blocks": [
    {
      "name": "item",
      "type": "item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "text1",
          "label": "Route"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "背景颜色"
    },
    {
      "type": "text",
      "id": "text",
      "label": "自定义Class"
    },
    {
      "type": "checkbox",
      "id": "is_love",
      "label": "show Love",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "bf-tab-box",
      "blocks": []
    }
  ]
}
{% endschema %}
