{% stylesheet %}
  .shopify-section.bf-tab-box-section {
    position: sticky;
    top: 0;
    z-index: 3;
  }

  .bf-tab-box {
    display: block;
    background: #000;
  }
  .bf-tab-box .bf-tab-cont {
    border-bottom: 1px solid #666666;
  }

  .bf-tab-box .bf-tab-scroll {
    overflow: hidden;
  }

  .bf-tab-box .bf-tab-list {
    display: flex;
  }
  .bf-tab-box .bf-tab-item {
    flex: 1;
    border: 0;
    background: transparent;
    text-align: center;
    color: #666;
    font-size: 24px;
    padding: 8px 0;
    cursor: pointer;
  }

  .bf-tab-box .bf-tab-item.active {
    font-family: var(--heading-font-family);
    color: #fff;
    border-bottom: 1px solid #DEB581;
  }
  .bf-2024.bf-tab-box {
    background: linear-gradient(180deg, rgba(244, 52, 90, 1) -13.5%, #b4003e 113.5%);
  }
  :where(.bf-tab-box).bf-2024 .bf-tab-cont {
    border: 0;
  }
  :where(.bf-tab-box).bf-2024 .bf-tab-item {
    color: #fff;
    padding: 18px 0;
    cursor: url('https://cdn.shopify.com/s/files/1/0656/9079/6273/files/cu3.svg'), auto;
  }
  :where(.bf-tab-box).bf-2024 .bf-tab-item.active {
    border: 0;
    color: #FFF3D4;
    font-family: var(--text-font-family);
  }
  .chr-2024.bf-tab-box {
    background: linear-gradient(180deg, #E9EFF9 0.3%, #F3F4F7 99.48%);
  }
  :where(.bf-tab-box).chr-2024 .bf-tab-item {
    color: #000;
    flex: none;
  }

  :where(.bf-tab-box).chr-2024 .bf-tab-item.active {
    border: 0;
    color: #e0004d;
  }

  :where(.bf-tab-box).chr-2024 .bf-tab-cont {
    border: 0;
  }
  .bf-tab-box.results-diy {
    background: #fff;
    border-top: 1px solid  #EBEBEB;
    border-bottom: 1px solid  #EBEBEB;
  }
  :where(.bf-tab-box).results-diy .bf-tab-item {
    color: #190A0A;
    font-size: 14px;
    flex: none;
    height: 65px;
    display: flex;
    align-items: center;
    border-bottom: 2.5px solid transparent;
  }

  :where(.bf-tab-box).results-diy .bf-tab-list {
    gap: clamp(0px, 3.125vw, 60px);
  }

  :where(.bf-tab-box).results-diy .bf-tab-item.active {
    color: #190A0A;
    border-bottom: 2.5px solid #86868B;
  }

  :where(.bf-tab-box).results-diy .bf-tab-cont {
    border: 0;
  }

  .new-2025.bf-tab-box {
    background: linear-gradient(0deg, #B00427 -25%, #8F1224 125%);
  }
  :where(.bf-tab-box).new-2025 .bf-tab-item {
    color: #fff;
  }
  .seo-diy.bf-tab-box {
    background: #F9F9F9;
  }
  :where(.bf-tab-box).seo-diy .bf-tab-item {
    color: #000;
  }
  :where(.bf-tab-box).seo-diy .bf-tab-item.active {
    color: #E0004D;
  }
  :where(.bf-tab-box).seo-diy .bf-tab-cont {
    border: 0;
  }
  :where(.bf-tab-box).vd-2025 .bf-tab-list:after {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    background-color: #C0C0C0;
    bottom: 0;
    left: 0;
  }
  .vd-2025.bf-tab-box .bf-tab-list {
    display: flex;
    position: relative;
  }
  :where(.bf-tab-box) .bf-tab-item svg {
    padding-left: 10px;
    display: none;
  }
  :where(.bf-tab-box) .bf-tab-item.active svg {
    display: block;
  }
  @media (min-width:999px) {
    :where(.bf-tab-box).chr-2024 .bf-tab-list {
      justify-content: center;
      gap: 90px;
    }
  }
  @media (max-width:999px) {
    .bf-tab-box .bf-tab-cont {
      border: 0;
    }
    .bf-tab-box .bf-tab-item {
      color: #9D9D9D;
      font-size: 16px;
      flex-shrink: 0;
      white-space: nowrap;
      padding: 8px 10px;
    }
    :where(.bf-tab-box).seo-diy .bf-tab-item {
      color: #000;
    }
    :where(.bf-tab-box).chr-2024 .bf-tab-item {
      color: #000;
    }
    :where(.bf-tab-box).bf-2024 .bf-tab-item {
      color: #fff;
    }
    .bf-tab-box .bf-tab-item.active {
      color: #DEB581;
    }

    :where(.bf-tab-box).bf-2024 .bf-tab-item.active {
      color: #FFF3D4;
    }
    .bf-tab-box .bf-tab-scroll {
      overflow-x: auto;
    }
    .bf-tab-box .bf-tab-scroll::-webkit-scrollbar {
      display: none;
    }

    :where(.bf-tab-box).chr-2024 .bf-tab-item.active {
      color: #e0004d;
    }
    :where(.bf-tab-box).new-2025 .bf-tab-item,
    :where(.bf-tab-box).new-2025 .bf-tab-item.active {
      color: #fff;
    }
    :where(.bf-tab-box).results-diy  .bf-tab-item {
      color: #190A0A;
      font-size: 14px;
    }
    :where(.bf-tab-box).results-diy  .bf-tab-item.active {
      color: #190A0A;
    }
    :where(.bf-tab-box).seo-diy .bf-tab-item.active {
      color: #E0004D;
    }
    .vd-2025.bf-tab-box .bf-tab-list {
      width: fit-content;
    }
  }
  @media (max-width:740px) {
    :where(.bf-tab-box) .bf-tab-item svg {
      padding-left: 5px;
      width: 13px;
      height: 13px;
    }
  }
{% endstylesheet %}

<section class="section-box">
