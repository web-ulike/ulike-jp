{%- liquid
  assign section_id = 'jp-air10-full-body-care-2026-' | append: section.id
  assign default_title = 'お顔からVIOまで、\n1台で全身に対応可能'
  assign default_description = 'お顔、ヒゲ、脇、腕、脚、VIOなど、アタッチメント付け替えの手間なしで、全身*トータルケアが1台で完結。'
  assign default_note = '注意事項:\n*一部使用できない箇所があります。取扱説明書をご確認ください。\n*毛の太さや刺激の感じ方に応じて、ご自身でモードをご調整ください。'
-%}
<section id="{{ section_id }}" class="jp-full-body-care-2026">
  <div class="jp-full-body-care-2026__inner">
    <div class="jp-full-body-care-2026__content"><h2 class="jp-full-body-care-2026__title to-top">{{ section.settings.title | default: default_title | escape | newline_to_br }}</h2><p class="jp-full-body-care-2026__description to-top" style="transition-delay:.1s">{{ section.settings.description | default: default_description | escape }}</p></div>
    <div class="jp-full-body-care-2026__chart to-top" style="transition-delay:.2s"><picture>{% if section.settings.chart_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.chart_mobile | image_url: width: 1200 }}">{% endif %}{% if section.settings.chart != blank %}{{ section.settings.chart | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 750, 1200, 1800, 2400', class: 'jp-full-body-care-2026__chart-image', alt: section.settings.chart.alt }}{% elsif section.settings.chart_mobile != blank %}{{ section.settings.chart_mobile | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 750, 1200', class: 'jp-full-body-care-2026__chart-image', alt: section.settings.chart_mobile.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'jp-full-body-care-2026__placeholder' }}{% endif %}</picture></div>
    <p class="jp-full-body-care-2026__note">{{ section.settings.note | default: default_note | escape | newline_to_br }}</p>
  </div>
</section>
<style>
  #{{ section_id }}{background:#fff;color:#000;overflow:hidden}#{{ section_id }} *{box-sizing:border-box}#{{ section_id }} .jp-full-body-care-2026__inner{height:1661px;margin:0 auto;max-width:1280px;position:relative}#{{ section_id }} .jp-full-body-care-2026__content{left:50%;position:absolute;text-align:center;top:106px;transform:translateX(-50%);width:896px;z-index:2}#{{ section_id }} .jp-full-body-care-2026__title{font-family:"Noto Sans JP",sans-serif;font-size:48px;font-weight:500;line-height:1.5;margin:0 0 31px}#{{ section_id }} .jp-full-body-care-2026__description{color:rgba(0,0,0,.8);font-family:"Noto Sans JP",sans-serif;font-size:24px;line-height:1.5;margin:0 auto;width:696px}#{{ section_id }} .jp-full-body-care-2026__chart{height:1187px;left:50%;position:absolute;top:334px;transform:translateX(-50%);width:1250px}#{{ section_id }} .jp-full-body-care-2026__chart picture,#{{ section_id }} .jp-full-body-care-2026__chart-image,#{{ section_id }} .jp-full-body-care-2026__placeholder{display:block;height:100%;width:100%}#{{ section_id }} .jp-full-body-care-2026__chart-image{object-fit:contain}#{{ section_id }} .jp-full-body-care-2026__placeholder{fill:#f4f4f2}#{{ section_id }} .jp-full-body-care-2026__note{bottom:65px;color:rgba(0,0,0,.5);font-family:Saans,"Noto Sans JP",sans-serif;font-size:10px;left:5px;line-height:1.5;margin:0;position:absolute}@media screen and (max-width:749px){#{{ section_id }} .jp-full-body-care-2026__inner{height:674px;max-width:none;width:100%}#{{ section_id }} .jp-full-body-care-2026__content{left:20px;text-align:left;top:35px;transform:none;width:calc(100% - 40px)}#{{ section_id }} .jp-full-body-care-2026__title{font-size:30px;line-height:1.5;margin-bottom:19px}#{{ section_id }} .jp-full-body-care-2026__description{font-size:18px;line-height:1.3;margin:0;width:100%}#{{ section_id }} .jp-full-body-care-2026__chart{height:316px;left:20px;top:260px;transform:none;width:calc(100% - 40px)}#{{ section_id }} .jp-full-body-care-2026__note{bottom:18px;font-family:"Noto Sans JP",sans-serif;font-size:10px;left:20px;width:calc(100% - 40px)}}
</style>
{% schema %}
{"name":"jp-air10-full-body-care","settings":[{"type":"image_picker","id":"chart","label":"PC 全身护理示意图"},{"type":"image_picker","id":"chart_mobile","label":"M 全身护理示意图"},{"type":"textarea","id":"title","label":"标题","default":"お顔からVIOまで、\n1台で全身に対応可能"},{"type":"textarea","id":"description","label":"说明文案","default":"お顔、ヒゲ、脇、腕、脚、VIOなど、アタッチメント付け替えの手間なしで、全身*トータルケアが1台で完結。"},{"type":"textarea","id":"note","label":"脚注文案","default":"注意事項:\n*一部使用できない箇所があります。取扱説明書をご確認ください。\n*毛の太さや刺激の感じ方に応じて、ご自身でモードをご調整ください。"}],"presets":[{"name":"jp-air10-full-body-care"}]}
{% endschema %}
