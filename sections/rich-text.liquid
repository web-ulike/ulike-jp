        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers.</p>"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "options": [
            { "value": "subtext-sm", "label": "Small" },
            { "value": "subtext-md", "label": "Medium" },
            { "value": "subtext-lg", "label": "Large" },
            { "value": "subtext-xl", "label": "Extra large" },
            { "value": "subtext-custom", "label": "Custom" }
          ],
          "default": "subtext-md"
