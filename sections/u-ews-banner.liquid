{% comment %}
  Section: u-ews-banner
  Notes:
  - Extended warranty banner
  - Image is configurable
  - Text/buttons use absolute positioning
  - Styles are fixed
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section id="u-ews-banner-{{ sid }}" class="u-ews-banner">
  <div class="u-ews-banner__inner">
    <div class="u-ews-banner__media">
      {%- if st.image_pc != blank -%}
        <img
          class="u-ews-banner__image u-ews-banner__image--pc"
          src="{{ st.image_pc | image_url: width: 2200 }}"
          alt="{{ st.heading | escape }}"
          loading="lazy"
          width="{{ st.image_pc.width }}"
          height="{{ st.image_pc.height }}"
        >
      {%- endif -%}

      {%- if st.image_mobile != blank -%}
        <img
          class="u-ews-banner__image u-ews-banner__image--mobile"
          src="{{ st.image_mobile | image_url: width: 1200 }}"
          alt="{{ st.heading | escape }}"
          loading="lazy"
          width="{{ st.image_mobile.width }}"
          height="{{ st.image_mobile.height }}"
        >
      {%- endif -%}

      <div class="u-ews-banner__overlay page-width">
        <div class="u-ews-banner__content">
          {%- if st.eyebrow != blank -%}
            <div class="u-ews-banner__eyebrow">
              {{ st.eyebrow }}
            </div>
          {%- endif -%}

          {%- if st.heading != blank -%}
            <h2 class="u-ews-banner__heading">
              {{ st.heading }}
            </h2>
          {%- endif -%}

          {%- if st.desc != blank -%}
            <div class="u-ews-banner__desc">
              {{ st.desc }}
            </div>
          {%- endif -%}

          <div class="u-ews-banner__actions">
            {%- if st.button_1_text != blank -%}
              <a
                class="u-ews-banner__btn u-ews-banner__btn--primary"
                
                {% if st.button_1_link != blank %}
                  href="{{ st.button_1_link }}"
                  target="_blank"
                  rel="noopener noreferrer"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                <span>{{ st.button_1_text }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none" aria-hidden="true">
                  <path d="M1 1L6 6L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}

            {%- if st.button_2_text != blank -%}
              <a
                class="u-ews-banner__btn u-ews-banner__btn--secondary"
                {% if st.button_2_link != blank %}
                  href="{{ st.button_2_link }}"
                  target="_blank"
                  rel="noopener noreferrer"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                <span>{{ st.button_2_text }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none" aria-hidden="true">
                  <path d="M1 1L6 6L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>

          {%- if st.note != blank -%}
            <div class="u-ews-banner__note">
              {{ st.note }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #u-ews-banner-{{ sid }} {
    background: #fff;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__inner {
    padding-left: 0;
    padding-right: 0;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__media {
    position: relative;
    overflow: hidden;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__image {
    display: block;
    width: 100%;
    height: auto;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__image--mobile {
    display: none;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__content {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 500px;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__eyebrow {
    color: #E0004D;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    margin-bottom: 15px;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__heading {
    margin: 0;
    color: #111;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: 0;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__desc {
    margin-top: 18px;
    color: #111;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 400;
    width: 58%;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__btn {
    min-width: 150px;
    height: 44px;
    padding: 0 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    font-size: 14px;
    line-height: 1;
    font-weight: 500;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__btn--primary {
    background: #000;
    color: #fff;
    border: 1px solid #000;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__btn--secondary {
    background: transparent;
    color: #111;
    border: 1px solid #9b9b9b;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__btn:hover {
    opacity: 0.9;
  }

  #u-ews-banner-{{ sid }} .u-ews-banner__note {
    position: absolute;
    left: 0;
    bottom: -120px;
    width: 520px;
    color: #666;
    font-size: 12px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    #u-ews-banner-{{ sid }} .u-ews-banner__inner {
      max-width: 100%;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__image--pc {
      display: none;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__image--mobile {
      display: block;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__overlay {
      left: 0;
      right: 0;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__content {
      top: 0px;
      transform: none;
      padding: 0px 30px;
      width: 100%;
      height: 100%;
      padding-top: 20%;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__eyebrow {
      margin-bottom: 12px;
      font-size: 14px;
      line-height: 1.4;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__heading {
      line-height: 1.2;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__desc {
      margin-top: 18px;
      font-size: 20px;
      line-height: 1.5;
      width: 90%;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__actions {
      gap: 20px;
      margin-top: 25px;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__btn {
      min-width: 128px;
      height: 40px;
      padding: 0 18px;
      font-size: 12px;
    }

    #u-ews-banner-{{ sid }} .u-ews-banner__note {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 20px;
      width: auto;
      font-size: 10px;
      line-height: 1.2;
      padding: 0px 0px;
      width: 90%;
      color: rgba(0, 0, 0, 0.70);
    }
  }
</style>

{% schema %}
{
  "name": "u-ews-banner",
  "tag": "section",
  "class": "section section-u-ews-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "PC image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ulike有償延長保証サービス"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "最大５年まで延長"
    },
    {
      "type": "html",
      "id": "desc",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 text",
      "default": "購入はこちら"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 text",
      "default": "登録はこちら"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "※サービスの詳しい内容は「有償延長保証サービス」のページまでご確認いただけます。"
    }
  ],
  "presets": [
    {
      "name": "u-ews-banner"
    }
  ]
}
{% endschema %}