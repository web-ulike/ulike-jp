{{ 'compare-product-new.css' | asset_url | stylesheet_tag }}
<script src="{{ 'compare-product-new.js' | asset_url }}" defer></script>

<compare-product-new class="compare-product" data-section-id="{{ section.id }}">
  {% if section.settings.title != blank %}
    <h2 class="compare-top-title">{{ section.settings.title | escape }}</h2>
  {% endif %}
  <div id="selectContainer-{{ section.id }}" class="compare-select-container" data-select-container></div>
  <div class="compare-product-details" data-product-details></div>
  <div class="compare-table" data-compare-table></div>
  <script type="application/json" data-compare-data>
    {
      "swatches": {{ settings.color_swatch_config | json }},
      "products": [
        {%- assign product_blocks = section.blocks | where: 'type', 'product-item' -%}
        {%- for block in product_blocks -%}
          {%- assign product = block.settings.product -%}
          {
            "sort": {{ forloop.index }},
            "id": {{ product.id | json }},
            "title": {{ product.title | json }},
            "price": {{ product.price | money | json }},
            "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %},
            "buttonText": {{ block.settings.btn_txt | json }},
            "link": {{ block.settings.link | json }},
            "variants": [
              {%- for variant in product.variants -%}
                {%- assign variant_image = variant.featured_image | default: product.featured_image -%}
                {
                  "color": {{ variant.option1 | json }},
                  "image": {% if variant_image %}{{ variant_image | image_url: width: 600 | json }}{% else %}null{% endif %}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "groups": [
        {%- assign comparison_blocks = section.blocks | where: 'type', 'item' -%}
        {%- for block in comparison_blocks -%}
          {
            "title": {{ block.settings.title | json }},
            "sort": {{ block.settings.sort | json }},
            "fields": [
              {%- for i in (0..5) -%}
                {%- assign suffix = i -%}
                {%- if i == 0 -%}{%- assign suffix = '' -%}{%- endif -%}
                {%- assign image_key = 'image' | append: suffix -%}
                {%- assign text_key = 'text' | append: suffix -%}
                {
                  "image": {% if block.settings[image_key] %}{{ block.settings[image_key] | image_url: width: 240 | json }}{% else %}null{% endif %},
                  "text": {{ block.settings[text_key] | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</compare-product-new>

{% schema %}
{
  "name": "compare-product-new",
  "class": "compare-product-new",
  "settings": [
    {
      "type": "header",
      "content": "Compare Product Test"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Compare Ulike Models"
    }
  ],
  "blocks": [
    {
      "type": "product-item",
      "name": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "btn_txt",
          "label": "Button Text",
          "default": "Buy Now"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Button Link",
          "default": "/collections/all"
        }
      ]
    },
    {
      "type": "item",
      "name": "Product Item",
      "settings": [
        { "type": "header", "content": "小模块", "info": "11" },
        { "type": "html", "id": "title", "label": "Title" },
        { "type": "number", "id": "sort", "label": "Sort" },
        { "type": "image_picker", "id": "image", "label": "Main Image" },
        { "type": "richtext", "id": "text", "label": "Desc" },
        { "type": "image_picker", "id": "image1", "label": "Image 1" },
        { "type": "richtext", "id": "text1", "label": "Desc 1" },
        { "type": "image_picker", "id": "image2", "label": "Image 2" },
        { "type": "richtext", "id": "text2", "label": "Desc 2" },
        { "type": "image_picker", "id": "image3", "label": "Image 3" },
        { "type": "richtext", "id": "text3", "label": "Desc 3" },
        { "type": "image_picker", "id": "image4", "label": "Image 4" },
        { "type": "richtext", "id": "text4", "label": "Desc 4" },
        { "type": "image_picker", "id": "image5", "label": "Image 5" },
        { "type": "richtext", "id": "text5", "label": "Desc 5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "compare-product-new",
      "blocks": []
    }
  ]
}
{% endschema %}
