<style>
  .IPL-no1 {
    background: #f9f9f9;
    padding: 60px 80px;
  }

  .IPL-no1 .IPL-no1-cont {
    display: flex;
    gap: 20px;
    align-items: flex-end;
    justify-content: space-between;
    position: relative;
    padding-bottom: 100px;
  }

  .IPL-no1 .IPL-no1-left {
    max-width: 370px;
    position: relative;
  }

  .IPL-no1 .ipl-logo {
    display: block;
    width: 150px;
  }

  .IPL-no1 .IPL-no1-sub {
    font-size: 30px;
    color: #000;
    font-weight: 500;
    line-height: 1.3;
    margin: 10px 0px 10px;
  }

  .IPL-no1 .IPL-no1-color-title {
    font-size: 100px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0);
    line-height: 1;
    background-clip: text;
    background-repeat: no-repeat;
    --deg-num: -76deg;
    background-image: linear-gradient(var(--deg-num), #be0737, #ff5f88);
    background-size: 100% 100%;
    margin-top: 4px;
  }

  .IPL-no1 .IPL-no1-color-title-image {
    display: block;
    width: 100%;
    max-width: 270px;
    margin-top: 4px;
  }

  .IPL-no1 .IPL-no1-color-title-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .IPL-no1 .IPL-no1-right {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .IPL-no1 .IPL-no1-item {
    padding-right: 40px;
    text-align: center;
    color: #000;
    line-height: 1;
    gap: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .IPL-no1 .IPL-no1-item .detail {
    text-align: left;
  }

  .IPL-no1 .IPL-no1-item::after {
    content: '';
    width: 2px;
    height: 50px;
    background-color: #eaeaea;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  .IPL-no1 .IPL-no1-item:last-child {
    padding-right: 0;
    border-right: 0;
  }
  .IPL-no1 .IPL-no1-item:last-child::after {
    display: none;
  }

  .IPL-no1 .IPL-no1-num {
    font-size: 80px;
    font-weight: 600;
    display: flex;
    align-items: center;
    line-height: 110%;
    position: relative;
  }

  .IPL-no1 .IPL-no1-num::after {
    content: '+';
    margin-left: 2px;
    font-size: 50px;
  }

  .IPL-no1 .IPL-no1-num span {
    display: block;
    position: relative;
    padding: 0px;
    font-weight: 500;
    font-size: 70px;
  }

  .IPL-no1 .IPL-no1-p {
    font-size: 26px;
    line-height: 1;
    margin-top: 0px;
  }
  .IPL-no1 .IPL-no1-p span{
    font-size: 14px;
    vertical-align: super;
  }

  .des_ipl-rt {
    color: #b3b3b3;
    font-size: 12px;
    line-height: 1.3;
    position: absolute;
    left: 0;
    bottom: 0;
    width: 400px;
  }

  .des_ipl-rt--mobile {
    display: none;
  }

  @media screen and (max-width: 1440px) {
    .IPL-no1 {
      padding: 40px 40px;
    }

    .IPL-no1 .IPL-no1-color-title {
      font-size: 90px;
    }
    .IPL-no1 .IPL-no1-sub {
      font-size: 24px;
    }
    .IPL-no1 .icon-image {
      width: 60px;
    }

    .IPL-no1 .IPL-no1-p {
      font-size: 20px;
    }
  }

  @media (max-width: 1200px) {
    .IPL-no1 .IPL-no1-sub {
      font-size: 18px;
    }

    .IPL-no1 .IPL-no1-color-title {
      font-size: 70px;
    }
    .IPL-no1 .IPL-no1-right {
      gap: 20px;
    }
    .IPL-no1 .IPL-no1-item {
      padding-right: 20px;
    }
  }

  @media (max-width: 991px) {
    .IPL-no1 {
      padding: 50px 0;
    }
    .IPL-no1 .IPL-no1-cont {
      flex-direction: column;
      gap: 30px;
      padding-bottom: 0px;
    }
    .IPL-no1 .IPL-no1-color-title {
      font-size: 65px;
    }
    .IPL-no1 .IPL-no1-color-title-image {
      margin-left: auto;
      margin-right: auto;
      max-width: 200px;
    }
    .IPL-no1 .IPL-no1-left {
      text-align: center;
      padding-bottom: 0;
      max-width: none;
      width: 100%;
    }

    .IPL-no1 .ipl-logo {
      margin: 0 auto;
    }

    .IPL-no1 .IPL-no1-num span {
      padding-right: 20px;
    }

    .IPL-no1 .IPL-no1-num span::before {
      right: 5px;
    }
  }

  @media (max-width: 768px) {
    .IPL-no1 .IPL-no1-right {
      display: block;
      width: 100%;
      padding: 0px 24px;
    }

    .IPL-no1 .IPL-no1-item {
      justify-content: flex-start;
      padding: 20px 0px;
      border-bottom: 1px solid #d9d9d9;
    }
    .IPL-no1 .IPL-no1-item:last-child {
      border-bottom: 0px;
    }
    .IPL-no1 .IPL-no1-item::after {
      display: none;
    }

    .IPL-no1 .IPL-no1-item .icon-image {
      width: 50px;
    }

    .IPL-no1 .IPL-no1-num {
      font-size: 40px;
      font-weight: 400;
      display: inline-flex;
    }
    .IPL-no1 .IPL-no1-num span {
      padding-right: 0px;
      font-size: 36px;
      font-weight: 400;
    }

    .IPL-no1 .IPL-no1-p {
      font-size: 20px;
      font-weight: 500;
      line-height: 130%;
    }
    .IPL-no1-cont-box{
      width:100%;
    }
    .des_ipl-rt {
      padding: 0 24px;
      margin-top: 0px;
      position: static;
      width: 100%;
      display: block;
    }

    .IPL-no1 .IPL-no1-num::after {
      margin-left: 0;
      font-size: 30px;
      position: absolute;
      right: -20px;
      bottom: 0px;
      line-height: 1;
    }
  }
</style>

<section>
  <div class="IPL-no1 to-top">
    <div class="">
      {% comment %} container {% endcomment %}
      <div class="IPL-no1-cont">
        <div class="IPL-no1-left to-top" style="transition-delay: 0.05s">
          {%- if section.settings.image != blank -%}
            <img loading="lazy" class="ipl-logo" {% render 'image-attributes', image: section.settings.image %}>
          {%- endif -%}
          <div class="IPL-no1-sub">{{ section.settings.text }}</div>
          {%- if section.settings.title_image != blank -%}
            <div class="IPL-no1-color-title-image">
              <img loading="lazy" {% render 'image-attributes', image: section.settings.title_image %}>
            </div>
          {%- else -%}
            <div class="IPL-no1-color-title">{{ section.settings.text1 }}</div>
          {%- endif -%}
        </div>
        <div class="IPL-no1-cont-box">
          <div class="IPL-no1-right">
            {%- for block in section.blocks -%}
              <div class="IPL-no1-item to-top" style="transition-delay: 0.{{ forloop.index }}s">
                <div class="icon-image">
                  <img loading="lazy" {% render 'image-attributes', image: block.settings.image %}>
                </div>
                <div class="detail">
                  <div class="IPL-no1-num">
                    {{ block.settings.text }}
                  </div>
                  <div class="IPL-no1-p">{{ block.settings.text2 }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if section.settings.des != blank -%}
          <div class="des_ipl-rt des_ipl-rt--desktop to-top" style="transition-delay: 0.1s">
            {{ section.settings.des }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<script>

  function animateNumbersWhenVisible(elements) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const element = entry.target;
          const start = 0;
          const end = parseInt(element.textContent.match(/\d+/)[0]);
          const duration = Math.max(800, Math.min(2000, Math.abs(end - start) * 20)); // 根据数字的大小调整动画时间，最小1000毫秒，最大4000毫秒
          animateNumber(element, start, end, duration);
          observer.unobserve(element); // 仅触发一次动画后停止观察
        }
      });
    });

    elements.forEach((element) => {
      observer.observe(element);
    });
  }

  function animateNumber(element, start, end, duration) {
    const initialValue = element.textContent;
    let startTime = null;
    const step = (timestamp) => {
      if (!startTime) startTime = timestamp;
      const progress = Math.min((timestamp - startTime) / duration, 1);
      const value = Math.floor(progress * (end - start) + start);
      const newValue = initialValue.replace(/\d+/, value.toString().padStart(initialValue.match(/\d+/)[0].length, '0'));
      element.textContent = newValue;
      if (progress < 1) {
        requestAnimationFrame(step);
      }
    };
    requestAnimationFrame(step);
  }

  document.addEventListener('DOMContentLoaded', function () {
    const numberContainers = document.querySelectorAll('.IPL-no1 .IPL-no1-num span');
    animateNumbersWhenVisible(numberContainers);
  });
</script>
