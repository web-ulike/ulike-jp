{
  "name": "p-IPL-no1",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "text1",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "title_image",
      "label": "Title image"
    },
    {
      "type": "text",
      "id": "des",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "name": "item",
      "type": "item",
      "settings": [
        {
          "type": "html",
          "id": "text",
          "label": "标题"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "icon"
        },
        {
          "type": "html",
          "id": "text2",
          "label": "描述"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "p-IPL-no1"
    }
  ]
}
{% endschema %}
