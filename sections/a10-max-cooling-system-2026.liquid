{% comment %}
  Air 10 Max 2026: cooling-system. PC and mobile share this standalone section.
  Copy and media are configured in the theme editor; typography inherits the theme.
{% endcomment %}

<section id="a10-max-cooling-system-2026-{{ section.id }}" class="a10-2026 a10-2026__cooling a10-2026__system">
<div class="container a10-2026__container">
<div class="a10-2026__inner">
<article class="a10-2026__cooling-row">
<div class="a10-2026__cooling-copy">{% if section.settings.title != blank %}
<h2 class="a10-2026__subtitle to-top" style="transition-delay: 0.1s;">{{ section.settings.title | escape | newline_to_br }}</h2>
{% endif %}
<div class="a10-2026__body a10-2026__desktop to-top" style="transition-delay: 0.2s;">{{ section.settings.description | escape | newline_to_br }}</div>

<div class="a10-2026__body a10-2026__mobile to-top" style="transition-delay: 0.2s;">{{ section.settings.description_mobile | default: section.settings.description | escape | newline_to_br }}</div>

<div class="a10-2026__cooling-chart">{%- assign a10_image = section.settings.chart | default: section.settings.chart_mobile -%}
<picture class="a10-2026__media{% if a10_image == blank %} a10-2026__media--fallback{% endif %}">{% if section.settings.chart_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.chart_mobile | image_url: width: 375 }} 375w, {{ section.settings.chart_mobile | image_url: width: 750 }} 750w, {{ section.settings.chart_mobile | image_url: width: 1100 }} 1100w" sizes="304px">{% else %}<source media="(max-width: 749px)" srcset="{{ 'a10-max-cooling-chart-mobile-2026.jpeg' | asset_url }}">{% endif %}{% if a10_image != blank %}{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}{% else %}<img src="{{ 'a10-max-cooling-chart-mobile-2026.jpeg' | asset_url }}" alt="冷感ヘッドと既存IPL製品の温度比較" loading="lazy" width="609" height="474">{% endif %}</picture></div>
</div>

<div class="a10-2026__cooling-visual">{%- assign a10_image = section.settings.image | default: section.settings.image_mobile -%}
<picture class="a10-2026__media{% if a10_image == blank %} a10-2026__media--fallback{% endif %}">{% if section.settings.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 375 }} 375w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">{% else %}<source media="(max-width: 749px)" srcset="{{ 'a10-max-cooling-diagram-mobile-2026.png' | asset_url }}">{% endif %}{% if a10_image != blank %}{{ a10_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: a10_image.alt }}{% else %}<img src="{{ 'a10-max-cooling-diagram-mobile-2026.png' | asset_url }}" alt="ダブルチャネル放熱機能とVC液体冷却ソリューション" loading="lazy" width="373" height="283">{% endif %}</picture></div>
</article>
{% if section.settings.note != blank %}
<div class="a10-2026__note to-top" style="transition-delay: 0.3s;">{{ section.settings.note | escape | newline_to_br }}</div>
{% endif %}</div>
</div>
</section>

<style>
#a10-max-cooling-system-2026-{{ section.id }} { color: #190a0a;  overflow: hidden; }
#a10-max-cooling-system-2026-{{ section.id }} *, #a10-max-cooling-system-2026-{{ section.id }} *::before, #a10-max-cooling-system-2026-{{ section.id }} *::after { box-sizing: border-box; }
#a10-max-cooling-system-2026-{{ section.id }} h2, #a10-max-cooling-system-2026-{{ section.id }} h3, #a10-max-cooling-system-2026-{{ section.id }} p { margin: 0; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__title { font-size: 40px; line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__subtitle { font-size: 32px; line-height: 1.5; font-weight: 400; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__body { color: #3f3636; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__body p + p { margin-top: 0; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__note { color: rgba(0,0,0,.5); font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__note p { margin: 0; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__media { display: block; min-width: 0; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__media img { display: block; width: 100%; height: auto; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__center { text-align: center; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__mobile { display: none; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__body :is(a, strong, em), #a10-max-cooling-system-2026-{{ section.id }} .a10-2026__note a { color: inherit; }
#a10-max-cooling-system-2026-{{ section.id }} sup { font-size: .645em; line-height: 0; vertical-align: super; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__cooling { padding: 120px 0 140px; background: #fff; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__cooling .a10-2026__title { text-align: center; margin-bottom: 70px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-row { display: grid; grid-template-columns: 1fr 1fr; background: #fafafb; margin-bottom: 20px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy { padding: 100px 65px; align-self: center; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy .a10-2026__body { font-size: 22px; margin-top: 18px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-row:nth-child(odd) .a10-2026__cooling-visual { order: -1; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-visual { display: flex; align-items: center; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-chart { margin-top: 25px; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__cooling .a10-2026__note { margin-top: 60px; max-width: 650px; }
@media (min-width:750px) {
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__media--fallback { display: none; }
}
@media (min-width:750px) and (max-width:1400px) {
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__title { font-size: 32px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__subtitle { font-size: 26px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy { padding: 55px 35px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy .a10-2026__body { font-size: 18px; }
}
@media (max-width:749px) {
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__desktop { display: none !important; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__mobile { display: block; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__title { font-size: 24px; line-height: 1.3; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__subtitle { font-size: 24px; line-height: 1.5; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__body { font-size: 14px; line-height: 1.5; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__note { font-size: 10px; line-height: 1.5; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__cooling { padding: 40px 0 20px; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__cooling .a10-2026__title { font-size: 20px; font-weight: 500; line-height: 1.6; margin: 0 var(--container-gutter) 36px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-row { display: flex; flex-direction: column; background: #f7f8fa; margin: 0; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy { padding: 46px var(--container-gutter) 38px; width: 100%; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy .a10-2026__body { font-size: 14px; margin-top: 22px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-row:nth-child(odd) .a10-2026__cooling-visual { order: initial; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-chart { margin-top: 35px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-visual { width: 100%; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__cooling .a10-2026__note { margin: 30px var(--container-gutter) 0; }
}
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__system { padding-top:0; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__system .a10-2026__cooling-visual { order:initial !important; }
@media(max-width:749px) {
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__system { padding-top:0; }
}

/* Keep short copy inside clipped cards while it enters the viewport. */
@media (prefers-reduced-motion: no-preference) {
#a10-max-cooling-system-2026-{{ section.id }} .to-top:not(.appear) { transform: translateY(20px); }
}

@media (max-width:749px) {
#a10-max-cooling-system-2026-{{ section.id }} > .a10-2026__container { padding-inline: 0; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__system { padding: 0 0 36px; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__inner { width: 100%; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-row { position: relative; display: block; min-height: calc(100vw * 760 / 375); margin: 0; background: #f7f8fa; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy { width: 100%; padding: 50px 20px 0; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy .a10-2026__subtitle { font-size: 24px; line-height: 1.3; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy .a10-2026__body { margin-top: 24px; color: #000; font-size: 14px; line-height: 1.3; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-copy .a10-2026__mobile { width: calc(100% + 14px); }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-chart { position: absolute; top: 188px; left: 50%; width: min(304px, calc(100% - 70px)); margin: 0; transform: translateX(-50%); }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-chart img { width: 100%; height: auto; mix-blend-mode: multiply; }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-visual { position: absolute; top: calc(100vw * 452 / 375); left: 50%; display: block; width: min(373px, 100%); height: auto; transform: translateX(-50%); }
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-visual img { width: 100%; height: auto; mix-blend-mode: multiply; }
#a10-max-cooling-system-2026-{{ section.id }}.a10-2026__cooling .a10-2026__note { max-width: none; margin: 28px 20px 0; font-size: 10px; line-height: 1.5; }
}
@media (max-width:359px) {
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-chart { top: 210px; }
}
@media (max-width:319px) {
#a10-max-cooling-system-2026-{{ section.id }} .a10-2026__cooling-chart { top: 228px; }
}

</style>

{% schema %}
{
  "name": "A10 Max 持续冷却",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 右侧散热系统大图"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "M 散热系统大图"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "冷感、長時間キープ"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "说明文案",
      "default": "Ulike独自の「ダブルチャネル」と「VC液冷システム」が安定した放熱性能を実現し、30分間連続使用しても照射時の肌の表面温度を16℃以下にキープ*4。"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "脚注文案",
      "default": "*1.刺激や痛みの感じ方には個人差と部位差があります。\n*2.日本国内サファイア冷感特許：特許第3226132号、特許第3242510号。\n*3.電源投入後、未照射状態の冷却面の温度を指す。国際認証機関CVCによる試験結果：NO: GJW2024-1748、結果はテスト条件により異なる可能性もあります。\n*4.国際認証機関CVCによる試験結果：NO: GJW2024-1748、結果はテスト条件により異なる可能性もあります。"
    },
    {
      "type": "image_picker",
      "id": "chart",
      "label": "PC 温度对比图"
    },
    {
      "type": "image_picker",
      "id": "chart_mobile",
      "label": "M 温度对比图"
    },
    {
      "type": "textarea",
      "id": "description_mobile",
      "label": "M 说明（留空沿用 PC）",
      "default": "Ulike独自の「ダブルチャネル」と「VC液冷システム」が驚異の放熱効率を実現し、30分間連続使用しても照射時の肌の表面温度を14℃以下にキープ*4。"
    }
  ],
  "presets": [
    {
      "name": "A10 Max 持续冷却"
    }
  ]
}
{% endschema %}
