{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section
  id="pd2026-products-{{ sid }}"
  class="pd2026-products"
  style="
    --pd2026-products-bg: {{ st.background }};
    --pd2026-products-card-bg: {{ st.card_background }};
    --pd2026-products-text: {{ st.text_color }};
    --pd2026-products-accent: {{ st.accent_color }};
  "
>
  <div class="pd2026-products__inner container">
    <div class="pd2026-products__heading to-top">
      {%- if st.heading != blank -%}
        <h2>{{ st.heading }}</h2>
      {%- endif -%}
      {%- if st.description != blank -%}
        <div class="pd2026-products__description to-top" style="transition-delay: 0.2s" >{{ st.description }}</div>
      {%- endif -%}
    </div>

    <div class="pd2026-products__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bs = block.settings
          assign item_product = bs.product
          assign item_image = bs.image
          if item_image == blank and item_product != blank
            assign item_image = item_product.featured_image
          endif
          assign item_title = bs.title
          if item_title == blank and item_product != blank
            assign item_title = item_product.title
          endif
          assign item_url = bs.link
          if item_url == blank and item_product != blank
            assign item_url = item_product.url
          endif
        -%}
        <div class="pd2026-products__card to-top" style="transition-delay: 0.4s" {{ block.shopify_attributes }}>
          <div class="pd2026-products__content">
            {%- if bs.badge != blank -%}
              <div class="pd2026-products__badge">{{ bs.badge }}</div>
            {%- endif -%}

            {%- if item_title != blank -%}
              <h3>{{ item_title }}</h3>
            {%- endif -%}

            {%- if bs.text != blank -%}
              <div class="pd2026-products__text">{{ bs.text }}</div>
            {%- endif -%}

            {%- if item_product != blank and bs.show_price -%}
              <div class="pd2026-products__price">
                {%- render 'product-price', product: item_product, class: 'flex gap-2' -%}
              </div>
            {%- endif -%}

            {%- if bs.note != blank -%}
              <div class="pd2026-products__note">{{ bs.note }}</div>
            {%- endif -%}

            {%- if item_url != blank and bs.link_text != blank -%}
              <a class="pd2026-products__link" href="{{ item_url }}">{{ bs.link_text }}</a>
            {%- endif -%}
          </div>

          <div class="pd2026-products__media">
            {%- if item_image != blank -%}
              {{
                item_image
                | image_url: width: 760
                | image_tag:
                  loading: 'lazy',
                  widths: '320,480,640,760',
                  class: 'pd2026-products__image',
                  alt: item_image.alt
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'pd2026-products__placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if st.disclaimer != blank -%}
      <div class="pd2026-products__disclaimer to-top" style="transition-delay: 0.6s" >{{ st.disclaimer }}</div>
    {%- endif -%}
  </div>
</section>

<style>
  #pd2026-products-{{ sid }} {
    background: #F1F7FB;
    color: var(--pd2026-products-text);
    padding: {{ st.padding_top }}px 0 {{ st.padding_bottom }}px;
  }

  #pd2026-products-{{ sid }} .pd2026-products__heading {
    max-width: 760px;
    margin: 0 auto 80px;
    text-align: center;
  }

  #pd2026-products-{{ sid }} .pd2026-products__heading h2 {
    margin: 0;
    color: #1A1A1A;
    font-size: 45px;
    font-weight: 500;
    line-height: 1.3;
  }

  #pd2026-products-{{ sid }} .pd2026-products__description {
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.3;
    color: #3F3636
  }

  #pd2026-products-{{ sid }} .pd2026-products__description p {
    margin: 0;
  }

  #pd2026-products-{{ sid }} .pd2026-products__grid {
    display: grid;
    grid-template-columns: repeat({{ st.columns }}, minmax(0, 1fr));
    gap: 12px;
  }

  #pd2026-products-{{ sid }} .pd2026-products__card {
    min-height: 280px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 42%;
    align-items: center;
    gap: 10px;
    padding: 30px 65px;
    border-radius: 16px;
    background: var(--pd2026-products-card-bg);
    overflow: hidden;
    border: 2px solid #FFF;
    {% comment %} background: #D4EFFF; {% endcomment %}
  }

  #pd2026-products-{{ sid }} .pd2026-products__card:nth-child(2) {
    padding: 0px 0px 0px 65px;
    grid-template-columns: minmax(0, 1fr) 50%;
  }

  #pd2026-products-{{ sid }} .pd2026-products__content {
    min-width: 0;
  }

  #pd2026-products-{{ sid }} .pd2026-products__badge {
    margin-bottom: 16px;
    color: #E0004D;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
  }

  #pd2026-products-{{ sid }} .pd2026-products__card h3 {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #1A1A1A;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    width: 85%;
  }

  #pd2026-products-{{ sid }} .pd2026-products__card h3::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 0;
    top: 12px;
    width: 126px;
    height: 8px;
    background: #F7D1DC;
  }

  #pd2026-products-{{ sid }} .pd2026-products__text {
    margin-top: 16px;
    font-size: 10px;
    color: #909090;
    line-height: 1.3;
  }

  #pd2026-products-{{ sid }} .pd2026-products__text p {
    margin: 0;
  }

  #pd2026-products-{{ sid }} .pd2026-products__price {
    margin-top: 10px;
    font-size: 14px;
  }

  #pd2026-products-{{ sid }} .pd2026-products__note {
    margin-top: 12px;
    color: rgba(0, 0, 0, .52);
    font-size: 10px;
    line-height: 1.5;
  }

  #pd2026-products-{{ sid }} .pd2026-products__link {
    display: inline-flex;
    margin-top: 12px;
    color: var(--pd2026-products-accent);
    font-size: 12px;
    line-height: 1.2;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #pd2026-products-{{ sid }} .pd2026-products__media {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  #pd2026-products-{{ sid }} .pd2026-products__image,
  #pd2026-products-{{ sid }} .pd2026-products__placeholder-svg {
    display: block;
    width: 100%;
    max-width: 260px;
    height: auto;
  }

  #pd2026-products-{{ sid }} .pd2026-products__card:nth-child(2) .pd2026-products__image{ 
    max-width: 360px;
  }

  #pd2026-products-{{ sid }} .pd2026-products__disclaimer {
    max-width: 820px;
    margin-top: 40px;
    color: rgba(0, 0, 0, .5);
    font-size: 10px;
    line-height: 1.5;
  }

  #pd2026-products-{{ sid }} .pd2026-products__disclaimer p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    #pd2026-products-{{ sid }} .pd2026-products__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 767px) {
    #pd2026-products-{{ sid }} {
      padding: 40px 0 40px;
    }

    #pd2026-products-{{ sid }} .pd2026-products__heading {
      margin-bottom: 30px;
    }

    #pd2026-products-{{ sid }} .pd2026-products__heading h2 {
      font-size: 30px;
    }

    #pd2026-products-{{ sid }} .pd2026-products__description {
      margin-top: 24px;
      color: #1A1A1A;
      font-size: 15px;
      line-height: 1.5;
    }

    #pd2026-products-{{ sid }} .pd2026-products__grid {
      gap: 16px;
    }

    #pd2026-products-{{ sid }} .pd2026-products__card {
      min-height: 136px;
      grid-template-columns: minmax(0, 1fr) 42%;
      gap: 8px;
      padding: 27px 15px;
      border-radius: 5px;
    }

    #pd2026-products-{{ sid }} .pd2026-products__card:nth-child(2) {
      padding: 20px 0px 12px 15px;
    }

    #pd2026-products-{{ sid }} .pd2026-products__badge {
      margin-bottom: 14px;
      font-size: 16px;
      line-height: 1.2;
    }

    #pd2026-products-{{ sid }} .pd2026-products__card h3 {
      width: 100%;
      font-size: 12px;
      line-height: 1.45;
    }

    #pd2026-products-{{ sid }} .pd2026-products__text {
      margin-top: 8px;
      font-size: 9px;
      line-height: 1.4;
    }

    #pd2026-products-{{ sid }} .pd2026-products__note {
      margin-top: 8px;
      font-size: 9px;
    }

    #pd2026-products-{{ sid }} .pd2026-products__image,
    #pd2026-products-{{ sid }} .pd2026-products__placeholder-svg {
      max-width: 128px;
    }

    #pd2026-products-{{ sid }} .pd2026-products__disclaimer {
      margin-top: 28px;
      font-size: 9px;
      line-height: 1.7;
    }

    #pd2026-products-{{ sid }} .pd2026-products__card h3::before {
      top: 8px;
      width: 85px;
      height: 6px;
    }
  }
</style>

{% schema %}
{
  "name": "2026 PD Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "豪華賞品をご用意" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>ご購入者様全員に「ハートミラー」をプレゼント！<br>さらに、毎日先着5名様にアロマストーンセットをプレゼント！</p>" },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer", "default": "<p>キャンペーンの内容・期間は、予告なく変更となる場合がございます。</p>" },
    { "type": "range", "id": "columns", "label": "Columns on PC", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "padding_top", "label": "PC padding top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "PC padding bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "card_radius", "label": "Card radius PC", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "mobile_card_radius", "label": "Card radius mobile", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 8 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#d8f2ff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#e6004f" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product / Prize",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "賞品 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "ご購入者様全員に「ハートミラー」をプレゼント！" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "show_price", "label": "Show product price", "default": false },
        { "type": "text", "id": "note", "label": "Note" },
        { "type": "text", "id": "link_text", "label": "Link text" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "2026 PD Products",
      "blocks": [
        { "type": "product" },
        {
          "type": "product",
          "settings": {
            "badge": "賞品 2",
            "title": "毎日先着5名様にアロマストーンセットをプレゼント！"
          }
        }
      ]
    }
  ]
}
{% endschema %}
