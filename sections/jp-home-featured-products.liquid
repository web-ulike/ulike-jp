        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Home Featured Products",
      "blocks": [
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        }
      ]
    }
  ]
}
{% endschema %}