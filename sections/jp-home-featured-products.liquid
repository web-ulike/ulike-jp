<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionEl = document.querySelector('.jp-home-featured-products--{{ sid }}');
    if (!sectionEl) return;

    let featuredSwiper = null;

    const getVisibleSlides = () => Array.from(sectionEl.querySelectorAll('.jp-home-featured-products__slide:not(.is-hidden)'));

    const syncNavigationState = () => {
      const prevBtn = sectionEl.querySelector('.jp-home-featured-products__nav--prev');
      const nextBtn = sectionEl.querySelector('.jp-home-featured-products__nav--next');
      const footerEl = sectionEl.querySelector('.jp-home-featured-products__footer');
      const slidesCount = getVisibleSlides().length;
      const isDesktop = window.matchMedia('(min-width: 990px)').matches;
      const isTablet = window.matchMedia('(min-width: 768px)').matches && !isDesktop;
      const visibleThreshold = isDesktop ? 3 : (isTablet ? 2 : 1.18);
      const shouldHideSwiperControls = slidesCount <= Math.floor(visibleThreshold);

      if (!prevBtn || !nextBtn) return;

      if (footerEl) {
        footerEl.classList.toggle('is-swiper-hidden', shouldHideSwiperControls);
      }

      if (shouldHideSwiperControls) {
        prevBtn.setAttribute('disabled', 'disabled');
        nextBtn.setAttribute('disabled', 'disabled');
      } else {
        prevBtn.removeAttribute('disabled');
        nextBtn.removeAttribute('disabled');
      }
    };

    const initFeaturedProductsSwiper = () => {
      const swiperEl = sectionEl.querySelector('.jp-home-featured-products__swiper');
      if (!swiperEl) return;

      if (typeof window.Swiper === 'undefined') {
        syncNavigationState();
        return;
      }

      if (featuredSwiper) {
        featuredSwiper.destroy(true, true);
        featuredSwiper = null;
      }

      featuredSwiper = new window.Swiper(swiperEl, {
        slidesPerView: 1.1,
        spaceBetween: 20,
        speed: 700,
        allowTouchMove: true,
        simulateTouch: true,
        followFinger: true,
        slideToClickedSlide: false,
        watchOverflow: true,
        observer: true,
        observeParents: true,
        pagination: {
          el: sectionEl.querySelector('.jp-home-featured-products__progress'),
          type: 'progressbar'
        },
        breakpoints: {
          768: {
            slidesPerView: 2,
            spaceBetween: 20
          },
          990: {
            slidesPerView: 3,
            spaceBetween: 20,
            allowTouchMove: true,
            simulateTouch: true,
            followFinger: true
          }
        },
        on: {
          init() {
            syncNavigationState();
          },
          resize() {
            syncNavigationState();
          },
          breakpoint() {
            syncNavigationState();
          },
          slideChange() {
            syncNavigationState();
          }
        }
      });
    };

    const switchTab = (tabKey) => {
      const triggers = sectionEl.querySelectorAll('[data-tab-trigger]');
      const slides = sectionEl.querySelectorAll('[data-tab-panel]');

      triggers.forEach((trigger) => {
        const isActive = trigger.getAttribute('data-tab-trigger') === tabKey;
        trigger.classList.toggle('is-active', isActive);
        trigger.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      slides.forEach((slide) => {
        const shouldShow = slide.getAttribute('data-tab-panel') === tabKey;
        slide.classList.toggle('is-hidden', !shouldShow);
      });

      initFeaturedProductsSwiper();
      if (featuredSwiper) {
        featuredSwiper.update();
      }
      syncNavigationState();
    };


    const goToPrevSlide = () => {
      if (!featuredSwiper) return;
      featuredSwiper.slidePrev();
      syncNavigationState();
    };

    const goToNextSlide = () => {
      if (!featuredSwiper) return;
      featuredSwiper.slideNext();
      syncNavigationState();
    };

    const bindSlideClickGuard = () => {
      const interactiveEls = sectionEl.querySelectorAll(
        '.jp-home-featured-products__slide a, .jp-home-featured-products__slide button, .jp-home-featured-products__slide form, .jp-home-featured-products__slide product-form'
      );

      interactiveEls.forEach((el) => {
        el.addEventListener('click', (event) => {
          event.stopPropagation();
        }, { capture: true });
      });
    };

    const bindNavButtons = () => {
      const prevBtn = sectionEl.querySelector('.jp-home-featured-products__nav--prev');
      const nextBtn = sectionEl.querySelector('.jp-home-featured-products__nav--next');

      if (prevBtn) {
        prevBtn.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          goToPrevSlide();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          goToNextSlide();
        });
      }
    };

    const bindCartLoading = () => {
      const forms = sectionEl.querySelectorAll('.jp-home-featured-products__cart-form');

      forms.forEach((form) => {
        form.addEventListener('submit', () => {
          const button = form.querySelector('.jp-home-featured-products__btn--cart');
          if (!button || button.disabled) return;

          button.classList.add('loading');
          button.setAttribute('aria-busy', 'true');
          button.setAttribute('data-loading', 'true');
          window.setTimeout(() => {
            button.disabled = true;
          }, 0);

          window.setTimeout(() => {
            button.classList.remove('loading');
            button.removeAttribute('aria-busy');
            button.removeAttribute('data-loading');
            button.disabled = false;
          }, 6000);
        });
      });
    };

    const bindEvents = () => {
      const triggers = sectionEl.querySelectorAll('[data-tab-trigger]');
      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          switchTab(trigger.getAttribute('data-tab-trigger'));
        });
      });

      bindSlideClickGuard();
      bindNavButtons();
      bindCartLoading();
    };

    const init = () => {
      bindEvents();
      switchTab('{{ default_tab_key }}');
    };
    init();
  });
</script>

