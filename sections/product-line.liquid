    }
    @keyframes scanning {
      0% {
        transform: translate(-100%, -100%);
    }
    100% {
        transform: translate(100%, 100%);
    }
    }
    .product-note{
      color: #919191;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
    margin-top: 60px;
    }
