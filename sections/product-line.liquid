      color: #190A0A;
    }
    .product-line .product__slide-list:not(:last-child){
      margin-bottom: var(--product-line-block-gap-desktop, 80px);
    }
    .product__image-wrapper .tag-box{
      font-family: var(--font-sans-family);
      display: flex;
      position: absolute;
      left: 10px;
      top: 10px;
      align-items: center;
      color: #FFF;
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    text-transform: uppercase;
    display: inline-flex;
    padding: 11px 14px;
