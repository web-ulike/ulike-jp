        animation: scanning 3s linear infinite;
    }

   .discount-pri-inner .oriprice {

      font-size: 18px;
  }
  .product-line.blast_friday-2025  .product-note{
  color: #000;
  }
  .blast_friday-2025  .product__content-wrapper h3{
  font-weight:400;
  }
  .discount-pri-inner .price-wrapper {
      margin-bottom: 0px;
  }
    @media (min-width: 768px) and (max-width: 1450px){
    .product__content-wrapper {
        padding: 16px 110px 16px 92px;
    }
    }
    @media (max-width: 992px){
      .product-line h2{
        font-size: 28px;
        margin-bottom: 30px;
      }
    .product-line .product__slide-inner{
      flex-direction: column;
    }
    .product__slide-inner .product__image-wrapper, .product__slide-inner .product__content-wrapper{
      width: 100%;
    }
    .product__slide-inner .product__image-wrapper{
      flex: none;
