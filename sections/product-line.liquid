    }
    .product__content-wrapper .price-wrapper{
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 30px;

    }
    .product__content-wrapper .price-notice{
      margin-bottom: 4px;
      color: #3F3636;
      font-family: var(--font-sans-family);
      font-size: 20px;
      font-style: normal;
      font-weight: 400;
      line-height: 130%;
    }
    .product__content-wrapper .price{
      color:  #E0004D;
      font-size: 32px;
      font-style: normal;
      font-weight: 400;
      line-height: 130%;
    }
    .product__content-wrapper .price-suffix{
      color: #000;
