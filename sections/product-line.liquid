      }
      .discount-pri-inner .price {
        padding-right: 10px;
    }
    .discount-pri-inner .price-wrapper {
        margin-bottom: 0px;
                gap: 0;
    }
    .discount-pri-inner {
        margin-bottom: 13px;
    }
