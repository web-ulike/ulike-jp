</style>
<section class="section-{{ section.id }}-padding">
  <div class="product-line{% if section.settings.custom_class %} {{ section.settings.custom_class }}{% endif %}">
    <div class="container">
      <h2 class="to-top">{{ section.settings.tle }}</h2>

      {%- for block in section.blocks -%}
        <div class="product__slide-list">
          <div class="product__slide">
            <div class="product__slide-inner {% if block.settings.image_position == 'right' %}product__slide-inner_reverse{% endif %}">
              <div class="product__image-wrapper slide-to-right">
                <picture>
                  {%- if block.settings.mb_product_image -%}
                    <source media="(max-width: 767px)" srcset="{{ block.settings.mb_product_image | image_url }}">
                  {%- endif -%}
                  {%- if block.settings.product_image -%}
                    <img
                      src="{{ block.settings.product_image | image_url }}"
                      alt="{{ block.settings.product_image.alt }}"
                    >
                  {%- endif -%}
                </picture>
                {% if block.settings.active_txt != blank or block.settings.active_image  %}
                <div class="tag-box">
                  <div class="tag-txt">{{ block.settings.active_txt }}</div>
                  {%- if block.settings.active_image -%}
                    <img src="{{ block.settings.active_image | image_url }}" alt="" width="16" height="18">
                  {%- endif -%}
                </div>
                  {%- endif -%}
              </div>
              <div class="product__content-wrapper  to-top">
                {%- if block.settings.tag_image -%}
                  <div class="tag-img">
                    <img src="{{ block.settings.tag_image | image_url }}" alt="">
                  </div>
                {%- endif -%}
                 {%- if block.settings.tag_txt != blank -%}
                  <div class="tag-txt-animate">
                   {{  block.settings.tag_txt }}
                  </div>
                {%- endif -%}
                <h3>
                  <a href="{{ block.settings.tle_link_url }}" class="h3-link"> {{ block.settings.tle }} </a>
                </h3>
                <div class="subtitle">{{ block.settings.subtle }}</div>
                <div class="des">
                  {{ block.settings.des }}
                </div>
                {% if block.settings.discount != blank %}
                  <div class="discount-pri-inner">
                {% endif %}
                  {% if block.settings.discount != blank %}
                 <div class="discount-cnt-box">
                   <div class="discount-cnt">{{ block.settings.discount }}</div>
                   <div class="discount-cnt-txt"><span class="discount-cnt1">%</span> <span class="discount-cnt2">OFF</span></div>
                 </div>
                {% endif %}
                {% if block.settings.price_notice_text != blank %}
                  <div class="price-notice">{{ block.settings.price_notice_text }}</div>
                {% endif %}
                <div class="price-wrapper">
                  {% comment %}
                    <div class="price">{{ block.settings.price }}</div>
                    <div class="oriprice">{{ block.settings.ori_price }}</div>
                  {% endcomment %}
                    {% if block.settings.discount_txt != blank %}
                  <div class="discount-pri-txt">{{ block.settings.discount_txt  }}</div>
                {% endif %}
                  {%- liquid
                    assign product = block.settings.product
                    assign compare_price_label = block.settings.compare_price_label | default: '定価'
                  -%}
                  <div class="price">
                    {{ product.price | money }}
                    {%- if block.settings.price_suffix != blank -%}
                      <span class="price-suffix">{{ block.settings.price_suffix }}</span>
                    {%- endif -%}
                  </div>
                  <div class="oriprice">{{ compare_price_label }} {{ product.compare_at_price | money }}{{ block.settings.compare_price_suffix }}</div>
                </div>
                {% if block.settings.discount != blank %}
                  </div>
                {% endif %}
                <div class="btn-wrapper">
                  <!-- <a href="javascript:;" class="btn-link">{{ block.settings.buy_txt }}</a> -->

                  {%- if block.settings.add_bt_txt != blank -%}
                    <div class="product-form-wrapper product-form-wrapper-cus" {{ block.shopify_attributes }}>
                      {%- liquid
                        assign gift_card_recipient_feature_active = false
                        assign product_form_id = 'ProductForm-' | append: block.id
                        assign product = block.settings.product
                        if block.settings.show_gift_card_recipient and product.gift_card?
                          assign gift_card_recipient_feature_active = true
                        endif
                      -%}
                      {%- form 'product',
                        product,
                        id: product_form_id,
                        novalidate: 'novalidate',
                        data-type: 'add-to-cart-form',
                        data-hide-errors: gift_card_recipient_feature_active,
                        class: 'product-form grid gap-8',
                        is: 'product-form'
                      -%}
                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                          disabled
                        >

                        {%- liquid
                          if gift_card_recipient_feature_active
                            render 'gift-card-recipient-form', product: product, form: form, section_id: section_id
                          endif

                          assign check_against_inventory = true
                          if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                            assign check_against_inventory = false
                          endif
                          if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                            assign quantity_rule_soldout = true
                          endif
                        -%}

                        <div class="product-form__buttons grid gap-4">
                          <div
                            class="product-form__error-message alert alert--error text-sm font-medium leading-tight"
                            role="alert"
                            hidden
                          ></div>
                          <div class="flex gap-4">
                            <button
                              type="submit"
                              name="add"
                              form="{{ product_form_id }}"
                              class="product-form__submit button button--secondary button--fixed w-full mt-2"
                              is="hover-button"
                              {%- if product.selected_or_first_available_variant.available == false
                                or quantity_rule_soldout
                              %}
                                disabled
                              {% endif -%}
                              {%- if product.template_suffix == 'pre-order' %}
                                data-pre-order="true"
                              {% endif -%}
                            >
                              <span class="btn-fill" data-fill></span>
                              <span class="btn-text">
                                {%- liquid
                                  if product.selected_or_first_available_variant.available == false or quantity_rule_soldout
                                    echo 'products.product.sold_out' | t
                                  elsif product.template_suffix != 'pre-order'
                                    echo 'products.product.add_to_cart' | t
                                  else
                                    echo 'products.product.pre_order' | t
                                  endif
                                -%}
                              </span>
                            </button>
                          </div>
                        </div>
                      {%- endform -%}
                    </div>
                  {%- endif -%}

                    {% if block.settings.buy_link_url != blank %}

                  <a href="{{ block.settings.buy_link_url }}" class="btn-link btn-buy-now">
                    {{- block.settings.buy_txt -}}
                  </a>
                  {% else if %}
                  <shopify-buy-now 
                    product-id="{{ product.id }}" 
                    variant-id="{{ product.selected_or_first_available_variant.id }}" 
                    button-text="{{ block.settings.buy_txt }}">
                    <button class="custom-buy-btn btn-link btn-buy-now"> {{ block.settings.buy_txt }}</button>
                  </shopify-buy-now>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
      <div class="product-note to-top">
        {{ section.settings.note }}
      </div>
    </div>
  </div>
</section>
<script></script>
{% schema %}
{
  "name": "product line",
  "class": "shopify-section--product-line",
  "settings": [
     {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "tle",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "richtext",
          "id": "active_txt",
          "label": "Active Text"
        },
        {
          "type": "image_picker",
          "id": "active_image",
          "label": "Active Images"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Desktop image position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },

        {
          "type": "select",
          "id": "tle_position",
          "label": "Mobile Txt position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Images"
        },
        {
          "type": "image_picker",
          "id": "mb_product_image",
          "label": "Mobile Product Images"
        },
        {
          "type": "image_picker",
          "id": "tag_image",
          "label": "Tag Images"
        },
         {
          "type": "text",
          "id": "tag_txt",
          "label": "Tag Text"
        },
        {
          "type": "text",
          "id": "tle",
          "label": "Title"
        },
                {
          "type": "url",
          "id": "tle_link_url",
          "label": "Product Link"
        },
        {
          "type": "text",
          "id": "subtle",
          "label": "subTitle"
        },
        {
          "type": "richtext",
          "id": "des",
          "label": "Descripte"
        },
          {
          "type": "text",
          "id": "discount",
          "label": "Discount"
        },
        {
          "type": "text",
          "id": "discount_txt",
          "label": "Discount Text"
