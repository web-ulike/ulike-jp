      font-size: 24px;
    }
  }
  .product-line.valentine-sale-2026 .discount-pri-inner .price-wrapper {
    display: grid;
    width: 100%;
    grid-template-columns: max-content max-content;
    align-items: baseline;
    column-gap: 12px;
    row-gap: 3px;
  }
  .product-line.valentine-sale-2026 .discount-pri-inner .discount-pri-txt {
    grid-column: 1 / -1;
  }
  @media (min-width: 993px) {
    .product-line.valentine-sale-2026 .discount-pri-inner .discount-pri-txt {
      font-size: 20px;
