    }
    .product__content-wrapper .oriprice{
      font-family: var(--font-sans-family);
      color:  #3F3636;
      font-size: 20px;
      font-style: normal;
      font-weight: 300;
      line-height: 130%;
      text-decoration: line-through;
    }
    .product__content-wrapper .btn-wrapper{
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .product__content-wrapper .btn-link{
