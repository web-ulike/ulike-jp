{
  "type": "header",
  "name": "Header group",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "message-1": {
          "type": "message",
          "settings": {
            "text": "Discover : The Collection",
            "learn_more_text": "Learn more",
            "title": "The Collection",
            "content": "<p>This collection is the result of years of experience in product design and engineering, driven by a deep focus on detail and material quality. It features thoughtfully selected leather, rich textures, and refined embossing accents.<\/p>",
            "button_text": "Shop"
          }
        }
      },
      "block_order": [
        "message-1"
      ],
      "settings": {
        "announcement_bar_position": "non_sticky",
        "announcement_text_size": "normal",
        "autoplay": true,
        "cycle_speed": 5,
        "background": "#f3ff34",
        "text_color": "#282828",
        "button_background": "#282828",
        "button_text_color": "#ffffff"
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "enable_sticky_header": true,
        "logo": "{{ shop.brand.logo }}",
        "logo_max_width": 95,
        "mobile_logo_max_width": 100,
        "navigation_menu": "main-menu",
        "header_layout": "logo_left_navigation_center",
        "show_icons": true,
        "reduce_desktop_padding": false,
        "show_locale_selector": true,
        "show_country_selector": false,
        "enable_transparent_header": false,
        "transparent_header_text_color": "#ffffff",
        "search_menu": "search"
      }
    }
  },
  "order": [
    "announcement-bar",
    "header"
  ]
}
