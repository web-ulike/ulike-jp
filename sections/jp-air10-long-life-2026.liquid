{%- liquid
  assign section_id = 'jp-air10-long-life-2026-' | append: section.id
-%}

<section id="{{ section_id }}" class="jp-long-life-2026">
  <div class="jp-long-life-2026__inner">
    <div class="jp-long-life-2026__intro">
      <h2 class="jp-long-life-2026__title">{{ section.settings.title | escape }}</h2>
      <div class="jp-long-life-2026__description">{{ section.settings.description }}</div>
    </div>

    <div class="jp-long-life-2026__metrics" aria-label="製品の耐久性とケアコスト">
      <div class="jp-long-life-2026__metric">
        <p class="jp-long-life-2026__metric-value"><span>{{ section.settings.lifetime_value | escape }}</span><small>{{ section.settings.lifetime_unit | escape }}</small></p>
        <p class="jp-long-life-2026__metric-label">{{ section.settings.lifetime_label | escape }}</p>
      </div>
      <div class="jp-long-life-2026__divider"></div>
      <div class="jp-long-life-2026__metric">
        <p class="jp-long-life-2026__metric-value"><span>{{ section.settings.cost_value | escape }}</span><small>{{ section.settings.cost_unit | escape }}</small></p>
        <p class="jp-long-life-2026__metric-label">{{ section.settings.cost_label | escape }}</p>
      </div>
    </div>

    <div class="jp-long-life-2026__image-wrap">
      {% if section.settings.image != blank %}
        <picture>
          {% if section.settings.image_mobile != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
          {% endif %}
          {{ section.settings.image | image_url: width: 2200 | image_tag: class: 'jp-long-life-2026__image', loading: 'lazy', widths: '750, 1200, 1600, 1920, 2200' }}
        </picture>
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'jp-long-life-2026__placeholder' }}
      {% endif %}
    </div>

    {% if section.settings.note != blank %}
      <div class="jp-long-life-2026__note">{{ section.settings.note }}</div>
    {% endif %}
  </div>
</section>

{% style %}
  #{{ section_id }} { background: #fff; }
  #{{ section_id }} .jp-long-life-2026__inner { max-width: 1280px; margin: 0 auto; padding: 120px 40px 76px; }
  #{{ section_id }} .jp-long-life-2026__intro { max-width: 680px; }
  #{{ section_id }} .jp-long-life-2026__title { margin: 0 0 30px; color: #000; font-size: 48px; font-weight: 400; line-height: 1.3; }
  #{{ section_id }} .jp-long-life-2026__description { color: #3f3636; font-size: 21px; line-height: 1.65; }
  #{{ section_id }} .jp-long-life-2026__description p { margin: 0; }
  #{{ section_id }} .jp-long-life-2026__metrics { display: flex; align-items: center; width: fit-content; margin: 65px 0 40px; }
  #{{ section_id }} .jp-long-life-2026__metric { min-width: 165px; text-align: center; }
  #{{ section_id }} .jp-long-life-2026__metric-value, #{{ section_id }} .jp-long-life-2026__metric-label { margin: 0; }
  #{{ section_id }} .jp-long-life-2026__metric-value { color: #e3004f; font-family: Arial, sans-serif; font-size: 50px; font-weight: 400; line-height: 1; white-space: nowrap; }
  #{{ section_id }} .jp-long-life-2026__metric-value small { margin-left: 3px; color: #000; font-family: inherit; font-size: 18px; }
  #{{ section_id }} .jp-long-life-2026__metric-label { margin-top: 12px; color: #000; font-size: 14px; line-height: 1.4; }
  #{{ section_id }} .jp-long-life-2026__divider { width: 1px; height: 60px; margin: 0 28px; background: rgba(0, 0, 0, .45); }
  #{{ section_id }} .jp-long-life-2026__image-wrap { overflow: hidden; width: 100%; }
  #{{ section_id }} .jp-long-life-2026__image-wrap picture, #{{ section_id }} .jp-long-life-2026__image, #{{ section_id }} .jp-long-life-2026__placeholder { display: block; width: 100%; }
  #{{ section_id }} .jp-long-life-2026__image { height: auto; }
  #{{ section_id }} .jp-long-life-2026__placeholder { aspect-ratio: 336 / 298; fill: #eee; }
  #{{ section_id }} .jp-long-life-2026__note { margin-top: 16px; color: rgba(0, 0, 0, .5); font-size: 12px; line-height: 1.6; }
  #{{ section_id }} .jp-long-life-2026__note p { margin: 0; }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .jp-long-life-2026__inner { padding: 54px 19px 31px; }
    #{{ section_id }} .jp-long-life-2026__title { margin-bottom: 24px; font-size: 30px; line-height: 1.3; }
    #{{ section_id }} .jp-long-life-2026__description { font-size: 19px; line-height: 1.52; }
    #{{ section_id }} .jp-long-life-2026__metrics { width: 100%; margin: 32px 0 46px; }
    #{{ section_id }} .jp-long-life-2026__metric { flex: 1; min-width: 0; }
    #{{ section_id }} .jp-long-life-2026__metric-value { font-size: 40px; }
    #{{ section_id }} .jp-long-life-2026__metric-value small { font-size: 15px; }
    #{{ section_id }} .jp-long-life-2026__metric-label { margin-top: 7px; font-size: 12px; }
    #{{ section_id }} .jp-long-life-2026__divider { height: 47px; margin: 0 16px; }
    #{{ section_id }} .jp-long-life-2026__image-wrap { aspect-ratio: 336 / 298; }
    #{{ section_id }} .jp-long-life-2026__image { height: 100%; object-fit: cover; }
    #{{ section_id }} .jp-long-life-2026__note { margin-top: 14px; font-size: 10px; line-height: 1.45; }
  }
{% endstyle %}

{% schema %}
{
  "name": "jp-air10-long-life-2026",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "PC 图片" },
    { "type": "image_picker", "id": "image_mobile", "label": "移动端图片" },
    { "type": "text", "id": "title", "label": "标题", "default": "長く付き合える、納得の一台" },
    { "type": "richtext", "id": "description", "label": "说明文字", "default": "<p>最大90万回*1の長寿命ランプを採用し、毎日のケアを長く支える一台。1回あたりのケアコストは約116円と*2、サロン施術と比べても無理のない使い続けやすさを叶えます。</p>" },
    { "type": "text", "id": "lifetime_value", "label": "寿命数值", "default": "90" },
    { "type": "text", "id": "lifetime_unit", "label": "寿命单位", "default": "万回" },
    { "type": "text", "id": "lifetime_label", "label": "寿命说明", "default": "長寿命ランプ" },
    { "type": "text", "id": "cost_value", "label": "成本数值", "default": "116" },
    { "type": "text", "id": "cost_unit", "label": "成本单位", "default": "円/回" },
    { "type": "text", "id": "cost_label", "label": "成本说明", "default": "自宅でサロン級" },
    { "type": "richtext", "id": "note", "label": "脚注", "default": "<p>*1.当社の耐久性試験結果。最大90万回連続で照射できます。<br>*2.116円の算出根拠：本体価格69,800円 ÷ 最大照射回数90万発 ＝ 約0.078円／発。全身ケア1回あたり約1,500発使用した場合、約116円相当。</p>" }
  ],
  "presets": [{ "name": "jp-air10-long-life-2026" }]
}
{% endschema %}
