{% comment %}
  Section: jp-triple-guarantee
  - PC: left image + right accordion
  - Mobile: title + image + accordion
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section id="jp-triple-guarantee-{{ sid }}" class="jp-triple-guarantee">
  <div class="jp-container jp-triple-guarantee__inner">
    {% if st.heading != blank %}
      <h2 class="jp-triple-guarantee__heading">{{ st.heading }}</h2>
    {% endif %}

    <div class="jp-triple-guarantee__body">
      <div class="jp-triple-guarantee__image-wrap">
        {% if st.image != blank %}
          <img
            class="jp-triple-guarantee__image"
            src="{{ st.image | image_url: width: 1200 }}"
            srcset="
              {{ st.image | image_url: width: 600 }} 600w,
              {{ st.image | image_url: width: 900 }} 900w,
              {{ st.image | image_url: width: 1200 }} 1200w,
              {{ st.image | image_url }} 1600w
            "
            sizes="(max-width: 768px) 100vw, 45vw"
            alt="{{ st.image.alt | default: st.heading | escape }}"
            loading="lazy"
          >
        {% else %}
          <div class="jp-triple-guarantee__placeholder">
            Upload image
          </div>
        {% endif %}
      </div>

      <div class="jp-triple-guarantee__accordion">
        {% for block in section.blocks %}
          {%- liquid
            assign bs = block.settings
            assign is_open = false
          -%}

          <div
            class="jp-triple-guarantee__item{% if is_open %} is-open{% endif %}"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="jp-triple-guarantee__trigger"
              aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
            >
              <span>{{ bs.title }}</span>
              <svg class="jp-triple-guarantee__icon" xmlns="http://www.w3.org/2000/svg" width="26" height="15" viewBox="0 0 26 15" fill="none" aria-hidden="true">
                <path d="M2.35488 -9.92763e-07L12.5909 10.241L22.7169 0.111675L25.0667 2.46326L12.5299 15L10.1802 12.6484L10.2362 12.5926L-9.63953e-06 2.35137L2.35488 -9.92763e-07Z" fill="currentColor"/>
              </svg>
            </button>

            <div class="jp-triple-guarantee__panel">
              <div class="jp-triple-guarantee__panel-inner">
                {% if bs.text != blank %}
                  <div class="jp-triple-guarantee__text">
                    {{ bs.text }}
                  </div>
                {% endif %}

                {% if bs.note != blank %}
                  <div class="jp-triple-guarantee__note">
                    {{ bs.note }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  #jp-triple-guarantee-{{ sid }} {
    background: {{ st.bg_color }};
    padding: {{ st.pc_padding_top }}px 0 {{ st.pc_padding_bottom }}px;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__inner {
    margin: 0 auto;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__heading {
    margin: 0 0 50px;
    text-align: center;
    color: #000;
    font-size: 48px;
    line-height: 1.3;
    font-weight: 500;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__body {
    display: grid;
    grid-template-columns: 48.5% 51.5%;
    align-items: center;
    gap: 70px;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__image-wrap {
    width: 100%;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__placeholder {
    width: 100%;
    min-height: 320px;
    background: #f4f4f4;
    color: #999;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__accordion {
    width: 100%;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__item {
    border-bottom: 1px solid rgba(25, 10, 10, 0.12);
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__item:first-child {
    border-top: none;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__trigger {
    width: 100%;
    padding: 10px 0 5px;
    border: 0;
    background: transparent;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    text-align: left;
    cursor: pointer;
    font-size: 32px;
    line-height: 1.5;
    font-weight: 500;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__icon {
    flex: 0 0 auto;
    width: 26px;
    height: 15px;
    color: #000;
    transition: transform 0.25s ease;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__item.is-open .jp-triple-guarantee__icon {
    transform: rotate(180deg);
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__panel {
    height: var(--collapsed-height, 60px);
    overflow: hidden;
    transition: height 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: height;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__item.is-open .jp-triple-guarantee__panel {
    height: var(--expanded-height, auto);
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__panel-inner {
    padding: 0 28px 20px 0;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__text {
    color: rgba(0, 0, 0, 0.50);;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 400;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__text p {
    margin: 0;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__item:not(.is-open) .jp-triple-guarantee__text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__item:not(.is-open) .jp-triple-guarantee__note {
    display: none;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__note {
    margin-top: 16px;
    color: rgba(25, 10, 10, 0.48);
    font-size: 9px;
    line-height: 1.55;
    font-weight: 400;
  }

  #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__note p {
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    #jp-triple-guarantee-{{ sid }} {
      padding: {{ st.mb_padding_top }}px 0 {{ st.mb_padding_bottom }}px;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__inner {
      max-width: none;
      padding-left: 0;
      padding-right: 0;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__heading {
      margin: 0 16px 28px;
      font-size: 18px;
      line-height: 1.45;
      font-weight: 500;
      text-align: center;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__body {
      display: block;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__image-wrap {
      margin-bottom: 0;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__image {
      width: 100%;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__accordion {
      background: #fff;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__item {
      border-bottom: 1px solid rgba(25, 10, 10, 0.12);
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__trigger {
      padding: 20px 16px 14px;
      font-size: 16px;
      line-height: 1.45;
      font-weight: 500;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__panel-inner {
      padding: 0 16px 20px;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__text {
      font-size: 10px;
      line-height: 1.75;
      color: rgba(25, 10, 10, 0.72);
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__panel {
      --collapsed-height: 35px;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__note {
      margin-top: 14px;
      font-size: 8px;
      line-height: 1.55;
    }

    #jp-triple-guarantee-{{ sid }} .jp-triple-guarantee__placeholder {
      min-height: 220px;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('#jp-triple-guarantee-{{ sid }}');
    if (!section) return;

    const items = Array.from(section.querySelectorAll('.jp-triple-guarantee__item'));

    const getCollapsedHeight = (item) => {
      const panel = item.querySelector('.jp-triple-guarantee__panel');
      if (!panel) return 0;
      const cssValue = getComputedStyle(panel).getPropertyValue('--collapsed-height').trim();
      const parsedValue = parseFloat(cssValue);
      return Number.isFinite(parsedValue) ? parsedValue : 60;
    };

    const setOpenState = (item, shouldOpen, animate = true) => {
      const panel = item.querySelector('.jp-triple-guarantee__panel');
      const trigger = item.querySelector('.jp-triple-guarantee__trigger');
      if (!panel) return;

      const collapsedHeight = getCollapsedHeight(item);
      const fullHeight = panel.scrollHeight;

      panel.style.transition = animate ? '' : 'none';
      panel.style.height = shouldOpen ? fullHeight + 'px' : collapsedHeight + 'px';
      item.classList.toggle('is-open', shouldOpen);
      if (trigger) trigger.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');

      if (!animate) {
        panel.offsetHeight;
        panel.style.transition = '';
      }
    };

    items.forEach((item) => {
      setOpenState(item, item.classList.contains('is-open'), false);
    });

    items.forEach((item) => {
      const trigger = item.querySelector('.jp-triple-guarantee__trigger');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const shouldOpen = !item.classList.contains('is-open');

        requestAnimationFrame(() => {
          items.forEach((otherItem) => {
            setOpenState(otherItem, otherItem === item ? shouldOpen : false, true);
          });
        });
      });
    });

    window.addEventListener('resize', () => {
      items.forEach((item) => {
        setOpenState(item, item.classList.contains('is-open'), false);
      });
    });
  })();
</script>

