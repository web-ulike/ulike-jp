        </div>
      </div>
    </div>
  </div>
</section>

<script>
  window.addEventListener('load', () => {
    const section = document.querySelector('.jp-blog-topics--{{ sid }}');
    if (!section) return;

    const sliderEl = section.querySelector('[data-jp-blog-topics-slider]');
    if (!sliderEl) return;

    let swiper = null;

    const initMobileSlider = () => {
      if (window.innerWidth > 989) {
        if (swiper) {
          swiper.destroy(true, true);
          swiper = null;
        }
        return;
      }

      if (swiper || typeof window.Swiper !== 'function') return;

      swiper = new window.Swiper(sliderEl, {
        slidesPerView: 1,
        spaceBetween: 24,
        loop: true,
        speed: 650,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
      });
    };

    initMobileSlider();
    window.addEventListener('resize', initMobileSlider);
  });
</script>

