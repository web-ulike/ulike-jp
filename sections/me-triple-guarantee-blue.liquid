{% assign sid = section.id %}<section id="me-triple-blue-{{ sid }}" class="me-triple-blue" style="--bg:{{ section.settings.background }}">{% if section.settings.image != blank or section.settings.image_mobile != blank %}{% assign fallback=section.settings.image | default:section.settings.image_mobile %}<picture class="me-triple-blue__media">{% if section.settings.image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.image_mobile | image_url: width:1000 }}">{% endif %}{{ fallback | image_url: width:2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 1920, 2400' }}</picture>{% endif %}<div class="me-triple-blue__copy"><div class="pc">{{ section.settings.title_html }}{{ section.settings.copy_html }}</div><div class="mobile">{{ section.settings.title_html_mobile }}{{ section.settings.copy_html_mobile }}</div>{% if section.settings.badge_image != blank %}{{ section.settings.badge_image | image_url: width:700 | image_tag: class: 'me-triple-blue__badge', loading: 'lazy', widths: '300, 500, 700' }}{% endif %}</div></section><style>#me-triple-blue-{{ sid }}{position:relative;min-height:720px;overflow:hidden;background:var(--bg)}#me-triple-blue-{{ sid }} .me-triple-blue__media{position:absolute;inset:0}#me-triple-blue-{{ sid }} .me-triple-blue__media img{display:block;width:100%;height:100%;object-fit:cover}#me-triple-blue-{{ sid }} .me-triple-blue__copy{position:relative;z-index:1;width:min(420px,30vw);padding-top:175px;margin-left:calc(50% + 45px);color:#111}#me-triple-blue-{{ sid }} h2,#me-triple-blue-{{ sid }} h3{margin:0;font-size:40px;line-height:1.3}#me-triple-blue-{{ sid }} p{margin:24px 0 0;font-size:12px;line-height:1.8}#me-triple-blue-{{ sid }} .me-triple-blue__badge{display:block;width:300px;max-width:100%;margin-top:52px}#me-triple-blue-{{ sid }} .mobile{display:none}@media(max-width:749px){#me-triple-blue-{{ sid }}{display:flex;min-height:0;flex-direction:column}#me-triple-blue-{{ sid }} .me-triple-blue__media{position:relative;height:340px;order:1}#me-triple-blue-{{ sid }} .me-triple-blue__copy{width:auto;padding:28px 16px 40px;margin:0;order:2}#me-triple-blue-{{ sid }} .pc{display:none}#me-triple-blue-{{ sid }} .mobile{display:block}#me-triple-blue-{{ sid }} h2,#me-triple-blue-{{ sid }} h3{font-size:23px}#me-triple-blue-{{ sid }} p{margin-top:13px;font-size:12px;line-height:1.7}#me-triple-blue-{{ sid }} .me-triple-blue__badge{width:260px;margin-top:25px}}
  #me-triple-blue-{{ sid }} .pc > :first-child{margin:0;font-size:40px;font-weight:600;line-height:1.4;letter-spacing:-.035em}#me-triple-blue-{{ sid }} .pc > :not(:first-child){margin:24px 0 0;font-size:14px;line-height:1.65}@media(max-width:749px){#me-triple-blue-{{ sid }} .mobile > :first-child{margin:0;font-size:26px;font-weight:600;line-height:1.4}#me-triple-blue-{{ sid }} .mobile > :not(:first-child){margin:14px 0 0;font-size:12px;line-height:1.7}}
</style>
{% schema %}{"name":"Ulike ME 三重保证模块","settings":[{"type":"image_picker","id":"image","label":"PC 背景图"},{"type":"image_picker","id":"image_mobile","label":"移动端顶部图片"},{"type":"html","id":"title_html","label":"PC 标题（HTML）"},{"type":"html","id":"copy_html","label":"PC 描述（HTML）"},{"type":"html","id":"title_html_mobile","label":"移动端标题（HTML）"},{"type":"html","id":"copy_html_mobile","label":"移动端描述（HTML）"},{"type":"image_picker","id":"badge_image","label":"保证图标图片"},{"type":"color","id":"background","label":"背景","default":"#e7f2ff"}],"presets":[{"name":"Ulike ME 三重保证模块"}]}{% endschema %}
