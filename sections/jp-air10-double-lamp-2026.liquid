{%- liquid
  assign section_id = 'jp-air10-double-lamp-2026-' | append: section.id
  assign default_body = 'さらに「ダブルランプ」搭載で、高出力エネルギーを均一かつ精密に照射し、打ち漏れやムラを大幅に減少。\n従来のケアでは太刀打ちできなかった太くて硬い毛の根元まで強力にアプローチし、再生を効果的に抑制します。'
-%}

<section id="{{ section_id }}" class="jp-double-lamp-2026">
  <div class="jp-double-lamp-2026__background" aria-hidden="true">
    <picture>
      {%- if section.settings.background_image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.background_image_mobile | image_url: width: 1200 }}">
      {%- endif -%}
      {%- if section.settings.background_image != blank -%}
        {{ section.settings.background_image | image_url: width: 3000 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 2200, 3000', class: 'jp-double-lamp-2026__background-image', alt: '' }}
      {%- elsif section.settings.background_image_mobile != blank -%}
        {{ section.settings.background_image_mobile | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 750, 1200', class: 'jp-double-lamp-2026__background-image', alt: '' }}
      {%- endif -%}
    </picture>
  </div>
  <div class="jp-double-lamp-2026__fade" aria-hidden="true"></div>

  <div class="jp-double-lamp-2026__inner">
    <div class="jp-double-lamp-2026__heading to-top">
      <p>{{ section.settings.title | default: 'ダブルランプ' | escape }}</p>
      <span>{{ section.settings.subtitle | default: '搭載' | escape }}</span>
    </div>

    <div class="jp-double-lamp-2026__connector" aria-hidden="true">
      <svg preserveAspectRatio="none" viewBox="0 0 74.5938 498.519" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle opacity="0.4" cx="37.2969" cy="37.2969" r="37.2969" transform="matrix(-1 0 0 1 74.5938 423.925)" fill="white"/>
        <circle cx="37.2969" cy="37.2969" r="36.7969" transform="matrix(-1 0 0 1 74.5938 423.925)" stroke="#95AAC9"/>
        <circle cx="19.9577" cy="19.9577" r="19.9577" transform="matrix(-1 0 0 1 57.2539 441.265)" fill="#95AAC9"/>
        <circle opacity="0.25" cx="21.1474" cy="21.1474" r="21.1474" transform="matrix(-1 0 0 1 58.4462 0)" fill="#FBFAF4"/>
        <circle cx="21.1474" cy="21.1474" r="20.6843" transform="matrix(-1 0 0 1 58.4462 0)" fill="white" stroke="#95AAC9" stroke-width="0.926215"/>
        <circle cx="11.316" cy="11.316" r="11.316" transform="matrix(-1 0 0 1 48.6124 10.1705)" fill="#95AAC9"/>
        <path d="M37.7969 44.3431L37.7969 422.728" stroke="#95AAC9" stroke-dasharray="3 3"/>
      </svg>
    </div>

    <div class="jp-double-lamp-2026__body to-top" style="transition-delay: .1s">{{ section.settings.body | default: default_body | escape | newline_to_br }}</div>
  </div>
</section>

<style>
  #{{ section_id }} { background: #eef1f8; color: #000; overflow: hidden; position: relative; }
  #{{ section_id }} * { box-sizing: border-box; }
  #{{ section_id }} .jp-double-lamp-2026__background, #{{ section_id }} .jp-double-lamp-2026__background picture { display: block; pointer-events: none; position: relative; width: 100%; }
  #{{ section_id }} .jp-double-lamp-2026__background-image { display: block; height: auto; max-width: none; object-fit: initial; width: 100%; }
  #{{ section_id }} .jp-double-lamp-2026__fade { background: linear-gradient(180deg, rgba(246,245,250,0) 0%, #eef1f8 65.517%); bottom: 0; height: 153px; left: 0; position: absolute; width: 100%; }
  #{{ section_id }} .jp-double-lamp-2026__inner { bottom: 0; height: auto; left: 0; margin: 0; max-width: none; position: absolute; right: 0; top: 0; width: 100%; }
  #{{ section_id }} .jp-double-lamp-2026__heading { background: rgba(255,255,255,.02); border-radius: 100px; box-shadow: 0 4px 4px rgba(102,33,8,.1); height: 156px; left: calc(50% - 585px); padding-top: 29px; position: absolute; text-align: center; top: 84px; width: 414px; }
  #{{ section_id }} .jp-double-lamp-2026__heading p { font-family: "Noto Sans JP", sans-serif; font-size: 46px; font-weight: 700; line-height: 1.2; margin: 0; white-space: nowrap; }
  #{{ section_id }} .jp-double-lamp-2026__heading span { display: block; font-family: "Noto Sans JP", sans-serif; font-size: 32px; font-weight: 500; letter-spacing: .1em; line-height: 1.5; margin-top: 4px; }
  #{{ section_id }} .jp-double-lamp-2026__connector { height: 499px; left: 38.18vw; position: absolute; top: 267px; width: 75px; }
  #{{ section_id }} .jp-double-lamp-2026__connector svg { display: block; height: 100%; width: 100%; }
  #{{ section_id }} .jp-double-lamp-2026__body { font-family: "Noto Sans JP", sans-serif; font-size: 24px; font-weight: 400; left: calc(50% + 94px); line-height: 1.5; position: absolute; top: 114px; width: 531px; }
  @media screen and (max-width: 749px) {
    #{{ section_id }} { background: linear-gradient(0deg, #fff 15.69%, #e2e7f1 127.77%); height: 696px; }
    #{{ section_id }} .jp-double-lamp-2026__background, #{{ section_id }} .jp-double-lamp-2026__background picture { height: 696px; overflow: hidden; }
    #{{ section_id }} .jp-double-lamp-2026__background-image { height: 696px; left: 50%; max-width: none; position: absolute; transform: translateX(-50%); width: 656px; }
    #{{ section_id }} .jp-double-lamp-2026__fade { height: 53px; left: 50%; transform: translateX(-50%); width: 656px; }
    #{{ section_id }} .jp-double-lamp-2026__inner { height: 696px; max-width: none; width: 100%; }
    #{{ section_id }} .jp-double-lamp-2026__heading { border-radius: 60px; box-shadow: 0 2.4px 2.4px rgba(102,33,8,.1); height: 94px; left: 50%; padding-top: 18px; top: 272px; transform: translateX(-50%); width: 250px; }
    #{{ section_id }} .jp-double-lamp-2026__heading p { font-size: 26px; }
    #{{ section_id }} .jp-double-lamp-2026__heading span { font-size: 19px; margin-top: 2px; }
    #{{ section_id }} .jp-double-lamp-2026__connector { height: 170px; left: 108px; top: 370px; width: 27px; }
    #{{ section_id }} .jp-double-lamp-2026__body { font-size: 18px; left: 18px; line-height: 1.5; top: 65px; width: calc(100% - 36px); }
  }
</style>

{% schema %}
{
  "name": "jp-air10-double-lamp-2026",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "PC 背景图片" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "M 背景图片" },
    { "type": "text", "id": "title", "label": "标题", "default": "ダブルランプ" },
    { "type": "text", "id": "subtitle", "label": "副标题", "default": "搭載" },
    { "type": "textarea", "id": "body", "label": "说明文案", "default": "さらに「ダブルランプ」搭載で、高出力エネルギーを均一かつ精密に照射し、打ち漏れやムラを大幅に減少。\n従来のケアでは太刀打ちできなかった太くて硬い毛の根元まで強力にアプローチし、再生を効果的に抑制します。" }
  ],
  "presets": [{ "name": "jp-air10-double-lamp-2026" }]
}
{% endschema %}
