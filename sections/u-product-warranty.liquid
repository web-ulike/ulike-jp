<script>
  (() => {
    const root = document.getElementById('u-ewr-{{ sid }}');
    if (!root) return;

    // 表单与弹窗等核心节点缓存
    const form = root.querySelector('.u-ewr__form');
    const successModal = root.querySelector('[data-ewr-success]');
    const successCloseEls = root.querySelectorAll('[data-ewr-success-close]');
    const orderQueryTip = root.querySelector('[data-ewr-order-query-tip]');
    const orderQueryError = root.querySelector('[data-ewr-order-query-error]');
    const submitErrorEl = root.querySelector('[data-ewr-submit-error]');
    const serviceEmailInput = form.querySelector('input[name="userEmail"]');
    const serviceOrderInput = form.querySelector('input[name="orderNo"]');

    const siteCode = (root.getAttribute('data-site-code') || 'JP').trim().toUpperCase();
    const merchantCode = (root.getAttribute('data-merchant-code') || 'ULIKE').trim().toUpperCase();

    const serviceYearVariantMap = {
      '42869728641072': '1_year',
      '42869728673840': '2_year',
      '42869728706608': '3_year'
    };

    // 订单查询状态：避免重复请求与并发请求
    let orderQueryKey = '';
    let orderQueryLoading = false;

    // 当前已选择并上传成功的文件列表
    let uploadedFiles = [];
    let uploadLoadingCount = 0;
    const maxFiles = 5;
    const maxSize = 10 * 1024 * 1024;

    // 根据字段名获取表单项
    function getInputByName(name) {
      return form.querySelector('[name="' + name + '"]');
    }

    function getFieldValue(name) {
      const input = getInputByName(name);
      return input ? input.value || '' : '';
    }

    // 上传相关节点与限制配置
    const uploadInput = root.querySelector('.u-ewr__upload-input');
    const uploadSection = root.querySelector('[data-ewr-upload-section]');
    const uploadList = root.querySelector('[data-upload-list]');
    const uploadError = root.querySelector('[data-upload-error]');
    const snField = root.querySelector('[data-ewr-sn-field]');

    // 关闭所有自定义下拉，仅保留当前操作的下拉
    function closeAllSelects(except) {
      root.querySelectorAll('[data-ewr-select]').forEach((select) => {
        if (select !== except) {
          select.classList.remove('is-open');
          const trigger = select.querySelector('.u-ewr-select__trigger');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // 単項目バリデーション：必須とメール形式チェック（カスタム phone 対応）
    function validateField(field) {
      if (!field) return true;

      let input = field.querySelector('input[data-required="true"], textarea[data-required="true"], select[data-required="true"]');

      if (!input) {
        input = field.querySelector('input[name="userPhone"], textarea[name="userPhone"], select[name="userPhone"]');
      }

      if (!input) {
        input = field.querySelector('input, textarea, select');
      }

      if (!input) return true;

      const errorEl = field.querySelector('.u-ewr__error:not(.u-ewr__error--upload), .pr-form__error');
      if (errorEl && !errorEl.hasAttribute('data-default-text')) {
        errorEl.setAttribute('data-default-text', errorEl.textContent || '');
      }
      if (errorEl && errorEl.hasAttribute('data-default-text')) {
        errorEl.textContent = errorEl.getAttribute('data-default-text') || '';
      }

      const required = input.dataset.required === 'true' || input.name === 'userPhone';
      const type = input.dataset.type || input.type;
      const value = (input.value || '').trim();

      let valid = true;

      if (required && !value) {
        valid = false;
      }

      if (valid && type === 'email' && value) {
        valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      }

      field.classList.toggle('is-error', !valid);

      const prField = field.querySelector('.pr-form__field');
      if (prField) {
        prField.classList.toggle('has-error', !valid);
      }

      return valid;
    }

    // 同步输入框填写态，用于浮动标签样式切换
    function syncFieldFilledState(field) {
      if (!field) return;
      const input = field.querySelector('input, textarea, select');
      if (!input) return;

      const value = (input.value || '').trim();
      field.classList.toggle('is-filled', !!value);
    }

    // 设置订单查询成功/进行中的提示文案
    function setOrderQueryTip(message) {
      if (!orderQueryTip) return;
      orderQueryTip.textContent = message || '';
      orderQueryTip.classList.toggle('is-show', !!message);
    }

    // 设置订单查询失败提示文案
    function setOrderQueryError(message) {
      if (!orderQueryError) return;
      orderQueryError.textContent = message || '';
      orderQueryError.classList.toggle('is-show', !!message);
    }

    // 设置上传区域错误提示
    function setUploadError(message) {
      if (!uploadError) return;

      if (!message) {
        uploadError.textContent = '';
        uploadError.classList.remove('is-show');
        return;
      }

      uploadError.textContent = message;
      uploadError.classList.add('is-show');
    }

    function setSubmitError(message) {
      if (!submitErrorEl) return;
      submitErrorEl.textContent = message || '';
      submitErrorEl.classList.toggle('is-show', !!message);
    }

    // フィールドエラーメッセージを設定（カスタム phone 対応）
    function setFieldErrorMessage(name, message) {
      const input = getInputByName(name);
      if (!input) return;

      const field = input.closest('.u-ewr__field');
      if (!field) return;

      const errorEl = field.querySelector('.u-ewr__error:not(.u-ewr__error--upload), .pr-form__error');
      if (errorEl && !errorEl.hasAttribute('data-default-text')) {
        errorEl.setAttribute('data-default-text', errorEl.textContent || '');
      }
      if (errorEl) {
        errorEl.textContent = message || '';
      }

      field.classList.add('is-error');
      const prField = field.querySelector('.pr-form__field');
      if (prField) {
        prField.classList.add('has-error');
      }
    }

    function clearFieldErrorMessage(name) {
      const input = getInputByName(name);
      if (!input) return;

      const field = input.closest('.u-ewr__field');
      if (!field) return;

      const errorEl = field.querySelector('.u-ewr__error:not(.u-ewr__error--upload), .pr-form__error');
      if (errorEl && errorEl.hasAttribute('data-default-text')) {
        errorEl.textContent = errorEl.getAttribute('data-default-text') || '';
      }

      field.classList.remove('is-error');
      const prField = field.querySelector('.pr-form__field');
      if (prField) {
        prField.classList.remove('has-error');
      }
    }

    // 通用回填方法：设置值、清除错误态、刷新填写态
    function setInputValue(name, value) {
      const input = getInputByName(name);
      if (!input) return;

      input.value = value == null ? '' : value;

      const field = input.closest('.u-ewr__field');
      if (field) field.classList.remove('is-error');
      syncFieldFilledState(field);
    }

    function setSelectValue(name, value) {
      const input = getInputByName(name);
      if (!input) return;

      const select = input.closest('[data-ewr-select]');
      const field = input.closest('.u-ewr__field');
      if (!select) {
        setInputValue(name, value);
        return;
      }

      const option = select.querySelector('.u-ewr-select__option[data-value="' + value + '"]');
      const label = select.querySelector('[data-ewr-select-label]');

      if (!option) {
        input.value = '';
        if (label) label.textContent = '{{ st.select_placeholder | escape }}';
      } else {
        input.value = value == null ? '' : value;
        if (label) {
          label.textContent = option.getAttribute('data-label') || option.textContent.trim();
        }
      }

      if (field) field.classList.remove('is-error');
      syncFieldFilledState(field);
    }

    function getServiceYearValueFromOrder(orderData) {
      if (!orderData || !orderData.lineItems || !Array.isArray(orderData.lineItems.edges)) return '';

      for (const edge of orderData.lineItems.edges) {
        const variant = edge && edge.node && edge.node.variant;
        if (!variant) continue;

        const variantId = variant.longId
          ? String(variant.longId)
          : String((variant.id || '')).replace('gid://shopify/ProductVariant/', '');

        if (variantId && serviceYearVariantMap[variantId]) {
          return serviceYearVariantMap[variantId];
        }
      }

      return '';
    }

    function shouldHideUploadByChannel() {
      const channelInput = getInputByName('orderChannel');
      const value = channelInput ? (channelInput.value || '').trim() : '';
      return value === 'Shopify' || value === 'Amazon';
    }

    function syncUploadSectionVisibility() {
      const hideUpload = shouldHideUploadByChannel();

      if (uploadSection) {
        uploadSection.hidden = hideUpload;
      }

      if (snField) {
        snField.hidden = false;
      }

      if (hideUpload) {
        setUploadError('');
      }
    }

    // 初始化自定义下拉：打开、选择、回填 hidden input 与显示文案
    root.querySelectorAll('[data-ewr-select]').forEach((select) => {
      const trigger = select.querySelector('.u-ewr-select__trigger');
      const hiddenInput = select.querySelector('input[type="hidden"]');
      const label = select.querySelector('[data-ewr-select-label]');
      const options = select.querySelectorAll('.u-ewr-select__option');

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = select.classList.contains('is-open');
        closeAllSelects(select);
        select.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });

      options.forEach((option) => {
        option.addEventListener('click', () => {
          const value = option.getAttribute('data-value') || '';
          const text = option.getAttribute('data-label') || option.textContent.trim();

          hiddenInput.value = value;
          label.textContent = text;

          select.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');

          const field = hiddenInput.closest('.u-ewr__field');
          if (field) field.classList.remove('is-error');
          syncFieldFilledState(field);

          if (hiddenInput.name === 'orderChannel') {
            syncUploadSectionVisibility();
          }
        });
      });
    });

    // 点击空白区域时关闭下拉
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) return;
      const inSelect = e.target.closest('[data-ewr-select]');
      if (!inSelect) closeAllSelects();
    });

    // 将订单接口返回的数据自动回填到表单
    function fillOrderAddress(orderData) {
      if (!orderData) return;

      const shippingAddress = orderData.shippingAddress || {};
      const firstName = shippingAddress.firstName || '';
      const lastName = shippingAddress.lastName || '';
      const fullName = [firstName, lastName].filter(Boolean).join(' ').trim();

      if (fullName) setInputValue('customerName', fullName);
      setInputValue('userPhone', orderData.phone || shippingAddress.phone || '');
      setInputValue('shippingZip', shippingAddress.zip || '');
      setInputValue('shippingProvince', shippingAddress.province || '');
      setInputValue('shippingCity', shippingAddress.city || '');
      setInputValue('shippingAddress1', shippingAddress.address1 || '');
      setInputValue('shippingAddress2', shippingAddress.address2 || '');
      {% comment %} setInputValue('orderNo', orderData.name || ''); {% endcomment %}

      if (orderData.createdAt) {
        const createdAt = new Date(orderData.createdAt);
        if (!isNaN(createdAt.getTime())) {
          const year = createdAt.getFullYear();
          const month = String(createdAt.getMonth() + 1).padStart(2, '0');
          const day = String(createdAt.getDate()).padStart(2, '0');
          setInputValue('serviceOrderDate', year + '-' + month + '-' + day);
        }
      }

      const serviceYearValue = getServiceYearValueFromOrder(orderData);
      if (serviceYearValue) {
        setSelectValue('serviceYear', serviceYearValue);
      }
    }
    function createUploadAddElement() {
      const uploadAdd = document.createElement('label');
      uploadAdd.className = 'u-ewr__upload-add';
      uploadAdd.setAttribute('for', 'u-ewr-upload-{{ sid }}');
      uploadAdd.innerHTML = `{%- if st.upload_icon != blank -%}
                      <img
                        src="{{ st.upload_icon | image_url: width: 120 }}"
                        alt=""
                        loading="lazy"
                        width="60"
                        height="60"
                      >
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="30" height="24" viewBox="0 0 30 24" fill="none">
                        <path d="M28.8082 6.33764C28.8082 4.80103 27.656 3.64882 26.1194 3.64882H21.7023V2.68882C21.7023 1.15221 20.5501 0 19.0134 0H9.98697C8.45087 0 7.29815 1.15221 7.29815 2.68882V3.64933H2.68882C1.15221 3.64933 0 4.80154 0 6.33815V21.1262C0 22.6628 1.15221 23.815 2.68882 23.815H17.0929C17.8612 23.815 18.2451 23.6233 18.2451 22.855C18.2451 22.0867 17.669 21.8945 17.0929 21.8945H3.26492C2.49662 22.0867 1.92051 21.3184 1.92051 20.7423V6.52985C1.92051 5.76154 2.49662 5.18544 3.26492 5.18544H9.02646V3.07323C9.02646 2.30492 9.60256 1.72882 10.3709 1.72882H19.0134C19.7817 1.72882 20.3578 2.30492 20.3578 3.07323V5.18544H25.9277C26.696 5.18544 27.2721 5.76154 27.2721 6.52985V12.8675C27.2721 13.4436 27.6565 14.0197 28.2326 14.0197C29.0009 14.0197 29.1926 13.6353 29.1926 12.8675L28.8082 6.33764Z" fill="black"/>
                      </svg>
                    {%- endif -%}`;
      return uploadAdd;
    }

    // 根据邮箱 + 订单号查询订单信息，并自动填充表单
    async function queryCustomerOrder() {
      const email = serviceEmailInput ? serviceEmailInput.value.trim() : '';
      const orderNo = serviceOrderInput ? serviceOrderInput.value.trim() : '';

      setOrderQueryError('');
      setSubmitError('');

      if (!email || !orderNo) {
        setOrderQueryTip('');
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setOrderQueryTip('');
        return;
      }

      const nextKey = email + '::' + orderNo;
      if (orderQueryLoading || orderQueryKey === nextKey) return;

      orderQueryLoading = true;
      orderQueryKey = nextKey;
      setOrderQueryTip('注文情報を照会中です...');

      try {
        const response = await window.UlikeCommon.sendUlikeApi('/user/queryCustomerOrder', {
          merchantCode: merchantCode,
          siteCode: siteCode,
          orderNo: orderNo,
          userEmail: email,
        });

        if (!response || response.code !== 0 || !response.data) {
          throw new Error((response && response.message) || '注文情報の照会に失敗しました');
        }

        fillOrderAddress(response.data);
        setOrderQueryTip('注文情報を自動入力しました。');
      } catch (error) {
        orderQueryKey = '';
        setOrderQueryTip('');
        setOrderQueryError('{{ st.query_order_error_text | escape }}');
        console.error('注文情報の照会に失敗しました:', error);
      } finally {
        orderQueryLoading = false;
      }
    }

    // 监听表单输入，实时更新填写态与错误态
    form.querySelectorAll('.u-ewr__field').forEach((field) => {
      const input = field.querySelector('input');
      if (!input) return;

      syncFieldFilledState(field);

      input.addEventListener('input', () => {
        syncFieldFilledState(field);
        if (field.classList.contains('is-error')) validateField(field);
      });

      input.addEventListener('change', () => {
        syncFieldFilledState(field);
        if (field.classList.contains('is-error')) validateField(field);
      });

      input.addEventListener('blur', () => {
        syncFieldFilledState(field);
      });
    });

    // 邮箱与订单号变化后，自动触发订单查询
    [serviceEmailInput, serviceOrderInput].forEach((input) => {
      if (!input) return;

      input.addEventListener('blur', () => {
        queryCustomerOrder();
      });

      input.addEventListener('change', () => {
        queryCustomerOrder();
      });

      input.addEventListener('input', () => {
        orderQueryKey = '';
        setOrderQueryTip('');
        setOrderQueryError('');
      });
    });

    syncUploadSectionVisibility();

    // 同步提交按钮状态：上传中或提交中时禁用按钮
    function setSubmitButtonState(disabled, text) {
      const submitBtn = form.querySelector('.u-ewr__submit');
      if (!submitBtn) return;
      submitBtn.disabled = !!disabled;
      if (text != null) submitBtn.textContent = text;
    }

    // 直传文件到签名地址
    async function putUploadFile(file, uploadUrl) {
      const response = await fetch(uploadUrl, {
        method: 'PUT',
        body: file,
        headers: {
          'Content-Type': file.type || 'application/octet-stream',
        },
      });

      if (!response.ok) {
        throw new Error('Upload failed: ' + response.status);
      }
    }

    // 单文件上传：先换取签名地址，再上传文件，最后保留 fileKey 用于提交
    async function uploadSingleFile(file) {
      const signRes = await window.UlikeCommon.sendUlikeApi('/user/uploadSign', {
        scene: 'APPLY_WARRANTY',
        fileName: file.name,
        contentType: file.type || 'application/octet-stream',
        size: file.size,
      });

      if (!signRes || !signRes.data || !signRes.data.uploadUrl || !signRes.data.fileKey) {
        throw new Error('Missing uploadUrl or fileKey');
      }

      await putUploadFile(file, signRes.data.uploadUrl);

      return {
        file: file,
        name: file.name,
        type: file.type,
        size: file.size,
        fileKey: signRes.data.fileKey,
        previewUrl: file.type && file.type.indexOf('image/') === 0 ? URL.createObjectURL(file) : '',
      };
    }

    function renderUploads() {
      if (!uploadList) return;

      uploadList.innerHTML = '';
      uploadList.classList.toggle('is-empty', uploadedFiles.length === 0);

      uploadedFiles.forEach((item, index) => {
        const file = item.file;
        const uploadItem = document.createElement('div');
        uploadItem.className = 'u-ewr__upload-item';

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'u-ewr__upload-remove';
        removeBtn.textContent = '×';
        removeBtn.addEventListener('click', () => {
          const removed = uploadedFiles[index];
          if (removed && removed.previewUrl) URL.revokeObjectURL(removed.previewUrl);
          uploadedFiles.splice(index, 1);
          renderUploads();
          if (!uploadedFiles.length) setUploadError('');
        });

        if (item.previewUrl) {
          const img = document.createElement('img');
          img.className = 'u-ewr__upload-thumb';
          img.alt = item.name;
          img.src = item.previewUrl;
          uploadItem.appendChild(img);
        } else {
          const fileBox = document.createElement('div');
          fileBox.className = 'u-ewr__upload-file';
          fileBox.textContent = item.name || (file ? file.name : 'File');
          uploadItem.appendChild(fileBox);
        }

        uploadItem.appendChild(removeBtn);
        uploadList.appendChild(uploadItem);
      });

      uploadList.appendChild(createUploadAddElement());
    }

    // 处理文件选择：数量与大小校验
    if (uploadInput) {
      uploadInput.addEventListener('change', async (e) => {
        const files = Array.from(e.target.files || []);
        if (!files.length) return;

        e.target.value = '';

        if (uploadedFiles.length + files.length > maxFiles) {
          setUploadError('{{ st.upload_limit_error | escape }}');
          return;
        }

        for (const file of files) {
          if (file.size > maxSize) {
            setUploadError('{{ st.upload_size_error | escape }}'.replace('[name]', file.name));
            return;
          }
        }

        setUploadError('');
        setSubmitError('');
        uploadLoadingCount += files.length;
        setSubmitButtonState(true, '{{ st.submitting_text | escape }}');

        try {
          for (const file of files) {
            const uploaded = await uploadSingleFile(file);
            uploadedFiles.push(uploaded);
            renderUploads();
          }
        } catch (error) {
          console.error('Upload proof file failed:', error);
          setUploadError('{{ st.submit_fail_text | escape }}');
        } finally {
          uploadLoadingCount = Math.max(0, uploadLoadingCount - files.length);
          if (uploadLoadingCount === 0) {
            const submitBtn = form.querySelector('.u-ewr__submit');
            const submitText = submitBtn
              ? submitBtn.getAttribute('data-default-text') || '{{ st.submit_text | escape }}'
              : '{{ st.submit_text | escape }}';
            setSubmitButtonState(false, submitText);
          }
        }
      });
      renderUploads();
    }

    function collectFormData() {
      const userPhoneE164 = getFieldValue('userPhone_e164').trim();
      const userPhoneDialCode = getFieldValue('userPhone_dial_code').trim();
      const userPhoneRaw = getFieldValue('userPhone').trim();
      const userPhone = userPhoneDialCode && userPhoneRaw ? userPhoneDialCode + '-' + userPhoneRaw : '';

      return {
        merchantCode: merchantCode,
        siteCode: siteCode,
        userEmail: getFieldValue('userEmail'),
        firstName: getFieldValue('customerName'),
        lastName: 'jp',
        userPhone: userPhone,
        orderChannel: getFieldValue('orderChannel'),
        productTitle: getFieldValue('productTitle'),
        orderNo: getFieldValue('serviceOrderNo'),
        productSn: getFieldValue('productSn'),
        fileKeyList: uploadedFiles.map((item) => item.fileKey).filter(Boolean),
        extend: {
          shippingAddress: {
            address1: getFieldValue('shippingAddress1'),
            address2: getFieldValue('shippingAddress2'),
            city: getFieldValue('shippingCity'),
            province: getFieldValue('shippingProvince'),
            zip: getFieldValue('shippingZip'),
          },
          serviceInfo: {
            orderDate: getFieldValue('orderNo'),
            serviceOrderDate: getFieldValue('serviceOrderDate'),
            year: getFieldValue('serviceYear')
          },
        },
      };
    }

    // 打开提交成功弹窗
    function openSuccess() {
      if (!successModal) return;
      successModal.hidden = false;
      document.documentElement.classList.add('overflow-hidden');
      document.body.classList.add('overflow-hidden');
    }

    // 关闭提交成功弹窗
    function closeSuccess() {
      if (!successModal) return;
      successModal.hidden = true;
      document.documentElement.classList.remove('overflow-hidden');
      document.body.classList.remove('overflow-hidden');
    }

    // 绑定弹窗关闭事件
    successCloseEls.forEach((el) => {
      el.addEventListener('click', closeSuccess);
    });

    async function handleSubmit(payload) {
      const response = await window.UlikeCommon.sendUlikeApi('/user/submitWarrantyApply', payload);

      if (!response || response.code !== 0) {
        const submitError = new Error((response && response.message) || 'Submit failed');
        submitError.code = response && response.code;
        submitError.response = response;
        throw submitError;
      }

      return response;
    }

    // 表单提交主流程：校验、提交、重置、成功反馈
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setSubmitError('');

      if (uploadLoadingCount > 0) {
        setUploadError('ファイルをアップロード中です。しばらくしてから再度お試しください。');
        return;
      }

      let valid = true;
      const fields = form.querySelectorAll('.u-ewr__field');

      // 逐项校验表单字段
      fields.forEach((field) => {
        if (!validateField(field)) valid = false;
      });

      // 上传文件按购买渠道决定是否必填
      if (shouldHideUploadByChannel()) {
        setUploadError('');
      } else if (!uploadedFiles.length) {
        setUploadError('{{ st.upload_required_error | escape }}');
        valid = false;
      } else {
        setUploadError('');
      }

      if (!valid) {
        scrollToFirstError();
        return;
      }

      const submitBtn = form.querySelector('.u-ewr__submit');
      const originalText = submitBtn.getAttribute('data-default-text') || submitBtn.textContent;
      submitBtn.setAttribute('data-default-text', originalText);

      try {
        setSubmitButtonState(true, '{{ st.submitting_text | escape }}');

        clearFieldErrorMessage('orderNo');
        clearFieldErrorMessage('serviceOrderNo');
        clearFieldErrorMessage('productSn');
        clearFieldErrorMessage('userPhone');
        const payload = collectFormData();
        console.log('Submit payload:', payload);
        await handleSubmit(payload);

        form.reset();
        uploadedFiles.forEach((item) => {
          if (item && item.previewUrl) URL.revokeObjectURL(item.previewUrl);
        });
        uploadedFiles = [];
        renderUploads();
        setUploadError('');
        setOrderQueryTip('');
        setOrderQueryError('');
        setSubmitError('');

        root.querySelectorAll('[data-ewr-select]').forEach((select) => {
          const hidden = select.querySelector('input[type="hidden"]');
          const label = select.querySelector('[data-ewr-select-label]');
          if (hidden) hidden.value = '';
          if (label) label.textContent = '{{ st.select_placeholder | escape }}';
        });
        syncUploadSectionVisibility();

        form.querySelectorAll('.u-ewr__field').forEach((field) => {
          field.classList.remove('is-error');
          field.classList.remove('is-filled');
        });
        openSuccess();
      } catch (error) {
        const responseCode = error && (error.code != null ? String(error.code) : '');
        const responseMessage = error && error.message ? String(error.message) : '';

        clearFieldErrorMessage('serviceOrderNo');
        clearFieldErrorMessage('productSn');
        clearFieldErrorMessage('userPhone');

        if (responseCode === '99998') {
          if (responseMessage === 'user_sys_order_no_invalid') {
            setFieldErrorMessage('serviceOrderNo', '有効な注文番号を入力してください。');
            setSubmitError('');
            console.error(error);
            return;
          }

          if (responseMessage === 'user_sys_order_no_exist') {
            setFieldErrorMessage('serviceOrderNo', 'その注文番号は既に申請済みです。');
            setSubmitError('');
            console.error(error);
            return;
          }

          if (responseMessage === 'user_sys_product_sn_invalid') {
            setFieldErrorMessage('productSn', '有効なシリアルナンバーを入力してください。');
            setSubmitError('');
            console.error(error);
            return;
          }

          if (responseMessage === 'user_sys_order_status_invalid') {
            setFieldErrorMessage('serviceOrderNo', 'この注文はすでに保証申請済みです。再度ご提出しないでください。');
            setSubmitError('');
            console.error(error);
            return;
          }

          if (responseMessage === 'user_sys_order_expired') {
            setFieldErrorMessage('serviceOrderNo', 'この注文は登録可能期間を過ぎています。');
            setSubmitError('');
            console.error(error);
            return;
          }
        }

        setSubmitError('送信に失敗しました。しばらくしてから再度お試しください。');
        console.error(error);
      } finally {
        setSubmitButtonState(false, originalText);
      }
    });


       function scrollToFirstError() {
      const firstErrorField = form.querySelector('.u-ewr__field.is-error');
      const firstPhoneError = form.querySelector('.pr-form__field.has-error');
      const uploadHasError = uploadError && uploadError.classList.contains('is-show') && uploadSection && !uploadSection.hidden;

      let target = firstErrorField;

      if (!target && firstPhoneError) {
        target = firstPhoneError.closest('.u-ewr__field') || firstPhoneError;
      }

      if (!target && uploadHasError) {
        target = uploadSection;
      }

      if (!target) return;

      const rect = target.getBoundingClientRect();
      const absoluteTop = window.pageYOffset + rect.top;
      const offsetTop = Math.max(absoluteTop - 120, 0);

      window.scrollTo({
        top: offsetTop,
        behavior: 'smooth'
      });

      const focusInput = target.querySelector('input:not([type="hidden"]), textarea, select, button');
      if (focusInput && typeof focusInput.focus === 'function') {
        focusInput.focus({ preventScroll: true });
      }
    }

  })();



</script>

