                          <path d="M39.195 42.0024H57.486C58.6057 42.0024 59.7254 42.7486 59.7254 43.8683V44.2419C59.7254 45.3616 58.6057 46.1087 57.486 46.1087H39.195C38.0753 46.1087 36.9556 45.3616 36.9556 44.2419V43.8683C36.9546 42.7496 38.0743 42.0024 39.195 42.0024Z" fill="black"/>
                        </g>
                        <defs>
                          <clipPath id="clip0_1_454">
                            <rect width="59.7711" height="59.7711" fill="white"/>
                          </clipPath>
                        </defs>
                      </svg>
                    {%- endif -%}
                  </label>
                </div>

                <div class="u-ewr__upload-text">
                  {{ st.upload_text }}
                </div>
              </div>

              <p class="u-ewr__error u-ewr__error--upload" data-upload-error></p>
            </div>
          </div>

          <div class="u-ewr__actions">
            <button type="submit" class="u-ewr__submit">
              {{ st.submit_text }}
            </button>
          </div>

          <p class="u-ewr__submit-error" data-ewr-submit-error></p>

          <div class="u-ewr__footnotes">
            <div>{{ st.footnote_1 }}</div>
            <div>{{ st.footnote_2 }}</div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="u-ewr-modal" data-ewr-success hidden>
    <div class="u-ewr-modal__overlay" data-ewr-success-close></div>

    <div class="u-ewr-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="u-ewr-success-title-{{ sid }}">
      <button type="button" class="u-ewr-modal__close" data-ewr-success-close aria-label="Close">×</button>

      <div class="u-ewr-modal__icon">
        {%- if st.success_icon != blank -%}
          <img
            src="{{ st.success_icon | image_url: width: 120 }}"
            alt=""
            loading="lazy"
            width="60"
            height="60"
          >
        {%- else -%}
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="24" fill="#59C36A"/>
            <path d="M22 32L29 39L42 24" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </div>

      <h3 id="u-ewr-success-title-{{ sid }}" class="u-ewr-modal__title">
        {{ st.success_title }}
      </h3>

      <div class="u-ewr-modal__desc">
        {{ st.success_desc }}
      </div>

      <div class="u-ewr-modal__subdesc">
        {{ st.success_subdesc }}
      </div>
    </div>
  </div>
</section>

<style>
  #u-ewr-{{ sid }}{
    --ewr-bg: {{ st.page_bg }};
    --ewr-text: {{ st.text_color }};
    --ewr-muted: {{ st.muted_color }};
    --ewr-line: {{ st.line_color }};
    --ewr-tab-bg: {{ st.tab_bg }};
    --ewr-tab-active-bg: {{ st.tab_active_bg }};
    --ewr-tab-active-text: {{ st.tab_active_text }};
    --ewr-btn-bg: {{ st.button_bg }};
    --ewr-btn-text: {{ st.button_text }};
    --ewr-error: #D92D20;
    --ewr-modal-border: #191919;

    background: var(--ewr-bg);
    color: var(--ewr-text);
    padding: 40px 20px 60px;
  }

  #u-ewr-{{ sid }} *{
    box-sizing: border-box;
  }

  #u-ewr-{{ sid }} .u-ewr__container{
    margin: 0 auto;
  }

  #u-ewr-{{ sid }} .u-ewr__page-note{
    font-size: 14px;
    line-height: 1.7;
    color: var(--ewr-muted);
    margin-bottom: 26px;
  }

  #u-ewr-{{ sid }} .u-ewr__panel{
    display: none;
  }

  #u-ewr-{{ sid }} .u-ewr__panel.is-active{
    display: block;
  }

  #u-ewr-{{ sid }} .u-ewr__group + .u-ewr__group{
    margin-top: 54px;
  }

  #u-ewr-{{ sid }} .u-ewr__group-title{
    margin: 0 0 26px;
    font-size: 34px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0;
  }

  #u-ewr-{{ sid }} .u-ewr__grid{
    display: grid;
    gap: 20px 30px;
  }

  #u-ewr-{{ sid }} .u-ewr__grid--2{
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #u-ewr-{{ sid }} .u-ewr__field{
    position: relative;
  }

  #u-ewr-{{ sid }} .u-ewr__field .pr-form__group{
    margin: 0;
  }

  #u-ewr-{{ sid }} .u-ewr__field .pr-form__label{
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 10px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: .02em;
    color: #7A7A7A;
  }

  #u-ewr-{{ sid }} .u-ewr__field .pr-form__field{
    position: relative;
  }

  #u-ewr-{{ sid }} .u-ewr__field .pr-form__error{
    display: none;
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ewr-error);
  }

  #u-ewr-{{ sid }} .u-ewr__field .pr-form__field.has-error .pr-form__error{
    display: block;
  }

  #u-ewr-{{ sid }} .u-ewr__field--full{
    grid-column: 1 / -1;
  }

  #u-ewr-{{ sid }} .u-ewr__label{
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 10px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: .02em;
    color: #7A7A7A;
  }

  #u-ewr-{{ sid }} .u-ewr__label--floating{
    position: absolute;
    left: 0;
    top: 17px;
    z-index: 2;
    margin: 0;
    pointer-events: none;
    transform-origin: left top;
    transition: top .2s ease, transform .2s ease, color .2s ease;
  }

  #u-ewr-{{ sid }} .u-ewr__required{
    color: #E5484D;
  }

  #u-ewr-{{ sid }} .u-ewr__input,
  #u-ewr-{{ sid }} .u-ewr-select__trigger{
    width: 100%;
    height: 52px;
    border: 0;
    border-bottom: 1px solid var(--ewr-line);
    border-radius: 0;
    background: transparent;
    color: var(--ewr-text);
    font-size: 24px;
    line-height: 1.2;
    padding: 18px 0 10px;
    outline: none;
  }

  #u-ewr-{{ sid }} .u-ewr__input::placeholder{
    color: #9B9B9B;
  }

