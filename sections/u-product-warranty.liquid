{% comment %}
  Section: u-extended-warranty-register
  Notes:
  - New independent section for extended warranty registration
  - Includes:
    1) register form
    2) success popup
    3) query tab placeholder (currently unsupported)
  - API submit is placeholder now, replace handleSubmit() as needed
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section
  id="u-ewr-{{ sid }}"
  class="u-ewr"
  data-section-id="{{ sid }}"
  data-enable-query="{{ st.enable_query }}"
  data-site-code="{{ st.site_code | escape }}"
  data-merchant-code="{{ st.merchant_code | escape }}"
>
  <div class="u-ewr__container container">
    {%- if st.show_page_note -%}
      <div class="u-ewr__page-note">
        {{ st.page_note }}
      </div>
    {%- endif -%}

    <div class="u-ewr__tab-panels">
      <div class="u-ewr__panel is-active" data-ewr-panel="register" style="display:block;">
        <form class="u-ewr__form" novalidate>
          <div class="u-ewr__group">
            <h3 class="u-ewr__group-title">{{ st.service_info_title }}</h3>

            <div class="u-ewr__grid u-ewr__grid--2">
              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.service_email_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="email"
                  name="userEmail"
                  placeholder=" "
                  data-required="true"
                  data-type="email"
                >
                <p class="u-ewr__error">{{ st.error_email }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.service_order_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="orderNo"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">注文番号を入力してください。</p>
                <p class="u-ewr__query-tip" data-ewr-order-query-tip></p>
                <p class="u-ewr__query-tip u-ewr__query-tip--error" data-ewr-order-query-error></p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label">
                  {{ st.service_year_label }}
                  <span class="u-ewr__required">*</span>
                </label>

                <div class="u-ewr-select" data-ewr-select>
                  <input type="hidden" name="serviceYear" data-required="true">
                  <button type="button" class="u-ewr-select__trigger" aria-expanded="false">
                    <span data-ewr-select-label>{{ st.select_placeholder }}</span>
                    <span class="u-ewr-select__arrow">
                      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </button>

                  <div class="u-ewr-select__menu">
                    <ul class="u-ewr-select__list">
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'service_year' -%}
                          <li
                            class="u-ewr-select__option"
                            data-value="{{ block.settings.value | escape }}"
                            data-label="{{ block.settings.label | escape }}"
                            {{ block.shopify_attributes }}
                          >
                            {{ block.settings.label }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>

                <p class="u-ewr__error">購入年数を選択してください。</p>
              </div>

              <div class="u-ewr__field is-filled">
                <label class="u-ewr__label ">
                  {{ st.service_date_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="date"
                  name="serviceOrderDate"
                  placeholder=" "
                  data-required="true"
                  max="{{ 'now' | date: '%Y-%m-%d' }}"
                >
                <p class="u-ewr__error">注文日時を選択してください。</p>
              </div>
            </div>
          </div>

          <div class="u-ewr__group">
            <h3 class="u-ewr__group-title">{{ st.customer_info_title }}</h3>

            <div class="u-ewr__grid u-ewr__grid--2">
              <div class="u-ewr__field">
                <label class="u-ewr__label ">
                  {{ st.customer_name_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="customerName"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">氏名を入力してください。</p>
              </div>

              <div class="u-ewr__field">
                {% render 'u-pr-phone-input',
                  section_id: section.id,
                  input_name: 'userPhone',
                  label_text: st.customer_phone_label,
                  placeholder_text: 'Enter Your Phone Number',
                  error_text: '電話番号を入力してください。',
                  default_country: 'jp',
                  default_dial: '+81'
                %}
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_zip_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="shippingZip"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">郵便番号を入力してください。</p>
              </div>

              <div class="u-ewr__field u-ewr__field--placeholder u-ewr__field--desktop-only"></div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_prefecture_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="shippingProvince"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">都道府県を入力してください。</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_city_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="shippingCity"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">市区町村を入力してください。</p>
              </div>

              <div class="u-ewr__field u-ewr__field--full">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_address1_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="shippingAddress1"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">住所1を入力してください。</p>
              </div>

              <div class="u-ewr__field u-ewr__field--full">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_address2_label }}
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="shippingAddress2"
                  placeholder=" "
                >
              </div>
            </div>
          </div>

          <div class="u-ewr__group">
            <h3 class="u-ewr__group-title">{{ st.product_info_title }}</h3>

            <div class="u-ewr__grid u-ewr__grid--2">
              <div class="u-ewr__field">
                <label class="u-ewr__label">
                  {{ st.channel_label }}
                  <span class="u-ewr__required">*</span>
                </label>

                <div class="u-ewr-select" data-ewr-select>
                  <input type="hidden" name="orderChannel" data-required="true">
                  <button type="button" class="u-ewr-select__trigger" aria-expanded="false">
                    <span data-ewr-select-label>{{ st.select_placeholder }}</span>
                    <span class="u-ewr-select__arrow">
                      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </button>

                  <div class="u-ewr-select__menu">
                    <ul class="u-ewr-select__list">
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'channel' -%}
                          <li
                            class="u-ewr-select__option"
                            data-value="{{ block.settings.value | escape }}"
                            data-label="{{ block.settings.label | escape }}"
                            {{ block.shopify_attributes }}
                          >
                            {{ block.settings.label }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>

                <p class="u-ewr__error">購入サイトを選択してください。</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label">
                  {{ st.model_label }}
                  <span class="u-ewr__required">*</span>
                </label>

                <div class="u-ewr-select" data-ewr-select>
                  <input type="hidden" name="productTitle" data-required="true">
                  <button type="button" class="u-ewr-select__trigger" aria-expanded="false">
                    <span data-ewr-select-label>{{ st.select_placeholder }}</span>
                    <span class="u-ewr-select__arrow">
                      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </button>

                  <div class="u-ewr-select__menu">
                    <ul class="u-ewr-select__list">
                      <li class="u-ewr-select__option" data-value="Air 10" data-label="Air 10">Air 10</li>
                      <li class="u-ewr-select__option" data-value="Air Pro S" data-label="Air Pro S">Air Pro S</li>
                      <li class="u-ewr-select__option" data-value="Ulike X Plus" data-label="Ulike X Plus">Ulike X Plus</li>
                      <li class="u-ewr-select__option" data-value="Ulike Men" data-label="Ulike Men">Ulike Men</li>
                      <li class="u-ewr-select__option" data-value="Air Pro" data-label="Air Pro">Air Pro</li>
                      <li class="u-ewr-select__option" data-value="Air 3" data-label="Air 3">Air 3</li>
                      <li class="u-ewr-select__option" data-value="Air 2" data-label="Air 2">Air 2</li>
                      <li class="u-ewr-select__option" data-value="Air10 Max" data-label="Air10 Max">Air10 Max</li>
                      <li class="u-ewr-select__option" data-value="Ulike X Max" data-label="Ulike X Max">Ulike X Max</li>
                      <li class="u-ewr-select__option" data-value="Air Rose" data-label="Air Rose">Air Rose</li>
                      <li class="u-ewr-select__option" data-value="Ulike X (オフライン版)" data-label="Ulike X (オフライン版)">Ulike X (オフライン版)</li>
                      <li class="u-ewr-select__option" data-value="Air 10 Pro (オフライン版)" data-label="Air 10 Pro (オフライン版)">Air 10 Pro (オフライン版)</li>
                    </ul>
                  </div>
                </div>

                <p class="u-ewr__error">購入モデルを選択してください。</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.product_order_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="serviceOrderNo"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">注文番号を入力してください。</p>
              </div>

              <div class="u-ewr__field" data-ewr-sn-field>
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.serial_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="productSn"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">シリアルナンバーを入力してください。</p>
              </div>
            </div>

            <div class="u-ewr__sn-note">
              {{ st.serial_note }}
            </div>

            <div class="u-ewr__upload" data-ewr-upload-section>
              <input
                id="u-ewr-upload-{{ sid }}"
                class="u-ewr__upload-input"
                type="file"
                name="proof_files"
                multiple
                accept="image/*,.pdf"
              >

              <div class="u-ewr__upload-box" data-upload-box>
                <div class="u-ewr__upload-list" data-upload-list>
                  <label class="u-ewr__upload-add" for="u-ewr-upload-{{ sid }}">
                    {%- if st.upload_icon != blank -%}
                      <img
                        src="{{ st.upload_icon | image_url: width: 120 }}"
                        alt=""
                        loading="lazy"
                        width="60"
                        height="60"
                      >
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60" fill="none">
                        <g clip-path="url(#clip0_1_454)">
                          <path d="M22.77 29.3112H24.6369C24.6369 27.4454 26.1302 25.5785 27.996 25.5785V23.7117C25.0104 23.7127 22.77 26.3247 22.77 29.3112Z" fill="black"/>
                          <path d="M27.9956 16.6196C21.2763 16.6196 15.6777 22.2192 15.6777 29.311C15.6777 36.4039 21.2773 42.0024 27.9956 42.0024C29.8624 42.0024 31.7283 41.6289 33.2216 40.8827C37.3278 39.0159 40.3144 34.537 40.3144 29.6846V29.311C40.3144 22.2192 34.7148 16.6196 27.9956 16.6196ZM33.2216 36.4039C31.7283 37.5236 29.8624 38.2707 27.9956 38.2707C23.1431 38.2707 19.4104 34.1644 19.4104 29.312C19.4104 24.4596 23.5167 20.3533 27.9956 20.3533C32.848 20.3533 36.5807 24.4596 36.5807 29.312V29.6856C36.5817 32.2976 35.461 34.9106 33.2216 36.4039Z" fill="black"/>
