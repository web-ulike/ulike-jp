<script>
  (() => {
    const root = document.getElementById('u-ewr-{{ sid }}');
    if (!root) return;

    const form = root.querySelector('.u-ewr__form');
    const successModal = root.querySelector('[data-ewr-success]');
    const successCloseEls = root.querySelectorAll('[data-ewr-success-close]');
    const orderQueryTip = root.querySelector('[data-ewr-order-query-tip]');
    const orderQueryError = root.querySelector('[data-ewr-order-query-error]');
    const serviceEmailInput = form.querySelector('input[name="service_email"]');
    const serviceOrderInput = form.querySelector('input[name="service_order_no"]');

    let orderQueryKey = '';
    let orderQueryLoading = false;

    let uploadedFiles = [];

    function closeAllSelects(except) {
      root.querySelectorAll('[data-ewr-select]').forEach((select) => {
        if (select !== except) {
          select.classList.remove('is-open');
          const trigger = select.querySelector('.u-ewr-select__trigger');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
      });
    }

    root.querySelectorAll('[data-ewr-select]').forEach((select) => {
      const trigger = select.querySelector('.u-ewr-select__trigger');
      const hiddenInput = select.querySelector('input[type="hidden"]');
      const label = select.querySelector('[data-ewr-select-label]');
      const options = select.querySelectorAll('.u-ewr-select__option');

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = select.classList.contains('is-open');
        closeAllSelects(select);
        select.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });

      options.forEach((option) => {
        option.addEventListener('click', () => {
          const value = option.getAttribute('data-value') || '';
          const text = option.getAttribute('data-label') || option.textContent.trim();

          hiddenInput.value = value;
          label.textContent = text;

          select.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');

          const field = hiddenInput.closest('.u-ewr__field');
          if (field) field.classList.remove('is-error');
          syncFieldFilledState(field);
        });
      });
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) return;
      const inSelect = e.target.closest('[data-ewr-select]');
      if (!inSelect) closeAllSelects();
    });

    function validateField(field) {
      const input = field.querySelector('input, textarea, select');
      if (!input) return true;

      const required = input.dataset.required === 'true';
      const type = input.dataset.type;
      let value = '';

      if (input.type === 'hidden') {
        value = (input.value || '').trim();
      } else {
        value = (input.value || '').trim();
      }

      let valid = true;

      if (required && !value) {
        valid = false;
      }

      if (valid && type === 'email' && value) {
        valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      }

      field.classList.toggle('is-error', !valid);
      return valid;
    }

    function syncFieldFilledState(field) {
      if (!field) return;
      const input = field.querySelector('input, textarea, select');
      if (!input) return;

      const value = (input.value || '').trim();
      field.classList.toggle('is-filled', !!value);
    }

    function setOrderQueryTip(message) {
      if (!orderQueryTip) return;
      orderQueryTip.textContent = message || '';
      orderQueryTip.classList.toggle('is-show', !!message);
    }

    function setOrderQueryError(message) {
      if (!orderQueryError) return;
      orderQueryError.textContent = message || '';
      orderQueryError.classList.toggle('is-show', !!message);
    }

    function getInputByName(name) {
      return form.querySelector('[name="' + name + '"]');
    }

    function setInputValue(name, value) {
      const input = getInputByName(name);
      if (!input) return;

      input.value = value == null ? '' : value;

      const field = input.closest('.u-ewr__field');
      if (field) field.classList.remove('is-error');
      syncFieldFilledState(field);
    }

    function fillOrderAddress(orderData) {
      if (!orderData) return;

      const shippingAddress = orderData.shippingAddress || {};
      const firstName = shippingAddress.firstName || '';
      const lastName = shippingAddress.lastName || '';
      const fullName = [firstName, lastName].filter(Boolean).join(' ').trim();

      if (fullName) setInputValue('customer_name', fullName);
      setInputValue('customer_zip', shippingAddress.zip || '');
      setInputValue('customer_prefecture', shippingAddress.province || '');
      setInputValue('customer_city', shippingAddress.city || '');
      setInputValue('customer_address1', shippingAddress.address1 || '');
      setInputValue('customer_address2', shippingAddress.address2 || '');
      setInputValue('product_order_no', orderData.name || '');

      const lineItemEdges = orderData.lineItems && orderData.lineItems.edges ? orderData.lineItems.edges : [];
      const firstLineItem = lineItemEdges.length ? lineItemEdges[0].node : null;
      const variantTitle = firstLineItem && firstLineItem.variant ? firstLineItem.variant.title : '';
      const productTitle = firstLineItem && firstLineItem.variant && firstLineItem.variant.product ? firstLineItem.variant.product.title : '';
      const modelText = variantTitle || productTitle || '';

      if (modelText) {
        const modelInput = getInputByName('product_model');
        const modelSelect = modelInput ? modelInput.closest('[data-ewr-select]') : null;
        const modelLabel = modelSelect ? modelSelect.querySelector('[data-ewr-select-label]') : null;

        if (modelInput) modelInput.value = modelText;
        if (modelLabel) modelLabel.textContent = modelText;
        if (modelInput) syncFieldFilledState(modelInput.closest('.u-ewr__field'));
      }
    }

    async function queryCustomerOrder() {
      const email = serviceEmailInput ? serviceEmailInput.value.trim() : '';
      const orderNo = serviceOrderInput ? serviceOrderInput.value.trim() : '';

      setOrderQueryError('');

      if (!email || !orderNo) {
        setOrderQueryTip('');
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setOrderQueryTip('');
        return;
      }

      const nextKey = email + '::' + orderNo;
      if (orderQueryLoading || orderQueryKey === nextKey) return;

      orderQueryLoading = true;
      orderQueryKey = nextKey;
      setOrderQueryTip('Querying order information...');

      try {
        const response = await window.UlikeCommon.sendUlikeApi('/user/queryCustomerOrder', {
          merchantCode: 'ULIKE',
          siteCode: 'US',
          orderNo: orderNo,
          userEmail: email
        });

        if (!response || response.code !== 0 || !response.data) {
          throw new Error((response && response.message) || 'Order query failed');
        }

        fillOrderAddress(response.data);
        setOrderQueryTip('Order information filled successfully.');
      } catch (error) {
        orderQueryKey = '';
        setOrderQueryTip('');
        setOrderQueryError('{{ st.query_order_error_text | escape }}');
        console.error('Query customer order failed:', error);
      } finally {
        orderQueryLoading = false;
      }
    }

    form.querySelectorAll('.u-ewr__field').forEach((field) => {
      const input = field.querySelector('input');
      if (!input) return;

      syncFieldFilledState(field);

      input.addEventListener('input', () => {
        syncFieldFilledState(field);
        if (field.classList.contains('is-error')) validateField(field);
      });

      input.addEventListener('change', () => {
        syncFieldFilledState(field);
        if (field.classList.contains('is-error')) validateField(field);
      });

      input.addEventListener('blur', () => {
        syncFieldFilledState(field);
      });
    });

    [serviceEmailInput, serviceOrderInput].forEach((input) => {
      if (!input) return;

      input.addEventListener('blur', () => {
        queryCustomerOrder();
      });

      input.addEventListener('change', () => {
        queryCustomerOrder();
      });

      input.addEventListener('input', () => {
        orderQueryKey = '';
        setOrderQueryTip('');
        setOrderQueryError('');
      });
    });

    const uploadInput = root.querySelector('.u-ewr__upload-input');
    const uploadList = root.querySelector('[data-upload-list]');
    const uploadError = root.querySelector('[data-upload-error]');
    const maxFiles = 5;
    const maxSize = 10 * 1024 * 1024;

    function setUploadError(message) {
      if (!message) {
        uploadError.textContent = '';
        uploadError.classList.remove('is-show');
        return;
      }
      uploadError.textContent = message;
      uploadError.classList.add('is-show');
    }

    function renderUploads() {
      uploadList.innerHTML = '';

      uploadedFiles.forEach((file, index) => {
        const item = document.createElement('div');
        item.className = 'u-ewr__upload-item';

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'u-ewr__upload-remove';
        removeBtn.textContent = '×';
        removeBtn.addEventListener('click', () => {
          uploadedFiles.splice(index, 1);
          renderUploads();
        });

        if (file.type && file.type.indexOf('image/') === 0) {
          const img = document.createElement('img');
          img.className = 'u-ewr__upload-thumb';
          img.alt = file.name;
          img.src = URL.createObjectURL(file);
          item.appendChild(img);
        } else {
          const fileBox = document.createElement('div');
          fileBox.className = 'u-ewr__upload-file';
          fileBox.textContent = file.name;
          item.appendChild(fileBox);
        }

        item.appendChild(removeBtn);
        uploadList.appendChild(item);
      });
    }

    if (uploadInput) {
      uploadInput.addEventListener('change', (e) => {
        const files = Array.from(e.target.files || []);

        if (!files.length) return;

        for (const file of files) {
          if (uploadedFiles.length >= maxFiles) {
            setUploadError('{{ st.upload_limit_error | escape }}');
            break;
          }

          if (file.size > maxSize) {
            setUploadError('{{ st.upload_size_error | escape }}'.replace('[name]', file.name));
            continue;
          }

          uploadedFiles.push(file);
        }

        renderUploads();
        e.target.value = '';
      });
    }

    function collectFormData() {
      const data = {};
      form.querySelectorAll('input[name]').forEach((input) => {
        if (input.type === 'file') return;
        data[input.name] = input.value || '';
      });
      data.proof_files = uploadedFiles.map((file) => ({
        name: file.name,
        type: file.type,
        size: file.size
      }));
      return data;
    }

    function openSuccess() {
      if (!successModal) return;
      successModal.hidden = false;
      document.documentElement.classList.add('overflow-hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeSuccess() {
      if (!successModal) return;
      successModal.hidden = true;
      document.documentElement.classList.remove('overflow-hidden');
      document.body.classList.remove('overflow-hidden');
    }

    successCloseEls.forEach((el) => {
      el.addEventListener('click', closeSuccess);
    });

    async function handleSubmit(payload) {
      console.log('Extended warranty submit payload:', payload);

      /*
        Replace here with your real API, for example:

        const formData = new FormData();
        Object.keys(payload).forEach((key) => {
          if (key !== 'proof_files') formData.append(key, payload[key]);
        });
        uploadedFiles.forEach((file) => formData.append('proof_files[]', file));

        const response = await fetch('/apps/xxx/extended-warranty', {
          method: 'POST',
          body: formData
        });

        if (!response.ok) throw new Error('Submit failed');
        return await response.json();
      */

      return new Promise((resolve) => {
        setTimeout(() => resolve({ code: 200 }), 500);
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      let valid = true;
      const fields = form.querySelectorAll('.u-ewr__field');

      fields.forEach((field) => {
        if (!validateField(field)) valid = false;
      });

      if (!uploadedFiles.length) {
        setUploadError('{{ st.upload_required_error | escape }}');
        valid = false;
      } else {
        setUploadError('');
      }

      if (!valid) return;

      const submitBtn = form.querySelector('.u-ewr__submit');
      const originalText = submitBtn.textContent;

      try {
        submitBtn.disabled = true;
        submitBtn.textContent = '{{ st.submitting_text }}';

        const payload = collectFormData();
        await handleSubmit(payload);

        form.reset();
        uploadedFiles = [];
        renderUploads();

        root.querySelectorAll('[data-ewr-select]').forEach((select) => {
          const hidden = select.querySelector('input[type="hidden"]');
          const label = select.querySelector('[data-ewr-select-label]');
          if (hidden) hidden.value = '';
          if (label) label.textContent = '{{ st.select_placeholder | escape }}';
        });

        form.querySelectorAll('.u-ewr__field').forEach((field) => {
          field.classList.remove('is-error');
          field.classList.remove('is-filled');
        });

        openSuccess();
      } catch (error) {
        console.error(error);
        alert('{{ st.submit_fail_text | escape }}');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  })();
</script>

