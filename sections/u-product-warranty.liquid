{% comment %}
  Section: u-extended-warranty-register
  Notes:
  - New independent section for extended warranty registration
  - Includes:
    1) register form
    2) success popup
    3) query tab placeholder (currently unsupported)
  - API submit is placeholder now, replace handleSubmit() as needed
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section
  id="u-ewr-{{ sid }}"
  class="u-ewr"
  data-section-id="{{ sid }}"
  data-enable-query="{{ st.enable_query }}"
>
  <div class="u-ewr__container page-width">
    {%- if st.show_page_note -%}
      <div class="u-ewr__page-note">
        {{ st.page_note }}
      </div>
    {%- endif -%}

    <div class="u-ewr__tab-panels">
      <div class="u-ewr__panel is-active" data-ewr-panel="register" style="display:block;">
        <form class="u-ewr__form" novalidate>
          <div class="u-ewr__group">
            <h3 class="u-ewr__group-title">{{ st.service_info_title }}</h3>

            <div class="u-ewr__grid u-ewr__grid--2">
              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.service_email_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="email"
                  name="service_email"
                  placeholder=" "
                  data-required="true"
                  data-type="email"
                >
                <p class="u-ewr__error">{{ st.error_email }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.service_order_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="service_order_no"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
                <p class="u-ewr__query-tip" data-ewr-order-query-tip></p>
                <p class="u-ewr__query-tip u-ewr__query-tip--error" data-ewr-order-query-error></p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label">
                  {{ st.service_year_label }}
                  <span class="u-ewr__required">*</span>
                </label>

                <div class="u-ewr-select" data-ewr-select>
                  <input type="hidden" name="service_year" data-required="true">
                  <button type="button" class="u-ewr-select__trigger" aria-expanded="false">
                    <span data-ewr-select-label>{{ st.select_placeholder }}</span>
                    <span class="u-ewr-select__arrow">
                      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </button>

                  <div class="u-ewr-select__menu">
                    <ul class="u-ewr-select__list">
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'service_year' -%}
                          <li
                            class="u-ewr-select__option"
                            data-value="{{ block.settings.value | escape }}"
                            data-label="{{ block.settings.label | escape }}"
                            {{ block.shopify_attributes }}
                          >
                            {{ block.settings.label }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>

                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.service_date_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="date"
                  name="service_order_date"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>
            </div>
          </div>

          <div class="u-ewr__group">
            <h3 class="u-ewr__group-title">{{ st.customer_info_title }}</h3>

            <div class="u-ewr__grid u-ewr__grid--2">
              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_name_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="customer_name"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_phone_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="customer_phone"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_zip_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="customer_zip"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field u-ewr__field--placeholder u-ewr__field--desktop-only"></div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_prefecture_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="customer_prefecture"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_city_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="customer_city"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field u-ewr__field--full">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_address1_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="customer_address1"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field u-ewr__field--full">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.customer_address2_label }}
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="customer_address2"
                  placeholder=" "
                >
              </div>
            </div>
          </div>

          <div class="u-ewr__group">
            <h3 class="u-ewr__group-title">{{ st.product_info_title }}</h3>

            <div class="u-ewr__grid u-ewr__grid--2">
              <div class="u-ewr__field">
                <label class="u-ewr__label">
                  {{ st.channel_label }}
                  <span class="u-ewr__required">*</span>
                </label>

                <div class="u-ewr-select" data-ewr-select>
                  <input type="hidden" name="purchase_channel" data-required="true">
                  <button type="button" class="u-ewr-select__trigger" aria-expanded="false">
                    <span data-ewr-select-label>{{ st.select_placeholder }}</span>
                    <span class="u-ewr-select__arrow">
                      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </button>

                  <div class="u-ewr-select__menu">
                    <ul class="u-ewr-select__list">
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'channel' -%}
                          <li
                            class="u-ewr-select__option"
                            data-value="{{ block.settings.value | escape }}"
                            data-label="{{ block.settings.label | escape }}"
                            {{ block.shopify_attributes }}
                          >
                            {{ block.settings.label }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>

                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label">
                  {{ st.model_label }}
                  <span class="u-ewr__required">*</span>
                </label>

                <div class="u-ewr-select" data-ewr-select>
                  <input type="hidden" name="product_model" data-required="true">
                  <button type="button" class="u-ewr-select__trigger" aria-expanded="false">
                    <span data-ewr-select-label>{{ st.select_placeholder }}</span>
                    <span class="u-ewr-select__arrow">
                      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </button>

                  <div class="u-ewr-select__menu">
                    <ul class="u-ewr-select__list">
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'model' -%}
                          <li
                            class="u-ewr-select__option"
                            data-value="{{ block.settings.value | escape }}"
                            data-label="{{ block.settings.label | escape }}"
                            {{ block.shopify_attributes }}
                          >
                            {{ block.settings.label }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>

                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.product_order_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="product_order_no"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>

              <div class="u-ewr__field">
                <label class="u-ewr__label u-ewr__label--floating">
                  {{ st.serial_label }}
                  <span class="u-ewr__required">*</span>
                </label>
                <input
                  class="u-ewr__input"
                  type="text"
                  name="serial_number"
                  placeholder=" "
                  data-required="true"
                >
                <p class="u-ewr__error">{{ st.error_required }}</p>
              </div>
            </div>

            <div class="u-ewr__sn-note">
              {{ st.serial_note }}
            </div>

            <div class="u-ewr__upload">
              <input
                id="u-ewr-upload-{{ sid }}"
                class="u-ewr__upload-input"
                type="file"
                name="proof_files"
                multiple
                accept="image/*,.pdf"
              >

              <div class="u-ewr__upload-box" data-upload-box>
                <div class="u-ewr__upload-list" data-upload-list></div>

                <label class="u-ewr__upload-add" for="u-ewr-upload-{{ sid }}">
                  {%- if st.upload_icon != blank -%}
                    <img
                      src="{{ st.upload_icon | image_url: width: 120 }}"
                      alt=""
                      loading="lazy"
                      width="60"
                      height="60"
                    >
                  {%- else -%}
                    <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M31.1667 18.3333V12.8333C31.1667 11.8217 30.345 11 29.3333 11H12.8333C11.8217 11 11 11.8217 11 12.8333V31.1667C11 32.1783 11.8217 33 12.8333 33H18.3333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M15.583 18.3333C16.5965 18.3333 17.4163 17.5135 17.4163 16.5C17.4163 15.4865 16.5965 14.6667 15.583 14.6667C14.5695 14.6667 13.7497 15.4865 13.7497 16.5C13.7497 17.5135 14.5695 18.3333 15.583 18.3333Z" stroke="currentColor" stroke-width="2"/>
                      <path d="M31.167 25.6667V36.6667" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="M25.667 31.1667H36.667" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="M11 27.5L17.4167 21.0833L22 25.6667L25.6667 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                </label>

                <div class="u-ewr__upload-text">
                  {{ st.upload_text }}
                </div>
              </div>

              <p class="u-ewr__error u-ewr__error--upload" data-upload-error></p>
            </div>
          </div>

          <div class="u-ewr__actions">
            <button type="submit" class="u-ewr__submit">
              {{ st.submit_text }}
            </button>
          </div>

          <div class="u-ewr__footnotes">
            <div>{{ st.footnote_1 }}</div>
            <div>{{ st.footnote_2 }}</div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="u-ewr-modal" data-ewr-success hidden>
    <div class="u-ewr-modal__overlay" data-ewr-success-close></div>

    <div class="u-ewr-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="u-ewr-success-title-{{ sid }}">
      <button type="button" class="u-ewr-modal__close" data-ewr-success-close aria-label="Close">
        ×
      </button>

      <div class="u-ewr-modal__icon">
        {%- if st.success_icon != blank -%}
          <img
            src="{{ st.success_icon | image_url: width: 120 }}"
            alt=""
            loading="lazy"
            width="60"
            height="60"
          >
        {%- else -%}
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="24" fill="#59C36A"/>
            <path d="M22 32L29 39L42 24" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </div>

      <h3 id="u-ewr-success-title-{{ sid }}" class="u-ewr-modal__title">
        {{ st.success_title }}
      </h3>

      <div class="u-ewr-modal__desc">
        {{ st.success_desc }}
      </div>

      <div class="u-ewr-modal__subdesc">
        {{ st.success_subdesc }}
      </div>
    </div>
  </div>
</section>

<style>
  #u-ewr-{{ sid }}{
    --ewr-bg: {{ st.page_bg }};
    --ewr-text: {{ st.text_color }};
    --ewr-muted: {{ st.muted_color }};
    --ewr-line: {{ st.line_color }};
    --ewr-tab-bg: {{ st.tab_bg }};
    --ewr-tab-active-bg: {{ st.tab_active_bg }};
    --ewr-tab-active-text: {{ st.tab_active_text }};
    --ewr-btn-bg: {{ st.button_bg }};
    --ewr-btn-text: {{ st.button_text }};
    --ewr-error: #D92D20;
    --ewr-modal-border: #191919;

    background: var(--ewr-bg);
    color: var(--ewr-text);
    padding: 40px 20px 60px;
  }

  #u-ewr-{{ sid }} *{
    box-sizing: border-box;
  }

  #u-ewr-{{ sid }} .u-ewr__container{
    margin: 0 auto;
  }

  #u-ewr-{{ sid }} .u-ewr__page-note{
    font-size: 14px;
    line-height: 1.7;
    color: var(--ewr-muted);
    margin-bottom: 26px;
  }

  #u-ewr-{{ sid }} .u-ewr__panel{
    display: none;
  }

  #u-ewr-{{ sid }} .u-ewr__panel.is-active{
    display: block;
  }

  #u-ewr-{{ sid }} .u-ewr__group + .u-ewr__group{
    margin-top: 54px;
  }

  #u-ewr-{{ sid }} .u-ewr__group-title{
    margin: 0 0 26px;
    font-size: 34px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0;
  }

  #u-ewr-{{ sid }} .u-ewr__grid{
    display: grid;
    gap: 28px 36px;
  }

  #u-ewr-{{ sid }} .u-ewr__grid--2{
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #u-ewr-{{ sid }} .u-ewr__field{
    position: relative;
  }

  #u-ewr-{{ sid }} .u-ewr__field--full{
    grid-column: 1 / -1;
  }

  #u-ewr-{{ sid }} .u-ewr__label{
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 10px;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: .02em;
    color: #7A7A7A;
  }

  #u-ewr-{{ sid }} .u-ewr__label--floating{
    position: absolute;
    left: 0;
    top: 17px;
    z-index: 2;
    margin: 0;
    pointer-events: none;
    transform-origin: left top;
    transition: top .2s ease, transform .2s ease, color .2s ease;
  }

  #u-ewr-{{ sid }} .u-ewr__required{
    color: #E5484D;
  }

  #u-ewr-{{ sid }} .u-ewr__input,
  #u-ewr-{{ sid }} .u-ewr-select__trigger{
    width: 100%;
    height: 52px;
    border: 0;
    border-bottom: 1px solid var(--ewr-line);
    border-radius: 0;
    background: transparent;
    color: var(--ewr-text);
    font-size: 24px;
    line-height: 1.2;
    padding: 18px 0 10px;
    outline: none;
  }

  #u-ewr-{{ sid }} .u-ewr__input::placeholder{
    color: #9B9B9B;
  }

  #u-ewr-{{ sid }} .u-ewr__input[placeholder=" "]::placeholder{
    color: transparent;
  }

  #u-ewr-{{ sid }} .u-ewr__field:focus-within .u-ewr__label--floating,
  #u-ewr-{{ sid }} .u-ewr__field.is-filled .u-ewr__label--floating{
    top: 0;
    transform: scale(.84);
    color: var(--ewr-text);
  }

  #u-ewr-{{ sid }} .u-ewr__input:focus,
  #u-ewr-{{ sid }} .u-ewr-select__trigger:focus{
    border-bottom-color: var(--ewr-text);
  }

  #u-ewr-{{ sid }} .u-ewr-select{
    position: relative;
  }

  #u-ewr-{{ sid }} .u-ewr-select__trigger{
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    cursor: pointer;
  }

  #u-ewr-{{ sid }} .u-ewr-select__arrow{
    display: inline-flex;
    flex: 0 0 auto;
    margin-left: 12px;
  }

  #u-ewr-{{ sid }} .u-ewr-select__menu{
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 10;
    display: none;
    background: #fff;
    border: 1px solid #d9d9d9;
    max-height: 260px;
    overflow: auto;
    box-shadow: 0 10px 24px rgba(0,0,0,.08);
  }

  #u-ewr-{{ sid }} .u-ewr-select.is-open .u-ewr-select__menu{
    display: block;
  }

  #u-ewr-{{ sid }} .u-ewr-select__list{
    list-style: none;
    margin: 0;
    padding: 8px 0;
  }

  #u-ewr-{{ sid }} .u-ewr-select__option{
    padding: 12px 16px;
    font-size: 16px;
    line-height: 1.4;
    cursor: pointer;
  }

  #u-ewr-{{ sid }} .u-ewr-select__option:hover{
    background: #f4f4f4;
  }

  #u-ewr-{{ sid }} .u-ewr__sn-note{
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--ewr-muted);
  }

  #u-ewr-{{ sid }} .u-ewr__upload{
    margin-top: 42px;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-input{
    display: none;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-box{
    background: rgba(255,255,255,.35);
    border-radius: 8px;
    padding: 30px 24px 26px;
    min-height: 220px;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-list{
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 18px;
    min-height: 90px;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-item,
  #u-ewr-{{ sid }} .u-ewr__upload-add{
    width: 96px;
    height: 96px;
    border-radius: 4px;
    background: #F5F5F5;
    position: relative;
    overflow: hidden;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-add{
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ewr-text);
    cursor: pointer;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-thumb{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-file{
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
    color: var(--ewr-text);
    background: #ececec;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-remove{
    position: absolute;
    top: 4px;
    right: 4px;
    width: 22px;
    height: 22px;
    border: 0;
    border-radius: 2px;
    background: rgba(0,0,0,.55);
    color: #fff;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
  }

  #u-ewr-{{ sid }} .u-ewr__upload-text{
    font-size: 14px;
    line-height: 1.8;
    color: var(--ewr-muted);
    text-align: center;
  }

  #u-ewr-{{ sid }} .u-ewr__error{
    display: none;
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ewr-error);
  }

