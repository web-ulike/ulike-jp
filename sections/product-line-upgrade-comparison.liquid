      {%- if section.settings.note != blank -%}
        <div class="pluc__note to-top">{{ section.settings.note }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('pluc-{{ sid }}');
    if (!root) return;

    const closeModal = (modal) => {
      if (!modal) return;
      modal.hidden = true;
      const opener = root.querySelector(`[aria-controls="${modal.id}"]`);
      if (opener) opener.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    };

    root.addEventListener('click', (event) => {
      const openButton = event.target.closest('[data-pluc-open]');
      if (openButton) {
        const modal = document.getElementById(openButton.getAttribute('aria-controls'));
        if (!modal) return;
        modal.hidden = false;
        openButton.setAttribute('aria-expanded', 'true');
        document.documentElement.style.overflow = 'hidden';
        const closeButton = modal.querySelector('.pluc-modal__close');
        if (closeButton) closeButton.focus();
        return;
      }

      const closeButton = event.target.closest('[data-pluc-close]');
      if (closeButton) {
        closeModal(closeButton.closest('[data-pluc-modal]'));
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const modal = root.querySelector('.pluc-modal:not([hidden])');
      if (modal) closeModal(modal);
    });
  })();
</script>

