{% assign sid = section.id %}
<section id="me-triple-{{ sid }}" class="me-triple" style="--me-triple-bg: {{ section.settings.background }};">
  <div class="me-triple__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    <div class="me-triple__grid">
      <div class="me-triple__media">{% if section.settings.image != blank %}<picture>{% if section.settings.image_mobile != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">{% endif %}{{ section.settings.image | image_url: width: 1200 | image_tag: class: 'me-triple__image', loading: 'lazy', widths: '500, 750, 1000, 1200' }}</picture>{% else %}<div class="me-triple__empty">画像を設定</div>{% endif %}</div>
      <div class="me-triple__items">{% for block in section.blocks %}<details class="me-triple__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.title }}<span aria-hidden="true">+</span></summary><div class="me-triple__body">{{ block.settings.text }}</div></details>{% endfor %}</div>
    </div>
  </div>
</section>
<style>
  #me-triple-{{ sid }} { background:var(--me-triple-bg); padding:108px 24px; color:#111; } #me-triple-{{ sid }} .me-triple__inner { max-width:1260px; margin:auto; } #me-triple-{{ sid }} h2 { margin:0 0 55px; text-align:center; font-size:42px; line-height:1.35; font-weight:600; } #me-triple-{{ sid }} .me-triple__grid { display:grid; grid-template-columns:minmax(0, .95fr) minmax(0, 1.05fr); align-items:center; gap:80px; } #me-triple-{{ sid }} .me-triple__image { display:block; width:100%; height:auto; } #me-triple-{{ sid }} .me-triple__empty { display:grid; min-height:440px; place-items:center; color:#7194b4; background:#eaf4fd; } #me-triple-{{ sid }} .me-triple__item { border-bottom:1px solid #ccd8e2; } #me-triple-{{ sid }} summary { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:28px 0; cursor:pointer; list-style:none; font-size:26px; line-height:1.4; font-weight:600; } #me-triple-{{ sid }} summary::-webkit-details-marker { display:none; } #me-triple-{{ sid }} summary span { color:#6dbcf1; font-size:34px; font-weight:300; } #me-triple-{{ sid }} details[open] summary span { transform:rotate(45deg); } #me-triple-{{ sid }} .me-triple__body { padding:0 38px 28px 0; color:#546270; font-size:15px; line-height:1.85; } #me-triple-{{ sid }} .me-triple__body p { margin:0; }
  @media(max-width:749px) { #me-triple-{{ sid }} { padding:52px 0 0; } #me-triple-{{ sid }} h2 { margin:0 20px 27px; font-size:24px; } #me-triple-{{ sid }} .me-triple__grid { display:block; } #me-triple-{{ sid }} .me-triple__empty { min-height:280px; } #me-triple-{{ sid }} .me-triple__items { padding:0 16px; } #me-triple-{{ sid }} summary { padding:22px 0; font-size:18px; } #me-triple-{{ sid }} .me-triple__body { padding:0 20px 22px 0; font-size:12px; line-height:1.75; } }
</style>
{% schema %}
{"name":"Ulike ME 三重保证","max_blocks":3,"settings":[{"type":"text","id":"heading","label":"标题","default":"長く安心して使える<br>「トリプル保証」"},{"type":"image_picker","id":"image","label":"PC 图片"},{"type":"image_picker","id":"image_mobile","label":"移动端图片"},{"type":"color","id":"background","label":"背景","default":"#ffffff"}],"blocks":[{"type":"guarantee","name":"保证条目","settings":[{"type":"text","id":"title","label":"标题"},{"type":"richtext","id":"text","label":"说明"}]}],"presets":[{"name":"Ulike ME 三重保证","blocks":[{"type":"guarantee"},{"type":"guarantee"},{"type":"guarantee"}]}]}
{% endschema %}
