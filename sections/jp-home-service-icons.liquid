{% liquid
  assign sid = section.id
%}

<section class="jp-home-service-icons jp-home-service-icons--{{ sid }}">
  <div class="jp-container">
    <div class="jp-home-service-icons__inner">
      <div class="jp-home-service-icons__list swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="jp-home-service-icons__item swiper-slide" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a class="jp-home-service-icons__link" href="{{ block.settings.link }}">
              {% else %}
                <div class="jp-home-service-icons__link">
              {% endif %}

              {% if block.settings.icon != blank %}
                <div class="jp-home-service-icons__icon">
                  <img
                    src="{{ block.settings.icon | image_url: width: 120 }}"
                    alt="{{ block.settings.icon.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.icon.width }}"
                    height="{{ block.settings.icon.height }}"
                  >
                </div>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="jp-home-service-icons__text">{{ block.settings.text }}</div>
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .jp-home-service-icons--{{ sid }} {
    --jp-home-service-icons-border: #ece7ea;
    --jp-home-service-icons-text: #111111;
    --jp-home-service-icons-bg: #ffffff;
    --jp-home-service-icons-icon-size: 22px;
    --jp-home-service-icons-gap: 10px;
    padding: 18px 0;
    background: var(--jp-home-service-icons-bg);
    border-bottom: 1px solid var(--jp-home-service-icons-border);
  }

  .jp-home-service-icons--{{ sid }} .jp-home-service-icons__inner {
    position: relative;
  }

  .jp-home-service-icons--{{ sid }} .jp-home-service-icons__list {
    overflow: hidden;
  }

  .jp-home-service-icons--{{ sid }} .jp-home-service-icons__list .swiper-wrapper {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 5 }}, minmax(0, 1fr));
    gap: 0;
  }

  .jp-home-service-icons--{{ sid }} .jp-home-service-icons__item {
    min-width: 0;
  }

  .jp-home-service-icons--{{ sid }} .jp-home-service-icons__link {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--jp-home-service-icons-gap);
    text-decoration: none;
    color: var(--jp-home-service-icons-text);
    text-align: center;
    padding: 8px 14px;
  }

  .jp-home-service-icons--{{ sid }} .jp-home-service-icons__icon {
    width: var(--jp-home-service-icons-icon-size);
    height: var(--jp-home-service-icons-icon-size);
    flex: 0 0 var(--jp-home-service-icons-icon-size);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .jp-home-service-icons--{{ sid }} .jp-home-service-icons__icon img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }

  .jp-home-service-icons--{{ sid }} .jp-home-service-icons__text {
    font-size: 13px;
    line-height: 1.5;
    font-weight: 500;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    .jp-home-service-icons--{{ sid }} {
      padding: 12px 0;
    }

    .jp-home-service-icons--{{ sid }} .jp-home-service-icons__list {
      overflow: hidden;
    }

    .jp-home-service-icons--{{ sid }} .jp-home-service-icons__list .swiper-wrapper {
      display: flex;
      gap: 0;
    }

    .jp-home-service-icons--{{ sid }} .jp-home-service-icons__item {
      width: auto;
      min-width: 160px;
    }

    .jp-home-service-icons--{{ sid }} .jp-home-service-icons__link {
      min-height: 44px;
      justify-content: flex-start;
      padding: 6px 12px;
      gap: 8px;
    }

    .jp-home-service-icons--{{ sid }} .jp-home-service-icons__icon {
      width: 18px;
      height: 18px;
      flex-basis: 18px;
    }

    .jp-home-service-icons--{{ sid }} .jp-home-service-icons__text {
      font-size: 12px;
      white-space: nowrap;
    }
  }
</style>

<script>
  (() => {
    const sectionEl = document.querySelector('.jp-home-service-icons--{{ sid }}');
    if (!sectionEl) return;

    const initServiceIconsSwiper = () => {
      const swiperEl = sectionEl.querySelector('.jp-home-service-icons__list');
      if (!swiperEl || typeof window.Swiper === 'undefined') return;

      const isMobile = window.innerWidth <= 989;

      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }

      if (!isMobile) return;

      new window.Swiper(swiperEl, {
        slidesPerView: 'auto',
        spaceBetween: 0,
        freeMode: true,
        watchOverflow: true
      });
    };

    initServiceIconsSwiper();
    window.addEventListener('resize', initServiceIconsSwiper);
  })();
</script>

