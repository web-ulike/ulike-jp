{%- liquid
  assign section_id = 'jp-air10-power-2026-' | append: section.id
  assign default_description = '出力エネルギーが28J*1へとアップグレード。たった週3回*2の新習慣が、目に見える肌の変化をいち早く体験いただけます*。'
  assign default_note = '*1.国際認証機関SGSによる報告：GZCPCH24001216-01S1_CN。トリートメントスケジュールに従って週3回使用した場合、効果を実感し始めます。効果には個人差及び部位差があります。\n*2.国際認証機関CVCにより：WTS2024-15864、最大出力エネルギーはUSHRモード使用時に限られている、結果はテスト条件による異なる可能性もあります。'
-%}

<section id="{{ section_id }}" class="jp-power-2026">
  <div class="jp-power-2026__background" aria-hidden="true">
    <picture>
      {%- if section.settings.background_image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.background_image_mobile | image_url: width: 1200 }}">
      {%- endif -%}
      {%- if section.settings.background_image != blank -%}
        {{ section.settings.background_image | image_url: width: 3000 | image_tag: loading: 'lazy', widths: '750, 1200, 1600, 2200, 3000', class: 'jp-power-2026__background-image', alt: '' }}
      {%- elsif section.settings.background_image_mobile != blank -%}
        {{ section.settings.background_image_mobile | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 750, 1200', class: 'jp-power-2026__background-image', alt: '' }}
      {%- endif -%}
    </picture>
  </div>

  <div class="jp-power-2026__inner">
    <p class="jp-power-2026__description to-top">{{ section.settings.description | default: default_description | escape }}</p>

    <div class="jp-power-2026__result to-top" style="transition-delay: .1s">
      <span class="jp-power-2026__result-prefix">{{ section.settings.result_prefix | default: 'たった' | escape }}</span>
      <span class="jp-power-2026__result-number">
        {%- if section.settings.result_number == blank or section.settings.result_number == '3' -%}
          <svg aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 82.7412 116.717" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.4089 80.3194C9.40756 84.3057 9.47635 88.3112 10.5628 92.2258C13.4967 102.801 20.1808 109.647 31.0547 111.888C37.5175 113.219 43.7079 111.944 49.5006 108.843C57.5044 104.559 62.9871 98.0809 65.5785 89.387C68.1656 80.7023 66.7125 72.4524 61.8602 64.8691C56.5881 56.6305 48.9254 51.7336 39.5025 49.4557C39.1734 49.3762 38.8429 49.3004 38.4125 49.1989C49.2552 37.2456 60.0334 25.3633 70.9257 13.3546C70.4584 13.3546 70.1662 13.3546 69.8733 13.3546C59.9986 13.3546 50.1232 13.3142 40.2493 13.383C37.7175 13.4007 35.1772 13.6795 32.6596 13.9915C28.808 14.4695 25.8762 16.5162 23.7629 19.7139C22.565 21.5259 21.4942 23.4236 20.4006 25.3023C20.1893 25.6661 19.9935 25.8405 19.5588 25.8186C18.8142 25.7803 18.066 25.8079 17.2263 25.8079C20.6999 17.1417 24.1345 8.57333 27.5705 0C28.7442 0.361684 29.8562 0.763791 30.9972 1.04534C34.3049 1.86303 37.6969 2.05167 41.0755 2.08146C54.2684 2.19918 67.4628 2.22329 80.6571 2.28003C81.855 2.2857 81.8557 2.27932 82.1585 3.436C82.3287 4.08206 82.4656 4.73877 82.6712 5.37278C82.823 5.83871 82.7273 6.15359 82.3897 6.51669C77.3382 11.9476 72.303 17.3934 67.2642 22.8364C61.7574 28.7858 56.2506 34.7358 50.7438 40.6859C50.5303 40.9164 50.3204 41.1511 50.0871 41.4086C51.5593 41.9014 52.9834 42.3135 54.3585 42.8482C66.0444 47.3912 73.0909 55.8624 75.1525 68.2044C76.7502 77.7649 74.7078 86.7531 69.5698 94.9534C62.7481 105.841 52.9897 112.756 40.4861 115.615C32.7234 117.391 24.972 117.073 17.4433 114.281C11.9812 112.255 7.23958 109.12 3.75536 104.372C0.236389 99.5758 -0.913198 94.1917 0.74842 88.4438C2.03133 84.0078 4.95601 81.0987 9.68414 80.3158C9.85434 80.2882 10.0267 80.2733 10.1983 80.264C10.2579 80.2612 10.3189 80.2945 10.4089 80.3194Z" fill="black"/>
          </svg>
        {%- else -%}
          {{ section.settings.result_number | escape }}
        {%- endif -%}
      </span>
      <span class="jp-power-2026__result-unit" aria-hidden="true">
        <svg preserveAspectRatio="none" viewBox="0 0 57.9026 53.1458" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M51.821 4.23391L44.3339 46.7253H4.82636L12.3135 4.23391H51.821ZM13.2207 2.66025C12.7962 2.45073 12.3225 2.21954 11.8006 1.96758C11.2786 1.71606 10.725 1.4641 10.1411 1.21258C9.44526 0.877081 9.02352 1.12859 8.87586 1.96758L0.0236644 52.2017C-0.087417 52.8311 0.192544 53.1458 0.864 53.1458H2.75103C3.38049 53.1458 3.74986 52.8311 3.86094 52.2017L4.5491 48.2989H44.0566L43.3684 52.2017C43.2574 52.8311 43.5378 53.1458 44.2088 53.1458H46.0335C46.7036 53.1458 47.0951 52.8311 47.2062 52.2017L55.4149 5.61881L57.1872 4.48587C57.6085 4.23391 57.8456 3.96162 57.8975 3.66766C57.9784 3.20618 57.0838 2.09356 55.2144 0.331156C54.7918 -0.130328 54.3267 -0.109557 53.8196 0.393922L51.5329 2.66025H13.2207ZM36.2547 16.8868L33.6262 31.806H20.0377L22.6662 16.8868H36.2547ZM23.4966 15.3131C23.1575 15.1036 22.7665 14.8941 22.323 14.6837C21.8787 14.4742 21.3901 14.2222 20.8564 13.9282C20.1136 13.6352 19.6679 13.9075 19.5207 14.7465L15.6378 36.7789C15.5191 37.4509 15.7954 37.7864 16.4664 37.7864H18.0392C18.6686 37.7864 19.0421 37.4509 19.1608 36.7789L19.7596 33.3797H33.3481L32.8378 36.2755C32.72 36.9474 32.9905 37.2824 33.6497 37.2824H35.2568C35.8745 37.2824 36.243 36.9474 36.3608 36.2755L39.5781 18.0202L41.2028 17.0128C41.4841 16.8457 41.6462 16.6353 41.6905 16.3833C41.7867 15.8383 41.0082 14.7889 39.3551 13.236C38.885 12.817 38.3978 12.8581 37.8902 13.3615L36.0402 15.3131H23.4966Z" fill="black"/>
        </svg>
      </span>
      <span class="jp-power-2026__result-suffix">{{ section.settings.result_suffix | default: 'で効果を実感' | escape }}</span>
    </div>

    <div class="jp-power-2026__badge to-top" style="transition-delay: .2s">
      {%- if section.settings.power_image != blank -%}
        {{ section.settings.power_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '220, 350, 500, 700', class: 'jp-power-2026__badge-image', alt: section.settings.power_image.alt }}
      {%- endif -%}
      <div class="jp-power-2026__badge-copy">
        <strong>{{ section.settings.power_number | default: '28J' | escape }}</strong>
        <span>{{ section.settings.power_label | default: 'ハイパワー' | escape }}</span>
      </div>
    </div>

    <p class="jp-power-2026__note">{{ section.settings.note | default: default_note | escape | newline_to_br }}</p>
  </div>
</section>

<style>
  #{{ section_id }} { background: linear-gradient(0deg, #fff 15.69%, #e2e7f1 127.77%); color: #000; overflow: hidden; position: relative; }
  #{{ section_id }} * { box-sizing: border-box; }
  #{{ section_id }} .jp-power-2026__background, #{{ section_id }} .jp-power-2026__background picture { display: block; pointer-events: none; position: relative; width: 100%; }
  #{{ section_id }} .jp-power-2026__background-image { display: block; height: auto; max-width: none; object-fit: initial; position: relative; transform: none; width: 100%; }
  #{{ section_id }} .jp-power-2026__inner { bottom: 0; height: auto; left: 0; margin: 0 auto; max-width: 1280px; position: absolute; right: 0; top: 0; }
  #{{ section_id }} .jp-power-2026__description { font-family: "Noto Sans JP", sans-serif; font-size: 24px; font-weight: 400; left: 15px; line-height: 1.5; margin: 0; max-width: 595px; position: absolute; top: 313px; }
  #{{ section_id }} .jp-power-2026__result { align-items: center; display: flex; font-family: "Noto Sans JP", sans-serif; font-size: 48px; font-weight: 500; left: 14px; letter-spacing: .04em; line-height: 1.3; position: absolute; top: 176px; }
  #{{ section_id }} .jp-power-2026__result-number { 
    align-items: center; display: inline-flex; flex: 0 0 auto; height: 117px; 
    justify-content: center; margin: 0 4px 0 8px;
     transform: translateY(-20px); 
     width: 83px; }
  #{{ section_id }} .jp-power-2026__result-number svg { display: block; height: 100%; width: 100%; }
  #{{ section_id }} .jp-power-2026__result-unit { align-items: center; display: inline-flex; flex: 0 0 auto; height: 53px; margin: 23px 8px 0 0; width: 58px; }
  #{{ section_id }} .jp-power-2026__result-unit svg { display: block; height: 100%; width: 100%; }
  #{{ section_id }} .jp-power-2026__badge { height: 300px; left: 5px; position: absolute; top: 483px; width: 265px; }
  #{{ section_id }} .jp-power-2026__badge-image { display: block; height: 124px; left: 50%; max-width: 100%; object-fit: contain; position: absolute; top: 0; transform: translateX(-50%); width: 131px; }
  #{{ section_id }} .jp-power-2026__badge-copy { bottom: auto; font-family: "Noto Sans JP", sans-serif; left: 50%; position: absolute; text-align: center; top: 150px; transform: translateX(-50%); white-space: nowrap; }
  #{{ section_id }} .jp-power-2026__badge-copy strong { display: block; font-family: Roboto, Saans, sans-serif; font-size: 85px; font-weight: 600; line-height: 1.05; }
  #{{ section_id }} .jp-power-2026__badge-copy span { display: block; font-size: 24px; font-weight: 700; line-height: 1.8; }
  #{{ section_id }} .jp-power-2026__note { bottom: auto; color: rgba(0,0,0,.5); font-family: Saans, "Noto Sans JP", sans-serif; font-size: 10px; left: 15px; line-height: 1.5; margin: 0; position: absolute; top: 831px; width: 575px; }
  @media screen and (max-width: 749px) {
    #{{ section_id }} .jp-power-2026__background-image { height: auto; width: 100%; }
    #{{ section_id }} .jp-power-2026__inner { max-width: none; width: 100%; }
    #{{ section_id }} .jp-power-2026__description { font-size: 18px; left: 18px; line-height: 1.5; max-width: calc(100% - 36px); top: 140px; }
    #{{ section_id }} .jp-power-2026__result { font-size: 26px; left: 50%; letter-spacing: .04em; top: 46px; transform: translateX(-50%); white-space: nowrap; }
    #{{ section_id }} .jp-power-2026__result-number { height: 63px; margin: 0 2px 0 4px; transform: translateY(-4px); width: 45px; }
    #{{ section_id }} .jp-power-2026__result-unit { height: 29px; margin: 12px 4px 0 0; width: 31px; }
    #{{ section_id }} .jp-power-2026__badge { height: 184px; left: 50%; top: 261px; transform: translateX(-50%); width: 145px; }
    #{{ section_id }} .jp-power-2026__badge-image { height: 122px; width: 122px; }
    #{{ section_id }} .jp-power-2026__badge-copy { bottom: 0; top: auto; }
    #{{ section_id }} .jp-power-2026__badge-copy strong { font-size: 42px; }
    #{{ section_id }} .jp-power-2026__badge-copy span { font-size: 12px; }
    #{{ section_id }} .jp-power-2026__note { bottom: 21px; font-family: "Noto Sans JP", sans-serif; font-size: 8px; left: 21px; top: auto; width: calc(100% - 42px); }
  }
</style>

{% schema %}
{
  "name": "jp-air10-power-2026",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "PC 背景图片" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "M 背景图片" },
    { "type": "image_picker", "id": "power_image", "label": "28J 功率视觉图" },
    { "type": "textarea", "id": "description", "label": "说明文案", "default": "出力エネルギーが28J*1へとアップグレード。たった週3回*2の新習慣が、目に見える肌の変化をいち早く体験いただけます*。" },
    { "type": "text", "id": "result_prefix", "label": "效果标题前缀", "default": "たった" },
    { "type": "text", "id": "result_number", "label": "效果标题数字", "default": "3" },
    { "type": "text", "id": "result_suffix", "label": "效果标题后缀", "default": "で効果を実感" },
    { "type": "text", "id": "power_number", "label": "功率数值", "default": "28J" },
    { "type": "text", "id": "power_label", "label": "功率标题", "default": "ハイパワー" },
    { "type": "textarea", "id": "note", "label": "脚注文案", "default": "*1.国際認証機関SGSによる報告：GZCPCH24001216-01S1_CN。トリートメントスケジュールに従って週3回使用した場合、効果を実感し始めます。効果には個人差及び部位差があります。\n*2.国際認証機関CVCにより：WTS2024-15864、最大出力エネルギーはUSHRモード使用時に限られている、結果はテスト条件による異なる可能性もあります。" }
  ],
  "presets": [{ "name": "jp-air10-power-2026" }]
}
{% endschema %}
