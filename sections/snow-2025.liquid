<style>
#shopify-section-{{ section.id }} {
pointer-events: none;
    overflow: hidden;
}
.snowCanvas-2025-new{
    display: block;
        display: block;
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index:1;
}
</style>
<canvas id="snowCanvas-2025" class="snowCanvas-2025-new"></canvas>
<script>
const canvas = document.getElementById('snowCanvas-2025');
const ctx = canvas.getContext('2d');

let width = window.innerWidth;
let height = window.innerHeight;
canvas.width = width;
canvas.height = height;

// --- 配置参数 ---
const maxSnowflakes = window.innerWidth < 992 ? 56 : 150;
const  snowW =  window.innerWidth < 992 ? 1 : 3;
const snowflakes = [];
const flakeProbability = 0.1; // 10% 的几率是六芒星雪花，90% 是圆点
// 【新增配置】发光强度，数值越大光晕越明显。建议范围 5 - 15
const glowBlurAmount = 8;

// --- 雪花类 ---
class Snowflake {
    constructor() {
        this.reset(true);
    }

    reset(isInitial = false) {
        this.type = Math.random() < flakeProbability ? 'flake' : 'dot';

        this.x = Math.random() * width;
        this.y = isInitial ? Math.random() * height : -10;

        this.drift = Math.random() * 0.5 - 0.25;
        this.speed = Math.random() * 1 + 0.25;

        if (this.type === 'flake') {
            this.radius = Math.random() * 4 + snowW; // 六芒星雪花半径 5px - 9px
            this.rotation = Math.random() * Math.PI * 2;
            this.rotationSpeed = (Math.random() - 0.5) * 0.02;
            this.opacity = 0.9;
        } else {
            this.radius = Math.random() * 2 + 1; // 圆点半径 1px - 3px
            this.rotation = 0;
            this.rotationSpeed = 0;
            this.opacity = Math.random() * 0.5 + 0.3;
        }
    }

    update() {
        this.y += this.speed;
        this.x += this.drift;

        if (this.type === 'flake') {
            this.rotation += this.rotationSpeed;
        }

        if (this.y > height + 10 || this.x < -10 || this.x > width + 10) {
            this.reset();
        }
    }

    draw() {
        if (this.type === 'flake') {
            this.drawHexagram();
        } else {
            this.drawDot();
        }
    }

    // 绘制普通圆点 (已添加发光)
    drawDot() {
        // 【新增】保存状态，防止阴影设置影响其他元素
        ctx.save();

        ctx.beginPath();
        const colorStr = `rgba(255, 255, 255, ${this.opacity})`;
        ctx.fillStyle = colorStr;
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);

        // --- 【新增】添加外发光效果 ---
        // 让发光的透明度稍微低一点，看起来更柔和
        ctx.shadowColor = `rgba(255, 255, 255, ${this.opacity * 0.8})`;
        ctx.shadowBlur = glowBlurAmount; // 设置模糊距离
        ctx.shadowOffsetX = 0; // 居中
        ctx.shadowOffsetY = 0; // 居中

        ctx.fill();

        // 【新增】恢复状态
        ctx.restore();
    }

    // 绘制六芒星雪花 (已添加发光)
    drawHexagram() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rotation);

        const colorStr = `rgba(255, 255, 255, ${this.opacity})`;
        ctx.strokeStyle = colorStr;
        ctx.lineWidth = 1.5;
        ctx.lineCap = "round";

        // --- 【新增】添加外发光效果 ---
        // 阴影效果同样适用于描边 (stroke)
        ctx.shadowColor = `rgba(255, 255, 255, ${this.opacity * 0.8})`;
        // 六芒星比较大，可以让它的发光稍微强一点点 (可选)
        ctx.shadowBlur = glowBlurAmount + 2;
        ctx.shadowOffsetX = 0;
        ctx.shadowOffsetY = 0;

        ctx.beginPath();

        // 六个主分支
        for (let i = 0; i < 6; i++) {
            // 主线段
            ctx.moveTo(0, 0);
            ctx.lineTo(this.radius, 0);

            // 在主线段末端绘制两个小分支
            const branchLength = this.radius * 0.2; // 小分支长度
            const branchAngle = Math.PI / 6; // 小分支与主线段的夹角

            ctx.moveTo(this.radius, 0); // 回到主线段末端
            ctx.lineTo(this.radius - branchLength * Math.cos(branchAngle), -branchLength * Math.sin(branchAngle));

            ctx.moveTo(this.radius, 0); // 回到主线段末端
            ctx.lineTo(this.radius - branchLength * Math.cos(branchAngle), branchLength * Math.sin(branchAngle));

            // 旋转60度，进入下一个主分支
            ctx.rotate(Math.PI / 3);
        }
        ctx.stroke();

        ctx.restore();
    }
}

// --- 初始化 ---
function init() {
    snowflakes.length = 0;
    for (let i = 0; i < maxSnowflakes; i++) {
        snowflakes.push(new Snowflake());
    }
}

function animate() {
    // 提示：为了让发光效果在深色背景下更明显，确保你的 CSS 中 canvas 的背景是深色的。
    // 如果你想在 JS 里强制设置一个深色背景来测试，可以取消下面这行的注释：
    // ctx.fillStyle = '#0a0a2a'; ctx.fillRect(0, 0, width, height);

    // 原始的清空画布操作
    ctx.clearRect(0, 0, width, height);

    for (const s of snowflakes) {
        s.update();
        s.draw();
    }
    requestAnimationFrame(animate);
}

window.addEventListener('resize', () => {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;
});

init();
animate();

</script>

